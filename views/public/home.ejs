    <!-- Hero Section (Tactical Navy & Gold) -->
    <section id="hero-section" class="relative min-h-[35vh] py-16 md:py-20 flex items-center justify-center overflow-hidden bg-slate-950 bg-cover bg-center bg-no-repeat"
        style="background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95)), url('/images/directory-pnp-2.jpg');">
        <div class="absolute inset-0 z-0 bg-gradient-to-br from-pnp-blue/20 via-slate-950/40 to-slate-950/80"></div>

        <div class="container mx-auto px-4 relative z-10 text-center flex flex-col items-center">
            <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md text-pnp-gold px-4 py-1.5 rounded-full mb-3 border border-white/20">
                <i class="fas fa-shield-halved text-xs"></i>
                <span class="text-[10px] font-black uppercase tracking-widest">Official Portal &bull; PNP Sta. Cruz</span>
            </div>

            <h1 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-2">
                Sta. Cruz <span class="text-pnp-gold">Public Safety Portal</span>
            </h1>

            <p class="text-xs sm:text-sm text-blue-100/90 font-medium max-w-2xl mx-auto leading-relaxed">
                Your official municipal platform for real-time crime mapping, verified police bulletins, and public safety advisories from the Sta. Cruz Municipal Police Station.
            </p>

            <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5">
                <button type="button" onclick="openFaqModal()"
                    class="px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-gold hover:bg-yellow-400 text-slate-950 transition flex items-center gap-2 shadow-md active:scale-95 cursor-pointer">
                    <i class="fas fa-circle-question text-sm"></i>
                    <span>Station FAQ & Guidelines</span>
                </button>
                <a href="/map" class="px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider bg-white/10 hover:bg-white/20 text-white border border-white/20 transition flex items-center gap-2 backdrop-blur-md">
                    <i class="fas fa-map-marked-alt text-xs text-pnp-gold"></i>
                    <span>Explore Crime Map</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Bulletins Section -->
    <section id="bulletins-section" class="py-8 sm:py-12 relative min-h-[40vh]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <% if (locals.policeNewsList && policeNewsList.length > 0) { %>
                <% const carouselNews = policeNewsList.slice(0, 5); %>
                <!-- Carousel Container -->
                <div class="mb-10">
                    <div class="mb-4 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3">
                        <div>
                            <div class="inline-flex items-center space-x-1.5 bg-pnp-blue/5 dark:bg-pnp-gold/10 text-pnp-blue dark:text-pnp-gold px-3 py-1 rounded-full mb-1.5 border border-pnp-blue/10 dark:border-pnp-gold/25">
                                <i class="fas fa-newspaper text-[9px]"></i>
                                <span class="text-[9px] font-black uppercase tracking-widest">Station News & Releases</span>
                            </div>
                            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight leading-none">Police News & Releases</h2>
                        </div>
                        <a href="/news" class="text-xs font-black text-pnp-blue dark:text-pnp-gold hover:underline flex items-center space-x-1.5 uppercase tracking-wider">
                            <span>View All News</span>
                            <i class="fas fa-arrow-right text-[9px]"></i>
                        </a>
                    </div>

                    <!-- Carousel Wrapper (Outer Relative Wrapper) -->
                    <div class="relative w-full">
                        <!-- Floating Navigation Controls -->
                        <button id="carousel-prev" class="absolute left-1.5 sm:left-2 lg:-left-5 top-1/2 -translate-y-1/2 z-40 w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/95 dark:bg-slate-900/95 text-slate-700 dark:text-slate-300 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 flex items-center justify-center transition-all shadow-md border border-slate-200/90 dark:border-slate-800 focus:outline-none transform hover:scale-105 active:scale-95 cursor-pointer" aria-label="Previous Slide">
                            <i class="fas fa-chevron-left text-xs"></i>
                        </button>
                        <button id="carousel-next" class="absolute right-1.5 sm:right-2 lg:-right-5 top-1/2 -translate-y-1/2 z-40 w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/95 dark:bg-slate-900/95 text-slate-700 dark:text-slate-300 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 flex items-center justify-center transition-all shadow-md border border-slate-200/90 dark:border-slate-800 focus:outline-none transform hover:scale-105 active:scale-95 cursor-pointer" aria-label="Next Slide">
                            <i class="fas fa-chevron-right text-xs"></i>
                        </button>

                        <!-- Carousel Inner (Overflow Mask) -->
                        <div class="overflow-hidden w-full rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xs bg-white dark:bg-slate-900">
                        <!-- Inner Track -->
                        <div id="carousel-track" class="flex transition-transform duration-700 ease-in-out">
                            <% carouselNews.forEach((news, index) => { %>
                                <div class="w-full shrink-0 flex-none px-4 md:px-8 py-6 md:py-8">
                                    <div class="flex flex-col lg:flex-row items-stretch gap-6 group">
                                        <!-- Media Container (Based on public/bulletins, NO mock-up images) -->
                                        <div class="w-full lg:w-1/2 h-64 md:h-72 lg:h-80 rounded-xl overflow-hidden relative shadow-2xs shrink-0 bg-slate-950 border border-slate-200/90 dark:border-slate-800 flex items-center justify-center">
                                            <% if ((news.photo_paths && news.photo_paths.length > 0) || news.photo_path || (news.video_paths && news.video_paths.length > 0)) { %>
                                                <% 
                                                    const newsCoverImg = (news.photo_paths && news.photo_paths.length > 0) 
                                                        ? news.photo_paths[0] 
                                                        : (news.photo_path || '/images/PNP.jpg');
                                                %>
                                                <div class="w-full h-full relative flex items-center justify-center bg-slate-950 overflow-hidden">
                                                    <img src="<%= newsCoverImg %>" alt="<%= news.headline %>"
                                                        class="w-full h-full object-contain group-hover:scale-105 transition duration-700 select-none" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                                                    <% if (news.video_paths && news.video_paths.length > 0) { %>
                                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-black/30 pointer-events-none"></div>
                                                        <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-md text-[9px] font-black uppercase tracking-wider text-white border border-white/10 shadow flex items-center space-x-1.5 z-10">
                                                            <i class="fas fa-video text-pnp-gold"></i>
                                                            <span>Video Report</span>
                                                        </div>
                                                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                                            <div class="w-14 h-14 rounded-full bg-slate-950/75 backdrop-blur-md border border-white/20 text-pnp-gold flex items-center justify-center shadow-xl group-hover:scale-110 group-hover:bg-pnp-blue group-hover:text-white transition-all duration-300">
                                                                <i class="fas fa-play text-xl ml-1"></i>
                                                            </div>
                                                        </div>
                                                    <% } %>
                                                    <% if (news.photo_paths && news.photo_paths.length > 1) { %>
                                                        <div class="absolute bottom-3 right-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-full text-white text-[9px] font-black tracking-widest flex items-center space-x-1.5 border border-white/10 shadow-lg z-10">
                                                            <i class="fas fa-images text-emerald-400"></i>
                                                            <span>+<%= news.photo_paths.length - 1 %></span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } else if (news.facebook_url) { %>
                                                <div class="w-full h-full bg-slate-950 flex items-center justify-center overflow-hidden">
                                                    <iframe src="https://www.facebook.com/plugins/<%= /video|watch|reel/i.test(news.facebook_url) ? 'video.php' : 'post.php' %>?href=<%= encodeURIComponent(news.facebook_url) %>&show_text=true&width=500" 
                                                        width="100%" height="100%" style="border:none;overflow:hidden;min-height:260px;" scrolling="no" frameborder="0" allowfullscreen="true" 
                                                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share; unload" class="w-full h-full"></iframe>
                                                </div>
                                            <% } else { %>
                                                <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-slate-900 to-slate-850">
                                                    <div class="w-14 h-14 rounded-xl bg-pnp-blue/30 dark:bg-pnp-gold/15 text-pnp-gold flex items-center justify-center text-2xl mb-2.5 border border-pnp-gold/20">
                                                        <i class="fas fa-shield-halved"></i>
                                                    </div>
                                                    <span class="text-xs font-black uppercase tracking-wider text-slate-200">PNP News & Press</span>
                                                    <span class="text-[9px] text-slate-400 font-bold uppercase tracking-widest mt-0.5">Sta. Cruz Municipal Police Station</span>
                                                </div>
                                            <% } %>
                                            <div class="absolute bottom-3 left-3 text-white font-black text-[9px] uppercase tracking-widest bg-pnp-blue/90 dark:bg-slate-950/90 backdrop-blur-md px-3 py-1 rounded-lg border border-white/10 pointer-events-none">
                                                <i class="fas fa-clock mr-1 text-pnp-gold"></i>
                                                <%= new Date(news.publishedAt).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %>
                                            </div>
                                        </div>
                                        
                                        <!-- Content Info -->
                                        <div class="w-full lg:w-1/2 flex flex-col justify-center text-left py-2">
                                            <div class="flex items-center gap-2 mb-3 flex-wrap">
                                                <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700">
                                                    <%= news.category || 'Official News' %>
                                                </span>
                                            </div>
                                            
                                            <h3 class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition-colors tracking-tight line-clamp-2">
                                                <%= news.headline %>
                                            </h3>
                                            
                                            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-5 line-clamp-3">
                                                <%= news.description || news.fullContent || 'Click See More to view full news article.' %>
                                            </p>
                                            
                                            <div class="mt-auto">
                                                <a href="/news" class="inline-flex items-center bg-pnp-blue hover:bg-pnp-blue/90 text-white dark:bg-pnp-gold dark:text-slate-950 font-black text-xs uppercase tracking-wider px-4 py-2.5 rounded-xl transition duration-200 shadow-2xs border border-pnp-gold/40">
                                                    <span>See More</span>
                                                    <i class="fas fa-arrow-right ml-1.5 text-[9px]"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Slide Dots/Indicators -->
                        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center space-x-1.5 z-30">
                            <% carouselNews.forEach((_, index) => { %>
                                <button class="carousel-dot w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-700 hover:bg-pnp-gold transition-all duration-300 focus:outline-none" data-slide="<%= index %>"></button>
                            <% }) %>
                        </div>
                    </div> <!-- Closes Carousel Inner -->
                </div> <!-- Closes Carousel Wrapper (Outer) -->
            </div> <!-- Closes Carousel Container -->
            <% } %>

            <!-- Public Advisories Content -->
            <div class="mt-12">
                <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-3">
                    <div>
                        <div class="inline-flex items-center space-x-1.5 bg-pnp-blue/5 dark:bg-pnp-gold/10 text-pnp-blue dark:text-pnp-gold px-3 py-1 rounded-full mb-1.5 border border-pnp-blue/10 dark:border-pnp-gold/25">
                            <i class="fas fa-bullhorn text-[9px]"></i>
                            <span class="text-[9px] font-black uppercase tracking-widest">Public Safety Advisories</span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight leading-none">Recent Public Advisories</h2>
                    </div>
                    <a href="/bulletins" class="text-xs font-black text-pnp-blue dark:text-pnp-gold hover:underline flex items-center space-x-1.5 uppercase tracking-wider">
                        <span>View All Advisories</span>
                        <i class="fas fa-arrow-right text-[9px]"></i>
                    </a>
                </div>

                <% if (locals.bulletins && bulletins.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                        <% bulletins.slice(0, 3).forEach(bulletin => { %>
                            <div class="bulletin-card group bg-white dark:bg-slate-900 rounded-2xl shadow-xs hover:shadow-md border border-slate-200/90 dark:border-slate-800 overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-0.5 cursor-pointer" data-category="<%= bulletin.category %>" onclick="openBulletinModal('<%= bulletin.id %>')">
                                <% if ((bulletin.photo_paths && bulletin.photo_paths.length > 0) || bulletin.photo_path || (bulletin.video_paths && bulletin.video_paths.length > 0)) { %>
                                    <% 
                                        const bulletinCoverImg = (bulletin.photo_paths && bulletin.photo_paths.length > 0) 
                                            ? bulletin.photo_paths[0] 
                                            : (bulletin.photo_path || '/images/PNP.jpg');
                                    %>
                                    <div class="h-48 overflow-hidden relative bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                                        <img src="<%= bulletinCoverImg %>" alt="<%= bulletin.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-700 select-none" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                                        <% if (bulletin.video_paths && bulletin.video_paths.length > 0) { %>
                                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-black/30 pointer-events-none"></div>
                                            <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-md text-[9px] font-black uppercase tracking-wider text-white border border-white/10 shadow flex items-center space-x-1.5 z-10">
                                                <i class="fas fa-video text-pnp-gold"></i>
                                                <span>Video Advisory</span>
                                            </div>
                                            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                                <div class="w-12 h-12 rounded-full bg-slate-950/75 backdrop-blur-md border border-white/20 text-pnp-gold flex items-center justify-center shadow-xl group-hover:scale-110 group-hover:bg-pnp-blue group-hover:text-white transition-all duration-300">
                                                    <i class="fas fa-play text-base ml-0.5"></i>
                                                </div>
                                            </div>
                                        <% } %>
                                        <% if (bulletin.photo_paths && bulletin.photo_paths.length > 1) { %>
                                            <div class="absolute bottom-3 right-3 bg-slate-900/80 backdrop-blur-md px-2.5 py-1 rounded-full text-white text-[9px] font-black tracking-widest flex items-center space-x-1.5 border border-white/10 shadow-lg z-10">
                                                <i class="fas fa-images text-emerald-400"></i>
                                                <span>+<%= bulletin.photo_paths.length - 1 %></span>
                                            </div>
                                        <% } %>
                                    </div>
                                <% } else if (bulletin.facebook_url) { %>
                                    <div class="h-48 bg-blue-950/20 dark:bg-slate-900 border-b border-blue-500/10 flex flex-col items-center justify-center p-4 text-center">
                                        <div class="w-12 h-12 rounded-xl bg-[#1877F2]/10 border border-[#1877F2]/20 flex items-center justify-center text-[#1877F2] text-2xl mb-2 group-hover:scale-110 transition duration-300">
                                            <i class="fab fa-facebook"></i>
                                        </div>
                                        <span class="text-[10px] font-black uppercase text-[#1877F2] tracking-wider">Official Facebook Notice</span>
                                    </div>
                                <% } else { %>
                                    <div class="h-48 bg-slate-100 dark:bg-slate-800 flex items-center justify-center border-b border-slate-200 dark:border-slate-800">
                                        <i class="fas fa-bullhorn text-4xl text-slate-300 dark:text-slate-600 group-hover:text-pnp-blue transition-colors"></i>
                                    </div>
                                <% } %>

                                <div class="p-5 sm:p-6 flex-grow flex flex-col">
                                    <div class="flex justify-between items-start mb-3">
                                        <% const badgeColors = { 'Wanted Person': 'bg-rose-50 text-rose-700 border-rose-200 dark:bg-rose-950/40 dark:text-rose-300 dark:border-rose-800/60', 'Missing Person': 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60', 'Crime Advisory': 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/40 dark:text-orange-300 dark:border-orange-800/60', 'Traffic Advisory': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60', 'Cybercrime Advisory': 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-800/60', 'Community Awareness': 'bg-teal-50 text-teal-700 border-teal-200 dark:bg-teal-950/40 dark:text-teal-300 dark:border-teal-800/60', 'Recovered Property': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60', 'General Announcement': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60' }; %>
                                        <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border shadow-2xs <%= badgeColors[bulletin.category] || 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700' %>">
                                            <%= bulletin.category %>
                                        </span>
                                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">
                                            <%= new Date(bulletin.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %>
                                        </span>
                                    </div>

                                    <h3 class="text-base font-black text-slate-900 dark:text-white leading-snug mb-2 group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition duration-200 line-clamp-2">
                                        <%= bulletin.title %>
                                    </h3>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-4 line-clamp-3">
                                        <%= bulletin.body %>
                                    </p>

                                    <div class="mt-auto pt-3.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                        <button type="button" onclick="event.stopPropagation(); openBulletinModal('<%= bulletin.id %>')" class="text-[10px] font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider group-hover:underline flex items-center focus:outline-none">
                                            <span>See More</span>
                                            <i class="fas fa-arrow-right ml-1 text-[8px]"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="mt-10 text-center">
                        <a href="/bulletins" class="inline-flex items-center space-x-2 bg-pnp-blue hover:bg-pnp-blue/90 text-white dark:bg-pnp-gold dark:text-slate-950 font-black px-6 py-3 rounded-xl transition duration-200 shadow-xs uppercase tracking-wider text-xs border border-pnp-gold/40">
                            <span>View All Advisories</span>
                            <i class="fas fa-arrow-right text-[9px]"></i>
                        </a>
                    </div>
                <% } else { %>
                    <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xs">
                        <div class="w-14 h-14 bg-slate-100 dark:bg-slate-800 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3 text-lg">
                            <i class="fas fa-folder-open"></i>
                        </div>
                        <h3 class="text-xs font-black text-slate-700 dark:text-slate-300 uppercase tracking-widest">No Advisories Found</h3>
                        <p class="text-xs text-slate-400 mt-1">There are currently no active public safety advisories.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Directory Section -->
    <section id="directory-section" class="py-12 bg-white dark:bg-slate-900 relative border-t border-slate-200/90 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="flex flex-col lg:flex-row gap-10 items-center">
                <!-- Left Side: Station Headquarters -->
                <div class="w-full lg:w-[45%] rounded-2xl overflow-hidden shadow-xs border border-slate-200/90 dark:border-slate-800 group relative bg-slate-950 flex items-center justify-center shrink-0 min-h-[320px] md:min-h-[420px]">
                    <img src="/images/stacruz_police_station.jpg" alt="Sta. Cruz Municipal Police Station Headquarters" class="w-full h-full object-cover rounded-xl group-hover:scale-[1.02] transition-transform duration-500 min-h-[320px] md:min-h-[420px]">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/30 to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4 bg-slate-950/85 backdrop-blur-md px-4 py-3 rounded-xl border border-white/10 text-left">
                        <div class="inline-flex items-center space-x-1.5 bg-pnp-gold/20 text-pnp-gold px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-widest mb-1 border border-pnp-gold/30">
                            <i class="fas fa-shield-halved text-[8px]"></i>
                            <span>Station Headquarters</span>
                        </div>
                        <p class="text-xs sm:text-sm font-black text-white uppercase tracking-tight">Sta. Cruz Municipal Police Station</p>
                        <p class="text-[10px] text-slate-300 font-medium">Poblacion, Santa Cruz, Laguna &bull; Laguna PPO</p>
                    </div>
                </div>

                <!-- Right Side: Text Directory -->
                <div class="w-full lg:w-[55%] space-y-5 pl-0 lg:pl-2">
                    <div class="border-l-4 border-pnp-gold pl-5 py-2.5 inline-block w-full bg-slate-50 dark:bg-slate-800/50 rounded-r-xl border border-slate-200/60 dark:border-slate-800">
                        <h2 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white uppercase tracking-tight leading-none mb-1">Sta. Cruz</h2>
                        <h2 class="text-xl md:text-2xl font-black text-slate-700 dark:text-slate-300 uppercase tracking-tight leading-none mb-1">Municipal Police Station</h2>
                        <h2 class="text-base md:text-lg font-black text-pnp-gold uppercase tracking-[0.2em] leading-none">Official Directory</h2>
                    </div>

                    <div class="space-y-4">
                        <% if (typeof personnel !== 'undefined' && personnel && personnel.length > 0) { %>
                            <% personnel.forEach(p => { %>
                                <div class="border-l-2 border-slate-200 dark:border-slate-700 pl-3.5 hover:border-pnp-blue dark:hover:border-pnp-gold transition-colors group">
                                    <h4 class="text-base font-black text-slate-800 dark:text-white uppercase tracking-tight group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition-colors"><%= p.name %></h4>
                                    <p class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mt-0.5"><%= p.position %></p>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="py-10 px-5 text-center bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-dashed border-slate-200 dark:border-slate-700">
                                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700/50 flex items-center justify-center text-slate-400 mx-auto mb-2">
                                    <i class="fas fa-users-slash text-base"></i>
                                </div>
                                <h4 class="text-xs font-black text-slate-600 dark:text-slate-300 uppercase tracking-widest">No Directory Personnel Listed</h4>
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mt-1">Official station directory roster is currently being updated by station administration.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- INTERACTIVE BULLETIN DETAIL MODAL -->
    <div id="bulletin-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-md" onclick="closeBulletinModal()"></div>
        <div class="relative bg-white dark:bg-slate-900 w-[95%] max-w-6xl rounded-2xl overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800 transform scale-95 transition-all duration-300 flex flex-col lg:flex-row max-h-[90vh]">
            
            <!-- Left Side: Media Carousel -->
            <div class="w-full lg:w-[50%] relative bg-slate-950 flex items-center justify-center min-h-[250px] md:min-h-[400px] shrink-0 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800">
                <div id="bulletin-modal-media-container" class="w-full h-full relative overflow-hidden flex">
                    <!-- Media injected here -->
                </div>
                
                <button id="modal-prev-btn" onclick="bulletinModalPrev()" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-pnp-blue text-white flex items-center justify-center backdrop-blur-sm transition-all z-20 hidden shadow-md">
                    <i class="fas fa-chevron-left text-sm"></i>
                </button>
                <button id="modal-next-btn" onclick="bulletinModalNext()" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-pnp-blue text-white flex items-center justify-center backdrop-blur-sm transition-all z-20 hidden shadow-md">
                    <i class="fas fa-chevron-right text-sm"></i>
                </button>
                
                <div id="modal-dots-container" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-20 hidden"></div>
            </div>

            <!-- Right Side: Text Content -->
            <div class="w-full lg:w-[50%] p-6 md:p-10 overflow-y-auto bg-white dark:bg-slate-900 custom-modal-scrollbar relative max-h-[50vh] lg:max-h-none text-left">
                <button onclick="closeBulletinModal()" class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-950 border border-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:hover:text-white dark:border-slate-700 shadow-sm flex items-center justify-center focus:outline-none transition-all duration-300 z-10" title="Close Modal">
                    <i class="fas fa-times"></i>
                </button>

                <div class="mb-4 pr-12 flex items-center justify-between flex-wrap gap-2">
                    <span id="bulletin-modal-category" class="inline-block text-[10px] md:text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-xl border shadow-2xs transition-colors"></span>
                    <button id="tts-bulletin-modal-btn" onclick="" class="text-xs font-black text-slate-800 hover:text-pnp-blue dark:text-slate-200 dark:hover:text-pnp-gold uppercase tracking-widest flex items-center space-x-2 focus:outline-none transition px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 shadow-2xs">
                        <i class="fas fa-volume-high text-xs"></i>
                        <span>Read Advisory</span>
                    </button>
                </div>
                <div id="bulletin-modal-date" class="text-xs font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider mb-4 flex items-center gap-1.5"></div>
                <h3 id="bulletin-modal-title" class="text-2xl md:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white leading-tight mb-8 tracking-tight"></h3>
                
                <div id="bulletin-modal-content" class="text-slate-800 dark:text-slate-200 text-sm md:text-base leading-relaxed space-y-5 whitespace-pre-wrap mb-10 font-normal"></div>
            </div>
        </div>
    </div>

    <script>
        const bulletinsDatabase = <%- JSON.stringify([...(locals.bulletins || []), ...(locals.policeNewsList || [])]) %>;

        function openBulletinModal(bulletinId) {
            const bulletin = bulletinsDatabase.find(b => String(b.id) === String(bulletinId));
            if (!bulletin) return;

            const mediaContainer = document.getElementById('bulletin-modal-media-container');
            const prevBtn = document.getElementById('modal-prev-btn');
            const nextBtn = document.getElementById('modal-next-btn');
            const dotsContainer = document.getElementById('modal-dots-container');

            if (mediaContainer) {
                mediaContainer.innerHTML = '';
                dotsContainer.innerHTML = '';
                
                const mediaItems = [];
                
                if (bulletin.photo_paths && bulletin.photo_paths.length > 0) {
                    bulletin.photo_paths.forEach(url => {
                        if (url && !url.includes('unsplash.com')) mediaItems.push({ type: 'photo', url });
                    });
                } else if (bulletin.photo_path && !bulletin.photo_path.includes('unsplash.com')) {
                    mediaItems.push({ type: 'photo', url: bulletin.photo_path });
                }

                if (bulletin.video_paths && bulletin.video_paths.length > 0) {
                    bulletin.video_paths.forEach(url => {
                        if (url) mediaItems.push({ type: 'video', url });
                    });
                } else if (bulletin.video_path) {
                    mediaItems.push({ type: 'video', url: bulletin.video_path });
                }

                if (mediaItems.length > 0) {
                    const renderItemHtml = (item, idx) => {
                        if (item.type === 'video') {
                            return `<div class="absolute inset-0 w-full h-full transition-opacity duration-500 flex items-center justify-center bg-black ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}" data-slide="${idx}">
                                        <video src="${item.url}" poster="/images/PNP.jpg" preload="metadata" playsinline controls class="w-full h-full object-contain video-player-slide" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"></video>
                                        <div class="hidden flex flex-col items-center justify-center p-6 text-center">
                                            <img src="/images/PNP.jpg" class="w-36 h-36 object-contain rounded-xl mb-3 shadow" alt="Station Media">
                                            <span class="text-xs font-black text-amber-400 uppercase tracking-wider mb-2">Video playback unavailable in browser</span>
                                            <a href="${item.url}" target="_blank" download class="px-4 py-2 bg-pnp-blue hover:bg-blue-900 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition flex items-center space-x-2">
                                                <i class="fas fa-external-link-alt"></i>
                                                <span>Open / Download Video File</span>
                                            </a>
                                        </div>
                                    </div>`;
                        } else {
                            return `<div class="absolute inset-0 w-full h-full transition-opacity duration-500 flex items-center justify-center bg-black ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}" data-slide="${idx}">
                                        <img src="${item.url}" class="w-full h-full object-contain select-none" alt="Media ${idx + 1}" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                                    </div>`;
                        }
                    };
                    
                    mediaContainer.innerHTML = mediaItems.map((item, idx) => renderItemHtml(item, idx)).join('');
                    
                    window.currentBulletinModalSlide = 0;
                    window.totalBulletinModalSlides = mediaItems.length;

                    if (mediaItems.length > 1) {
                        prevBtn.classList.remove('hidden');
                        nextBtn.classList.remove('hidden');
                        dotsContainer.classList.remove('hidden');
                        
                        dotsContainer.innerHTML = mediaItems.map((_, idx) => `
                            <button onclick="bulletinModalGoTo(${idx})" class="w-2 h-2 rounded-full transition-all ${idx === 0 ? 'bg-white scale-125' : 'bg-white/40 hover:bg-white/80'}" data-dot="${idx}"></button>
                        `).join('');
                    } else {
                        prevBtn.classList.add('hidden');
                        nextBtn.classList.add('hidden');
                        dotsContainer.classList.add('hidden');
                    }
                } else if (bulletin.facebook_url) {
                    const isVideo = /video|watch|reel/i.test(bulletin.facebook_url);
                    const pluginType = isVideo ? 'video.php' : 'post.php';
                    mediaContainer.innerHTML = `
                        <div class="w-full h-full flex items-center justify-center bg-slate-950 p-2">
                            <iframe src="https://www.facebook.com/plugins/${pluginType}?href=${encodeURIComponent(bulletin.facebook_url)}&show_text=true&width=500" 
                                width="100%" height="100%" style="border:none;overflow:hidden;min-height:300px;" scrolling="no" frameborder="0" allowfullscreen="true" 
                                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share; unload" class="w-full h-full"></iframe>
                        </div>
                    `;
                    prevBtn.classList.add('hidden');
                    nextBtn.classList.add('hidden');
                    dotsContainer.classList.add('hidden');
                } else {
                    mediaContainer.innerHTML = `<div class="w-full h-full bg-slate-900 flex items-center justify-center text-slate-700">
                        <i class="fas fa-bullhorn text-6xl opacity-30"></i>
                    </div>`;
                    prevBtn.classList.add('hidden');
                    nextBtn.classList.add('hidden');
                    dotsContainer.classList.add('hidden');
                }
            }

            const catBadgeColors = {
                'Crime Advisory': 'bg-red-50 text-red-700 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-800/60',
                'Traffic Advisory': 'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60',
                'Cybercrime Advisory': 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-800/60',
                'Emergency Preparedness': 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/40 dark:text-orange-300 dark:border-orange-800/60',
                'VAWC Advisories': 'bg-pink-50 text-pink-700 border-pink-200 dark:bg-pink-950/40 dark:text-pink-300 dark:border-pink-800/60',
                'Community Awareness': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60',
                'Recovered Property': 'bg-green-50 text-green-700 border-green-200 dark:bg-green-950/40 dark:text-green-300 dark:border-green-800/60',
                'General Announcement': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60'
            };
            const catEl = document.getElementById('bulletin-modal-category');
            if (catEl) {
                const catName = bulletin.category || 'Official News';
                catEl.textContent = catName;
                catEl.className = `inline-block text-[10px] md:text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-xl border shadow-2xs ${catBadgeColors[catName] || 'bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700'}`;
            }
            document.getElementById('bulletin-modal-date').innerHTML = `<i class="fas fa-calendar-day mr-2"></i>${new Date(bulletin.created_at || bulletin.publishedAt).toLocaleDateString(undefined, {month: 'long', day: 'numeric', year: 'numeric'})}`;
            document.getElementById('bulletin-modal-title').textContent = bulletin.title || bulletin.headline;
            document.getElementById('bulletin-modal-content').textContent = bulletin.body || bulletin.fullContent || bulletin.description || '';

            const ttsBtn = document.getElementById('tts-bulletin-modal-btn');
            if (ttsBtn) {
                const speechTitle = bulletin.title || bulletin.headline || '';
                const speechBody = bulletin.body || bulletin.fullContent || bulletin.description || '';
                const speechText = `${speechTitle}. ${speechBody}`;
                ttsBtn.onclick = () => speakReport('tts-bulletin-modal-btn', speechText);
            }

            const modal = document.getElementById('bulletin-modal');
            const content = modal.querySelector('.relative');

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }, 50);
        }

        function closeBulletinModal() {
            if (typeof stopSpeech === 'function') stopSpeech();
            const modal = document.getElementById('bulletin-modal');
            if (!modal) return;
            const content = modal.querySelector('.relative');
            
            const videos = modal.querySelectorAll('video');
            videos.forEach(v => {
                try {
                    v.pause();
                } catch (e) {}
            });

            modal.classList.add('opacity-0');
            if (content) {
                content.classList.remove('scale-100');
                content.classList.add('scale-95');
            }
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        function bulletinModalUpdate() {
            const slides = document.querySelectorAll('#bulletin-modal-media-container [data-slide]');
            const dots = document.querySelectorAll('#modal-dots-container [data-dot]');
            
            slides.forEach((slide, idx) => {
                if (idx === window.currentBulletinModalSlide) {
                    slide.classList.replace('opacity-0', 'opacity-100');
                    slide.classList.replace('z-0', 'z-10');
                    slide.classList.remove('pointer-events-none');
                } else {
                    slide.classList.replace('opacity-100', 'opacity-0');
                    slide.classList.replace('z-10', 'z-0');
                    slide.classList.add('pointer-events-none');
                    
                    const vid = slide.querySelector('video');
                    if (vid) { try { vid.pause(); } catch(e){} }
                }
            });
            
            dots.forEach((dot, idx) => {
                if (idx === window.currentBulletinModalSlide) {
                    dot.classList.replace('bg-white/40', 'bg-white');
                    dot.classList.remove('hover:bg-white/80');
                    dot.classList.add('scale-125');
                } else {
                    dot.classList.replace('bg-white', 'bg-white/40');
                    dot.classList.add('hover:bg-white/80');
                    dot.classList.remove('scale-125');
                }
            });
        }

        function bulletinModalNext() {
            if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
            window.currentBulletinModalSlide = (window.currentBulletinModalSlide + 1) % window.totalBulletinModalSlides;
            bulletinModalUpdate();
        }

        function bulletinModalPrev() {
            if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
            window.currentBulletinModalSlide = (window.currentBulletinModalSlide - 1 + window.totalBulletinModalSlides) % window.totalBulletinModalSlides;
            bulletinModalUpdate();
        }

        function bulletinModalGoTo(idx) {
            if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
            window.currentBulletinModalSlide = idx;
            bulletinModalUpdate();
        }

        document.addEventListener('keydown', (e) => {
            const modal = document.getElementById('bulletin-modal');
            if (modal && !modal.classList.contains('hidden')) {
                if (e.key === 'ArrowLeft') {
                    bulletinModalPrev();
                } else if (e.key === 'ArrowRight') {
                    bulletinModalNext();
                } else if (e.key === 'Escape') {
                    closeBulletinModal();
                }
            }
        });



        document.addEventListener('DOMContentLoaded', () => {
            // Carousel Slider Logic
            const track = document.getElementById('carousel-track');
            const prevBtn = document.getElementById('carousel-prev');
            const nextBtn = document.getElementById('carousel-next');
            const dots = document.querySelectorAll('.carousel-dot');
            
            if (track) {
                const slides = track.children;
                const totalSlides = slides.length;
                let currentSlide = 0;
                let autoplayTimer = null;

                if (totalSlides > 0) {
                    function updateCarousel() {
                        track.style.transform = `translateX(-${currentSlide * 100}%)`;
                        dots.forEach((dot, index) => {
                            if (index === currentSlide) {
                                dot.classList.add('bg-pnp-gold', 'w-8');
                                dot.classList.remove('bg-slate-300', 'dark:bg-slate-700');
                            } else {
                                dot.classList.remove('bg-pnp-gold', 'w-8');
                                dot.classList.add('bg-slate-300', 'dark:bg-slate-700');
                            }
                        });
                    }

                    function nextSlide() {
                        currentSlide = (currentSlide + 1) % totalSlides;
                        updateCarousel();
                    }

                    function prevSlide() {
                        currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
                        updateCarousel();
                    }

                    function startAutoplay() {
                        stopAutoplay();
                        autoplayTimer = setInterval(nextSlide, 6000);
                    }

                    function stopAutoplay() {
                        if (autoplayTimer) {
                            clearInterval(autoplayTimer);
                            autoplayTimer = null;
                        }
                    }

                    if (prevBtn) {
                        prevBtn.addEventListener('click', () => {
                            prevSlide();
                            startAutoplay();
                        });
                    }

                    if (nextBtn) {
                        nextBtn.addEventListener('click', () => {
                            nextSlide();
                            startAutoplay();
                        });
                    }

                    dots.forEach((dot, index) => {
                        dot.addEventListener('click', () => {
                            currentSlide = index;
                            updateCarousel();
                            startAutoplay();
                        });
                    });

                    const wrapper = track.parentElement;
                    if (wrapper) {
                        wrapper.addEventListener('mouseenter', stopAutoplay);
                        wrapper.addEventListener('mouseleave', startAutoplay);
                    }

                    // Mobile Touch Swipe Gesture Support
                    let touchStartX = 0;
                    let touchStartY = 0;
                    let touchEndX = 0;
                    let touchEndY = 0;

                    track.addEventListener('touchstart', (e) => {
                        if (e.touches && e.touches.length > 0) {
                            touchStartX = e.touches[0].clientX;
                            touchStartY = e.touches[0].clientY;
                        }
                        stopAutoplay();
                    }, { passive: true });

                    track.addEventListener('touchend', (e) => {
                        if (e.changedTouches && e.changedTouches.length > 0) {
                            touchEndX = e.changedTouches[0].clientX;
                            touchEndY = e.changedTouches[0].clientY;
                            const diffX = touchEndX - touchStartX;
                            const diffY = touchEndY - touchStartY;
                            // Only trigger when horizontal swipe exceeds vertical scroll and distance > 40px
                            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                                if (diffX < 0) {
                                    nextSlide();
                                } else {
                                    prevSlide();
                                }
                            }
                        }
                        startAutoplay();
                    }, { passive: true });

                    // Initialize
                    updateCarousel();
                    startAutoplay();
                }
            }


        });
    </script>

    <!-- Additional Styles for Micro-animations -->
