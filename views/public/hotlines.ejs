<% let displayHotlines=[]; if (typeof hotlines !=='undefined' && hotlines) { displayHotlines=hotlines; } %>

<!-- Hero Header (Tactical Navy & Gold) -->
<div class="relative min-h-[30vh] py-14 md:py-20 flex items-center justify-center overflow-hidden bg-slate-950 bg-cover bg-center bg-no-repeat"
    style="background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95)), url('/images/directory-pnp-2.jpg');">
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-pnp-blue/20 via-slate-950/40 to-slate-950/80"></div>
    <div class="container mx-auto px-4 relative z-10 text-center flex flex-col items-center">
        <!-- Tactical Badge -->
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md text-pnp-gold px-4 py-1.5 rounded-full mb-3 border border-white/20">
            <i class="fas fa-phone-volume text-xs"></i>
            <span class="text-[10px] font-black uppercase tracking-widest">Emergency Communications Directory</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-2">
            Sta. Cruz <span class="text-pnp-gold">Emergency Hotlines</span>
        </h1>
        <p class="text-xs sm:text-sm text-blue-100/90 font-medium max-w-2xl mx-auto leading-relaxed">
            Immediate contacts for police assistance, fire suppression, emergency medical rescue, and municipal crisis units in Sta. Cruz, Laguna.
        </p>
    </div>
</div>

<div class="container mx-auto px-4 py-8 sm:py-12 max-w-7xl">
    <!-- Top 3 Quick Emergency Cards (Admin Card Aesthetic) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10 -mt-10 sm:-mt-14 relative z-20">
        <!-- Police 911 Card -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-lg hover:border-pnp-blue/40 dark:hover:border-pnp-gold/40 transition-all duration-300 p-6 flex flex-col justify-between text-center group">
            <div>
                <div class="w-14 h-14 mx-auto bg-blue-500/10 text-pnp-blue dark:text-blue-400 border border-blue-500/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <i class="fas fa-shield-halved text-2xl"></i>
                </div>
                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 block">Law Enforcement</span>
                <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight mt-1">Police Emergency</h3>
                <p class="text-3xl font-black text-red-600 dark:text-red-500 font-mono tracking-tight my-2">911</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Available 24/7 for immediate tactical dispatch</p>
            </div>
            <a href="tel:911" class="mt-5 w-full py-2.5 px-4 bg-pnp-blue hover:bg-blue-800 text-white rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 shadow-sm transition-all transform active:scale-95">
                <i class="fas fa-phone text-xs"></i>
                <span>Call 911 Now</span>
            </a>
        </div>

        <!-- BFP Fire Card -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-lg hover:border-orange-500/40 transition-all duration-300 p-6 flex flex-col justify-between text-center group">
            <div>
                <div class="w-14 h-14 mx-auto bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <i class="fas fa-fire-extinguisher text-2xl"></i>
                </div>
                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 block">Fire Rescue</span>
                <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight mt-1">Fire Department</h3>
                <p class="text-2xl font-black text-orange-600 dark:text-orange-500 font-mono tracking-tight my-2">+63967 052 8897</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">BFP Sta. Cruz Municipal Fire Station</p>
            </div>
            <a href="tel:+639670528897" class="mt-5 w-full py-2.5 px-4 bg-orange-600 hover:bg-orange-700 text-white rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 shadow-sm transition-all transform active:scale-95">
                <i class="fas fa-phone text-xs"></i>
                <span>Call BFP Fire</span>
            </a>
        </div>

        <!-- Medical / Red Cross Card -->
        <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-xs hover:shadow-lg hover:border-emerald-500/40 transition-all duration-300 p-6 flex flex-col justify-between text-center group">
            <div>
                <div class="w-14 h-14 mx-auto bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 rounded-2xl flex items-center justify-center mb-4 group-hover:scale-105 transition-transform">
                    <i class="fas fa-ambulance text-2xl"></i>
                </div>
                <span class="text-[9px] font-black uppercase tracking-[0.2em] text-slate-400 dark:text-slate-500 block">Medical & Rescue</span>
                <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-tight mt-1">Red Cross / Medical</h3>
                <p class="text-2xl font-black text-emerald-600 dark:text-emerald-500 font-mono tracking-tight my-2">+63 2 8790 2300</p>
                <p class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Emergency Medical and Disaster Response</p>
            </div>
            <a href="tel:+63287902300" class="mt-5 w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-[10px] font-black uppercase tracking-widest flex items-center justify-center gap-2 shadow-sm transition-all transform active:scale-95">
                <i class="fas fa-phone text-xs"></i>
                <span>Call Medical</span>
            </a>
        </div>
    </div>

    <!-- Full Directory Container (Admin Panel Aesthetic) -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-xs border border-slate-200/90 dark:border-slate-800 overflow-hidden">
        <!-- Panel Header with Search and Category Filters -->
        <div class="p-5 sm:p-6 border-b border-slate-200/80 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/60 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
            <div>
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <h2 class="text-sm sm:text-base font-black text-slate-900 dark:text-white uppercase tracking-[0.2em]">Official Station Directory</h2>
                </div>
                <p class="text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider mt-1">Sta. Cruz, Laguna &bull; Municipality of Santa Cruz</p>
            </div>

            <!-- Search and Category Filters -->
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto">
                <!-- Search input -->
                <div class="relative w-full sm:w-64">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                    <input type="text" id="hotlineSearchInput" oninput="filterHotlinesTable()" placeholder="Search agency or number..."
                        class="w-full pl-9 pr-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl outline-none text-xs font-bold text-slate-800 dark:text-white focus:ring-2 focus:ring-pnp-blue/20 transition-all placeholder:text-slate-400 shadow-2xs">
                </div>

                <!-- Category Dropdown Filter -->
                <div class="relative w-full sm:w-48">
                    <select id="hotlineCategoryFilter" onchange="filterHotlinesTable()"
                        class="w-full pl-4 pr-9 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl outline-none text-xs font-bold text-slate-800 dark:text-white focus:ring-2 focus:ring-pnp-blue/20 transition-all cursor-pointer appearance-none shadow-2xs">
                        <option value="All">All Categories</option>
                        <option value="Police">Police</option>
                        <option value="Fire">Fire</option>
                        <option value="Medical">Medical</option>
                        <option value="Disaster">Disaster</option>
                        <option value="Utility">Utility</option>
                    </select>
                    <i class="fas fa-chevron-down absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xs"></i>
                </div>
            </div>
        </div>

        <!-- Directory Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm" id="hotlinesTable">
                <thead class="bg-slate-50 dark:bg-slate-950 text-slate-400 dark:text-slate-500 uppercase text-[9.5px] font-black tracking-widest border-b border-slate-200/80 dark:border-slate-800">
                    <tr>
                        <th class="px-5 py-3.5 sm:px-6 sm:py-4">Agency / Office</th>
                        <th class="px-5 py-3.5 sm:px-6 sm:py-4">Contact Number</th>
                        <th class="px-5 py-3.5 sm:px-6 sm:py-4 hidden sm:table-cell">Category</th>
                        <th class="px-5 py-3.5 sm:px-6 sm:py-4 text-right">Connect</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300" id="hotlinesTableBody">
                    <% displayHotlines.forEach(h => { 
                        const agencyName = h.agency_name || h.name;
                        const rawNum = (h.contact_number || h.number) ? String(h.contact_number || h.number) : '';
                        const cleanTel = rawNum.replace(/[^0-9+]/g, '');
                        const formattedNum = rawNum.length === 11 ? rawNum.replace(/(\d{4})(\d{3})(\d{4})/, '$1 $2 $3') : rawNum;
                        
                        const catColors = {
                            'Police': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border-blue-200 dark:border-blue-800',
                            'Fire': 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400 border-orange-200 dark:border-orange-800',
                            'Medical': 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800',
                            'Disaster': 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 border-red-200 dark:border-red-800',
                            'Utility': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-800'
                        };
                    %>
                        <tr class="hotline-row hover:bg-slate-50 dark:hover:bg-slate-800/60 transition group"
                            data-agency="<%= (agencyName || '').toLowerCase() %>"
                            data-number="<%= rawNum.toLowerCase() %>"
                            data-category="<%= (h.category || '').toLowerCase() %>">
                            <td class="px-5 py-4 sm:px-6 sm:py-4.5">
                                <p class="text-sm font-black text-slate-900 dark:text-white group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition-colors">
                                    <%= agencyName %>
                                </p>
                                <p class="text-[9px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider mt-0.5">
                                    Santa Cruz, Laguna
                                </p>
                            </td>
                            <td class="px-5 py-4 sm:px-6 sm:py-4.5">
                                <span class="font-mono font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-200">
                                    <%= formattedNum || 'N/A' %>
                                </span>
                            </td>
                            <td class="px-5 py-4 sm:px-6 sm:py-4.5 hidden sm:table-cell">
                                <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border shadow-2xs <%= catColors[h.category] || 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-700' %>">
                                    <%= h.category || 'General' %>
                                </span>
                            </td>
                            <td class="px-5 py-4 sm:px-6 sm:py-4.5 text-right">
                                <a href="tel:<%= cleanTel %>"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-pnp-blue hover:bg-blue-800 text-white rounded-lg text-[10px] font-black uppercase tracking-wider shadow-xs transition active:scale-95"
                                    title="Call <%= agencyName %>">
                                    <i class="fas fa-phone-alt text-[9px]"></i>
                                    <span class="hidden sm:inline">Call</span>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- Empty Filter State -->
            <div id="hotlinesEmptyState" class="hidden py-16 text-center">
                <div class="w-12 h-12 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto mb-3">
                    <i class="fas fa-phone-slash text-base"></i>
                </div>
                <h4 class="text-xs font-black uppercase tracking-widest text-slate-600 dark:text-slate-400">No Hotlines Found</h4>
                <p class="text-[10px] text-slate-400 mt-1">Try searching with a different keyword or category filter.</p>
            </div>
        </div>
    </div>
</div>

<script>
    function filterHotlinesTable() {
        const query = (document.getElementById('hotlineSearchInput').value || '').toLowerCase().trim();
        const selectedCat = (document.getElementById('hotlineCategoryFilter').value || 'All').toLowerCase();
        const rows = document.querySelectorAll('.hotline-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const agency = row.getAttribute('data-agency') || '';
            const number = row.getAttribute('data-number') || '';
            const cat = row.getAttribute('data-category') || '';

            const matchesQuery = !query || agency.includes(query) || number.includes(query);
            const matchesCat = selectedCat === 'all' || cat === selectedCat;

            if (matchesQuery && matchesCat) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const emptyState = document.getElementById('hotlinesEmptyState');
        if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
        }
    }
</script>