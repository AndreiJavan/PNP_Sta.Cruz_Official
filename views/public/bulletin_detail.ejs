<div class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
    <div class="mb-6">
        <a href="/" class="inline-flex items-center space-x-2 text-xs font-black uppercase tracking-wider text-slate-700 dark:text-slate-300 hover:text-pnp-blue dark:hover:text-pnp-gold bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 px-3.5 py-2 rounded-xl shadow-2xs transition group">
            <i class="fas fa-arrow-left text-xs group-hover:-translate-x-1 transition text-pnp-gold"></i>
            <span>Back to Home</span>
        </a>
    </div>

    <article class="bg-white dark:bg-slate-900 rounded-2xl shadow-xs overflow-hidden border border-slate-200/90 dark:border-slate-800">
        <% 
            let mediaItems = [];
            if (bulletin.video_paths && bulletin.video_paths.length > 0) {
                bulletin.video_paths.forEach(function(path) {
                    mediaItems.push({ type: 'video', path: path });
                });
            }
            if (bulletin.photo_paths && bulletin.photo_paths.length > 0) {
                bulletin.photo_paths.forEach(function(path) {
                    mediaItems.push({ type: 'image', path: path });
                });
            } else if (bulletin.photo_path) {
                mediaItems.push({ type: 'image', path: bulletin.photo_path });
            }
        %>
        
        <% if (mediaItems.length > 0) { %>
            <div class="relative w-full h-64 md:h-96 overflow-hidden group bg-slate-950 border-b border-slate-200/90 dark:border-slate-800" id="bulletinCarousel">
                <% mediaItems.forEach(function(item, index) { %>
                    <% if (item.type === 'image') { %>
                        <img src="<%= item.path %>" alt="<%= bulletin.title %> - Image <%= index + 1 %>" class="absolute inset-0 w-full h-full object-contain transition-opacity duration-500 ease-in-out <%= index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0' %>" data-index="<%= index %>" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                    <% } else if (item.type === 'video') { %>
                        <div class="absolute inset-0 w-full h-full flex items-center justify-center transition-opacity duration-500 ease-in-out bg-black <%= index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none' %>" data-index="<%= index %>">
                            <video src="<%= item.path %>" controls class="w-full h-full object-contain" onclick="event.stopPropagation();"></video>
                        </div>
                    <% } %>
                <% }); %>
                
                <% if (mediaItems.length > 1) { %>
                    <!-- Carousel Controls -->
                    <button onclick="moveCarousel(-1)" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 bg-black/60 hover:bg-pnp-blue text-white w-9 h-9 sm:w-10 sm:h-10 rounded-full flex items-center justify-center backdrop-blur-sm transition opacity-90 sm:opacity-0 sm:group-hover:opacity-100 active:scale-90 focus:outline-none cursor-pointer" aria-label="Previous image">
                        <i class="fas fa-chevron-left text-xs sm:text-base"></i>
                    </button>
                    <button onclick="moveCarousel(1)" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 bg-black/60 hover:bg-pnp-blue text-white w-9 h-9 sm:w-10 sm:h-10 rounded-full flex items-center justify-center backdrop-blur-sm transition opacity-90 sm:opacity-0 sm:group-hover:opacity-100 active:scale-90 focus:outline-none cursor-pointer" aria-label="Next image">
                        <i class="fas fa-chevron-right text-xs sm:text-base"></i>
                    </button>
                    <!-- Indicators -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex space-x-2 bg-black/50 backdrop-blur-md px-3 py-1.5 rounded-full border border-white/10">
                        <% mediaItems.forEach(function(_, index) { %>
                            <button onclick="goToSlide(<%= index %>)" class="w-2 h-2 rounded-full transition-colors focus:outline-none <%= index === 0 ? 'bg-white' : 'bg-white/40 hover:bg-white/80' %>" data-indicator="<%= index %>"></button>
                        <% }); %>
                    </div>
                <% } %>
            </div>
            
            <% if (mediaItems.length > 1) { %>
            <script>
                let currentSlide = 0;
                const totalSlides = <%= mediaItems.length %>;
                
                function updateCarousel() {
                    const slides = document.querySelectorAll('#bulletinCarousel [data-index]');
                    const indicators = document.querySelectorAll('#bulletinCarousel [data-indicator]');
                    
                    slides.forEach((slide, idx) => {
                        if (idx === currentSlide) {
                            slide.classList.replace('opacity-0', 'opacity-100');
                            slide.classList.replace('z-0', 'z-10');
                            slide.classList.remove('pointer-events-none');
                        } else {
                            slide.classList.replace('opacity-100', 'opacity-0');
                            slide.classList.replace('z-10', 'z-0');
                            slide.classList.add('pointer-events-none');
                            const video = slide.querySelector('video');
                            if (video) {
                                video.pause();
                            }
                        }
                    });
                    
                    indicators.forEach((ind, idx) => {
                        if (idx === currentSlide) {
                            ind.classList.add('bg-white');
                            ind.classList.remove('bg-white/40', 'hover:bg-white/80');
                        } else {
                            ind.classList.remove('bg-white');
                            ind.classList.add('bg-white/40', 'hover:bg-white/80');
                        }
                    });
                }
                
                function moveCarousel(direction) {
                    currentSlide = (currentSlide + direction + totalSlides) % totalSlides;
                    updateCarousel();
                }
                
                function goToSlide(index) {
                    currentSlide = index;
                    updateCarousel();
                }

                // Touch Swipe Support
                (function initCarouselSwipe() {
                    const carousel = document.getElementById('bulletinCarousel');
                    if (!carousel) return;
                    let startX = 0, startY = 0;
                    carousel.addEventListener('touchstart', (e) => {
                        if (e.touches && e.touches.length > 0) {
                            startX = e.touches[0].clientX;
                            startY = e.touches[0].clientY;
                        }
                    }, { passive: true });
                    carousel.addEventListener('touchend', (e) => {
                        if (e.changedTouches && e.changedTouches.length > 0) {
                            const diffX = e.changedTouches[0].clientX - startX;
                            const diffY = e.changedTouches[0].clientY - startY;
                            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                                if (diffX < 0) {
                                    moveCarousel(1);
                                } else {
                                    moveCarousel(-1);
                                }
                            }
                        }
                    }, { passive: true });
                })();
            </script>
            <% } %>
        <% } %>
        
        <div class="p-6 sm:p-10">
            <div class="flex flex-wrap items-center gap-3 mb-6">
                <% 
                    const badgeColors = {
                        'Wanted Person': 'bg-red-50 text-red-700 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-800/60',
                        'Missing Person': 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/40 dark:text-orange-300 dark:border-orange-800/60',
                        'Crime Advisory': 'bg-yellow-50 text-yellow-800 border-yellow-200 dark:bg-yellow-950/40 dark:text-yellow-300 dark:border-yellow-800/60',
                        'Traffic Advisory': 'bg-blue-50 text-blue-800 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60',
                        'Cybercrime Advisory': 'bg-purple-50 text-purple-800 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-800/60',
                        'Community Awareness': 'bg-teal-50 text-teal-800 border-teal-200 dark:bg-teal-950/40 dark:text-teal-300 dark:border-teal-800/60',
                        'Recovered Property': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60',
                        'General Announcement': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60'
                    };
                %>
                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border shadow-2xs <%= badgeColors[bulletin.category] || 'bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700' %>">
                    <%= bulletin.category %>
                </span>
                <span class="text-[10px] text-slate-400 dark:text-slate-500 font-black uppercase tracking-widest flex items-center">
                    <i class="far fa-calendar-alt mr-1.5 text-pnp-gold"></i>
                    <%= new Date(bulletin.created_at).toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' }) %>
                </span>

                <button type="button" id="translateArticleBtn" onclick="toggleArticleTranslation()" class="ml-auto px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue hover:bg-pnp-blue/90 text-white dark:bg-pnp-gold dark:text-slate-950 border border-pnp-gold/40 shadow-2xs transition flex items-center space-x-1.5 cursor-pointer">
                    <i class="fas fa-language text-xs"></i>
                    <span id="translateBtnLabel">Translate Tagalog</span>
                </button>
            </div>
            
            <h1 id="articleTitle" class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 dark:text-white mb-6 leading-tight uppercase tracking-tight">
                <%= bulletin.title %>
            </h1>
            
            <div id="articleBody" class="text-slate-700 dark:text-slate-200 text-sm md:text-base leading-relaxed space-y-4 font-normal">
                <% bulletin.body.split('\n').forEach(para => { %>
                    <p><%= para %></p>
                <% }) %>
            </div>

            <script>
                let originalTitle = <%- JSON.stringify(bulletin.title) %>;
                let originalBody = <%- JSON.stringify(bulletin.body) %>;
                let translatedTitle = '';
                let translatedBody = '';
                let isTranslated = false;

                async function toggleArticleTranslation() {
                    const btn = document.getElementById('translateArticleBtn');
                    const label = document.getElementById('translateBtnLabel');
                    const titleEl = document.getElementById('articleTitle');
                    const bodyEl = document.getElementById('articleBody');

                    if (isTranslated) {
                        // Revert to original
                        titleEl.innerText = originalTitle;
                        renderParagraphs(originalBody);
                        label.innerText = 'Translate Tagalog';
                        isTranslated = false;
                        return;
                    }

                    if (translatedTitle && translatedBody) {
                        // Use already fetched translation
                        titleEl.innerText = translatedTitle;
                        renderParagraphs(translatedBody);
                        label.innerText = 'Show Original';
                        isTranslated = true;
                        return;
                    }

                    btn.disabled = true;
                    label.innerText = 'Translating...';

                    try {
                        const fullText = `[TITLE]: ${originalTitle}\n\n[BODY]:\n${originalBody}`;
                        const res = await fetch('/api/translate-tagalog', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ text: fullText })
                        });
                        const data = await res.json();

                        if (data.success && data.tagalogText) {
                            const resText = data.tagalogText;
                            const titleMatch = resText.match(/\[TITLE\]:\s*(.*)/i);
                            const bodyMatch = resText.match(/\[BODY\]:\s*([\s\S]*)/i);

                            if (titleMatch && titleMatch[1]) {
                                translatedTitle = titleMatch[1].trim();
                            } else {
                                translatedTitle = resText.split('\n')[0];
                            }

                            if (bodyMatch && bodyMatch[1]) {
                                translatedBody = bodyMatch[1].trim();
                            } else {
                                translatedBody = resText;
                            }

                            titleEl.innerText = translatedTitle;
                            renderParagraphs(translatedBody);
                            label.innerText = 'Show Original';
                            isTranslated = true;
                        } else {
                            alert('Translation temporarily unavailable. Please try again shortly.');
                            label.innerText = 'Translate Tagalog';
                        }
                    } catch (err) {
                        console.error('Translation error:', err);
                        alert('Error requesting AI translation.');
                        label.innerText = 'Translate Tagalog';
                    } finally {
                        btn.disabled = false;
                    }
                }

                function renderParagraphs(text) {
                    const bodyEl = document.getElementById('articleBody');
                    bodyEl.innerHTML = '';
                    text.split('\n').forEach(para => {
                        if (para.trim()) {
                            const p = document.createElement('p');
                            p.innerText = para;
                            bodyEl.appendChild(p);
                        }
                    });
                }
            </script>
            
            <div class="mt-10 pt-8 border-t border-slate-200/80 dark:border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-pnp-blue text-white rounded-xl flex items-center justify-center shadow-2xs">
                        <i class="fas fa-shield-alt text-sm"></i>
                    </div>
                    <div>
                        <p class="text-[9px] text-slate-400 dark:text-slate-500 font-black uppercase tracking-widest">Official Source</p>
                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200">Sta. Cruz Municipal Police Station</p>
                    </div>
                </div>
            </div>
        </div>
    </article>
</div>
