<!-- Hero Header (Tactical Navy & Gold) -->
<div class="relative min-h-[32vh] py-16 md:py-20 flex items-center justify-center overflow-hidden bg-[#083566] bg-cover bg-center bg-no-repeat"
     style="background-image: linear-gradient(to bottom, rgba(13, 82, 156, 0.85), rgba(8, 53, 102, 0.92)), url('/images/home-hero.jpg');">
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-pnp-blue/25 via-[#083566]/40 to-[#041A33]/80"></div>

    <!-- Hero Content -->
    <div class="container mx-auto px-4 relative z-10 text-center flex flex-col items-center">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md text-pnp-gold px-4 py-1.5 rounded-full mb-3 border border-white/20">
            <i class="fas fa-bullhorn text-xs"></i>
            <span class="text-[10px] font-black uppercase tracking-widest">Public Advisory System &bull; Sta. Cruz</span>
        </div>

        <h1 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tight mb-2">
            Public <span class="text-pnp-gold">Advisories & Directives</span>
        </h1>

        <p class="text-xs sm:text-sm text-blue-100/90 font-medium max-w-2xl mx-auto leading-relaxed">
            Official safety alerts, crime advisories, prevention directives, road traffic alerts, and cybercrime warnings directly from the Sta. Cruz Municipal Police Station.
        </p>
    </div>
</div>

<div class="container mx-auto px-4 py-8 sm:py-12 max-w-7xl <%= (category === 'Wanted Person' || category === 'Missing Person') ? 'pt-8 sm:pt-12' : '' %>">
    <!-- Category Pills & Date Filter Toolbar (Admin Style) -->
    <% if (category !== 'Wanted Person' && category !== 'Missing Person') { %>
    <div class="bg-white dark:bg-slate-900 p-4 sm:p-6 rounded-2xl shadow-xs border border-slate-200/90 dark:border-slate-800 -mt-10 sm:-mt-14 relative z-20 mb-8 sm:mb-12 max-w-5xl mx-auto flex flex-col gap-4">
        <div class="flex flex-wrap gap-2 justify-center">
            <% 
                const activeCat = category && category !== 'All' ? category : 'Crime Advisory';
            %>
            <button onclick="setCategoryFilter('Crime Advisory', this)" class="category-pill-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider <%= activeCat === 'Crime Advisory' ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue border border-transparent shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 font-bold' %> transition duration-200">
                <i class="fas fa-shield-alt mr-1 text-xs"></i> Crime Advisories
            </button>
            <button onclick="setCategoryFilter('Traffic Advisory', this)" class="category-pill-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider <%= activeCat === 'Traffic Advisory' ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue border border-transparent shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 font-bold' %> transition duration-200">
                <i class="fas fa-traffic-light mr-1 text-xs"></i> Traffic Advisories
            </button>
            <button onclick="setCategoryFilter('Cybercrime Advisory', this)" class="category-pill-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider <%= activeCat === 'Cybercrime Advisory' ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue border border-transparent shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 font-bold' %> transition duration-200">
                <i class="fas fa-shield-virus mr-1 text-xs"></i> Cybercrime Advisories
            </button>
            <button onclick="setCategoryFilter('Community Awareness', this)" class="category-pill-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider <%= activeCat === 'Community Awareness' ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue border border-transparent shadow-xs' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 font-bold' %> transition duration-200">
                <i class="fas fa-users mr-1 text-xs"></i> Community Awareness
            </button>
        </div>

        <!-- Search & Date Filter Bar -->
        <div class="w-full pt-3.5 border-t border-slate-200/80 dark:border-slate-800 flex flex-col md:flex-row items-center gap-3">
            <!-- Search input -->
            <div class="relative flex-1 w-full">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <i class="fas fa-search text-xs"></i>
                </div>
                <input type="text" id="publicSearchInput" oninput="filterPublicBulletins()" placeholder="Search advisories by title or content..."
                    class="w-full pl-9 pr-4 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold focus:ring-2 focus:ring-pnp-blue dark:focus:ring-pnp-gold text-slate-800 dark:text-slate-100 outline-none transition placeholder:text-slate-400 shadow-2xs">
            </div>

            <!-- Date Filter Presets -->
            <div class="flex items-center gap-2 w-full md:w-auto">
                <div class="relative flex-1 md:w-44">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-pnp-gold">
                        <i class="fas fa-calendar-alt text-xs"></i>
                    </div>
                    <select id="bulletinDateMode" onchange="onBulletinDateModeChange()"
                        class="w-full pl-8 pr-7 py-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-pnp-blue dark:focus:ring-pnp-gold appearance-none cursor-pointer shadow-2xs">
                        <option value="all">All Dates</option>
                        <option value="thisMonth">This Month</option>
                        <option value="thisYear">This Year</option>
                        <option value="custom">Custom Date Range</option>
                    </select>
                    <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-chevron-down text-[10px]"></i>
                    </div>
                </div>

                <!-- Reset button -->
                <button type="button" onclick="resetBulletinFilters()" title="Reset Filters"
                    class="h-10 px-3.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition shrink-0 cursor-pointer border border-slate-200 dark:border-slate-700">
                    <i class="fas fa-rotate-left text-xs"></i>
                    <span class="hidden sm:inline">Reset</span>
                </button>
            </div>
        </div>

        <!-- Custom Date Range Inputs (Hidden unless 'custom' is selected) -->
        <div id="bulletinCustomDateRow" class="hidden w-full flex-col sm:flex-row items-center gap-3 pt-2 border-t border-slate-200/80 dark:border-slate-800">
            <div class="flex items-center gap-2 w-full sm:w-auto flex-1">
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 shrink-0">From:</span>
                <input type="date" id="bulletinFromDate" onchange="filterPublicBulletins()"
                    class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-pnp-blue">
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto flex-1">
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 shrink-0">To:</span>
                <input type="date" id="bulletinToDate" onchange="filterPublicBulletins()"
                    class="w-full px-3 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-slate-100 outline-none focus:ring-2 focus:ring-pnp-blue">
            </div>
        </div>
    </div>
    <% } %>

    <!-- Bulletin Grid -->
    <div id="bulletin-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        <% 
            const activeCategoryInitial = (category && category !== 'All') ? category : 'Crime Advisory';
            let initialAdvisoryCount = 0;
            let totalMatchingInitial = 0;
            bulletins.forEach(b => {
                if (category === 'Wanted Person' || category === 'Missing Person') {
                    totalMatchingInitial++;
                } else {
                    const normB = (b.category || '').toLowerCase().trim();
                    const normA = activeCategoryInitial.toLowerCase().trim();
                    if (normA === 'crime advisory' && (normB === 'crime advisory' || normB === 'crime advisories' || normB.includes('crime') || normB.includes('prevention'))) totalMatchingInitial++;
                    else if (normA === 'traffic advisory' && (normB === 'traffic advisory' || normB === 'traffic advisories')) totalMatchingInitial++;
                    else if (normA === 'cybercrime advisory' && (normB === 'cybercrime advisory' || normB === 'cybercrime advisories' || normB.includes('cyber'))) totalMatchingInitial++;
                    else if (normA === 'community awareness' && (normB === 'community awareness' || normB.includes('community') || normB.includes('awareness'))) totalMatchingInitial++;
                    else if (normA === normB) totalMatchingInitial++;
                }
            });
        %>
        <% bulletins.forEach(bulletin=> { 
            let isCategoryMatch = false;
            if (category === 'Wanted Person' || category === 'Missing Person') {
                isCategoryMatch = true;
            } else {
                const normB = (bulletin.category || '').toLowerCase().trim();
                const normA = activeCategoryInitial.toLowerCase().trim();
                if (normA === 'crime advisory' && (normB === 'crime advisory' || normB === 'crime advisories' || normB.includes('crime') || normB.includes('prevention'))) isCategoryMatch = true;
                else if (normA === 'traffic advisory' && (normB === 'traffic advisory' || normB === 'traffic advisories')) isCategoryMatch = true;
                else if (normA === 'cybercrime advisory' && (normB === 'cybercrime advisory' || normB === 'cybercrime advisories' || normB.includes('cyber'))) isCategoryMatch = true;
                else if (normA === 'community awareness' && (normB === 'community awareness' || normB.includes('community') || normB.includes('awareness'))) isCategoryMatch = true;
                else if (normA === normB) isCategoryMatch = true;
            }
            const initiallyShow = isCategoryMatch && (initialAdvisoryCount < 10);
            if (initiallyShow) initialAdvisoryCount++;
        %>
            <div
                class="bulletin-card group bg-white dark:bg-slate-900 rounded-2xl shadow-xs border border-slate-200/90 dark:border-slate-800 overflow-hidden hover:shadow-lg hover:border-slate-300 dark:hover:border-slate-700 transition duration-300 flex flex-col cursor-pointer"
                style="<%= initiallyShow ? '' : 'display: none !important;' %>"
                data-category="<%= bulletin.category %>" data-date="<%= bulletin.created_at %>" onclick="openBulletinModal('<%= bulletin.id %>')">
                <% if ((bulletin.photo_paths && bulletin.photo_paths.length > 0) || bulletin.photo_path || (bulletin.video_paths && bulletin.video_paths.length > 0)) { %>
                    <% 
                        const bulletinGridImg = (bulletin.photo_paths && bulletin.photo_paths.length > 0) 
                            ? bulletin.photo_paths[0] 
                            : (bulletin.photo_path || '/images/PNP.jpg');
                    %>
                    <div class="h-52 overflow-hidden relative bg-slate-950 shrink-0 border-b border-slate-200/80 dark:border-slate-800 flex items-center justify-center">
                        <img src="<%= bulletinGridImg %>" alt="<%= bulletin.title %>"
                            class="w-full h-full object-contain group-hover:scale-105 transition duration-500 select-none" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                        <% if (bulletin.video_paths && bulletin.video_paths.length > 0) { %>
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-black/30 pointer-events-none"></div>
                            <div class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-md text-[9px] font-black uppercase tracking-wider text-white border border-white/10 shadow flex items-center space-x-1.5 z-10">
                                <i class="fas fa-video text-pnp-gold"></i>
                                <span>Video Advisory</span>
                            </div>
                            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                <div class="w-12 h-12 rounded-full bg-slate-950/75 backdrop-blur-md border border-white/20 text-pnp-gold flex items-center justify-center shadow-xl group-hover:scale-110 group-hover:bg-pnp-blue group-hover:text-white transition-all duration-300">
                                    <i class="fas fa-play text-base ml-0.5"></i>
                                </div>
                            </div>
                        <% } %>
                        <% if (bulletin.photo_paths && bulletin.photo_paths.length > 1) { %>
                            <div class="absolute bottom-3 right-3 bg-slate-950/80 backdrop-blur-md px-2.5 py-1 rounded-full text-white text-[9px] font-black tracking-widest flex items-center space-x-1.5 border border-white/10 shadow-lg z-10">
                                <i class="fas fa-images text-emerald-400"></i>
                                <span>+<%= bulletin.photo_paths.length - 1 %></span>
                            </div>
                        <% } %>
                    </div>
                <% } else if (bulletin.facebook_url && !bulletin.facebook_url.includes('post_') && !bulletin.facebook_url.includes('undefined')) { %>
                    <div class="h-64 overflow-hidden relative bg-slate-950 shrink-0 flex items-center justify-center border-b border-slate-800/80">
                        <iframe src="https://www.facebook.com/plugins/<%= /video|watch|reel/i.test(bulletin.facebook_url) ? 'video.php' : 'post.php' %>?href=<%= encodeURIComponent(bulletin.facebook_url) %>&show_text=false&width=500" 
                            width="100%" height="100%" style="border:none;overflow:hidden;min-height:240px;" scrolling="no" frameborder="0" allowfullscreen="true" 
                            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" class="w-full h-full"></iframe>
                    </div>
                <% } else { %>
                    <div class="h-52 bg-slate-100 dark:bg-slate-800/50 flex flex-col items-center justify-center border-b border-slate-200/80 dark:border-slate-800">
                        <div class="w-12 h-12 rounded-xl bg-pnp-blue/10 dark:bg-pnp-gold/15 text-pnp-blue dark:text-pnp-gold flex items-center justify-center text-xl mb-2">
                            <i class="fas fa-bullhorn"></i>
                        </div>
                        <span class="text-[9px] font-bold uppercase tracking-wider text-slate-400">Sta. Cruz PNP Advisory</span>
                    </div>
                <% } %>

                <div class="p-5 sm:p-6 flex-grow flex flex-col justify-between">
                    <div>
                        <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
                            <% const badgeColors={
                                'Wanted Person': 'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400 border-rose-200 dark:border-rose-800',
                                'Missing Person': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 border-amber-200 dark:border-amber-800',
                                'Crime Advisory': 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400 border-orange-200 dark:border-orange-800',
                                'Crime Advisories': 'bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400 border-orange-200 dark:border-orange-800',
                                'Traffic Advisory': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400 border-purple-200 dark:border-purple-800',
                                'Traffic Advisories': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400 border-purple-200 dark:border-purple-800',
                                'Cybercrime Advisory': 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 border-indigo-200 dark:border-indigo-800',
                                'Community Awareness': 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border-emerald-200 dark:border-emerald-800',
                                'General Announcement': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border-blue-200 dark:border-blue-800'
                            }; %>
                            <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border shadow-2xs <%= badgeColors[bulletin.category] || 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-700' %>">
                                <%= bulletin.category %>
                            </span>
                            <span class="text-[9px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider">
                                <%= new Date(bulletin.created_at).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %>
                            </span>
                        </div>

                        <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white mb-2 leading-tight group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition duration-200 line-clamp-2">
                            <%= bulletin.title %>
                        </h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed mb-4 line-clamp-3">
                            <%= bulletin.body %>
                        </p>

                        <% if (bulletin.facebook_url) { %>
                            <div class="mb-4">
                                <a href="<%= bulletin.facebook_url %>" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation();"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#1877F2] hover:bg-blue-700 text-white rounded-lg text-[9.5px] font-black uppercase tracking-wider transition shadow-2xs">
                                    <i class="fab fa-facebook text-xs"></i>
                                    <span>Official Facebook Notice</span>
                                    <i class="fas fa-external-link-alt text-[8px] opacity-80"></i>
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end">
                        <button type="button" onclick="event.stopPropagation(); openBulletinModal('<%= bulletin.id %>')"
                            class="inline-flex items-center text-pnp-blue dark:text-pnp-gold font-black text-[10px] uppercase tracking-wider hover:underline focus:outline-none">
                            Read Details <i class="fas fa-arrow-right ml-1.5 text-[8px]"></i>
                        </button>
                    </div>
                </div>
            </div>
            <% }) %>
    </div>

    <!-- Load More / Older Posts Pagination Button -->
    <div id="bulletin-load-more-container" class="mt-12 text-center" style="<%= totalMatchingInitial > 0 ? '' : 'display: none;' %>">
        <button id="bulletin-load-more-btn" onclick="loadMoreBulletins()"
            style="<%= totalMatchingInitial > 10 ? 'display: inline-flex;' : 'display: none;' %>"
            class="w-full sm:w-auto px-8 py-4 bg-pnp-blue hover:bg-pnp-blue/90 text-white dark:bg-pnp-gold dark:text-slate-950 font-black rounded-2xl shadow-xl flex items-center justify-center gap-3 active:scale-95 transition-all duration-200 mx-auto border border-pnp-gold/40">
            <i class="fas fa-history text-sm"></i>
            <span id="bulletin-load-more-text">Load Older Advisories</span>
            <i class="fas fa-chevron-down text-xs"></i>
        </button>
        <p id="bulletin-load-more-info" class="text-xs text-gray-500 dark:text-gray-400 font-bold mt-3">
            Showing <span id="bulletin-visible-count"><%= Math.min(10, totalMatchingInitial) %></span> of <span id="bulletin-total-count"><%= totalMatchingInitial %></span> advisories
        </p>
    </div>

    <div id="noResultsDiv" class="text-center py-20" style="<%= bulletins.length === 0 ? 'display: block;' : 'display: none;' %>">
        <div class="w-20 h-20 bg-gray-50 dark:bg-slate-900/50 text-gray-200 dark:text-slate-700 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-search text-3xl"></i>
        </div>
        <h3 class="text-xl font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">No bulletins found
        </h3>
        <p class="text-gray-400 dark:text-gray-500 text-sm mt-2">Try adjusting your search or filter criteria.</p>
    </div>
</div>

<!-- INTERACTIVE BULLETIN DETAIL MODAL -->
<div id="bulletin-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-md" onclick="closeBulletinModal()"></div>
    <div class="relative bg-white dark:bg-slate-900 w-[95%] max-w-6xl rounded-2xl overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800 transform scale-95 transition-all duration-300 flex flex-col lg:flex-row max-h-[90vh]">
        
        <!-- Left Side: Media Carousel -->
        <div class="w-full lg:w-[50%] relative bg-slate-950 flex items-center justify-center h-64 sm:h-80 md:h-[450px] lg:h-auto min-h-[240px] shrink-0 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800">
            <div id="bulletin-modal-media-container" class="w-full h-full relative overflow-hidden flex items-center justify-center">
                <!-- Media injected here -->
            </div>
            
            <button id="modal-prev-btn" onclick="bulletinModalPrev()" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-pnp-blue text-white flex items-center justify-center backdrop-blur-sm transition-all z-20 hidden shadow-md">
                <i class="fas fa-chevron-left text-sm"></i>
            </button>
            <button id="modal-next-btn" onclick="bulletinModalNext()" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 hover:bg-pnp-blue text-white flex items-center justify-center backdrop-blur-sm transition-all z-20 hidden shadow-md">
                <i class="fas fa-chevron-right text-sm"></i>
            </button>
            
            <div id="modal-dots-container" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2 z-20 hidden"></div>
        </div>

        <!-- Right Side: Text Content -->
        <div class="w-full lg:w-[50%] p-6 md:p-10 overflow-y-auto bg-white dark:bg-slate-900 custom-modal-scrollbar relative max-h-[50vh] lg:max-h-none text-left">
            <button onclick="closeBulletinModal()" class="absolute top-4 right-4 md:top-6 md:right-6 w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-950 border border-slate-200/90 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 dark:hover:text-white dark:border-slate-700 shadow-sm flex items-center justify-center focus:outline-none transition-all duration-300 z-10" title="Close Modal">
                <i class="fas fa-times"></i>
            </button>

            <div class="mb-4 pr-12 flex items-center justify-between flex-wrap gap-2">
                <div class="flex items-center space-x-2 flex-wrap gap-y-2">
                    <span id="bulletin-modal-category" class="inline-block text-[10px] md:text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-xl border shadow-2xs transition-colors"></span>
                    <div id="bulletin-modal-fb-btn" class="inline-block"></div>
                </div>
                <div class="flex items-center gap-2 flex-wrap justify-end">
                    <button onclick="openFaqModal('bulletins')" type="button" class="text-[11px] font-black text-pnp-blue hover:text-white hover:bg-pnp-blue dark:text-pnp-gold dark:hover:bg-pnp-gold dark:hover:text-slate-950 uppercase tracking-wider flex items-center space-x-1.5 focus:outline-none transition px-3 py-1.5 rounded-xl bg-pnp-blue/10 dark:bg-pnp-gold/15 border border-pnp-blue/20 dark:border-pnp-gold/30 shadow-2xs cursor-pointer" title="View Official Verified FAQ">
                        <i class="fas fa-circle-question text-xs"></i>
                        <span>Official FAQ</span>
                    </button>
                    <select class="tts-voice-select text-[11px] px-2.5 py-1.5 max-w-[135px] rounded-xl bg-slate-50 hover:bg-white text-slate-800 dark:bg-slate-800 dark:text-slate-100 border border-slate-300 dark:border-slate-700 focus:outline-none focus:ring-2 focus:ring-pnp-blue/20 font-bold shadow-2xs">
                        <option value="google:fil-PH" selected>Tagalog / Filipino</option>
                        <option value="google:en-US">English (US)</option>
                    </select>
                    <button id="tts-bulletin-modal-btn" onclick="" class="text-[11px] font-black text-slate-800 hover:text-pnp-blue dark:text-slate-200 dark:hover:text-pnp-gold uppercase tracking-wider flex items-center space-x-1.5 focus:outline-none transition px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 shadow-2xs">
                        <i class="fas fa-volume-high text-xs"></i>
                        <span>Listen</span>
                    </button>
                    <button id="translate-bulletin-modal-btn" onclick="toggleTranslation('translate-bulletin-modal-btn', 'bulletin-modal-title', 'bulletin-modal-content', 'tts-bulletin-modal-btn')" class="text-[11px] font-black text-slate-800 hover:text-pnp-blue dark:text-slate-200 dark:hover:text-pnp-gold uppercase tracking-wider flex items-center space-x-1.5 focus:outline-none transition px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 shadow-2xs">
                        <i class="fas fa-language text-xs"></i>
                        <span>Translate</span>
                    </button>
                </div>
            </div>
            <div id="bulletin-modal-date" class="text-xs font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider mb-4 flex items-center gap-1.5"></div>
            <h3 id="bulletin-modal-title" class="text-2xl md:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white leading-tight mb-8 tracking-tight"></h3>
            
            <div id="bulletin-modal-content" class="text-slate-800 dark:text-slate-200 text-sm md:text-base leading-relaxed space-y-5 whitespace-pre-wrap font-normal"></div>
        </div>
    </div>
</div>

<style>
    .custom-modal-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-modal-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-modal-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(148, 163, 184, 0.5);
        border-radius: 20px;
    }
    .dark .custom-modal-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(71, 85, 105, 0.5);
    }
    .custom-modal-scrollbar::-webkit-scrollbar-thumb:hover {
        background-color: rgba(148, 163, 184, 0.8);
    }
</style>

<script>
    const bulletinsDatabase = <%- JSON.stringify(bulletins) %>;
    let currentCategory = '<%= category && category !== "All" ? category : "Crime Advisory" %>';
    let bulletinPageLimit = 10;

    function setCategoryFilter(category, btnElement) {
        currentCategory = category;
        
        // Update styling of pill buttons
        const buttons = document.querySelectorAll('.category-pill-btn');
        buttons.forEach(btn => {
            btn.className = 'category-pill-btn px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider bg-gray-50 dark:bg-slate-900 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-slate-800 border border-gray-200 dark:border-slate-700 transition duration-300';
        });
        
        // Mark the clicked one as active
        btnElement.className = 'category-pill-btn px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue border border-transparent shadow-md transition duration-300';
        
        filterPublicBulletins(false);
    }

    function onBulletinDateModeChange() {
        const mode = document.getElementById('bulletinDateMode')?.value || 'all';
        const customRow = document.getElementById('bulletinCustomDateRow');
        if (customRow) {
            if (mode === 'custom') {
                customRow.classList.remove('hidden');
                customRow.classList.add('flex');
            } else {
                customRow.classList.add('hidden');
                customRow.classList.remove('flex');
            }
        }
        filterPublicBulletins(false);
    }

    function resetBulletinFilters() {
        const searchInputEl = document.getElementById('publicSearchInput');
        if (searchInputEl) searchInputEl.value = '';

        const dateModeEl = document.getElementById('bulletinDateMode');
        if (dateModeEl) dateModeEl.value = 'all';

        const customRow = document.getElementById('bulletinCustomDateRow');
        if (customRow) {
            customRow.classList.add('hidden');
            customRow.classList.remove('flex');
        }

        const fromDateEl = document.getElementById('bulletinFromDate');
        if (fromDateEl) fromDateEl.value = '';
        const toDateEl = document.getElementById('bulletinToDate');
        if (toDateEl) toDateEl.value = '';

        filterPublicBulletins(false);
    }

    function loadMoreBulletins() {
        bulletinPageLimit += 10;
        filterPublicBulletins(true);
    }

    function filterPublicBulletins(isLoadMore = false) {
        const searchInputEl = document.getElementById('publicSearchInput');
        const searchInput = searchInputEl ? searchInputEl.value.toLowerCase().trim() : '';
        const cards = document.querySelectorAll('.bulletin-card');
        const pageCategory = '<%= category %>';

        const dateMode = document.getElementById('bulletinDateMode')?.value || 'all';
        const fromDateVal = document.getElementById('bulletinFromDate')?.value || '';
        const toDateVal = document.getElementById('bulletinToDate')?.value || '';
        const now = new Date();

        if (!isLoadMore) {
            bulletinPageLimit = 10;
        }

        const matchingCards = [];

        cards.forEach(card => {
            const h3 = card.querySelector('h3');
            const p = card.querySelector('p');
            const cat = card.getAttribute('data-category') || '';
            const rawDate = card.getAttribute('data-date') || '';
            if (!h3 || !p) return;
            
            const title = h3.textContent.toLowerCase();
            const body = p.textContent.toLowerCase();
            
            // Search text match
            const matchesSearch = searchInput === '' || title.includes(searchInput) || body.includes(searchInput);
            
            // Category match
            let matchesCategory = false;
            if (pageCategory === 'Wanted Person' || pageCategory === 'Missing Person') {
                matchesCategory = true;
            } else {
                const normCat = cat.toLowerCase().trim();
                const normCur = currentCategory.toLowerCase().trim();
                
                if (normCur === 'crime advisory' && (normCat === 'crime advisory' || normCat === 'crime advisories' || normCat.includes('crime') || normCat.includes('prevention'))) {
                    matchesCategory = true;
                } else if (normCur === 'traffic advisory' && (normCat === 'traffic advisory' || normCat === 'traffic advisories')) {
                    matchesCategory = true;
                } else if (normCur === 'cybercrime advisory' && (normCat === 'cybercrime advisory' || normCat === 'cybercrime advisories' || normCat.includes('cyber'))) {
                    matchesCategory = true;
                } else if (normCur === 'community awareness' && (normCat === 'community awareness' || normCat.includes('community') || normCat.includes('awareness'))) {
                    matchesCategory = true;
                } else if (normCur === normCat) {
                    matchesCategory = true;
                }
            }

            // Date match
            let matchesDate = true;
            if (dateMode !== 'all' && rawDate) {
                const d = new Date(rawDate);
                if (!isNaN(d.getTime())) {
                    if (dateMode === 'thisMonth') {
                        matchesDate = (d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth());
                    } else if (dateMode === 'thisYear') {
                        matchesDate = (d.getFullYear() === now.getFullYear());
                    } else if (dateMode === 'custom') {
                        if (fromDateVal) {
                            const fromD = new Date(fromDateVal + 'T00:00:00');
                            if (d < fromD) matchesDate = false;
                        }
                        if (toDateVal) {
                            const toD = new Date(toDateVal + 'T23:59:59.999');
                            if (d > toD) matchesDate = false;
                        }
                    }
                }
            }
            
            if (matchesSearch && matchesCategory && matchesDate) {
                matchingCards.push(card);
            } else {
                card.style.setProperty('display', 'none', 'important');
            }
        });

        // Apply display styling & pagination (10 per page on all devices)
        matchingCards.forEach((card, index) => {
            if (index < bulletinPageLimit) {
                card.style.removeProperty('display');
                card.style.display = 'flex';
            } else {
                card.style.setProperty('display', 'none', 'important');
            }
        });
        
        const noResultsDiv = document.getElementById('noResultsDiv');
        if (noResultsDiv) {
            noResultsDiv.style.display = matchingCards.length === 0 ? 'block' : 'none';
        }

        // Update pagination container (active on PC and mobile)
        const loadMoreContainer = document.getElementById('bulletin-load-more-container');
        const loadMoreBtn = document.getElementById('bulletin-load-more-btn');
        const visibleCountSpan = document.getElementById('bulletin-visible-count');
        const totalCountSpan = document.getElementById('bulletin-total-count');
        const loadMoreInfo = document.getElementById('bulletin-load-more-info');

        if (loadMoreContainer) {
            if (matchingCards.length > 0) {
                loadMoreContainer.style.display = 'block';
                if (totalCountSpan) totalCountSpan.textContent = matchingCards.length;
                if (visibleCountSpan) visibleCountSpan.textContent = Math.min(bulletinPageLimit, matchingCards.length);

                if (matchingCards.length > bulletinPageLimit) {
                    if (loadMoreBtn) loadMoreBtn.style.display = 'inline-flex';
                    if (loadMoreInfo) loadMoreInfo.textContent = `Showing ${Math.min(bulletinPageLimit, matchingCards.length)} of ${matchingCards.length} advisories`;
                } else {
                    if (loadMoreBtn) loadMoreBtn.style.display = 'none';
                    if (loadMoreInfo) loadMoreInfo.textContent = `All ${matchingCards.length} advisories loaded`;
                }
            } else {
                loadMoreContainer.style.display = 'none';
            }
        }
    }

    window.addEventListener('resize', () => {
        filterPublicBulletins(true);
    });

    function openBulletinModal(bulletinId) {
        const bulletin = bulletinsDatabase.find(b => String(b.id) === String(bulletinId));
        if (!bulletin) return;

        const mediaContainer = document.getElementById('bulletin-modal-media-container');
        const prevBtn = document.getElementById('modal-prev-btn');
        const nextBtn = document.getElementById('modal-next-btn');
        const dotsContainer = document.getElementById('modal-dots-container');

        if (mediaContainer) {
            mediaContainer.innerHTML = '';
            if (dotsContainer) dotsContainer.innerHTML = '';

            const mediaItems = [];
            
            if (bulletin.photo_paths && bulletin.photo_paths.length > 0) {
                bulletin.photo_paths.forEach(url => {
                    if (url) mediaItems.push({ type: 'photo', url });
                });
            } else if (bulletin.photo_path) {
                mediaItems.push({ type: 'photo', url: bulletin.photo_path });
            }

            if (bulletin.video_paths && bulletin.video_paths.length > 0) {
                bulletin.video_paths.forEach(url => {
                    if (url) mediaItems.push({ type: 'video', url });
                });
            } else if (bulletin.video_path) {
                mediaItems.push({ type: 'video', url: bulletin.video_path });
            }

            if (bulletin.facebook_url && !bulletin.facebook_url.includes('post_') && mediaItems.length === 0) {
                const isVideo = /video|watch|reel/i.test(bulletin.facebook_url);
                const pluginType = isVideo ? 'video.php' : 'post.php';
                const embedSrc = `https://www.facebook.com/plugins/${pluginType}?href=${encodeURIComponent(bulletin.facebook_url)}&show_text=false&width=500`;
                mediaContainer.innerHTML = `<div class="w-full h-full min-h-[380px] bg-slate-950 flex flex-col items-center justify-center p-2 relative overflow-hidden">
                    <iframe src="${embedSrc}" width="100%" height="100%" style="border:none;overflow:hidden;min-height:380px;" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" class="rounded-2xl w-full max-w-xl shadow-2xl"></iframe>
                </div>`;
                if (prevBtn) prevBtn.classList.add('hidden');
                if (nextBtn) nextBtn.classList.add('hidden');
                if (dotsContainer) dotsContainer.classList.add('hidden');
            } else {
                if (mediaItems.length === 0) {
                    mediaItems.push({ type: 'photo', url: '/images/PNP.jpg' });
                }

                const renderItemHtml = (item, idx) => {
                    const isVisible = idx === 0;
                    const displayStyle = isVisible ? 'display: flex;' : 'display: none;';
                    if (item.type === 'video') {
                        return `<div class="w-full h-full min-h-[240px] flex items-center justify-center bg-slate-950 ${isVisible ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}" style="${displayStyle}" data-slide="${idx}">
                                    <video src="${item.url}" poster="/images/PNP.jpg" preload="metadata" playsinline controls class="max-w-full max-h-full w-auto h-auto object-contain video-player-slide" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"></video>
                                    <div class="hidden flex flex-col items-center justify-center p-6 text-center">
                                        <img src="/images/PNP.jpg" class="w-36 h-36 object-contain rounded-xl mb-3 shadow" alt="Station Media">
                                        <span class="text-xs font-black text-amber-400 uppercase tracking-wider mb-2">Video playback unavailable in browser</span>
                                        <a href="${item.url}" target="_blank" download class="px-4 py-2 bg-pnp-blue hover:bg-blue-900 text-white text-xs font-bold uppercase tracking-wider rounded-xl transition flex items-center space-x-2">
                                            <i class="fas fa-external-link-alt"></i>
                                            <span>Open / Download Video File</span>
                                        </a>
                                    </div>
                                </div>`;
                    } else {
                        return `<div class="w-full h-full min-h-[240px] flex items-center justify-center bg-slate-950 p-2 ${isVisible ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}" style="${displayStyle}" data-slide="${idx}">
                                    <img src="${item.url}" class="max-w-full max-h-full w-auto h-auto object-contain select-none rounded-xl" alt="Media ${idx + 1}" referrerpolicy="no-referrer" loading="lazy" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                                </div>`;
                    }
                };
                
                mediaContainer.innerHTML = mediaItems.map((item, idx) => renderItemHtml(item, idx)).join('');
                window.currentBulletinModalSlide = 0;
                window.totalBulletinModalSlides = mediaItems.length;

                if (mediaItems.length > 1) {
                    if (prevBtn) prevBtn.classList.remove('hidden');
                    if (nextBtn) nextBtn.classList.remove('hidden');
                    if (dotsContainer) {
                        dotsContainer.classList.remove('hidden');
                        dotsContainer.innerHTML = mediaItems.map((_, idx) => `
                            <button onclick="bulletinModalGoTo(${idx})" class="w-2 h-2 rounded-full transition-all ${idx === 0 ? 'bg-white scale-125' : 'bg-white/40 hover:bg-white/80'}" data-dot="${idx}"></button>
                        `).join('');
                    }
                } else {
                    if (prevBtn) prevBtn.classList.add('hidden');
                    if (nextBtn) nextBtn.classList.add('hidden');
                    if (dotsContainer) dotsContainer.classList.add('hidden');
                }
            }
        }

        const catBadgeColors = {
            'Crime Advisory': 'bg-red-50 text-red-700 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-800/60',
            'Traffic Advisory': 'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800/60',
            'Cybercrime Advisory': 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-950/40 dark:text-purple-300 dark:border-purple-800/60',
            'Emergency Preparedness': 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/40 dark:text-orange-300 dark:border-orange-800/60',
            'VAWC Advisories': 'bg-pink-50 text-pink-700 border-pink-200 dark:bg-pink-950/40 dark:text-pink-300 dark:border-pink-800/60',
            'Community Awareness': 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-800/60',
            'Recovered Property': 'bg-green-50 text-green-700 border-green-200 dark:bg-green-950/40 dark:text-green-300 dark:border-green-800/60',
            'General Announcement': 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-800/60'
        };
        const catEl = document.getElementById('bulletin-modal-category');
        if (catEl) {
            catEl.textContent = bulletin.category || 'Public Advisory';
            catEl.className = `inline-block text-[10px] md:text-xs font-black uppercase tracking-widest px-3.5 py-1.5 rounded-xl border shadow-2xs ${catBadgeColors[bulletin.category] || 'bg-slate-100 text-slate-800 border-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:border-slate-700'}`;
        }
        document.getElementById('bulletin-modal-date').innerHTML = `<i class="fas fa-calendar-day mr-2"></i>${new Date(bulletin.created_at).toLocaleDateString(undefined, {month: 'long', day: 'numeric', year: 'numeric'})}`;
        document.getElementById('bulletin-modal-title').textContent = bulletin.title;
        document.getElementById('bulletin-modal-content').textContent = bulletin.body;

        const fbBtn = document.getElementById('bulletin-modal-fb-btn');
        if (fbBtn) {
            if (bulletin.facebook_url) {
                fbBtn.innerHTML = `<a href="${bulletin.facebook_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center space-x-2 px-3.5 py-1.5 bg-[#1877F2] hover:bg-blue-700 text-white rounded-xl text-[11px] font-black uppercase tracking-wider transition shadow-sm">
                    <i class="fab fa-facebook text-xs"></i>
                    <span>Open Official Facebook Post</span>
                    <i class="fas fa-external-link-alt text-[9px] ml-1 opacity-80"></i>
                </a>`;
            } else {
                fbBtn.innerHTML = '';
            }
        }

        if (typeof resetTranslationButton === 'function') {
            resetTranslationButton('translate-bulletin-modal-btn', 'bulletin-modal-title', 'bulletin-modal-content', bulletin.title, bulletin.body, 'tts-bulletin-modal-btn');
        }

        const modal = document.getElementById('bulletin-modal');
        const content = modal.querySelector('.relative');

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }, 50);
    }

    function closeBulletinModal() {
        if (typeof stopSpeech === 'function') stopSpeech();
        const modal = document.getElementById('bulletin-modal');
        const content = modal.querySelector('.relative');
        
        // Pause all videos in collage if any
        if (modal) {
            const videos = modal.querySelectorAll('video');
            videos.forEach(v => {
                try {
                    v.pause();
                } catch (e) {}
            });
        }

        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => filterPublicBulletins(false));
    } else {
        filterPublicBulletins(false);
    }
    try {
        filterPublicBulletins(false);
    } catch(e) {}
    function bulletinModalUpdate() {
        const slides = document.querySelectorAll('#bulletin-modal-media-container [data-slide]');
        const dots = document.querySelectorAll('#modal-dots-container [data-dot]');
        
        slides.forEach((slide, idx) => {
            if (idx === window.currentBulletinModalSlide) {
                slide.style.display = 'flex';
                slide.classList.replace('opacity-0', 'opacity-100');
                slide.classList.replace('z-0', 'z-10');
                slide.classList.remove('pointer-events-none');
            } else {
                slide.style.display = 'none';
                slide.classList.replace('opacity-100', 'opacity-0');
                slide.classList.replace('z-10', 'z-0');
                slide.classList.add('pointer-events-none');
                
                const vid = slide.querySelector('video');
                if (vid) { try { vid.pause(); } catch(e){} }
            }
        });
        
        dots.forEach((dot, idx) => {
            if (idx === window.currentBulletinModalSlide) {
                dot.classList.replace('bg-white/40', 'bg-white');
                dot.classList.remove('hover:bg-white/80');
                dot.classList.add('scale-125');
            } else {
                dot.classList.replace('bg-white', 'bg-white/40');
                dot.classList.add('hover:bg-white/80');
                dot.classList.remove('scale-125');
            }
        });
    }

    function bulletinModalNext() {
        if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
        window.currentBulletinModalSlide = (window.currentBulletinModalSlide + 1) % window.totalBulletinModalSlides;
        bulletinModalUpdate();
    }

    function bulletinModalPrev() {
        if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
        window.currentBulletinModalSlide = (window.currentBulletinModalSlide - 1 + window.totalBulletinModalSlides) % window.totalBulletinModalSlides;
        bulletinModalUpdate();
    }

    function bulletinModalGoTo(idx) {
        if (!window.totalBulletinModalSlides || window.totalBulletinModalSlides <= 1) return;
        window.currentBulletinModalSlide = idx;
        bulletinModalUpdate();
    }

    // Keyboard navigation for carousel
    document.addEventListener('keydown', (e) => {
        const modal = document.getElementById('bulletin-modal');
        if (modal && !modal.classList.contains('hidden')) {
            if (e.key === 'ArrowLeft') {
                bulletinModalPrev();
            } else if (e.key === 'ArrowRight') {
                bulletinModalNext();
            } else if (e.key === 'Escape') {
                closeBulletinModal();
            }
        }
    });

    // Touch Swipe Support for Bulletin Modal Media
    (function initBulletinModalSwipe() {
        const container = document.getElementById('bulletin-modal-media-container');
        if (!container) return;
        let startX = 0, startY = 0;
        container.addEventListener('touchstart', (e) => {
            if (e.touches && e.touches.length > 0) {
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
            }
        }, { passive: true });
        container.addEventListener('touchend', (e) => {
            if (e.changedTouches && e.changedTouches.length > 0) {
                const diffX = e.changedTouches[0].clientX - startX;
                const diffY = e.changedTouches[0].clientY - startY;
                if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                    if (diffX < 0) {
                        bulletinModalNext();
                    } else {
                        bulletinModalPrev();
                    }
                }
            }
        }, { passive: true });
    })();
</script>