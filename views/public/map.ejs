    function locateBarangay(shouldMinimize = true) {
        const selectedName = document.getElementById('filterBarangay').value;
        const mapContainer = document.getElementById('map');

        // Always clear any currently drawn selected pins first!
        selectedPinsLayer.clearLayers();

        if (!selectedName) {
            if (mapContainer) mapContainer.classList.remove('barangay-selected');
            recenterStaCruzMap();
            if (typeof updateBarangayLabels === 'function') updateBarangayLabels();
            setTimeout(() => {
                if (typeof manageTooltipVisibility === 'function') manageTooltipVisibility();
            }, 100);
            return;
        }

        if (mapContainer) mapContainer.classList.add('barangay-selected');
        const pin = manualPins.find(p => p.name.toLowerCase() === selectedName.toLowerCase());
        if (pin && map) {
            // Open sidebar on desktop when a barangay is selected
            const sidebar = document.getElementById('filterSidebar');
            if (sidebar && sidebar.classList.contains('sidebar-hidden') && window.innerWidth >= 768) {
                sidebar.classList.remove('sidebar-hidden');
                sidebar.classList.add('sidebar-visible');
                const toggleBtn = document.getElementById('sidebarToggle');
                if (toggleBtn) {
                    toggleBtn.classList.add('opacity-0', 'pointer-events-none');
                    toggleBtn.classList.remove('opacity-100', 'pointer-events-auto');
                }
            }

            let targetCenter = [pin.lat, pin.lng];
            if (window.innerWidth >= 768) {
                try {
                    const targetPoint = map.project([pin.lat, pin.lng], 16).subtract([160, 0]);
                    targetCenter = map.unproject(targetPoint, 16);
                } catch (e) {
                    targetCenter = [pin.lat, pin.lng];
                }
            }

            map.flyTo(targetCenter, 16, {
                animate: true,
                duration: 1.2
            });

            // Create and show the beautiful gold Tactical Pin directly on the barangay name!
            const tacticalPin = L.marker([pin.lat, pin.lng], {
                icon: L.divIcon({
                    className: 'manual-pin-container',
                    html: `
                        <div class="relative group flex flex-col items-center select-none pointer-events-none">
                            <div class="absolute -inset-1.5 bg-pnp-blue/25 dark:bg-pnp-gold/35 rounded-2xl animate-ping pointer-events-none"></div>
                            <div class="relative px-3.5 py-1.5 rounded-xl bg-pnp-blue dark:bg-pnp-gold text-white dark:text-pnp-blue font-black text-xs uppercase tracking-wider shadow-2xl border-2 border-white dark:border-slate-900 flex items-center gap-1.5 z-10 whitespace-nowrap">
                                <i class="fas fa-location-dot text-[11px] text-pnp-gold dark:text-pnp-blue"></i>
                                <span>${pin.name}</span>
                            </div>
                            <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[8px] border-t-pnp-blue dark:border-t-pnp-gold -mt-[1px]"></div>
                        </div>
                    `,
                    iconSize: [160, 42],
                    iconAnchor: [80, 42]
                })
            }).addTo(selectedPinsLayer);

            // Calculate sector stats
            const brgyPoints = currentPoints.filter(p => p.barangay === pin.name);
            const totalIncidents = brgyPoints.length;

            const allCounts = Object.values(currentPoints.reduce((acc, curr) => {
                acc[curr.barangay] = (acc[curr.barangay] || 0) + 1;
                return acc;
            }, {}));
            const max = Math.max(...allCounts, 1);

            let classification = "Minimal Density";
            let classificationBg = "bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-500 dark:text-emerald-400";
            if (totalIncidents > 0) {
                const ratio = totalIncidents / max;
                if (ratio >= 0.75) {
                    classification = "High Density";
                    classificationBg = "bg-rose-500/10 dark:bg-rose-400/10 text-rose-500 dark:text-rose-400";
                } else if (ratio >= 0.40) {
                    classification = "Medium-High Density";
                    classificationBg = "bg-orange-500/10 dark:bg-orange-400/10 text-orange-500 dark:text-orange-400";
                } else if (ratio >= 0.15) {
                    classification = "Medium-Low Density";
                    classificationBg = "bg-amber-500/10 dark:bg-amber-400/10 text-amber-500 dark:text-amber-400";
                } else {
                    classification = "Low Density";
                    classificationBg = "bg-emerald-500/10 dark:bg-emerald-400/10 text-emerald-500 dark:text-emerald-400";
                }
            } else {
                classification = "Sector Clear";
                classificationBg = "bg-slate-500/10 dark:bg-slate-400/10 text-slate-500 dark:text-slate-400";
            }

            let dominantCrime = "None";
            let dominantColor = "#94A3B8";
            let dominantCount = 0;
            if (totalIncidents > 0) {
                const stats = {};
                brgyPoints.forEach(p => { stats[p.incident_type] = (stats[p.incident_type] || 0) + 1; });
                const topCrime = Object.entries(stats).sort((a, b) => b[1] - a[1])[0];
                dominantCrime = topCrime[0];
                dominantColor = getTacticalColor(topCrime[0]);
                dominantCount = topCrime[1];
            }

            tacticalPin.bindPopup(`
                <div class="p-4 min-w-[220px] bg-white dark:bg-slate-800 rounded-xl space-y-3">
                    <div class="flex items-center space-x-3 mb-2 pb-2 border-b border-gray-150 dark:border-slate-700">
                        <div class="w-8 h-8 bg-pnp-blue dark:bg-pnp-gold rounded-lg flex items-center justify-center shadow-md">
                            <i class="fas fa-shield-halved text-white dark:text-pnp-blue text-xs"></i>
                        </div>
                        <div>
                            <h3 class="text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-widest text-xs leading-none">${pin.name}</h3>
                            <p class="text-[8px] text-gray-400 font-bold uppercase mt-1">S-SPS Tactical Summary</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="text-gray-500 dark:text-gray-400 font-bold">Total Cases:</span>
                            <span class="font-black text-slate-850 dark:text-slate-200">${totalIncidents}</span>
                        </div>
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="text-gray-500 dark:text-gray-400 font-bold">Density Class:</span>
                            <span class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider ${classificationBg}">
                                ${classification}
                            </span>
                        </div>
                        <div class="flex justify-between items-center text-[10px]">
                            <span class="text-gray-500 dark:text-gray-400 font-bold">Dominant Incident:</span>
                            <div class="flex items-center space-x-1">
                                <span class="w-2 h-2 rounded-full" style="background-color: ${dominantColor}"></span>
                                <span class="font-black text-slate-800 dark:text-slate-200 uppercase">${dominantCrime}</span>
                            </div>
                        </div>
                    </div>
                </div>
            `);

            // Open popup and re-show sidebars on desktop after flyTo animation completes
            setTimeout(() => {
                tacticalPin.openPopup();

                const isMobile = window.innerWidth < 768;
                if (!isMobile) {
                    const sidebar = document.getElementById('filterSidebar');
                    if (sidebar && !sidebar.dataset.userToggled && sidebar.classList.contains('sidebar-hidden')) {
                        sidebar.classList.remove('sidebar-hidden');
                        sidebar.classList.add('sidebar-visible');
                        const toggleBtn = document.getElementById('sidebarToggle');
                        if (toggleBtn) {
                            toggleBtn.classList.add('opacity-0', 'pointer-events-none');
                            toggleBtn.classList.remove('opacity-100', 'pointer-events-auto');
                        }
                    }

                    const incidentsSidebar = document.getElementById('incidentsSidebar');
                    if (incidentsSidebar && !incidentsSidebar.dataset.userToggled && incidentsSidebar.classList.contains('sidebar-hidden')) {
                        incidentsSidebar.classList.remove('sidebar-hidden');
                        incidentsSidebar.classList.add('sidebar-visible');
                        const iToggle = document.getElementById('incidentsToggle');
                        if (iToggle) {
                            iToggle.classList.add('opacity-0', 'pointer-events-none');
                            iToggle.classList.remove('opacity-100', 'pointer-events-auto');
                        }
                    }
                }
            }, 1200);
        }
    }

    async function loadMapPoints(shouldLocate = true) {
        const barangay = document.getElementById('filterBarangay').value;

        // Automatically locate when barangay is selected
        if (barangay && shouldLocate) {
            locateBarangay();
        } else if (!barangay && shouldLocate) {
            // Reset view to Santa Cruz center when "All Barangays" is selected
            recenterStaCruzMap();
        }

        const topIncidentsSection = document.getElementById('topIncidentsSection');
        const topIncidentsList = document.getElementById('topIncidentsList');
        const topIncidentsRange = document.getElementById('topIncidentsRange');

        if (topIncidentsRange) {
            if (crimeDateFilterMode === 'thisYear') {
                topIncidentsRange.textContent = 'This Year';
            } else if (crimeDateFilterMode === 'monthYear') {
                const monthNamesShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                topIncidentsRange.textContent = `${monthNamesShort[parseInt(crimeDateSelectedMonth) - 1]} ${crimeDateSelectedYear}`;
            } else if (crimeDateFilterMode === 'yearOnly') {
                topIncidentsRange.textContent = `Year ${crimeDateSelectedYear}`;
            } else if (crimeDateFilterMode === 'customRange') {
                topIncidentsRange.textContent = 'Custom Range';
            }
        }

        try {
            // Use preloaded cached points if available, otherwise fetch from API
            if (!Array.isArray(allMapPointsCached) || allMapPointsCached.length === 0) {
                const url = `/api/map-points`;
                const response = await fetch(url);
                const points = await response.json();
                allMapPointsCached = Array.isArray(points) ? points : [];
            }
            populateYearDropdowns(allMapPointsCached);

            // Apply our elegant custom date filter locally!
            currentPoints = filterPointsByDate(allMapPointsCached);

            populateClassificationDropdown();
            updateHeatmap();
            updateLegend();

            incidentMarkers.clearLayers();

            // Calculate Top 3 Incidents based on the selected barangay and category if selected!
            const modeSelect = document.getElementById('mapDisplayMode');
            const mode = modeSelect ? modeSelect.value : 'density';
            let targetCategory = null;
            if (mode === 'density_focus') targetCategory = '8-Focus';
            else if (mode === 'density_nonindex') targetCategory = 'Non-Index';
            else if (mode === 'density_psi') targetCategory = 'PSI';

            let statsPoints = barangay
                ? currentPoints.filter(p => p.barangay.toLowerCase() === barangay.toLowerCase())
                : currentPoints;

            if (targetCategory) {
                statsPoints = statsPoints.filter(p => (p.category || 'Non-Index') === targetCategory);
            }

            const selectedClassification = document.getElementById('filterClassification')?.value || 'All';
            if (selectedClassification !== 'All') {
                statsPoints = statsPoints.filter(p => p.incident_type === selectedClassification);
            }

            const incidentCounts = {};
            const incidentCategoryMap = {};
            if (statsPoints.length > 0) {
                statsPoints.forEach(point => {
                    incidentCounts[point.incident_type] = (incidentCounts[point.incident_type] || 0) + 1;
                    if (point.category) {
                        incidentCategoryMap[point.incident_type] = point.category;
                    }
                });
            }

            const sortedIncidents = Object.entries(incidentCounts)
                .sort((a, b) => b[1] - a[1]);

            if (topIncidentsList) {
                topIncidentsList.innerHTML = sortedIncidents.length > 0
                    ? sortedIncidents.map(([type, count]) => {
                        const cat = incidentCategoryMap[type];
                        const catColor = getCategoryColor(type, cat);
                        const formatted = formatCrimeClassification(type);
                        return `
                        <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-900 rounded-2xl border border-gray-100 dark:border-slate-700 hover:border-gray-200 dark:hover:border-slate-600 transition">
                            <div class="flex items-start space-x-2.5 min-w-0 pr-2 flex-1">
                                <span class="w-2.5 h-2.5 rounded-full shrink-0 mt-1" style="background-color: ${catColor}"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-[11px] font-black text-gray-800 dark:text-gray-200 leading-tight">${escapeHtml(formatted.shortTitle)}</div>
                                    ${formatted.subtitle ? `<div class="text-[9px] font-medium text-gray-400 dark:text-gray-400 leading-tight mt-0.5 truncate">${escapeHtml(formatted.subtitle)}</div>` : ''}
                                </div>
                            </div>
                            <span class="text-xs font-black text-pnp-blue dark:text-pnp-gold shrink-0 ml-2 bg-pnp-blue/5 dark:bg-pnp-gold/10 px-2 py-1 rounded-lg">${count}</span>
                        </div>
                    `}).join('')
                    : `<p class="text-[10px] text-gray-400 font-bold uppercase text-center py-4">No incidents recorded</p>`;
            }
        } catch (err) {
            console.error('Error loading map points:', err);
        }
    }

    // Simple Point in Polygon function
    function isPointInPolygon(point, vs) {
        const x = point[0], y = point[1];
        let inside = false;

        if (Array.isArray(vs[0][0][0])) {
            for (let i = 0; i < vs.length; i++) {
                if (isPointInPolygon(point, vs[i])) return true;
            }
            return false;
        }

        const polygon = Array.isArray(vs[0][0]) ? vs[0] : vs;

        for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
            const xi = polygon[i][0], yi = polygon[i][1];
            const xj = polygon[j][0], yj = polygon[j][1];
            const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi);
            if (intersect) inside = !inside;
        }
        return inside;
    }

    function checkGeofence(latlng) {
        let isInside = false;
        if (santaCruzGeoJSON) {
            const point = [latlng.lng, latlng.lat];
            for (const feature of santaCruzGeoJSON.features) {
                if (isPointInPolygon(point, feature.geometry.coordinates)) {
                    isInside = true;
                    break;
                }
            }
        }
        return isInside;
    }

    // Helper to format long statutory crime classifications into concise, two-line structures
    function formatCrimeClassification(raw) {
        if (!raw || raw === 'All') {
            return { shortTitle: 'All Classifications', subtitle: 'All recorded crime incidents', full: 'All' };
        }

        let title = raw;
        let subtitle = '';

        if (raw.includes(' - ')) {
            const parts = raw.split(' - ');
            title = parts[0].trim();
            subtitle = parts.slice(1).join(' - ').trim();
        } else if (raw.includes(' – ')) {
            const parts = raw.split(' – ');
            title = parts[0].trim();
            subtitle = parts.slice(1).join(' – ').trim();
        }

        const upper = title.toUpperCase();

        if (upper.includes('ILLEGAL NUMBERS GAMES')) {
            title = 'Illegal Numbers Games (Anti-Gambling)';
            if (!subtitle) subtitle = 'PD 1602 / RA 9287';
        } else if (upper.includes('ANTI-ELECTRICITY') || upper.includes('TRANSMISSION LINES') || upper.includes('PILFERAGE')) {
            title = 'Electricity & Wire Pilferage Act';
            if (!subtitle) subtitle = 'RA 7832';
        } else if (upper.includes('VIOLENCE AGAINST WOMEN') || upper.includes('VAWC')) {
            title = 'Violence Against Women & Children (VAWC)';
            if (!subtitle) subtitle = 'RA 9262';
        } else if (upper.includes('DANGEROUS DRUGS')) {
            title = 'Comprehensive Dangerous Drugs';
            if (!subtitle) subtitle = 'RA 9165';
        } else if (upper.includes('FIREARMS AND AMMUNITION')) {
            title = 'Firearms & Ammunition Law';
            if (!subtitle) subtitle = 'RA 10591';
        } else if (upper.includes('ANTI-CARNAPPING')) {
            title = 'Anti-Carnapping Act';
            if (!subtitle) subtitle = 'RA 10883';
        } else if (upper.includes('ANTI-RAPE')) {
            title = 'Anti-Rape Law';
            if (!subtitle) subtitle = 'RA 8353';
        } else if (upper.includes('BOUNCING CHECK')) {
            title = 'Bouncing Check Law';
            if (!subtitle) subtitle = 'BP 22';
        } else if (upper.includes('CYBERCRIME PREVENTION')) {
            title = 'Cybercrime Prevention Act';
            if (!subtitle) subtitle = 'RA 10175';
        } else if (upper.includes('ANTI-CHILD PORNOGRAPHY')) {
            title = 'Anti-Child Pornography Act';
            if (!subtitle) subtitle = 'RA 9775';
        } else if (upper.includes('SPECIAL PROTECTION OF CHILDREN')) {
            title = 'Child Abuse & Exploitation';
            if (!subtitle) subtitle = 'RA 7610';
        } else if (title.length > 36 && !subtitle) {
            const words = title.split(' ');
            let line1 = '';
            let line2 = '';
            for (const w of words) {
                if ((line1 + ' ' + w).trim().length <= 32) {
                    line1 = (line1 + ' ' + w).trim();
                } else {
                    line2 = (line2 + ' ' + w).trim();
                }
            }
            title = line1 || title;
            subtitle = line2;
        }

        const toTitleCase = (str) => {
            return str.toLowerCase().replace(/(?:^|\s|\/|-)\w/g, (match) => match.toUpperCase());
        };

        return {
            shortTitle: toTitleCase(title),
            subtitle: subtitle,
            full: raw
        };
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    let cachedClassificationOffenses = [];

    function renderCustomClassificationItems(sortedOffenses, selectedVal) {
        if (sortedOffenses) {
            cachedClassificationOffenses = sortedOffenses;
        } else {
            sortedOffenses = cachedClassificationOffenses;
        }
        if (!selectedVal) {
            const sel = document.getElementById('filterClassification');
            selectedVal = sel ? sel.value : 'All';
        }

        const listContainer = document.getElementById('customClassificationList');
        const countBadge = document.getElementById('classificationCountBadge');
        if (countBadge) {
            countBadge.textContent = sortedOffenses.length ? `${sortedOffenses.length} classifications` : '';
        }

        if (!listContainer) return;

        const items = [{
            full: 'All',
            shortTitle: 'All Classifications',
            subtitle: 'All recorded crime incidents'
        }];

        sortedOffenses.forEach(off => {
            items.push(formatCrimeClassification(off));
        });

        let listHtml = '';
        items.forEach(item => {
            const isSelected = item.full === selectedVal;
            listHtml += `
                <button type="button" onclick="selectClassificationOption('${encodeURIComponent(item.full)}')"
                    class="classification-option-item w-full text-left p-2.5 rounded-xl transition duration-150 flex items-start gap-2.5 ${isSelected ? 'bg-pnp-blue text-white shadow-md ring-1 ring-pnp-gold' : 'hover:bg-white dark:hover:bg-slate-800 text-gray-800 dark:text-gray-200 border border-transparent hover:border-gray-200 dark:hover:border-slate-700'}"
                    data-search="${(item.shortTitle + ' ' + (item.subtitle || '') + ' ' + item.full).toLowerCase()}">
                    <div class="mt-1 w-2 h-2 rounded-full shrink-0 ${isSelected ? 'bg-pnp-gold ring-2 ring-white/50' : 'bg-gray-300 dark:bg-slate-600'}"></div>
                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-black truncate leading-snug ${isSelected ? 'text-white' : 'text-gray-900 dark:text-white'}">
                            ${escapeHtml(item.shortTitle)}
                        </div>
                        ${item.subtitle ? `
                            <div class="text-[10px] font-medium truncate leading-tight mt-0.5 ${isSelected ? 'text-blue-100' : 'text-gray-400 dark:text-gray-400'}">
                                ${escapeHtml(item.subtitle)}
                            </div>
                        ` : ''}
                    </div>
                    ${isSelected ? '<i class="fas fa-check text-pnp-gold text-xs shrink-0 self-center"></i>' : ''}
                </button>
            `;
        });

        listContainer.innerHTML = listHtml;
        updateCustomClassificationTriggerUI(selectedVal);
    }

    function selectClassificationOption(encodedVal) {
        const val = decodeURIComponent(encodedVal);
        const sel = document.getElementById('filterClassification');
        if (sel) {
            sel.value = val;
            sel.dispatchEvent(new Event('change'));
        }
        updateCustomClassificationTriggerUI(val);
        toggleClassificationDropdown(false);
    }

    function updateCustomClassificationTriggerUI(val) {
        if (!val) {
            const sel = document.getElementById('filterClassification');
            val = sel ? sel.value : 'All';
        }
        const formatted = formatCrimeClassification(val);
        const titleEl = document.getElementById('classificationTriggerTitle');
        const subEl = document.getElementById('classificationTriggerSubtitle');
        if (titleEl) titleEl.textContent = formatted.shortTitle;
        if (subEl) subEl.textContent = formatted.subtitle || (val === 'All' ? 'All recorded crime incidents' : 'Filtered classification');
    }

    function toggleClassificationDropdown(force) {
        const popover = document.getElementById('classificationDropdownPopover');
        const arrow = document.getElementById('classificationDropdownArrow');
        if (!popover) return;

        const isCurrentlyOpen = !popover.classList.contains('hidden');
        const shouldOpen = typeof force === 'boolean' ? force : !isCurrentlyOpen;

        if (shouldOpen) {
            popover.classList.remove('hidden');
            if (arrow) arrow.style.transform = 'rotate(180deg)';
            const searchInput = document.getElementById('classificationSearchInput');
            if (searchInput) {
                searchInput.value = '';
                filterClassificationSearch('');
                setTimeout(() => searchInput.focus(), 60);
            }
        } else {
            popover.classList.add('hidden');
            if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
    }

    function filterClassificationSearch(query) {
        const q = (query || '').toLowerCase().trim();
        const items = document.querySelectorAll('.classification-option-item');
        items.forEach(el => {
            const text = el.getAttribute('data-search') || '';
            if (!q || text.includes(q)) {
                el.classList.remove('hidden');
            } else {
                el.classList.add('hidden');
            }
        });
    }

    function populateClassificationDropdown() {
        const modeSelect = document.getElementById('mapDisplayMode');
        const mode = modeSelect ? modeSelect.value : 'density';
        let targetCategory = null;
        if (mode === 'density_focus') targetCategory = '8-Focus';
        else if (mode === 'density_nonindex') targetCategory = 'Non-Index';
        else if (mode === 'density_psi') targetCategory = 'PSI';

        const dropdown = document.getElementById('filterClassification');
        if (!dropdown) return;

        const currentVal = dropdown.value || 'All';

        const offenses = new Set();
        currentPoints.forEach(p => {
            const cat = p.category || 'Non-Index';
            if (!targetCategory || cat === targetCategory) {
                if (p.incident_type) {
                    offenses.add(p.incident_type);
                }
            }
        });

        const sorted = Array.from(offenses).sort();

        let html = `<option value="All">All Classifications</option>`;
        sorted.forEach(off => {
            const formatted = formatCrimeClassification(off);
            html += `<option value="${off}" title="${off}" ${off === currentVal ? 'selected' : ''}>${escapeHtml(formatted.shortTitle)}${formatted.subtitle ? ' (' + escapeHtml(formatted.subtitle) + ')' : ''}</option>`;
        });

        dropdown.innerHTML = html;
        dropdown.value = currentVal;

        if (currentVal !== 'All' && !offenses.has(currentVal)) {
            dropdown.value = 'All';
        }

        renderCustomClassificationItems(sorted, dropdown.value);
    }

    function getThematicStyleForFeature(feature) {
        const normalizeBrgyName = (name) => {
            const match = name.match(/Barangay (I{1,3}|IV|V) \(Pob\.\)/);
            if (match) return `Poblacion ${match[1]} (Barangay ${match[1]})`;
            return name;
        };
        const brgyName = normalizeBrgyName(feature.properties.ADM4_EN);
        const brgyPoints = currentPoints.filter(p => p.barangay === brgyName);
        const modeSelect = document.getElementById('mapDisplayMode');
        const mode = modeSelect ? modeSelect.value : 'density';

        let fillColor = 'transparent';
        let weight = 1;
        let fillOpacity = 0;

        if (mode.startsWith('density')) {
            let targetCategory = null;
            if (mode === 'density_focus') targetCategory = '8-Focus';
            else if (mode === 'density_nonindex') targetCategory = 'Non-Index';
            else if (mode === 'density_psi') targetCategory = 'PSI';

            let globalPoints = currentPoints;
            let localBrgyPoints = brgyPoints;

            if (targetCategory) {
                globalPoints = currentPoints.filter(p => (p.category || 'Non-Index') === targetCategory);
                localBrgyPoints = brgyPoints.filter(p => (p.category || 'Non-Index') === targetCategory);
            }

            const selectedClassification = document.getElementById('filterClassification')?.value || 'All';
            if (selectedClassification !== 'All') {
                globalPoints = globalPoints.filter(p => p.incident_type === selectedClassification);
                localBrgyPoints = localBrgyPoints.filter(p => p.incident_type === selectedClassification);
            }

            const allCounts = Object.values(globalPoints.reduce((acc, curr) => {
                acc[curr.barangay] = (acc[curr.barangay] || 0) + 1;
                return acc;
            }, {}));
            const max = Math.max(...allCounts, 1);
            const totalIncidentsLocal = localBrgyPoints.length;

            if (totalIncidentsLocal === 0) {
                fillColor = 'transparent';
                fillOpacity = 0;
                weight = 1.75;
            } else {
                const ratio = totalIncidentsLocal / max;
                if (targetCategory) {
                    if (mode === 'density_focus') {
                        fillColor = '#EF4444'; // Red for 8-Focus
                    } else if (mode === 'density_nonindex') {
                        fillColor = '#3B82F6'; // Blue for Non-Index
                    } else {
                        fillColor = '#D4AF37'; // Gold for PSI
                    }
                    fillOpacity = 0.15 + 0.65 * ratio;
                    weight = 2;
                } else {
                    if (ratio >= 0.75) fillColor = '#EF4444'; // Red (High Crime)
                    else if (ratio >= 0.40) fillColor = '#F97316'; // Orange (Medium-High)
                    else if (ratio >= 0.15) fillColor = '#FBBF24'; // Yellow (Medium-Low)
                    else fillColor = '#10B981'; // Green (Low)

                    fillOpacity = 0.7;
                    weight = 2;
                }
            }
        } else {
            // Clear / No overlay
            weight = 1.75;
            fillOpacity = 0.1;
            fillColor = '#1A3A5C';
        }

        const selected = document.getElementById('filterBarangay').value;
        if (selected && selected !== brgyName) {
            fillOpacity = fillOpacity > 0 ? 0.05 : 0;
            weight = 1.25;
            if (fillColor !== 'transparent') {
                fillColor = 'rgba(15, 23, 42, 0.5)';
            }
        }

        return {
            color: '#C8A415',
            opacity: 1,
            weight: weight,
            fillOpacity: fillOpacity,
            fillColor: fillColor
        };
    }

    function updateBarangayLabels() {
        if (!boundaryLayerGroup || !map) return;
        const currentZoom = map.getZoom();
        boundaryLayerGroup.eachLayer(layer => {
            const feature = layer.feature;
            if (!feature) return;
            let name = feature.properties.ADM4_EN;
            const match = name.match(/Barangay (I{1,3}|IV|V) \(Pob\.\)/);
            if (match) name = `Poblacion ${match[1]} (Barangay ${match[1]})`;

            const newLabel = getBarangayLabel(name, currentZoom);
            layer.setTooltipContent(newLabel);

            const pin = manualPins.find(p => p.name.toLowerCase() === name.toLowerCase());
            if (pin) {
                const tooltip = layer.getTooltip();
                if (tooltip) {
                    tooltip.setLatLng(L.latLng(pin.lat, pin.lng));
                }
            }
        });
    }

    let tooltipVisibilityRaf = null;
    function manageTooltipVisibility() {
        if (!map) return;
        if (tooltipVisibilityRaf) cancelAnimationFrame(tooltipVisibilityRaf);
        tooltipVisibilityRaf = requestAnimationFrame(() => {
            const tooltips = Array.from(document.querySelectorAll('.barangay-label-tooltip'));
            if (tooltips.length === 0) return;
            const selectedBrgy = (document.getElementById('filterBarangay')?.value || '').trim();

            // When a specific barangay is selected, hide all polygon name labels on the map
            // The selected barangay is clearly identified by its gold tactical pin badge!
            if (selectedBrgy) {
                tooltips.forEach(t => {
                    if (t.style.opacity !== '0') {
                        t.style.opacity = '0';
                        t.style.pointerEvents = 'none';
                    }
                });
                return;
            }

            const boxes = [];
            // Prioritize Jasaan so its label is evaluated first and never suppressed
            tooltips.sort((a, b) => {
                const aIsJasaan = (a.textContent || '').toUpperCase().includes('JASAAN');
                const bIsJasaan = (b.textContent || '').toUpperCase().includes('JASAAN');
                if (aIsJasaan && !bIsJasaan) return -1;
                if (!aIsJasaan && bIsJasaan) return 1;
                return 0;
            });

            // 1. Batch read bounding client rects (prevents layout thrashing)
            const items = tooltips.map(t => ({
                el: t,
                rect: t.getBoundingClientRect(),
                isJasaan: (t.textContent || '').toUpperCase().includes('JASAAN')
            }));

            // 2. Batch write styles
            items.forEach(({ el, rect, isJasaan }) => {
                if (rect.width === 0 && rect.height === 0) return;
                let isColliding = false;
                const pad = 2;

                for (let i = 0; i < boxes.length; i++) {
                    const b = boxes[i];
                    if (!(rect.right + pad < b.left ||
                        rect.left - pad > b.right ||
                        rect.bottom + pad < b.top ||
                        rect.top - pad > b.bottom)) {
                        isColliding = true;
                        break;
                    }
                }

                if (isColliding && !isJasaan) {
                    if (el.style.opacity !== '0') {
                        el.style.opacity = '0';
                        el.style.pointerEvents = 'none';
                    }
                } else {
                    if (el.style.opacity !== '1') {
                        el.style.opacity = '1';
                        el.style.pointerEvents = 'auto';
                    }
                    boxes.push(rect);
                }
            });
        });
    }

