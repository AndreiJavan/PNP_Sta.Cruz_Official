    function getBarangayLabel(name, zoom) {
        const pobMatch = name.match(/Poblacion (I{1,3}|IV|V)/);
        if (pobMatch) {
            const romanToNum = { 'I': '1', 'II': '2', 'III': '3', 'IV': '4', 'V': '5' };
            const num = romanToNum[pobMatch[1]];
            if (zoom < 16) {
                return `POB. ${num}`;
            } else {
                return name.replace('Poblacion', 'POB.').replace(' (Barangay ', '\n(BRGY. ').replace(')', '');
            }
        }
        return name.replace('Poblacion', 'POB.').replace(' (Barangay ', '\n(BRGY. ').replace(')', '');
    }

    function getTacticalColor(name) {
        if (!name) return '#ccc';
        const searchName = name.trim().toUpperCase();
        for (const [key, color] of Object.entries(allColors)) {
            if (key.toUpperCase() === searchName) return color;
        }
        for (const [key, color] of Object.entries(allColors)) {
            if (searchName.includes(key.toUpperCase()) || key.toUpperCase().includes(searchName)) return color;
        }
        return '#ccc';
    }

    function getCategoryColor(type, category) {
        if (category === '8-Focus') return '#EF4444'; // Red (Major Crimes)
        if (category === 'Non-Index') return '#3B82F6'; // Blue (Minor Crimes)
        if (category === 'PSI') return '#D4AF37'; // Gold (Public Safety Incident)

        const majorTypes = ['THEFT', 'ROBBERY', 'MURDER', 'HOMICIDE', 'PHYSICAL INJURIES', 'RAPE', 'CARNAPPING', 'VAWC'];
        const psiTypes = ['ACCIDENT', 'FIRE', 'FLOOD', 'EARTHQUAKE', 'LANDSLIDE', 'DISASTER', 'DISTURBANCE', 'EMERGENCY', 'MISSING', 'RESCUE'];
        
        const uType = (type || '').toUpperCase();
        if (majorTypes.some(m => uType.includes(m))) return '#EF4444';
        if (psiTypes.some(p => uType.includes(p))) return '#D4AF37';
        if (type) return '#3B82F6';
        return '#94A3B8';
    }

