    function toggleSidebar() {
        const sidebar = document.getElementById('filterSidebar');
        const toggleBtn = document.getElementById('sidebarToggle');
        const isMobile = window.innerWidth < 768;
        if (!sidebar) return;
        sidebar.dataset.userToggled = 'true';

        const isCurrentlyHidden = sidebar.classList.contains('sidebar-hidden') || !sidebar.classList.contains('sidebar-visible');

        if (isCurrentlyHidden) {
            // Close other sidebar on mobile so they never overlap
            if (isMobile) {
                const incSidebar = document.getElementById('incidentsSidebar');
                if (incSidebar) {
                    incSidebar.classList.add('sidebar-hidden');
                    incSidebar.classList.remove('sidebar-visible');
                }
            }
            sidebar.classList.remove('sidebar-hidden');
            sidebar.classList.add('sidebar-visible');
            if (toggleBtn) {
                toggleBtn.classList.add('opacity-0', 'pointer-events-none');
                toggleBtn.classList.remove('opacity-100', 'pointer-events-auto');
            }

            // Re-render data when sidebar opens
            loadMapPoints(false);
        } else {
            sidebar.classList.add('sidebar-hidden');
            sidebar.classList.remove('sidebar-visible');
            if (toggleBtn) {
                toggleBtn.classList.remove('opacity-0', 'pointer-events-none');
                toggleBtn.classList.add('opacity-100', 'pointer-events-auto');
            }
        }

        updateMobileNavButtons();

        setTimeout(() => {
            if (window.map) {
                window.map.invalidateSize({ pan: false });
                if (!isMobile) recenterStaCruzMap(true);
            }
        }, 350);
    }

