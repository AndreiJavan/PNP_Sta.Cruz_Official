    function recenterStaCruzMap(animate = true) {
        if (!map) return;
        const mapContainer = document.getElementById('map');
        if (mapContainer && !document.getElementById('filterBarangay')?.value) {
            mapContainer.classList.remove('barangay-selected');
        }
        const isMobile = window.innerWidth < 768;
        const isWideDesktop = window.innerWidth >= 1200;
        const leftSidebar = document.getElementById('filterSidebar');
        const rightSidebar = document.getElementById('incidentsSidebar');

        const isLeftOpen = leftSidebar && leftSidebar.classList.contains('sidebar-visible');
        const isRightOpen = rightSidebar && rightSidebar.classList.contains('sidebar-visible');

        let paddingTopLeft = [16, 16];
        let paddingBottomRight = [16, 16];

        if (isMobile) {
            // Keep mobile exactly as-is ("keep the same size in the mobile")
            paddingTopLeft = [16, 16];
            paddingBottomRight = [16, 16];
        } else if (isWideDesktop) {
            // On desktop, allow Santa Cruz to expand significantly closer to sidebars so it appears much bigger and fills the gaps
            paddingTopLeft = [isLeftOpen ? 160 : 30, 10];
            paddingBottomRight = [isRightOpen ? 160 : 30, 10];
        } else {
            paddingTopLeft = [isLeftOpen ? 120 : 20, 10];
            paddingBottomRight = [isRightOpen ? 120 : 20, 10];
        }

        const targetBounds = (boundaryLayerGroup && boundaryLayerGroup.getLayers().length > 0)
            ? boundaryLayerGroup.getBounds()
            : STA_CRUZ_BOUNDS;

        const maxZoomAllowed = isMobile ? 13 : 15;

        if (animate) {
            map.flyToBounds(targetBounds, {
                paddingTopLeft: paddingTopLeft,
                paddingBottomRight: paddingBottomRight,
                maxZoom: maxZoomAllowed,
                duration: 0.8
            });
        } else {
            map.fitBounds(targetBounds, {
                paddingTopLeft: paddingTopLeft,
                paddingBottomRight: paddingBottomRight,
                maxZoom: maxZoomAllowed
            });
        }
    }

    function populateYearDropdowns(points) {
        const years = new Set();
        // Always include the current/present year
        const currentYear = new Date().getFullYear();
        years.add(currentYear);

        points.forEach(p => {
            const pDateStr = p.incident_date || p.date || p.created_at;
            if (pDateStr) {
                const itemDate = new Date(pDateStr);
                if (!isNaN(itemDate.getTime())) {
                    years.add(itemDate.getFullYear());
                }
            }
        });

        // Convert to array and sort descending
        let sortedYears = Array.from(years).sort((a, b) => b - a);

        const filterMonthYear = document.getElementById('filterMonthYear');
        const filterYear = document.getElementById('filterYear');

        if (filterMonthYear) {
            const currentVal = filterMonthYear.value;
            filterMonthYear.innerHTML = sortedYears.map(yr =>
                `<option value="${yr}">${yr}</option>`
            ).join('');
            // Try to restore previous value, otherwise select first option
            if (sortedYears.includes(parseInt(currentVal))) {
                filterMonthYear.value = currentVal;
            } else {
                filterMonthYear.value = currentYear;
                crimeDateSelectedYear = currentYear;
            }
        }

        if (filterYear) {
            const currentVal = filterYear.value;
            filterYear.innerHTML = sortedYears.map(yr =>
                `<option value="${yr}">${yr}</option>`
            ).join('');
            // Try to restore previous value, otherwise select first option
            if (sortedYears.includes(parseInt(currentVal))) {
                filterYear.value = currentVal;
            } else {
                filterYear.value = currentYear;
                crimeDateSelectedYear = currentYear;
            }
        }

        // Restrict calendar pickers dynamically based on available/present years
        const minYear = Math.min(...sortedYears);
        const fromDateInput = document.getElementById('filterFromDate');
        const toDateInput = document.getElementById('filterToDate');
        const todayStr = new Date().toISOString().split('T')[0];

        if (fromDateInput) {
            fromDateInput.setAttribute('min', `${minYear}-01-01`);
            fromDateInput.setAttribute('max', todayStr);
        }
        if (toDateInput) {
            toDateInput.setAttribute('min', `${minYear}-01-01`);
            toDateInput.setAttribute('max', todayStr);
        }
    }

