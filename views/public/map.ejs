    function initMap() {
        try {
            const isMobile = window.innerWidth < 768;
            const initialPadding = [16, 16];

            map = L.map('leafletMap', {
                zoomControl: false,
                dragging: true,
                touchZoom: true,
                doubleClickZoom: true,
                scrollWheelZoom: true,
                boxZoom: true,
                keyboard: true,
                attributionControl: false,
                zoomSnap: isMobile ? 1 : 0.1, // Smooth fractional zoom on PC so Santa Cruz scales up to fill the screen
                zoomDelta: isMobile ? 1 : 0.5,
                minZoom: isMobile ? 11 : 12,
                maxZoom: 18,
                maxBounds: STA_CRUZ_MAX_BOUNDS,
                maxBoundsViscosity: isMobile ? 0.2 : 0.5,
                inertia: true,
                inertiaDeceleration: 3000,
                inertiaMaxSpeed: 1800,
                fadeAnimation: true,
                zoomAnimation: true
            }).fitBounds(STA_CRUZ_BOUNDS, { padding: initialPadding, maxZoom: isMobile ? 13 : 15 });

            window.map = map;

            const isDarkMap = document.documentElement.classList.contains('dark');
            const tileLayerUrl = isDarkMap
                ? 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}'
                : 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}';

            currentTileLayer = L.tileLayer(tileLayerUrl, {
                maxZoom: 18,
                maxNativeZoom: 16,
                attribution: 'Tiles &copy; <a href="https://www.esri.com/">Esri</a>'
            }).addTo(map);

            // Initialize incident markers layer
            incidentMarkers.addTo(map);
            selectedPinsLayer.addTo(map);
            policeStationsLayer.addTo(map);

            loadMapPoints();
            addPoliceStations();

            // Load Barangay GeoJSON
            fetch(barangayGeoJsonUrl)
                .then(res => {
                    if (!res.ok) throw new Error('Network response was not ok');
                    return res.json();
                })
                .then(data => {
                    santaCruzGeoJSON = data;

                    // --- APPLY INVERTED MASK SO ONLY STA. CRUZ LAGUNA IS VISIBLE ---
                    const worldRing = [[180, 90], [180, -90], [-180, -90], [-180, 90], [180, 90]];
                    let maskCoords = [worldRing];
                    data.features.forEach(f => {
                        if (f.geometry && f.geometry.type === 'Polygon') {
                            maskCoords.push(f.geometry.coordinates[0]);
                        } else if (f.geometry && f.geometry.type === 'MultiPolygon') {
                            f.geometry.coordinates.forEach(poly => maskCoords.push(poly[0]));
                        }
                    });

                    const isDark = document.documentElement.classList.contains('dark');
                    L.geoJSON({ type: 'Feature', geometry: { type: 'Polygon', coordinates: maskCoords } }, {
                        style: {
                            fillColor: isDark ? '#0f172a' : '#f8fafc',
                            fillOpacity: 1,
                            color: 'transparent',
                            weight: 0,
                            className: 'map-outside-mask-solid'
                        }, interactive: false
                    }).addTo(map);

                    const observer = new MutationObserver(() => {
                        const dark = document.documentElement.classList.contains('dark');
                        document.querySelectorAll('.map-outside-mask-solid').forEach(el => el.setAttribute('fill', dark ? '#0f172a' : '#f8fafc'));
                        if (currentTileLayer) {
                            const newUrl = dark
                                ? 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}'
                                : 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}';
                            currentTileLayer.options.maxNativeZoom = 16;
                            currentTileLayer.setUrl(newUrl);
                        }
                    });
                    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
                    // ---------------------------------------------------------

                    boundaryLayerGroup = L.geoJSON(data, {
                        style: function (feature) {
                            return getThematicStyleForFeature(feature);
                        },
                        onEachFeature: function (feature, layer) {
                            let name = feature.properties.ADM4_EN;
                            // Helper to normalize Poblacion names to match manualPins
                            const match = name.match(/Barangay (I{1,3}|IV|V) \(Pob\.\)/);
                            if (match) {
                                name = `Poblacion ${match[1]} (Barangay ${match[1]})`;
                            }

                            // Anchor each barangay explicitly to its verified true polygon centroid
                            const pin = manualPins.find(p => p.name.toLowerCase() === name.toLowerCase());
                            if (pin) {
                                layer.getCenter = function () {
                                    return L.latLng(pin.lat, pin.lng);
                                };
                            }

                            const displayName = getBarangayLabel(name, map.getZoom());

                            layer.bindTooltip(displayName, {
                                permanent: true,
                                direction: 'center',
                                className: 'barangay-label-tooltip',
                                opacity: 1,
                                interactive: false
                            });

                            if (pin) {
                                const tooltip = layer.getTooltip();
                                if (tooltip) {
                                    tooltip.setLatLng(L.latLng(pin.lat, pin.lng));
                                }
                            }

                            layer.on({
                                mouseover: function (e) {
                                    const layer = e.target;
                                    layer.setStyle({
                                        fillOpacity: 0.8,
                                        weight: 3,
                                        color: '#FFFFFF'
                                    });
                                },
                                mouseout: function (e) {
                                    const layer = e.target;
                                    layer.setStyle(getThematicStyleForFeature(feature));
                                },
                                click: function (e) {
                                    const barangaySelect = document.getElementById('filterBarangay');
                                    if (barangaySelect) {
                                        barangaySelect.value = name;
                                        loadMapPoints(false); // Update stats without relocating yet
                                        locateBarangay(); // Now do the fancy locate animation
                                    }
                                }
                            });
                        }
                    }).addTo(map);

                    // Perfectly center Sta. Cruz with responsive padding for both PC and mobile
                    recenterStaCruzMap(false);

                    // Seamlessly hide loading overlay once map and boundaries are ready
                    hideLoading();
                    setTimeout(manageTooltipVisibility, 100);
                })
                .catch(err => {
                    console.error('Error loading GeoJSON:', err);
                    hideLoading();
                });

            map.on('zoomend', () => {
                updateBarangayLabels();
                setTimeout(manageTooltipVisibility, 50);
            });
            map.on('resize', () => {
                setTimeout(manageTooltipVisibility, 50);
            });

            // Tap map to dismiss active mobile drawer for seamless navigation
            map.on('click', () => {
                if (window.innerWidth < 768) {
                    const filterSidebar = document.getElementById('filterSidebar');
                    const incidentsSidebar = document.getElementById('incidentsSidebar');
                    let changed = false;
                    if (filterSidebar && filterSidebar.classList.contains('sidebar-visible')) {
                        filterSidebar.classList.add('sidebar-hidden');
                        filterSidebar.classList.remove('sidebar-visible');
                        changed = true;
                    }
                    if (incidentsSidebar && incidentsSidebar.classList.contains('sidebar-visible')) {
                        incidentsSidebar.classList.add('sidebar-hidden');
                        incidentsSidebar.classList.remove('sidebar-visible');
                        changed = true;
                    }
                    if (changed) updateMobileNavButtons();
                }
            });
        } catch (err) {
            console.error('Error initializing map:', err);
            hideLoading();
        }
    }

