        setTimeout(() => {
            if (window.map) {
                window.map.invalidateSize({ pan: false });
                if (!isMobile) recenterStaCruzMap(true);
            }
        }, 350);
    }

    document.addEventListener('DOMContentLoaded', () => {
        initMap();

        // Prefill default custom range picker dates
        const currentYear = new Date().getFullYear();
        const fromDateInput = document.getElementById('filterFromDate');
        const toDateInput = document.getElementById('filterToDate');
        const todayStr = new Date().toISOString().split('T')[0];
        if (fromDateInput) {
            fromDateInput.value = `${currentYear}-01-01`;
            fromDateInput.setAttribute('max', todayStr);
        }
        if (toDateInput) {
            toDateInput.value = todayStr;
            toDateInput.setAttribute('max', todayStr);
        }

        // Initialize display badge text
        updateActivePeriodDisplay();

        // Sync sidebar and toggle buttons according to screen width
        function syncResponsiveSidebarState() {
            const isMobile = window.innerWidth < 768;
            const filterSidebar = document.getElementById('filterSidebar');
            const incidentsSidebar = document.getElementById('incidentsSidebar');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const incidentsToggle = document.getElementById('incidentsToggle');

            if (isMobile) {
                // On mobile, keep the Filter/Location Overview layout visible by default so user can filter data immediately
                if (!filterSidebar?.dataset.userToggled) {
                    filterSidebar?.classList.remove('sidebar-hidden');
                    filterSidebar?.classList.add('sidebar-visible');
                }
                if (!incidentsSidebar?.dataset.userToggled) {
                    incidentsSidebar?.classList.add('sidebar-hidden');
                    incidentsSidebar?.classList.remove('sidebar-visible');
                }
                sidebarToggle?.classList.add('opacity-0', 'pointer-events-none');
                incidentsToggle?.classList.add('opacity-0', 'pointer-events-none');
                updateMobileNavButtons();
            } else {
                // On desktop, keep sidebars visible by default
                if (!filterSidebar?.dataset.userToggled) {
                    filterSidebar?.classList.remove('sidebar-hidden');
                    filterSidebar?.classList.add('sidebar-visible');
                    sidebarToggle?.classList.add('opacity-0', 'pointer-events-none');
                    sidebarToggle?.classList.remove('opacity-100', 'pointer-events-auto');
                }
                if (!incidentsSidebar?.dataset.userToggled) {
                    incidentsSidebar?.classList.remove('sidebar-hidden');
                    incidentsSidebar?.classList.add('sidebar-visible');
                    incidentsToggle?.classList.add('opacity-0', 'pointer-events-none');
                    incidentsToggle?.classList.remove('opacity-100', 'pointer-events-auto');
                }
            }
        }

        syncResponsiveSidebarState();
        window.addEventListener('resize', () => {
            syncResponsiveSidebarState();
            recenterStaCruzMap(false);
        });

        // Robust event listeners for all map filters
        const setupListener = (id, callback) => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', callback);
                el.addEventListener('input', callback); // Catch changes faster in some browsers
            }
        };

        setupListener('crimeDateMode', () => onCrimeDateModeChange());
        setupListener('filterMonth', () => applyCrimeDateFilter(false));
        setupListener('filterMonthYear', () => applyCrimeDateFilter(false));
        setupListener('filterYear', () => applyCrimeDateFilter(false));
        setupListener('filterFromDate', () => applyCrimeDateFilter(false));
        setupListener('filterToDate', () => applyCrimeDateFilter(false));

        setupListener('mapDisplayMode', () => {
            updateHeatmap();
            updateLegend();
            loadMapPoints(false);
        });

        setupListener('filterClassification', () => {
            updateHeatmap();
            updateLegend();
            loadMapPoints(false);
        });

        setupListener('filterBarangay', () => loadMapPoints());

        // Close classification popover when clicking outside
        document.addEventListener('click', (e) => {
            const container = document.getElementById('classificationDropdownContainer');
            if (container && !container.contains(e.target)) {
                toggleClassificationDropdown(false);
            }
        });
    });
</script>

