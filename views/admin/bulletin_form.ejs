                    <button type="button" onclick="removeMediaGalleryItem(${idx}, event)"
                        class="pointer-events-auto w-8 h-8 rounded-lg bg-red-600 hover:bg-red-700 text-white shadow-lg flex items-center justify-center transition-all hover:scale-110 active:scale-95 cursor-pointer border border-red-500/30"
