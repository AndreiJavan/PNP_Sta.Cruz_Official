                class="px-5 py-3 rounded-xl bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider transition cursor-pointer">
                Cancel
            </button>
            <button type="button" id="finalConfirmBtn" onclick="executeFinalSubmit()"
                class="px-8 py-3 rounded-xl bg-pnp-blue hover:bg-pnp-gold text-white hover:text-pnp-blue text-xs font-black uppercase tracking-wider shadow-lg transition-all flex items-center space-x-2 cursor-pointer">
                <i class="fas fa-check"></i>
                <span id="finalConfirmBtnText"><%= bulletin ? 'Yes, Confirm & Update' : 'Yes, Confirm & Publish' %></span>
            </button>
