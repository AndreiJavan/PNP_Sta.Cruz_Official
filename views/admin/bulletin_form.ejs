                            <span id="errorDetectorStatusBadge" class="text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500 text-white shadow-sm">READY TO UPDATE</span>
                        </div>
                        <p id="errorDetectorText" class="text-xs font-bold mt-0.5 leading-snug truncate">All parameters verified and compliant.</p>
                    </div>
                </div>

                <!-- SUBMIT BUTTON -->
                <div class="w-full md:w-auto shrink-0 flex items-center space-x-3">
                    <a href="<%= typeof isPublic !== 'undefined' && isPublic ? '/bulletins' : '/admin/bulletins' %>"
                        class="w-full md:w-auto px-6 py-4 rounded-2xl bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider transition text-center">
                        Cancel
                    </a>
                    <button type="submit" id="submitBulletinBtn"
                        class="w-full md:w-auto bg-pnp-blue text-white font-black py-4 px-10 rounded-2xl shadow-xl transition-all duration-300 hover:bg-blue-900 uppercase tracking-widest text-xs flex items-center justify-center space-x-2 cursor-pointer">
