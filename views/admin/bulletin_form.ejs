<script>
    // State management
    let currentPublishType = 'advisory';
    let mediaItems = [];
    let currentSlide = 0;

    // Load bulletin data
    const isEditMode = <%= bulletin ? 'true' : 'false' %>;
    const initialFbUrl = '<%= bulletin ? (bulletin.facebook_url || bulletin.facebook_post_url || "") : "" %>';
    const initialCategory = '<%= bulletin ? (bulletin.category || "") : "" %>';

    // Parse initial media files
    <% 
        function resolveMediaList(pathsVal, singleVal) {
            let list = [];
            if (Array.isArray(pathsVal)) {
                list = pathsVal;
            } else if (singleVal) {
                if (Array.isArray(singleVal)) {
                    list = singleVal;
                } else if (typeof singleVal === 'string') {
                    const trimmed = singleVal.trim();
                    if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
                        try {
                            const parsed = JSON.parse(trimmed);
                            if (Array.isArray(parsed)) list = parsed;
                        } catch (e) {
                            try {
                                const sanitized = trimmed.replace(/'/g, '"');
                                const parsed = JSON.parse(sanitized);
                                if (Array.isArray(parsed)) list = parsed;
                            } catch (e2) {}
                        }
                    }
                    if (list.length === 0 && trimmed.length > 0 && trimmed !== '[]' && trimmed !== '""' && trimmed !== 'null') {
                        list = [trimmed];
                    }
                }
            }
            return list.map(item => {
                if (!item) return '';
                let s = typeof item === 'string' ? item : (item.url || item.path || '');
                s = s.trim().replace(/^["']|["']$/g, '');
                return s;
            }).filter(s => s && s.length > 0 && s !== '[]' && !s.startsWith('['));
        }

        let initPhotos = [];
        let initVideos = [];
        if (bulletin) {
            initPhotos = resolveMediaList(bulletin.photo_paths, bulletin.photo_path);
            initVideos = resolveMediaList(bulletin.video_paths, bulletin.video_path);
        }
    %>
    const serverPhotos = <%- JSON.stringify(initPhotos) %>;
    const serverVideos = <%- JSON.stringify(initVideos) %>;

    function formatMediaUrl(rawPath) {
        if (!rawPath) return '';
        let clean = String(rawPath).trim().replace(/^["']|["']$/g, '');
        if (clean.startsWith('http://') || clean.startsWith('https://') || clean.startsWith('blob:') || clean.startsWith('data:')) {
            return clean;
        }
        if (!clean.startsWith('/')) {
            return '/' + clean;
        }
        return clean;
    }

    // Initialize media from server
    serverPhotos.forEach((p, idx) => {
        if (!p || p === '[]' || p.startsWith('[')) return;
        const normalizedUrl = formatMediaUrl(p);
        const filename = normalizedUrl.split('/').pop() || `Photo ${idx + 1}`;
        mediaItems.push({
            id: 'existing-photo-' + idx,
            type: 'image',
            url: normalizedUrl,
            path: p,
            name: filename,
            size: 0,
            isExisting: true
        });
    });

    serverVideos.forEach((v, idx) => {
        if (!v || v === '[]' || v.startsWith('[')) return;
        const normalizedUrl = formatMediaUrl(v);
        const filename = normalizedUrl.split('/').pop() || `Video ${idx + 1}`;
        mediaItems.push({
            id: 'existing-video-' + idx,
            type: 'video',
            url: normalizedUrl,
            path: v,
            name: filename,
            size: 0,
            isExisting: true
        });
    });

    // Determine initial publication type
    function detectInitialType() {
        if (initialFbUrl && initialFbUrl.trim().length > 0) {
            return 'url';
        } else if (initialCategory === 'General Announcement') {
            return 'news';
        } else {
            return 'advisory';
        }
    }

    // Switch publication type (Advisory, News, URL)
    function switchPublicationType(type) {
        currentPublishType = type;
        const publishTypeInput = document.getElementById('publishTypeInput');
        if (publishTypeInput) publishTypeInput.value = type;

        const manualPanel = document.getElementById('manualPublishPanel');
        const urlPanel = document.getElementById('urlPublishPanel');
        const activeTypeTag = document.getElementById('activeTypeTag');

        const btnAdvisory = document.getElementById('typeBtnAdvisory');
        const btnNews = document.getElementById('typeBtnNews');
        const btnUrl = document.getElementById('typeBtnUrl');

        const advisorySelect = document.getElementById('categorySelectAdvisory');
        const newsBadge = document.getElementById('categoryNewsBadge');

        // Reset all cards styling
        [btnAdvisory, btnNews, btnUrl].forEach(btn => {
            if (!btn) return;
            btn.className = 'pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-gray-50/60 dark:bg-slate-800/40 border-gray-200 dark:border-slate-800';
            const indicator = btn.querySelector('.pub-type-indicator');
            if (indicator) indicator.classList.add('hidden');
        });

        // Set active card styling
        if (type === 'advisory') {
            if (btnAdvisory) {
                btnAdvisory.className = 'pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-white dark:bg-slate-900 border-amber-500 shadow-md ring-2 ring-amber-500/20';
                const indicator = btnAdvisory.querySelector('.pub-type-indicator');
                if (indicator) indicator.classList.remove('hidden');
            }
            if (activeTypeTag) {
                activeTypeTag.textContent = 'Public Advisory';
                activeTypeTag.className = 'px-3 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/10 text-amber-500 border border-amber-500/20';
            }
            if (manualPanel) manualPanel.classList.remove('hidden');
            if (urlPanel) urlPanel.classList.add('hidden');

            if (advisorySelect) {
                advisorySelect.classList.remove('hidden');
                advisorySelect.name = 'category';
                advisorySelect.disabled = false;
            }
            if (newsBadge) newsBadge.classList.add('hidden');
            removeHiddenCategoryInput();

            // Set input requirements
            const titleInput = document.getElementById('titleInput');
            const bodyInput = document.getElementById('bodyInput');
            const fbInput = document.getElementById('facebookUrlInput');
            if (titleInput) { titleInput.required = true; titleInput.name = 'title'; }
            if (bodyInput) { bodyInput.required = true; bodyInput.name = 'body'; }
            if (fbInput) { fbInput.required = false; }

        } else if (type === 'news') {
            if (btnNews) {
                btnNews.className = 'pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-white dark:bg-slate-900 border-pnp-blue dark:border-pnp-gold shadow-md ring-2 ring-pnp-blue/20 dark:ring-pnp-gold/20';
                const indicator = btnNews.querySelector('.pub-type-indicator');
                if (indicator) indicator.classList.remove('hidden');
            }
            if (activeTypeTag) {
                activeTypeTag.textContent = 'News & Release';
                activeTypeTag.className = 'px-3 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-pnp-blue/10 text-pnp-blue dark:text-blue-300 border border-pnp-blue/20';
            }
            if (manualPanel) manualPanel.classList.remove('hidden');
            if (urlPanel) urlPanel.classList.add('hidden');

            if (advisorySelect) {
                advisorySelect.classList.add('hidden');
                advisorySelect.name = 'category_inactive';
                advisorySelect.disabled = true;
            }
            if (newsBadge) newsBadge.classList.remove('hidden');
            setHiddenCategoryInput('General Announcement');

            // Set input requirements
            const titleInput = document.getElementById('titleInput');
            const bodyInput = document.getElementById('bodyInput');
            const fbInput = document.getElementById('facebookUrlInput');
            if (titleInput) { titleInput.required = true; titleInput.name = 'title'; }
            if (bodyInput) { bodyInput.required = true; bodyInput.name = 'body'; }
            if (fbInput) { fbInput.required = false; }

        } else if (type === 'url') {
            if (btnUrl) {
                btnUrl.className = 'pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-white dark:bg-slate-900 border-[#1877F2] shadow-md ring-2 ring-[#1877F2]/20';
                const indicator = btnUrl.querySelector('.pub-type-indicator');
                if (indicator) indicator.classList.remove('hidden');
            }
            if (activeTypeTag) {
                activeTypeTag.textContent = 'URL Post';
                activeTypeTag.className = 'px-3 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-[#1877F2]/10 text-[#1877F2] border border-[#1877F2]/20';
            }
            if (manualPanel) manualPanel.classList.add('hidden');
            if (urlPanel) urlPanel.classList.remove('hidden');

            if (advisorySelect) {
                advisorySelect.classList.add('hidden');
                advisorySelect.name = 'category_inactive';
                advisorySelect.disabled = true;
            }
            if (newsBadge) newsBadge.classList.add('hidden');
            setHiddenCategoryInput('General Announcement');

            // Set input requirements
            const titleInput = document.getElementById('titleInput');
            const bodyInput = document.getElementById('bodyInput');
            const fbInput = document.getElementById('facebookUrlInput');
            if (titleInput) { titleInput.required = false; titleInput.name = 'title_inactive'; }
            if (bodyInput) { bodyInput.required = false; bodyInput.name = 'body_inactive'; }
            if (fbInput) { fbInput.required = true; }

            // Sync URL fields from title/body if needed
            const urlTitleInput = document.getElementById('urlTitleInput');
            const urlBodyInput = document.getElementById('urlBodyInput');
            if (urlTitleInput && !urlTitleInput.value && titleInput && titleInput.value) {
                urlTitleInput.value = titleInput.value;
            }
            if (urlBodyInput && !urlBodyInput.value && bodyInput && bodyInput.value) {
                urlBodyInput.value = bodyInput.value;
            }

            if (fbInput && fbInput.value) {
                handleFacebookUrlInput(fbInput.value);
            }
        }

        updateValidationState();
    }

    function setHiddenCategoryInput(cat) {
        let el = document.getElementById('hiddenCategoryVal');
        if (!el) {
            el = document.createElement('input');
            el.type = 'hidden';
            el.id = 'hiddenCategoryVal';
            document.getElementById('bulletinForm').appendChild(el);
        }
        el.name = 'category';
        el.value = cat;
        el.disabled = false;
    }

    function removeHiddenCategoryInput() {
        const el = document.getElementById('hiddenCategoryVal');
        if (el) {
            el.disabled = true;
            el.name = 'category_inactive';
        }
    }

    // Media Handling (Drag & Drop, Selection, Client Validation, Max 10 Files)
    function handleMediaFileSelect(files) {
        if (!files || files.length === 0) return;

        let rejected = [];
        let videoPromises = [];

        Array.from(files).forEach(file => {
            if (mediaItems.length + videoPromises.length >= 10) {
                rejected.push(`"${file.name}" (Limit reached: Maximum 10 media files combined)`);
                return;
            }

            if (file.type.startsWith('image/')) {
                if (file.size > 5 * 1024 * 1024) {
                    rejected.push(`Image "${file.name}" (${(file.size / (1024 * 1024)).toFixed(1)}MB exceeds 5MB limit)`);
                } else {
                    const url = URL.createObjectURL(file);
                    mediaItems.push({
                        id: Date.now() + Math.random(),
                        file: file,
                        type: 'image',
                        url: url,
                        name: file.name,
                        size: file.size,
                        isExisting: false
                    });
                }
            } else if (file.type.startsWith('video/')) {
                if (file.size > 25 * 1024 * 1024) {
                    rejected.push(`Video "${file.name}" (${(file.size / (1024 * 1024)).toFixed(1)}MB exceeds 25MB limit)`);
                } else {
                    const p = new Promise(resolve => {
                        const tempVid = document.createElement('video');
                        tempVid.preload = 'metadata';
                        tempVid.src = URL.createObjectURL(file);
                        tempVid.onloadedmetadata = function() {
                            if (tempVid.duration > 180) { // 3 minutes limit
                                URL.revokeObjectURL(tempVid.src);
                                rejected.push(`Video "${file.name}" (${(tempVid.duration / 60).toFixed(1)} mins long - Movie clips exceeding 3 minutes are prohibited)`);
                            } else {
                                mediaItems.push({
                                    id: Date.now() + Math.random(),
                                    file: file,
                                    type: 'video',
                                    url: tempVid.src,
                                    name: file.name,
                                    size: file.size,
                                    duration: tempVid.duration,
                                    isExisting: false
                                });
                            }
                            resolve();
                        };
                        tempVid.onerror = function() {
                            URL.revokeObjectURL(tempVid.src);
                            rejected.push(`Video "${file.name}" (Corrupted or unsupported video format)`);
                            resolve();
                        };
                    });
                    videoPromises.push(p);
                }
            }
        });

        Promise.all(videoPromises).then(() => {
            if (rejected.length > 0) {
                alert(`Upload Notice:\n• ` + rejected.join('\n• '));
            }

            if (mediaItems.length > 0) {
                currentSlide = mediaItems.length - 1;
            }

            syncMediaInputs();
            renderCarousel();
            renderMediaGalleryGrid();
            updateValidationState();

            const input = document.getElementById('mediaFileInput');
            if (input) input.value = '';
        });
    }

    // Drag and Drop listeners
    const dropZone = document.getElementById('mediaDropZone');
    if (dropZone) {
        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('ring-2', 'ring-pnp-blue');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('ring-2', 'ring-pnp-blue');
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('ring-2', 'ring-pnp-blue');
            handleMediaFileSelect(e.dataTransfer.files);
        });
    }

    // Sync HTML inputs (DataTransfer for new files, JSON string for existing)
    function syncMediaInputs() {
        const photosInput = document.getElementById('photosInput');
        const videosInput = document.getElementById('videosInput');
        const existingPhotosInput = document.getElementById('existing_photos_input');
        const existingVideosInput = document.getElementById('existing_videos_input');

        const dtPhotos = new DataTransfer();
        const dtVideos = new DataTransfer();
        const remainingExistingPhotos = [];
        const remainingExistingVideos = [];

        mediaItems.forEach(item => {
            if (item.isExisting) {
                if (item.type === 'image') remainingExistingPhotos.push(item.path);
                else if (item.type === 'video') remainingExistingVideos.push(item.path);
            } else if (item.file) {
                if (item.type === 'image') dtPhotos.items.add(item.file);
                else if (item.type === 'video') dtVideos.items.add(item.file);
            }
        });

        if (photosInput) photosInput.files = dtPhotos.files;
        if (videosInput) videosInput.files = dtVideos.files;
        if (existingPhotosInput) existingPhotosInput.value = JSON.stringify(remainingExistingPhotos);
        if (existingVideosInput) existingVideosInput.value = JSON.stringify(remainingExistingVideos);
    }

    // Carousel Rendering & Navigation
    function renderCarousel() {
        const previewBox = document.getElementById('mediaPreviewBox');
        const placeholder = document.getElementById('mediaPlaceholder');
        const img = document.getElementById('previewImg');
        const vid = document.getElementById('previewVid');
        const badge = document.getElementById('carouselBadge');
        const dotsContainer = document.getElementById('carouselDots');
        const infoEl = document.getElementById('carouselInfo');
        const prevBtn = document.getElementById('prevSlideBtn');
        const nextBtn = document.getElementById('nextSlideBtn');
        const clearBtn = document.getElementById('clearAllMediaBtn');
        const addBtnText = document.getElementById('addMediaBtnText');
        const addBtn = document.getElementById('addMediaBtn');
        const viewGalleryBtn = document.getElementById('viewGalleryBtn');
        const galleryBtnCount = document.getElementById('galleryBtnCount');
        const quickGalleryLink = document.getElementById('quickGalleryLink');

        if (mediaItems.length === 0) {
            if (previewBox) previewBox.classList.add('hidden');
            if (placeholder) placeholder.classList.remove('hidden');
            if (clearBtn) clearBtn.classList.add('hidden');
            if (viewGalleryBtn) viewGalleryBtn.classList.add('hidden');
            if (quickGalleryLink) quickGalleryLink.classList.add('hidden');
            if (addBtnText) addBtnText.textContent = 'Choose / Add Media Files';
            if (addBtn) addBtn.disabled = false;
            renderThumbnailsStrip();
            return;
        }

        if (placeholder) placeholder.classList.add('hidden');
        if (previewBox) previewBox.classList.remove('hidden');
        if (clearBtn) clearBtn.classList.remove('hidden');
        if (viewGalleryBtn) {
            viewGalleryBtn.classList.remove('hidden');
            if (galleryBtnCount) galleryBtnCount.textContent = mediaItems.length;
        }
        if (quickGalleryLink) quickGalleryLink.classList.remove('hidden');

        if (currentSlide >= mediaItems.length) {
            currentSlide = Math.max(0, mediaItems.length - 1);
        }

        const currentItem = mediaItems[currentSlide];

        if (currentItem.type === 'image') {
            if (vid) { vid.classList.add('hidden'); vid.pause(); }
            if (img) { img.src = currentItem.url; img.classList.remove('hidden'); }
        } else {
            if (img) img.classList.add('hidden');
            if (vid) { vid.src = currentItem.url; vid.classList.remove('hidden'); }
        }

        if (badge) {
            const icon = currentItem.type === 'image' ? '<i class="fas fa-image text-emerald-400 mr-1.5"></i>' : '<i class="fas fa-film text-amber-400 mr-1.5"></i>';
            badge.innerHTML = `${icon}<span>${currentItem.type.toUpperCase()} (${currentSlide + 1}/${mediaItems.length})</span>`;
        }

        if (infoEl) {
            if (currentItem.isExisting) {
                infoEl.textContent = `${currentItem.name} (Attached Media)`;
            } else {
                const sizeMB = (currentItem.size / (1024 * 1024)).toFixed(1);
                const durText = currentItem.duration ? ` • ${Math.round(currentItem.duration)}s clip` : '';
                infoEl.textContent = `${currentItem.name} (${sizeMB} MB${durText})`;
            }
        }

        if (mediaItems.length > 1) {
            if (prevBtn) prevBtn.classList.remove('hidden');
            if (nextBtn) nextBtn.classList.remove('hidden');
        } else {
            if (prevBtn) prevBtn.classList.add('hidden');
            if (nextBtn) nextBtn.classList.add('hidden');
        }

        if (dotsContainer) {
            if (mediaItems.length > 1) {
                dotsContainer.innerHTML = mediaItems.map((_, idx) => `
                    <button type="button" onclick="goToSlide(${idx}, event)" class="h-2 rounded-full transition-all cursor-pointer ${idx === currentSlide ? 'bg-pnp-blue dark:bg-pnp-gold w-6' : 'bg-gray-300 dark:bg-slate-700 hover:bg-gray-400 w-2'}" title="Slide ${idx + 1}"></button>
                `).join('');
                dotsContainer.classList.remove('hidden');
            } else {
                dotsContainer.innerHTML = '';
                dotsContainer.classList.add('hidden');
            }
        }

        if (addBtnText) {
            if (mediaItems.length >= 10) {
                addBtnText.textContent = 'Limit Reached (10/10 Files)';
                if (addBtn) addBtn.disabled = true;
            } else {
                addBtnText.textContent = `Add Media (${mediaItems.length}/10)`;
                if (addBtn) addBtn.disabled = false;
            }
        }

        renderThumbnailsStrip();
    }

    // Render Inline Thumbnails Strip under carousel
    function renderThumbnailsStrip() {
        const strip = document.getElementById('thumbnailsStrip');
        if (!strip) return;

        if (mediaItems.length === 0) {
            strip.innerHTML = '';
            strip.classList.add('hidden');
            return;
        }

        strip.classList.remove('hidden');
        strip.innerHTML = mediaItems.map((item, idx) => `
            <div onclick="goToSlide(${idx}, event)" class="relative shrink-0 w-14 h-14 rounded-lg overflow-hidden border-2 cursor-pointer transition-all duration-200 group ${idx === currentSlide ? 'border-pnp-blue ring-2 ring-pnp-blue/30 scale-105' : 'border-gray-200 dark:border-slate-700 opacity-70 hover:opacity-100'}">
                ${item.type === 'image' 
                    ? `<img src="${item.url}" class="w-full h-full object-cover">` 
                    : `<div class="w-full h-full bg-slate-900 flex items-center justify-center text-white"><i class="fas fa-play text-[10px]"></i></div>`}
                <button type="button" onclick="removeMediaGalleryItem(${idx}, event)" class="absolute top-0.5 right-0.5 w-4 h-4 bg-red-600 hover:bg-red-700 text-white rounded text-[8px] flex items-center justify-center shadow opacity-0 group-hover:opacity-100 transition" title="Delete file">
                    <i class="fas fa-trash-alt"></i>
                </button>
                <span class="absolute bottom-0.5 left-0.5 px-1 py-0.2 bg-black/70 text-white text-[7px] font-bold uppercase rounded">
                    ${idx + 1}
                </span>
            </div>
        `).join('');
    }

    function trashCurrentMediaItem(e) {
        if (e) e.stopPropagation();
        if (mediaItems.length === 0) return;

        const removed = mediaItems[currentSlide];
        if (removed && removed.url && !removed.isExisting && String(removed.url).startsWith('blob:')) {
            URL.revokeObjectURL(removed.url);
        }

        mediaItems.splice(currentSlide, 1);
        if (currentSlide >= mediaItems.length) {
            currentSlide = Math.max(0, mediaItems.length - 1);
        }

        syncMediaInputs();
        renderCarousel();
        renderMediaGalleryGrid();
        updateValidationState();
    }

    function removeMediaGalleryItem(idx, e) {
        if (e) e.stopPropagation();
        if (idx < 0 || idx >= mediaItems.length) return;

        const removed = mediaItems[idx];
        if (removed && removed.url && !removed.isExisting && String(removed.url).startsWith('blob:')) {
            URL.revokeObjectURL(removed.url);
        }

        mediaItems.splice(idx, 1);
        if (currentSlide >= mediaItems.length) {
            currentSlide = Math.max(0, mediaItems.length - 1);
        }

        syncMediaInputs();
        renderCarousel();
        renderMediaGalleryGrid();
        updateValidationState();
    }

    function navigateCarousel(dir, e) {
        if (e) e.stopPropagation();
        if (mediaItems.length <= 1) return;
        currentSlide = (currentSlide + dir + mediaItems.length) % mediaItems.length;
        renderCarousel();
    }

    function goToSlide(idx, e) {
        if (e) e.stopPropagation();
        currentSlide = idx;
        renderCarousel();
    }

    function clearAllMedia() {
        mediaItems.forEach(item => {
            if (item.url && !item.isExisting && String(item.url).startsWith('blob:')) {
                URL.revokeObjectURL(item.url);
            }
        });
        mediaItems = [];
        currentSlide = 0;

        const photosInput = document.getElementById('photosInput');
        const videosInput = document.getElementById('videosInput');
        const mediaInput = document.getElementById('mediaFileInput');
        const existingPhotosInput = document.getElementById('existing_photos_input');
        const existingVideosInput = document.getElementById('existing_videos_input');

        if (photosInput) photosInput.value = '';
        if (videosInput) videosInput.value = '';
        if (mediaInput) mediaInput.value = '';
        if (existingPhotosInput) existingPhotosInput.value = '[]';
        if (existingVideosInput) existingVideosInput.value = '[]';

        renderCarousel();
        renderMediaGalleryGrid();
        updateValidationState();
        closeMediaGalleryModal();
    }

    // Media Gallery Modal functions (View all pictures & videos in one container)
    function openMediaGalleryModal() {
        const modal = document.getElementById('mediaGalleryModal');
        if (!modal) return;
        renderMediaGalleryGrid();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeMediaGalleryModal() {
        const modal = document.getElementById('mediaGalleryModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

