                <!-- Thumbnail Area -->
                <div class="w-full h-full flex items-center justify-center overflow-hidden bg-black/40 cursor-pointer" onclick="openFullscreenMediaByIndex(${idx})">
                    ${item.type === 'image' 
                        ? `<img src="${item.url}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">`
                        : `<video src="${item.url}" class="w-full h-full object-cover"></video>`}
