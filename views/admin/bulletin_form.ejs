                        <i class="${item.type === 'image' ? 'fas fa-image' : 'fas fa-film'} mr-1"></i>${item.type}
                    </span>
                    <span class="pointer-events-auto px-2 py-0.5 bg-black/70 backdrop-blur-md rounded-md text-[8px] font-bold text-slate-300 truncate max-w-[90px] shadow">
                        ${item.isExisting ? 'Saved' : (item.size ? (item.size / (1024*1024)).toFixed(1) + 'MB' : '')}
                    </span>
