    }

    function openFullscreenMediaByIndex(idx) {
        if (idx < 0 || idx >= mediaItems.length) return;
        const item = mediaItems[idx];
        if (item.type === 'image') {
            const modal = document.getElementById('fullscreenMediaModal');
            const img = document.getElementById('fullscreenImg');
            const title = document.getElementById('fullscreenMediaTitle');
            if (img) img.src = item.url;
            if (title) title.textContent = `Image Preview: ${item.name}`;
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        } else {
            goToSlide(idx);
            closeMediaGalleryModal();
        }
    }

    // Fullscreen enlarged viewer
    function openFullscreenMedia() {
        if (mediaItems.length === 0) return;
        const currentItem = mediaItems[currentSlide];
        if (currentItem.type !== 'image') return;

        const modal = document.getElementById('fullscreenMediaModal');
        const img = document.getElementById('fullscreenImg');
        const title = document.getElementById('fullscreenMediaTitle');

        if (img) img.src = currentItem.url;
        if (title) title.textContent = `Image Preview: ${currentItem.name}`;
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    }

    function closeFullscreenMedia() {
        const modal = document.getElementById('fullscreenMediaModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    // Facebook URL Input & Embed Rendering
    function handleFacebookUrlInput(url) {
        const previewBox = document.getElementById('fbUrlPreviewBox');
        const iframeContainer = document.getElementById('fbIframeContainer');
        const urlTitleInput = document.getElementById('urlTitleInput');
        const errorEl = document.getElementById('facebookUrlError');

        if (!url || !url.trim() || (!url.includes('facebook.com') && !url.includes('fb.watch') && !url.includes('fb.me'))) {
            if (previewBox) previewBox.classList.add('hidden');
            return;
        }

        const cleanUrl = url.trim();
        const isVideo = /video|watch|reel/i.test(cleanUrl);
        const pluginType = isVideo ? 'video.php' : 'post.php';
        const embedSrc = `https://www.facebook.com/plugins/${pluginType}?href=${encodeURIComponent(cleanUrl)}&show_text=true&width=500`;

        if (iframeContainer) {
            iframeContainer.innerHTML = `<iframe src="${embedSrc}" width="100%" height="100%" style="border:none;overflow:hidden;min-height:320px;" scrolling="no" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" class="w-full h-full rounded-xl"></iframe>`;
        }

        if (previewBox) previewBox.classList.remove('hidden');
        if (errorEl) errorEl.classList.add('hidden');

        // Suggest title if currently empty
        if (urlTitleInput && !urlTitleInput.value.trim()) {
            urlTitleInput.value = 'Official PNP Facebook Advisory Update';
        }
    }

    // Real-Time Counters & Validation
    function updateValidationState() {
        const isUrl = currentPublishType === 'url';

        const titleInput = isUrl ? document.getElementById('urlTitleInput') : document.getElementById('titleInput');
        const bodyInput = document.getElementById('bodyInput');
        const urlBodyInput = document.getElementById('urlBodyInput');
        const fbUrlInput = document.getElementById('facebookUrlInput');

        const titleCounter = isUrl ? document.getElementById('urlTitleCounter') : document.getElementById('titleCounter');
        const bodyCounter = document.getElementById('bodyCounter');
        const urlBodyCounter = document.getElementById('urlBodyCounter');

        const titleError = isUrl ? document.getElementById('urlTitleError') : document.getElementById('titleError');
        const bodyError = document.getElementById('bodyError');
        const fbUrlError = document.getElementById('facebookUrlError');

        const errorCard = document.getElementById('errorDetectorCard');
        const errorIconContainer = document.getElementById('errorDetectorIconContainer');
        const errorIcon = document.getElementById('errorDetectorIcon');
        const errorBadge = document.getElementById('errorDetectorStatusBadge');
        const errorText = document.getElementById('errorDetectorText');
        const submitBtn = document.getElementById('submitBulletinBtn');

        let validationErrorMessage = '';

        // 1. Validate Title
        const titleVal = titleInput ? titleInput.value.trim() : '';
        const titleWords = titleVal.split(/\s+/).filter(Boolean);
        const titleChars = titleVal.length;

        if (titleCounter) {
            titleCounter.textContent = `${titleChars} / 100 letters`;
        }

        if (titleChars === 0) {
            if (titleError) {
                titleError.textContent = 'Bulletin title is required (at least 3 words required).';
                titleError.classList.remove('hidden');
            }
            if (titleInput) {
                titleInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                titleInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
            }
            if (titleCounter) {
                titleCounter.classList.add('text-red-500');
                titleCounter.classList.remove('text-emerald-500', 'text-slate-400');
            }
            validationErrorMessage = 'Please enter a bulletin title (at least 3 words required).';
        } else if (titleWords.length < 3) {
            if (titleError) {
                titleError.textContent = `Validation Error: Title must be at least 3 words long (currently ${titleWords.length} words / ${titleChars} characters).`;
                titleError.classList.remove('hidden');
            }
            if (titleInput) {
                titleInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                titleInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
            }
            if (titleCounter) {
                titleCounter.classList.add('text-red-500');
                titleCounter.classList.remove('text-emerald-500', 'text-slate-400');
            }
            validationErrorMessage = `Title must be at least 3 words long (currently: ${titleWords.length} words).`;
        } else if (titleChars > 100 || titleWords.length > 15) {
            if (titleError) {
                titleError.textContent = `Validation Error: Title is too long (maximum 15 words / 100 characters. Currently: ${titleWords.length} words / ${titleChars} characters).`;
                titleError.classList.remove('hidden');
            }
            if (titleInput) {
                titleInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                titleInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
            }
            if (titleCounter) {
                titleCounter.classList.add('text-red-500');
                titleCounter.classList.remove('text-emerald-500', 'text-slate-400');
            }
            validationErrorMessage = `Title is too long (maximum 15 words / 100 characters).`;
        } else {
            if (titleError) titleError.classList.add('hidden');
            if (titleInput) {
                titleInput.classList.remove('border-red-500', 'ring-red-500/20');
                titleInput.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/20');
            }
            if (titleCounter) {
                titleCounter.classList.remove('text-red-500', 'text-slate-400');
                titleCounter.classList.add('text-emerald-500');
            }
        }

        // 2. Validate Body / Content (for Advisory / News)
        if (!isUrl) {
            const bodyVal = bodyInput ? bodyInput.value.trim() : '';
            const bodyWords = bodyVal.split(/\s+/).filter(Boolean);
            const bodyChars = bodyVal.length;

            if (bodyCounter) {
                bodyCounter.textContent = `${bodyChars} / 5,000 letters`;
            }

            if (bodyChars === 0) {
                if (bodyError) {
                    bodyError.textContent = 'Description content is required (at least 5 words / 15 characters).';
                    bodyError.classList.remove('hidden');
                }
                if (bodyInput) {
                    bodyInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                    bodyInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
                }
                if (bodyCounter) {
                    bodyCounter.classList.add('text-red-500');
                    bodyCounter.classList.remove('text-emerald-500', 'text-slate-400');
                }
                if (!validationErrorMessage) validationErrorMessage = 'Description body content is required (at least 5 words required).';
            } else if (bodyWords.length < 5 || bodyChars < 15) {
                if (bodyError) {
                    bodyError.textContent = `Validation Error: Description must be at least 5 words long (currently: ${bodyWords.length} words / ${bodyChars} characters).`;
                    bodyError.classList.remove('hidden');
                }
                if (bodyInput) {
                    bodyInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                    bodyInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
                }
                if (bodyCounter) {
                    bodyCounter.classList.add('text-red-500');
                    bodyCounter.classList.remove('text-emerald-500', 'text-slate-400');
                }
                if (!validationErrorMessage) validationErrorMessage = `Bulletin body must be at least 5 words long (currently: ${bodyWords.length} words).`;
            } else if (bodyWords.length > 500 || bodyChars > 5000) {
                if (bodyError) {
                    bodyError.textContent = `Validation Error: Description exceeds 500 words / 5,000 characters limit (currently: ${bodyWords.length} words / ${bodyChars} characters).`;
                    bodyError.classList.remove('hidden');
                }
                if (bodyInput) {
                    bodyInput.classList.add('border-red-500', 'ring-2', 'ring-red-500/20');
                    bodyInput.classList.remove('border-emerald-500', 'ring-emerald-500/20');
                }
                if (bodyCounter) {
                    bodyCounter.classList.add('text-red-500');
                    bodyCounter.classList.remove('text-emerald-500', 'text-slate-400');
                }
                if (!validationErrorMessage) validationErrorMessage = `Bulletin body is too long (maximum 500 words / 5,000 characters).`;
            } else {
                if (bodyError) bodyError.classList.add('hidden');
                if (bodyInput) {
                    bodyInput.classList.remove('border-red-500', 'ring-red-500/20');
                    bodyInput.classList.add('border-emerald-500', 'ring-2', 'ring-emerald-500/20');
                }
                if (bodyCounter) {
                    bodyCounter.classList.remove('text-red-500', 'text-slate-400');
                    bodyCounter.classList.add('text-emerald-500');
                }
            }

            // Media attachment requirement for advisory / news
            if (mediaItems.length === 0) {
                if (!validationErrorMessage) validationErrorMessage = 'At least 1 photo or video must be attached to the bulletin.';
            } else if (mediaItems.length > 10) {
                if (!validationErrorMessage) validationErrorMessage = `Maximum limit exceeded: You have ${mediaItems.length} files attached (limit is 10).`;
            }
        } else {
            // URL Post Validation
            const rawFbUrl = fbUrlInput ? (fbUrlInput.value || '').trim() : '';
            const isValidFbUrl = rawFbUrl.length > 0 && /^(https?:\/\/)?(www\.|m\.|web\.)?(facebook\.com|fb\.watch|fb\.me|fb\.gg)\/.+/i.test(rawFbUrl);

            if (urlBodyCounter && urlBodyInput) {
                urlBodyCounter.textContent = `${urlBodyInput.value.length} / 5,000 letters`;
            }

            if (!rawFbUrl) {
                if (fbUrlError) {
                    fbUrlError.textContent = 'Facebook Post URL is required for URL Post format.';
                    fbUrlError.classList.remove('hidden');
                }
                if (!validationErrorMessage) validationErrorMessage = 'Facebook Post URL link is required.';
            } else if (!isValidFbUrl) {
                if (fbUrlError) {
                    fbUrlError.textContent = 'Invalid Facebook URL format. Please provide a valid Facebook post/video link (e.g. https://www.facebook.com/...).';
                    fbUrlError.classList.remove('hidden');
                }
                if (!validationErrorMessage) validationErrorMessage = 'Invalid Facebook URL format. Must be a valid Facebook post or video URL.';
            } else {
                if (fbUrlError) fbUrlError.classList.add('hidden');
            }
        }

        // Update Error Detector Card UI
        if (validationErrorMessage) {
            if (errorCard) errorCard.className = 'w-full md:w-auto flex-1 p-4 rounded-2xl transition-all duration-300 flex items-center space-x-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-300';
            if (errorIconContainer) errorIconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg bg-red-500 text-white shadow-md animate-pulse';
            if (errorIcon) errorIcon.className = 'fas fa-exclamation-triangle';
            if (errorBadge) {
                errorBadge.textContent = isEditMode ? 'UPDATE BLOCKED' : 'POST BLOCKED';
                errorBadge.className = 'text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-red-500 text-white shadow-sm';
            }
            if (errorText) errorText.textContent = validationErrorMessage;
            return false;
        } else {
            if (errorCard) errorCard.className = 'w-full md:w-auto flex-1 p-4 rounded-2xl transition-all duration-300 flex items-center space-x-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 text-emerald-800 dark:text-emerald-200';
            if (errorIconContainer) errorIconContainer.className = 'w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-lg bg-emerald-500 text-white shadow-md';
            if (errorIcon) errorIcon.className = 'fas fa-check-circle';
            if (errorBadge) {
                errorBadge.textContent = isEditMode ? 'READY TO UPDATE' : 'READY TO POST';
                errorBadge.className = 'text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-500 text-white shadow-sm';
            }
            if (errorText) errorText.textContent = 'All parameters verified and compliant. Ready to submit.';
            return true;
        }
    }

    // Submit & Confirmation Modal
    function handleBulletinFormSubmit(event) {
        event.preventDefault();
        const isValid = updateValidationState();
        if (!isValid) {
            const activeError = document.getElementById('errorDetectorText')?.textContent || 'Please correct validation errors before submitting.';
            alert('Submission Blocked:\n' + activeError);
            return false;
        }

        // Prepare data for confirmation dialog
        const isUrl = currentPublishType === 'url';
        const titleInput = isUrl ? document.getElementById('urlTitleInput') : document.getElementById('titleInput');
        const advisorySelect = document.getElementById('categorySelectAdvisory');
        const titleVal = titleInput ? titleInput.value.trim() : '';

        // If URL mode, sync title and body inputs
        if (isUrl) {
            const urlTitle = document.getElementById('urlTitleInput')?.value.trim() || '';
            const urlBody = document.getElementById('urlBodyInput')?.value.trim() || '';
            const mainTitle = document.getElementById('titleInput');
            const mainBody = document.getElementById('bodyInput');
            if (mainTitle) mainTitle.value = urlTitle;
            if (mainBody) mainBody.value = urlBody;
        }

        const typeLabels = {
            'advisory': 'Public Advisory',
            'news': 'News & Release',
            'url': 'Facebook URL Post'
        };

        const categoryVal = (currentPublishType === 'news' || currentPublishType === 'url') 
            ? 'General Announcement' 
            : (advisorySelect ? advisorySelect.value : 'Public Advisory');

        const mediaSummary = isUrl 
            ? 'Facebook URL Import (Live Embed)' 
            : `${mediaItems.length} file(s) attached (${mediaItems.filter(i => i.type === 'image').length} photo(s), ${mediaItems.filter(i => i.type === 'video').length} video(s))`;

        document.getElementById('confirmModalTitle').textContent = titleVal;
        document.getElementById('confirmModalType').textContent = typeLabels[currentPublishType] || currentPublishType;
        document.getElementById('confirmModalCategory').textContent = categoryVal;
        document.getElementById('confirmModalMedia').textContent = mediaSummary;

        openUpdateConfirmationModal();
        return false;
    }

    function openUpdateConfirmationModal() {
        const modal = document.getElementById('updateConfirmModal');
        if (!modal) return;
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.firstElementChild.classList.remove('scale-95');
            modal.firstElementChild.classList.add('scale-100');
        }, 20);
    }

    function closeUpdateConfirmationModal() {
        const modal = document.getElementById('updateConfirmModal');
        if (!modal) return;
        modal.classList.add('opacity-0');
        modal.firstElementChild.classList.remove('scale-100');
        modal.firstElementChild.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    function executeFinalSubmit() {
        const btn = document.getElementById('finalConfirmBtn');
        const btnText = document.getElementById('finalConfirmBtnText');
        if (btn) btn.disabled = true;
        if (btnText) btnText.innerHTML = `<i class="fas fa-spinner fa-spin mr-2"></i> ${isEditMode ? 'Updating...' : 'Publishing...'}`;

        document.getElementById('bulletinForm').submit();
    }

    async function autoTranslateFormWithOpenRouter() {
        const titleEl = document.getElementById('titleInput');
        const bodyEl = document.getElementById('bodyInput');
        const btn = document.getElementById('autoTranslateBtn');

        const titleText = titleEl ? titleEl.value.trim() : '';
        const bodyText = bodyEl ? bodyEl.value.trim() : '';

        if (!titleText && !bodyText) {
            alert('Please enter a title or description first before translating.');
            return;
        }

        const originalBtnHTML = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i class="fas fa-spinner fa-spin text-xs"></i> <span>Translating AI...</span>`;

        try {
            const combinedText = `[TITLE]: ${titleText}\n\n[BODY]:\n${bodyText}`;
            const res = await fetch('/api/translate-tagalog', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: combinedText })
            });

            const data = await res.json();
            if (data.success && data.tagalogText) {
                const translated = data.tagalogText;
                const titleMatch = translated.match(/\[TITLE\]:\s*(.*)/i);
                const bodyMatch = translated.match(/\[BODY\]:\s*([\s\S]*)/i);

                if (titleMatch && titleMatch[1] && titleEl) {
                    titleEl.value = titleMatch[1].trim().substring(0, 100);
                } else if (titleEl) {
                    titleEl.value = translated.split('\n')[0].substring(0, 100);
                }

                if (bodyMatch && bodyMatch[1] && bodyEl) {
                    bodyEl.value = bodyMatch[1].trim();
                } else if (bodyEl) {
                    bodyEl.value = translated;
                }

                updateValidationState();
                alert('✨ Successfully translated content into Tagalog via OpenRouter AI!');
            } else {
                alert('Translation failed: ' + (data.error || 'Unknown error'));
            }
        } catch (err) {
            console.error('Auto-translate error:', err);
            alert('Error connecting to translation service.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalBtnHTML;
        }
    }

    // Keyboard & Escape listeners
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeFullscreenMedia();
            closeMediaGalleryModal();
            closeUpdateConfirmationModal();
        }
    });

    // Auto-initialize on load
    document.addEventListener('DOMContentLoaded', () => {
        const detectedType = detectInitialType();
        switchPublicationType(detectedType);
        syncMediaInputs();
        renderCarousel();
        renderMediaGalleryGrid();
        updateValidationState();

        if (detectedType === 'url' && initialFbUrl) {
            handleFacebookUrlInput(initialFbUrl);
        }
    });
</script>