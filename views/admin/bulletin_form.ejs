<div class="max-w-7xl mx-auto w-full px-4 py-8">
    <!-- Outer Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-xl border border-gray-150 dark:border-slate-800 overflow-hidden w-full transition-all">
        
        <!-- TOP HEADER -->
        <div class="p-6 sm:p-8 border-b border-gray-150 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-gray-50/50 dark:bg-slate-950/50">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-pnp-blue text-pnp-gold rounded-2xl flex items-center justify-center font-black text-xl shadow-md border border-pnp-gold/30 shrink-0">
                    <i class="fas <%= bulletin ? 'fa-edit' : 'fa-bullhorn' %> text-base"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <h3 class="text-xl font-black text-slate-900 dark:text-white uppercase tracking-wider">
                            <%= bulletin ? 'Edit Bulletin Notice' : 'Publish Notice' %>
                        </h3>
                        <span id="activeTypeTag" class="px-3 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold border border-pnp-blue/20">
                            Public Advisory
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
                        <%= bulletin ? 'Update bulletin details, publication category, or media attachments.' : 'Create and broadcast an official station bulletin.' %>
                    </p>
                </div>
            </div>
            <a href="<%= typeof isPublic !== 'undefined' && isPublic ? '/bulletins' : '/admin/bulletins' %>"
                class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 text-xs font-bold uppercase tracking-wider transition self-start sm:self-center">
                <i class="fas fa-times text-xs"></i>
                <span>Cancel</span>
            </a>
        </div>

        <!-- PUBLICATION TYPE SELECTOR (3 CARDS / TABS) -->
        <div class="p-6 sm:p-8 border-b border-gray-150 dark:border-slate-800 bg-gray-50/30 dark:bg-slate-900/40">
            <div class="flex items-center justify-between mb-4">
                <label class="block text-[11px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">
                    Select Publication Type
                </label>
                <span class="text-[10px] text-slate-400 font-bold uppercase">Click to switch format</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
                <!-- Option 1: Public Advisory -->
                <button type="button" id="typeBtnAdvisory" onclick="switchPublicationType('advisory')"
                    class="pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-white dark:bg-slate-900 border-amber-500 shadow-md ring-2 ring-amber-500/20">
                    <div class="flex items-center justify-between w-full">
                        <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl shrink-0">
                            <i class="fas fa-bullhorn"></i>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-amber-500/10 text-amber-500 border border-amber-500/20">Safety Alert</span>
                    </div>
                    <div>
                        <h4 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-tight mb-1">Public Advisory</h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-medium line-clamp-2">Public safety advisories with text, photos, or video announcement clips.</p>
                    </div>
                    <div class="pub-type-indicator flex items-center text-[10px] font-bold text-amber-500 uppercase tracking-wider pt-1">
                        <i class="fas fa-check-circle mr-1.5"></i>
                        <span>Selected Format</span>
                    </div>
                </button>

                <!-- Option 2: News & Release -->
                <button type="button" id="typeBtnNews" onclick="switchPublicationType('news')"
                    class="pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-gray-50/60 dark:bg-slate-800/40 border-gray-200 dark:border-slate-800 hover:border-pnp-blue dark:hover:border-pnp-gold">
                    <div class="flex items-center justify-between w-full">
                        <div class="w-11 h-11 rounded-xl bg-pnp-blue/10 text-pnp-blue dark:text-blue-400 flex items-center justify-center text-xl shrink-0">
                            <i class="fas fa-newspaper"></i>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-pnp-blue/10 text-pnp-blue dark:text-blue-300 border border-pnp-blue/20">Press Release</span>
                    </div>
                    <div>
                        <h4 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-tight mb-1">News & Release</h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-medium line-clamp-2">Official station news, general announcements, and press releases.</p>
                    </div>
                    <div class="pub-type-indicator hidden items-center text-[10px] font-bold text-pnp-blue dark:text-pnp-gold uppercase tracking-wider pt-1">
                        <i class="fas fa-check-circle mr-1.5"></i>
                        <span>Selected Format</span>
                    </div>
                </button>

                <!-- Option 3: URL Post (Facebook Import) -->
                <button type="button" id="typeBtnUrl" onclick="switchPublicationType('url')"
                    class="pub-type-card text-left p-5 rounded-2xl border-2 transition-all duration-300 flex flex-col justify-between space-y-3 cursor-pointer bg-gray-50/60 dark:bg-slate-800/40 border-gray-200 dark:border-slate-800 hover:border-[#1877F2]">
                    <div class="flex items-center justify-between w-full">
                        <div class="w-11 h-11 rounded-xl bg-[#1877F2]/10 text-[#1877F2] flex items-center justify-center text-xl shrink-0">
                            <i class="fab fa-facebook-f"></i>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-[#1877F2]/10 text-[#1877F2] border border-[#1877F2]/20">Facebook Import</span>
                    </div>
                    <div>
                        <h4 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-tight mb-1">URL Post</h4>
                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-medium line-clamp-2">Official Facebook post or video link with live interactive embed.</p>
                    </div>
                    <div class="pub-type-indicator hidden items-center text-[10px] font-bold text-[#1877F2] uppercase tracking-wider pt-1">
                        <i class="fas fa-check-circle mr-1.5"></i>
                        <span>Selected Format</span>
                    </div>
                </button>
            </div>
        </div>

        <!-- MAIN FORM -->
        <form id="bulletinForm"
            action="<%= bulletin ? '/admin/bulletins/' + bulletin.id + '/edit' : (typeof isPublic !== 'undefined' && isPublic ? '/bulletins/create' : '/admin/bulletins/create') %>"
            method="POST" enctype="multipart/form-data" class="p-6 sm:p-8 space-y-8"
            onsubmit="handleBulletinFormSubmit(event); return false;">

            <!-- Hidden Inputs -->
            <input type="hidden" name="publish_type" id="publishTypeInput" value="advisory">
            <input type="hidden" name="existing_photos" id="existing_photos_input" value="[]">
            <input type="hidden" name="existing_videos" id="existing_videos_input" value="[]">
            <input type="file" name="photos" id="photosInput" accept="image/*" multiple class="hidden">
            <input type="file" name="videos" id="videosInput" accept="video/*" multiple class="hidden">

            <!-- FORMAT 1 & 2: 2-COLUMN LAYOUT FOR ADVISORY & NEWS -->
            <div id="manualPublishPanel" class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-stretch">

                <!-- LEFT COLUMN: UNIFIED MEDIA PREVIEW & CAROUSEL -->
                <div class="space-y-4 flex flex-col">
                    <label class="block text-[10px] font-bold text-gray-400 dark:text-slate-400 uppercase tracking-widest">
                        Upload Media <span class="text-slate-400 font-normal">(Images & Videos, Max 10)</span>
                    </label>

                    <div class="flex-1 flex flex-col justify-between bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl p-5">
                        <!-- Dropzone Container -->
                        <div id="mediaDropZone" onclick="if(mediaItems.length === 0) document.getElementById('mediaFileInput').click()"
                            class="w-full min-h-[320px] lg:min-h-[360px] flex-1 rounded-xl bg-gray-100/80 dark:bg-slate-900 flex items-center justify-center cursor-pointer transition-all duration-300 border-2 border-dashed border-gray-200 dark:border-slate-800 hover:border-pnp-blue p-4 relative group overflow-hidden">

                            <!-- Empty State Placeholder -->
                            <div id="mediaPlaceholder" class="flex flex-col items-center justify-center text-center p-4">
                                <div class="w-16 h-16 rounded-2xl bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition duration-300">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <span class="text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mb-1">Drag & Drop or Click to Browse</span>
                                <p class="text-xs text-slate-400 dark:text-slate-500 font-medium max-w-xs leading-relaxed">
                                    Upload up to 10 photos or videos combined (JPG, PNG, WEBP, MP4). Max 5MB per image, max 25MB per video (up to 3 min).
                                </p>
                            </div>

                            <!-- Active Carousel Preview Box -->
                            <div id="mediaPreviewBox" class="hidden w-full h-full min-h-[300px] flex flex-col justify-between items-center relative" onclick="event.stopPropagation()">
                                <!-- Media Display Area -->
                                <div class="relative w-full flex-1 flex items-center justify-center bg-black/40 dark:bg-slate-950/80 rounded-xl overflow-hidden min-h-[220px] p-2">
                                    
                                    <!-- Top Header Bar Overlay -->
                                    <div class="absolute top-2 left-2 right-2 flex justify-between items-center z-30 pointer-events-none">
                                        <!-- Type Badge -->
                                        <span id="carouselBadge" class="pointer-events-auto px-3 py-1 rounded-lg bg-slate-900/85 text-white backdrop-blur-md text-[10px] font-black uppercase tracking-wider border border-white/10 shadow-lg flex items-center">
                                            <i class="fas fa-image text-emerald-400 mr-1.5"></i>
                                            <span>PHOTO (1/1)</span>
                                        </span>

                                        <div class="pointer-events-auto flex items-center space-x-2">
                                            <!-- VIEW ALL IN GRID BUTTON -->
                                            <button type="button" onclick="openMediaGalleryModal()" class="px-3 py-1.5 bg-slate-900/90 hover:bg-slate-950 text-pnp-gold rounded-lg shadow-lg hover:scale-105 active:scale-95 transition-all flex items-center space-x-1.5 text-[10px] font-black uppercase tracking-wider cursor-pointer border border-pnp-gold/30" title="View all photos and videos in one container">
                                                <i class="fas fa-th-large text-xs"></i>
                                                <span>Grid View</span>
                                            </button>

                                            <!-- DIRECT IN-CAROUSEL TRASH BUTTON -->
                                            <button type="button" id="trashCurrentItemBtn" onclick="trashCurrentMediaItem(event)"
                                                class="px-3 py-1.5 bg-red-600/90 hover:bg-red-700 text-white rounded-lg shadow-lg hover:scale-105 active:scale-95 transition-all flex items-center space-x-1.5 text-[10px] font-black uppercase tracking-wider cursor-pointer border border-red-500/30"
                                                title="Delete this image/video from bulletin">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                                <span>Trash</span>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Image Slide -->
                                    <img id="previewImg" onclick="openFullscreenMedia()" class="max-h-[250px] max-w-full object-contain rounded-lg shadow-md cursor-pointer hover:opacity-95 transition hidden" title="Click to view full screen">

                                    <!-- Video Slide -->
                                    <video id="previewVid" controls class="max-h-[250px] max-w-full object-contain rounded-lg shadow-md hidden"></video>

                                    <!-- Prev Slide Chevron -->
                                    <button type="button" id="prevSlideBtn" onclick="navigateCarousel(-1, event)"
                                        class="absolute left-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-900/80 hover:bg-slate-950 text-white flex items-center justify-center transition-all shadow-xl z-30 border border-white/15 cursor-pointer hover:scale-110 hidden"
                                        title="Previous Media">
                                        <i class="fas fa-chevron-left text-xs"></i>
                                    </button>

                                    <!-- Next Slide Chevron -->
                                    <button type="button" id="nextSlideBtn" onclick="navigateCarousel(1, event)"
                                        class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-900/80 hover:bg-slate-950 text-white flex items-center justify-center transition-all shadow-xl z-30 border border-white/15 cursor-pointer hover:scale-110 hidden"
                                        title="Next Media">
                                        <i class="fas fa-chevron-right text-xs"></i>
                                    </button>
                                </div>

                                <!-- Dots & File Info Footer -->
                                <div class="w-full mt-2.5 flex flex-col items-center space-y-1.5">
                                    <div id="carouselDots" class="flex items-center space-x-1.5 min-h-[12px]"></div>
                                    <p id="carouselInfo" class="text-[11px] font-bold text-slate-500 dark:text-slate-400 truncate max-w-full px-2 text-center"></p>

                                    <!-- Inline Thumbnails Strip: View All Uploaded Pictures & Videos directly on page -->
                                    <div id="thumbnailsStrip" class="w-full pt-2 border-t border-gray-200/60 dark:border-slate-800/80 flex items-center space-x-2 overflow-x-auto pb-1 custom-scrollbar hidden">
                                        <!-- Injected thumbnail previews -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Media Input Controls -->
                        <div class="mt-4 space-y-2">
                            <input type="file" id="mediaFileInput" accept="image/*,video/*" multiple class="hidden" onchange="handleMediaFileSelect(this.files)">

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <button type="button" id="addMediaBtn" onclick="document.getElementById('mediaFileInput').click()"
                                    class="w-full py-3.5 px-4 bg-pnp-blue hover:bg-blue-900 disabled:bg-slate-300 dark:disabled:bg-slate-800 disabled:text-slate-500 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition shadow-sm cursor-pointer disabled:cursor-not-allowed flex items-center justify-center space-x-2">
                                    <i class="fas fa-plus-circle"></i>
                                    <span id="addMediaBtnText">Add Media (0/10)</span>
                                </button>

                                <button type="button" id="viewGalleryBtn" onclick="openMediaGalleryModal()"
                                    class="w-full py-3.5 px-4 bg-slate-800 hover:bg-slate-700 text-pnp-gold rounded-xl text-xs font-bold uppercase tracking-wider transition border border-pnp-gold/20 flex items-center justify-center space-x-2 cursor-pointer hidden">
                                    <i class="fas fa-th-large"></i>
                                    <span>View All Media (<span id="galleryBtnCount">0</span>)</span>
                                </button>
                            </div>

                            <button type="button" id="clearAllMediaBtn" onclick="clearAllMedia()"
                                class="w-full py-2.5 px-4 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white rounded-xl text-xs font-bold uppercase tracking-wider transition hidden cursor-pointer flex items-center justify-center space-x-2">
                                <i class="fas fa-trash"></i>
                                <span>Clear All Attached Media</span>
                            </button>

                            <p class="text-[10px] text-slate-400 dark:text-slate-500 uppercase text-center pt-1">
                                JPG, PNG, WEBP, MP4 allowed • Up to 10 media files combined
                            </p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT COLUMN: FORM FIELDS (TITLE, CATEGORY, BODY) -->
                <div class="space-y-6 flex flex-col">

                    <!-- TITLE FIELD -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between items-center flex-wrap gap-2">
                            <label for="titleInput" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                                Bulletin Title <span class="text-red-500">*</span>
                            </label>
                            <div class="flex items-center space-x-2">
                                <button type="button" id="autoTranslateBtn" onclick="autoTranslateFormWithOpenRouter()" class="px-3 py-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-lg text-[10px] font-bold uppercase tracking-wider shadow transition flex items-center space-x-1.5 cursor-pointer">
                                    <i class="fas fa-magic text-xs text-amber-300"></i>
                                    <span>Auto-Translate (OpenRouter AI)</span>
                                </button>
                                <span id="titleCounter" class="text-[10px] font-mono font-bold text-slate-400 uppercase">
                                    0 / 100 letters
                                </span>
                            </div>
                        </div>
                        <input type="text" name="title" id="titleInput" value="<%= bulletin ? (bulletin.title || '') : '' %>"
                            required maxlength="100" placeholder="e.g. Heavy Rainfall Warning Advisory (3-15 words)"
                            oninput="updateValidationState()"
                            class="w-full px-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-pnp-blue dark:focus:ring-pnp-gold outline-none text-xs font-bold text-slate-800 dark:text-white transition">
                        <p id="titleError" class="text-[11px] font-bold text-red-500 mt-1 hidden"></p>
                    </div>

                    <!-- CATEGORY FIELD -->
                    <div class="space-y-1.5">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                            Category <span class="text-red-500">*</span>
                        </label>

                        <!-- Advisory Category Dropdown -->
                        <% 
                            const currentCategory = bulletin ? (bulletin.category || '') : '';
                        %>
                        <select name="category" id="categorySelectAdvisory" onchange="updateValidationState()"
                            class="w-full px-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-pnp-blue dark:focus:ring-pnp-gold outline-none text-xs font-bold text-slate-800 dark:text-white transition cursor-pointer">
                            <option value="Crime Advisory" <%= currentCategory === 'Crime Advisory' ? 'selected' : '' %>>Crime Advisory</option>
                            <option value="Traffic Advisory" <%= currentCategory === 'Traffic Advisory' ? 'selected' : '' %>>Traffic Advisory</option>
                            <option value="Cybercrime Advisory" <%= currentCategory === 'Cybercrime Advisory' ? 'selected' : '' %>>Cybercrime Advisory</option>
                            <option value="Community Awareness" <%= currentCategory === 'Community Awareness' ? 'selected' : '' %>>Community Awareness</option>
                        </select>

                        <!-- Locked Category Badge for News -->
                        <div id="categoryNewsBadge" class="hidden w-full px-4 py-3.5 bg-pnp-blue/10 border border-pnp-blue/20 rounded-xl text-xs font-bold text-pnp-blue dark:text-pnp-gold flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <i class="fas fa-newspaper text-sm"></i>
                                <span>General Announcement (News / Press Release)</span>
                            </div>
                            <span class="text-[10px] uppercase tracking-wider font-black px-2.5 py-0.5 rounded bg-pnp-blue/20">Locked</span>
                        </div>
                    </div>

                    <!-- BODY / CONTENT TEXTAREA -->
                    <div class="flex-1 flex flex-col space-y-1.5">
                        <div class="flex justify-between items-center">
                            <label for="bodyInput" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                                Description / Content <span class="text-red-500">*</span>
                            </label>
                            <span id="bodyCounter" class="text-[10px] font-mono font-bold text-slate-400 uppercase">
                                0 / 5,000 letters
                            </span>
                        </div>
                        <textarea name="body" id="bodyInput" rows="10" required
                            placeholder="Enter the full official announcement or advisory contents (min 5 words / 15 letters, max 5,000 letters)..."
                            oninput="updateValidationState()"
                            class="flex-1 w-full px-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-pnp-blue dark:focus:ring-pnp-gold outline-none text-xs font-medium text-slate-800 dark:text-white transition leading-relaxed"><%= bulletin ? (bulletin.body || '') : '' %></textarea>
                        <p id="bodyError" class="text-[11px] font-bold text-red-500 mt-1 hidden"></p>
                    </div>

                </div>

            </div>

            <!-- FORMAT 3: URL POST FLOW (FACEBOOK IMPORT) -->
            <div id="urlPublishPanel" class="hidden space-y-6">
                <!-- Header Banner -->
                <div class="p-5 rounded-2xl bg-[#1877F2]/10 border border-[#1877F2]/20 flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-2xl bg-[#1877F2] text-white flex items-center justify-center text-2xl shrink-0 shadow-md">
                        <i class="fab fa-facebook-f"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-black text-[#1877F2] uppercase tracking-wider">Facebook Official Post URL Import</h4>
                        <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5 font-medium">Link directly to an official post published on the PNP Sta. Cruz Facebook page.</p>
                    </div>
                </div>

                <!-- TITLE FIELD FOR URL POST -->
                <div class="space-y-1.5">
                    <div class="flex justify-between items-center">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                            Post Title / Headline <span class="text-red-500">*</span>
                        </label>
                        <span id="urlTitleCounter" class="text-[10px] font-mono font-bold text-slate-400 uppercase">
                            0 / 100 letters
                        </span>
                    </div>
                    <input type="text" id="urlTitleInput" maxlength="100"
                        value="<%= bulletin ? (bulletin.title || '') : '' %>"
                        placeholder="e.g. Official Statement on Community Outreach Operation"
                        oninput="updateValidationState()"
                        class="w-full px-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-[#1877F2] outline-none text-xs font-bold text-slate-800 dark:text-white transition">
                    <p id="urlTitleError" class="text-[11px] font-bold text-red-500 mt-1 hidden"></p>
                </div>

                <!-- CAPTION / DESCRIPTION FIELD FOR URL POST -->
                <div class="space-y-1.5">
                    <div class="flex justify-between items-center">
                        <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                            Post Description / First Paragraph <span class="text-slate-400 font-normal">(Optional)</span>
                        </label>
                        <span id="urlBodyCounter" class="text-[10px] font-mono font-bold text-slate-400 uppercase">
                            0 / 5,000 letters
                        </span>
                    </div>
                    <textarea id="urlBodyInput" rows="4"
                        placeholder="Paste or enter the Facebook caption or brief summary..."
                        oninput="updateValidationState()"
                        class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-[#1877F2] outline-none text-xs font-medium text-slate-800 dark:text-white transition leading-relaxed"><%= bulletin ? (bulletin.body || '') : '' %></textarea>
                </div>

                <!-- FACEBOOK POST URL FIELD -->
                <div class="space-y-3">
                    <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                        Facebook Post URL <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <i class="fab fa-facebook text-[#1877F2] absolute left-4 top-1/2 -translate-y-1/2 text-base"></i>
                        <input type="url" name="facebook_url" id="facebookUrlInput"
                            value="<%= bulletin ? (bulletin.facebook_url || bulletin.facebook_post_url || '') : '' %>"
                            oninput="handleFacebookUrlInput(this.value); updateValidationState();"
                            placeholder="https://www.facebook.com/..."
                            class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-xl focus:ring-2 focus:ring-[#1877F2] outline-none text-xs font-semibold text-slate-800 dark:text-white transition">
                    </div>
