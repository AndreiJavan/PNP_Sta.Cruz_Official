                <div class="col-span-full py-16 flex flex-col items-center justify-center text-slate-400 dark:text-slate-500">
                    <div class="w-16 h-16 rounded-2xl bg-gray-100 dark:bg-slate-800 flex items-center justify-center text-3xl mb-3">
                        <i class="fas fa-images"></i>
                    </div>
                    <p class="text-sm font-black uppercase tracking-wider text-slate-700 dark:text-slate-200">No Media Files Attached</p>
                    <p class="text-xs mt-1">Upload images or videos to view and manage them here.</p>
                    <button type="button" onclick="document.getElementById('mediaFileInput').click()" class="mt-4 px-6 py-2.5 bg-pnp-blue hover:bg-blue-900 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition">
