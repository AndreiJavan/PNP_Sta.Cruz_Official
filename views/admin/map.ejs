    window.addNewManualRow = function(insertIndex = null) {
        const todayStr = new Date().toISOString().split('T')[0];
        const activeBrgy = document.getElementById('filterBarangay') ? document.getElementById('filterBarangay').value : '';
        const defaultBrgy = (activeBrgy && VALID_BARANGAYS.includes(activeBrgy)) ? activeBrgy : VALID_BARANGAYS[0];
        const newRow = {
            barangay: defaultBrgy,
            date_committed: todayStr,
            incident_date: todayStr,
            offense: '',
            incident_type: '',
            category: 'Non-Index',
            description: ''
        };
        if (insertIndex !== null && typeof insertIndex === 'number' && insertIndex >= 0 && insertIndex <= manualData.length) {
            manualData.splice(insertIndex, 0, newRow);
        } else {
            manualData.push(newRow);
        }
        reviewData = manualData;
        renderManualTable();
        setTimeout(() => {
            const tbody = document.getElementById('manualTableBody');
            const container = tbody ? tbody.closest('.overflow-auto') : null;
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        }, 50);
    };

    window.deleteManualRow = function(index) {
        if (manualData.length <= 1) {
            const todayStr = new Date().toISOString().split('T')[0];
            const activeBrgy = document.getElementById('filterBarangay') ? document.getElementById('filterBarangay').value : '';
            const defaultBrgy = (activeBrgy && VALID_BARANGAYS.includes(activeBrgy)) ? activeBrgy : VALID_BARANGAYS[0];
            manualData = [{ 
                barangay: defaultBrgy, 
                date_committed: todayStr, 
                incident_date: todayStr,
                offense: '', 
                incident_type: '',
                category: 'Non-Index', 
                description: '' 
            }];
        } else {
            manualData.splice(index, 1);
        }
        reviewData = manualData;
        renderManualTable();
    };

