        if (typeof locateBarangay === 'function') {
            locateBarangay(false);
        } else {
            const pin = (typeof manualPins !== 'undefined' ? manualPins : []).find(p => p.name.toLowerCase() === bName.toLowerCase());
            if (pin && map) {
                map.flyTo([pin.lat, pin.lng], 16, { animate: true, duration: 1.2 });
            }
        }
    };

