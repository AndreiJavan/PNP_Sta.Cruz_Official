<div class="flex h-screen w-full overflow-hidden bg-slate-50 dark:bg-slate-900 relative">
    <!-- Sidebar: Location Overview & Stored Report Files Container -->
    <div id="filterSidebar"
        class="absolute top-0 left-0 z-[1050] w-full sm:w-[400px] lg:w-[420px] h-full bg-white dark:bg-slate-900 flex flex-col border-r border-gray-200 dark:border-slate-800 shadow-2xl transition-all duration-300 flex-shrink-0 sidebar-hidden">
        
        <!-- Header with Dual View Tabs & Collapse Controls -->
        <div class="p-3.5 bg-slate-100/90 dark:bg-slate-900/90 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between gap-2 shrink-0">
            <!-- View Switcher Tabs -->
            <div class="flex items-center gap-1 bg-white dark:bg-slate-800 p-1 rounded-xl border border-gray-200/80 dark:border-slate-700/80 shadow-2xs flex-1">
                <button type="button" onclick="switchSidebarView('overview')" id="tabBtnOverview" class="flex-1 py-1.5 px-2.5 rounded-lg text-[10px] font-black uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue shadow-xs cursor-pointer">
                    <i class="fas fa-layer-group text-[9px]"></i>
                    <span>Overview</span>
                </button>
                <button type="button" onclick="switchSidebarView('reports')" id="tabBtnReports" class="flex-1 py-1.5 px-2.5 rounded-lg text-[10px] font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 text-slate-500 hover:text-slate-800 dark:hover:text-white cursor-pointer">
                    <i class="fas fa-folder-open text-[9px]"></i>
                    <span>Stored Files</span>
                    <span id="tabReportsBadge" class="px-1.5 py-0.2 rounded-full text-[9px] font-black bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 tabular-nums"><%= (typeof reports !== 'undefined' ? reports.length : 0) %></span>
                </button>
            </div>

            <div class="flex items-center gap-1 shrink-0">
                <!-- Controls Info Toggle -->
                <button type="button" onclick="document.getElementById('mapControlsBox').classList.toggle('hidden')" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 text-slate-500 hover:text-pnp-blue dark:hover:text-pnp-gold border border-gray-200 dark:border-slate-700 transition shadow-2xs cursor-pointer" title="Map Controls Info">
                    <i class="fas fa-info-circle text-xs"></i>
                </button>
                <!-- Close / Collapse Sidebar Button (Works on both mobile & desktop) -->
                <button type="button" onclick="toggleMapSidebar()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 text-slate-500 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/30 border border-gray-200 dark:border-slate-700 transition shadow-2xs cursor-pointer" title="Collapse Location Overview">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
            </div>
        </div>

        <!-- TAB 1: LOCATION OVERVIEW CONTAINER -->
        <div id="sidebarViewOverview" class="flex-grow overflow-y-auto sidebar-scroll">
            <div class="p-4 sm:p-5 space-y-4">
                <!-- Title & Header Badge -->
                <div class="space-y-1">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-[9px] font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.25em] block">Location Overview</span>
                            <h4 class="text-lg font-black tracking-tight text-slate-800 dark:text-white leading-tight">Sta. Cruz Map</h4>
                        </div>
                        <div class="px-2.5 py-1 rounded-lg bg-pnp-blue/5 dark:bg-pnp-gold/10 border border-pnp-blue/15 dark:border-pnp-gold/20 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <span class="text-[9px] font-black uppercase text-pnp-blue dark:text-pnp-gold tracking-wider">Live Intel</span>
                        </div>
                    </div>

                    <!-- Collapsible Map Controls Guidance Box -->
                    <div id="mapControlsBox" class="hidden mt-2 p-3 bg-slate-50 dark:bg-slate-800/80 rounded-xl border border-gray-200 dark:border-slate-700 text-[10px] space-y-1.5">
                        <p class="font-black uppercase tracking-wider text-pnp-blue dark:text-pnp-gold flex items-center gap-1.5">
                            <i class="fas fa-compass text-xs"></i>
                            <span>Navigation Controls</span>
                        </p>
                        <p class="text-slate-600 dark:text-slate-300 font-medium leading-relaxed">
                            <span class="block">&bull; <strong>Left/Right Arrows:</strong> Cycle through barangays</span>
                            <span class="block">&bull; <strong>Click Sector:</strong> Zoom & isolate barangay density</span>
                            <span class="block">&bull; <strong>Double-click Incident:</strong> Jump to report logs</span>
                        </p>
                    </div>
                </div>

                <!-- Filter Controls Form -->
                <div class="space-y-3 bg-slate-50/80 dark:bg-slate-800/50 p-3.5 rounded-2xl border border-gray-200/80 dark:border-slate-700/60 shadow-2xs">
                    <!-- Sector / Barangay Selector -->
                    <div class="space-y-1">
                        <label class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Sector / Barangay</label>
                        <div class="flex items-center gap-1.5">
                            <select id="filterBarangay" class="flex-1 px-3 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-xs font-bold focus:ring-2 focus:ring-pnp-blue outline-none transition text-slate-800 dark:text-white cursor-pointer">
                                <option value="">All Barangays</option>
                                <% ["Alipit", "Bagumbayan", "Bubukal", "Calios", "Duhat", "Gatid", "Jasaan", "Labuin", "Malinao", "Oogong", "Pagsawitan", "Palasan", "Patimbao", "Poblacion I (Barangay I)", "Poblacion II (Barangay II)", "Poblacion III (Barangay III)", "Poblacion IV (Barangay IV)", "Poblacion V (Barangay V)", "San Jose", "San Juan", "San Pablo Norte", "San Pablo Sur", "Santisima Cruz", "Santo Angel Central", "Santo Angel Norte", "Santo Angel Sur"].forEach(brgy => { %>
                                    <option value="<%= brgy %>"><%= brgy %></option>
                                <% }) %>
                            </select>
                            <button onclick="document.getElementById('filterBarangay').value=''; const m=document.getElementById('mapDisplayMode'); if(m) m.value='density'; locateBarangay(false); if(typeof loadMapPoints === 'function') loadMapPoints(false);" class="w-9 h-9 bg-pnp-blue dark:bg-pnp-gold text-white dark:text-pnp-blue rounded-xl shadow-xs hover:scale-105 active:scale-95 transition flex items-center justify-center shrink-0 cursor-pointer" title="Reset to All Barangays">
                                <i class="fas fa-globe text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Category & Crime Date Row -->
                    <div class="grid grid-cols-2 gap-2">
                        <!-- Category Filter -->
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Category</label>
                            <select id="mapDisplayMode" onchange="updateHeatmap(); updateLegend();" class="w-full px-2.5 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-xs font-bold focus:ring-2 focus:ring-pnp-blue outline-none transition text-slate-800 dark:text-white cursor-pointer">
                                <option value="density">All Crimes</option>
                                <option value="density_focus">8-Focus</option>
                                <option value="density_nonindex">Non-Index</option>
                                <option value="density_psi" title="PUBLIC SAFETY INCIDENT">PSI</option>
                            </select>
                        </div>

                        <!-- Crime Date Filter Button -->
                        <div class="space-y-1">
                            <label class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">Timeline</label>
                            <button id="crimeDateBtn" type="button" onclick="toggleCrimeDatePopover(event)" class="w-full px-2.5 py-2 bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-700 rounded-xl text-xs font-bold focus:ring-2 focus:ring-pnp-blue outline-none transition text-slate-800 dark:text-white flex items-center justify-between shadow-2xs cursor-pointer group">
                                <span id="crimeDateLabel" class="truncate text-slate-800 dark:text-white font-bold text-[11px]">This Year</span>
                                <i class="fas fa-calendar-alt text-[10px] text-gray-400 group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition shrink-0 ml-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Crime Date Inline Selector Popover -->
                    <div id="crimeDatePopover" class="hidden mt-2 bg-white dark:bg-slate-900 p-3.5 rounded-2xl border border-gray-300 dark:border-slate-700 space-y-2.5 shadow-xl">
                        <div class="space-y-1">
                            <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">Timeline Method</label>
                            <select id="crimeDateMode" onchange="onCrimeDateModeChange()" class="w-full px-2.5 py-1.5 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-xl text-xs font-bold outline-none text-slate-800 dark:text-white cursor-pointer">
                                <option value="thisYear">This Year (Default)</option>
                                <option value="allYears">All Years</option>
                                <option value="monthYear">Month & Year</option>
                                <option value="yearOnly">Year Only</option>
                                <option value="customRange">Custom Date Range</option>
                            </select>
                        </div>

                        <div id="modeMonthYear" class="hidden grid grid-cols-2 gap-2">
                            <div class="space-y-1">
                                <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">Month</label>
                                <select id="filterMonth" onchange="applyCrimeDateFilter(false)" class="w-full px-2 py-1.5 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-lg text-[11px] font-bold outline-none text-slate-800 dark:text-white">
                                    <option value="1">January</option><option value="2">February</option><option value="3">March</option><option value="4">April</option><option value="5">May</option><option value="6">June</option><option value="7" selected>July</option><option value="8">August</option><option value="9">September</option><option value="10">October</option><option value="11">November</option><option value="12">December</option>
                                </select>
                            </div>
                            <div class="space-y-1">
                                <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">Year</label>
                                <select id="filterMonthYear" onchange="applyCrimeDateFilter(false)" class="w-full px-2 py-1.5 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-lg text-[11px] font-bold outline-none text-slate-800 dark:text-white"></select>
                            </div>
                        </div>

                        <div id="modeYearOnly" class="hidden space-y-1">
                            <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">Select Year</label>
                            <select id="filterYear" onchange="applyCrimeDateFilter(false)" class="w-full px-2 py-1.5 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-lg text-[11px] font-bold outline-none text-slate-800 dark:text-white"></select>
                        </div>

                        <div id="modeCustomRange" class="hidden grid grid-cols-2 gap-2">
                            <div class="space-y-1">
                                <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">From</label>
                                <input type="date" id="filterFromDate" onchange="applyCrimeDateFilter(false)" class="w-full px-2 py-1 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-lg text-[10px] font-bold outline-none text-slate-800 dark:text-white text-center">
                            </div>
                            <div class="space-y-1">
                                <label class="text-[8px] font-black text-gray-400 uppercase tracking-widest">To</label>
                                <input type="date" id="filterToDate" onchange="applyCrimeDateFilter(false)" class="w-full px-2 py-1 bg-gray-50 dark:bg-slate-800 border border-gray-300 dark:border-slate-700 rounded-lg text-[10px] font-bold outline-none text-slate-800 dark:text-white text-center">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ALL CRIME / BREAKDOWN SECTION -->
                <div id="topIncidentsSection" class="space-y-2 pt-1">
                    <div class="flex items-center justify-between">
                        <label id="sidebarCategoryLabel" class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">
                            All Crime
                        </label>
                        <span class="text-[8px] font-bold text-slate-400 uppercase">Double-click to view</span>
                    </div>
                    <div id="topIncidentsList" class="space-y-1.5 max-h-[320px] overflow-y-auto sidebar-scroll pr-0.5">
                        <!-- All incidents injected here dynamically -->
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: STORED REPORT FILES CONTAINER -->
        <div id="sidebarViewReports" class="hidden flex-grow overflow-y-auto sidebar-scroll flex flex-col">
            <div class="p-4 sm:p-5 space-y-3.5 flex-1 flex flex-col">
                <!-- Section Header -->
                <div class="flex items-center justify-between">
                    <div>
                        <span class="text-[9px] font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.25em] block">Storage Vault</span>
                        <h4 class="text-lg font-black tracking-tight text-slate-800 dark:text-white leading-tight">Stored Report Files</h4>
                    </div>
                    <a href="/admin/reports" class="px-2.5 py-1 rounded-lg bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue font-black text-[9px] uppercase tracking-wider shadow-xs hover:opacity-90 transition flex items-center gap-1" title="Go to Crime Reports Page">
                        <span>Reports Page</span>
                        <i class="fas fa-arrow-up-right-from-square text-[8px]"></i>
                    </a>
                </div>

                <!-- Active Report Filter Alert Banner (If isolated by report) -->
                <div id="reportActiveFilterBanner" class="hidden p-3 rounded-xl bg-pnp-blue/10 dark:bg-pnp-gold/10 border border-pnp-blue/30 dark:border-pnp-gold/30 flex items-center justify-between gap-2 animate-fade-in">
                    <div class="min-w-0">
                        <span class="text-[8px] font-black uppercase text-pnp-blue dark:text-pnp-gold block tracking-wider">Map Isolated to File:</span>
                        <span id="activeFilterReportName" class="text-[11px] font-black text-slate-900 dark:text-white uppercase truncate block">--</span>
                    </div>
                    <button type="button" onclick="clearReportFilter()" class="px-2.5 py-1 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 text-[9px] font-black uppercase tracking-wider hover:bg-red-600 hover:text-white transition cursor-pointer shrink-0">
                        Clear Filter
                    </button>
                </div>

                <!-- Search Reports Input -->
                <div class="relative">
                    <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                    <input type="text" id="reportsSearchInput" oninput="renderStoredReportsList(this.value)" placeholder="Search stored report files..." class="w-full pl-8 pr-3 py-2 bg-slate-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-pnp-blue placeholder:text-slate-400">
                </div>


                <!-- Stored Files List -->
                <div id="storedReportsListContainer" class="space-y-2.5 flex-1">
                    <!-- Populated dynamically via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- Map Canvas Container (Full Screen / Resizable) -->
    <div class="flex-grow relative z-0 h-full w-full overflow-hidden">
        
        <!-- Floating Top-Left Button: Location Overview Button (Top-Left, does not cover map) -->
        <button id="openSidebarBtn" onclick="toggleMapSidebar()" class="absolute top-4 left-4 z-[1000] px-3.5 py-2.5 rounded-2xl bg-white/95 dark:bg-slate-800/95 shadow-xl border border-gray-200/90 dark:border-slate-700/90 text-slate-800 dark:text-white font-black text-[11px] uppercase tracking-wider flex items-center gap-2 hover:bg-slate-100 dark:hover:bg-slate-700 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer backdrop-blur-md">
            <i class="fas fa-layer-group text-pnp-blue dark:text-pnp-gold"></i>
            <span>Location Overview</span>
        </button>

        <!-- Floating Top-Right Controls: Dynamic Context Legend (Replaces Stored Files Button on Right Side) -->
        <div class="absolute top-4 right-4 z-[1000] flex flex-col items-end pointer-events-none max-w-[calc(100vw-32px)]">
            <div id="mapTopRightLegend" class="pointer-events-auto w-64 sm:w-72 rounded-2xl bg-white/95 dark:bg-slate-900/95 shadow-2xl border border-gray-200/90 dark:border-slate-700/90 backdrop-blur-md transition-all duration-300 overflow-hidden text-left">
                <!-- Header with Minimize/Expand Toggle -->
                <div class="px-3.5 py-2.5 bg-slate-100/90 dark:bg-slate-800/90 border-b border-gray-200/80 dark:border-slate-700/80 flex items-center justify-between cursor-pointer select-none" onclick="toggleMapLegend()">
                    <div class="flex items-center gap-2 min-w-0">
                        <i id="topLegendIcon" class="fas fa-map-location-dot text-pnp-blue dark:text-pnp-gold text-xs shrink-0"></i>
                        <span id="topLegendTitle" class="text-[10px] font-black uppercase tracking-wider text-slate-800 dark:text-white truncate">Location Density Heatmap Legend</span>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0 ml-2">
                        <span id="topLegendBadge" class="text-[8px] font-black uppercase px-1.5 py-0.5 rounded-md bg-pnp-blue/10 text-pnp-blue dark:bg-pnp-gold/10 dark:text-pnp-gold tracking-wider">Sector Density</span>
                        <div class="w-5 h-5 flex items-center justify-center text-slate-400 hover:text-slate-600 dark:hover:text-white">
                            <i id="topLegendChevron" class="fas fa-chevron-up text-[9px] transition-transform duration-200"></i>
                        </div>
                    </div>
                </div>

                <!-- Legend Body (Switches between Overview Heatmap and Stored Files Legend) -->
                <div id="topLegendBody" class="p-3 space-y-2.5 transition-all duration-200">
                    <!-- VIEW A: Location Density Heatmap Legend Content (When on Overview) -->
                    <div id="legendContentHeatmap" class="space-y-2">
                        <!-- Dynamic Sector List populated via updateLegend() -->
                        <div id="dynamicLegend" class="space-y-1 max-h-48 overflow-y-auto sidebar-scroll">
                            <p class="text-[9px] text-gray-400 font-bold uppercase text-center py-2">Loading legend...</p>
                        </div>
                    </div>

                    <!-- VIEW B: Stored Files Heatmap & Top Sector Intel (When on Stored Files) -->
                    <div id="legendContentStoredFiles" class="hidden space-y-2.5">
                        <div id="dynamicStoredFilesLegend" class="space-y-2">
                            <p class="text-[9px] text-gray-400 font-bold uppercase text-center py-2">Loading stored files intel...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Bottom-Right Action: Add New Record (Opens Manual Store Modal) -->
        <div class="absolute bottom-6 right-6 md:bottom-8 md:right-8 z-[1000] flex flex-col items-end gap-3 pointer-events-none">
            <button type="button" onclick="openManualEntry()" class="pointer-events-auto flex items-center justify-center px-5 py-3 rounded-2xl bg-pnp-blue text-white dark:bg-pnp-gold dark:text-pnp-blue font-black text-xs uppercase tracking-widest hover:-translate-y-0.5 active:scale-95 transition-all duration-200 shadow-2xl border border-white/20 cursor-pointer">
                <i class="fas fa-plus mr-2 text-sm"></i> Add New Record
            </button>
            
            <button id="mapSidebarToggle" onclick="toggleMapSidebar()" class="pointer-events-auto lg:hidden w-12 h-12 bg-pnp-blue text-white rounded-full shadow-2xl flex items-center justify-center text-lg active:scale-95 transition-all duration-200 border border-white/10" aria-label="Toggle map sidebar">
                <i class="fas fa-filter"></i>
            </button>
        </div>

        <!-- Leaflet Map Element -->
        <div id="leafletMap" class="h-full w-full transition-all duration-300"></div>

        <!-- Loading Overlay -->
        <div id="mapLoading" class="absolute inset-0 bg-pnp-blue z-[1200] flex flex-col items-center justify-center text-white transition-opacity duration-500">
            <div class="w-20 h-20 border-4 border-pnp-gold border-t-transparent rounded-full animate-spin mb-6"></div>
            <p class="text-xs font-black uppercase tracking-[0.3em] animate-pulse">Initializing Secure Map Data...</p>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. DEDICATED MANUAL ENTRY MODAL           -->
<!-- ========================================== -->
<div id="manualEntryModal" class="fixed inset-0 z-[2500] hidden items-center justify-center bg-slate-950/75 dark:bg-slate-950/85 backdrop-blur-md p-3 sm:p-5 animate-modal-backdrop">
    <div class="modal-dialog-card bg-white dark:bg-slate-800 w-full max-w-5xl xl:max-w-6xl rounded-3xl shadow-2xl border border-gray-200/90 dark:border-slate-700/80 overflow-hidden flex flex-col h-[82vh] max-h-[82vh] animate-modal-pop">
        <!-- Header -->
        <div class="px-5 py-3.5 sm:px-6 sm:py-4 border-b border-gray-100 dark:border-slate-700/80 bg-gray-50/70 dark:bg-slate-900/70 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 sm:gap-4 flex-shrink-0">
            <div class="flex items-center space-x-3.5">
                <div class="w-10 h-10 bg-pnp-blue text-white rounded-xl flex items-center justify-center border border-white/20 shadow-md flex-shrink-0">
                    <i class="fas fa-keyboard text-lg text-white"></i>
                </div>
                <div>
                    <h3 class="text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-wider text-sm sm:text-base leading-tight">Manual Input</h3>
                    <p id="manualRowCount" class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Direct Grid Recording Session</p>
                </div>
            </div>

            <!-- Filters & Counters -->
            <div class="flex items-center space-x-2.5 bg-white dark:bg-slate-700/80 p-1.5 rounded-xl border border-gray-100 dark:border-slate-600/80 shadow-2xs">
                <select id="manualCategoryFilter" onchange="renderManualTable()" class="bg-transparent border-none text-[11px] font-black text-pnp-blue dark:text-pnp-gold uppercase px-3 py-1 outline-none cursor-pointer">
                    <option value="All">All Categories</option>
                    <option value="8-Focus">8-Focus Target</option>
                    <option value="Non-Index">Non-Index</option>
                    <option value="PSI" title="PUBLIC SAFETY INCIDENT">PSI Sector</option>
                </select>
                <div class="w-px h-5 bg-gray-200 dark:bg-slate-600"></div>
                <div class="flex items-center space-x-3.5 px-3 py-1">
                    <div class="flex items-center space-x-1.5" title="8-Focus Total"><div class="w-2 h-2 rounded-full bg-red-500 shadow-2xs shadow-red-500/50"></div><span id="manualCount8Focus" class="text-xs font-black text-pnp-blue dark:text-white">0</span></div>
                    <div class="flex items-center space-x-1.5" title="Non-Index Total"><div class="w-2 h-2 rounded-full bg-slate-500 shadow-2xs shadow-slate-500/50"></div><span id="manualCountNonIndex" class="text-xs font-black text-pnp-blue dark:text-white">0</span></div>
                    <div class="flex items-center space-x-1.5 cursor-help" title="PUBLIC SAFETY INCIDENT Total"><div class="w-2 h-2 rounded-full bg-blue-500 shadow-2xs shadow-blue-500/50"></div><span id="manualCountPSI" class="text-xs font-black text-pnp-blue dark:text-white">0</span></div>
                </div>
            </div>

            <button type="button" onclick="closeManualEntry()" class="w-8 h-8 rounded-xl bg-gray-100 dark:bg-slate-700 text-gray-500 hover:bg-red-500 hover:text-white transition-all transform hover:rotate-90 flex items-center justify-center shadow-2xs cursor-pointer flex-shrink-0 self-end sm:self-center" title="Close">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <!-- Top Error Notification Banner for Detected Issues in Manual Entry -->
