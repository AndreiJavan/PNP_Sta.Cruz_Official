    window.executeBatchGeneration = function() {
        const countInput = document.getElementById('batchCount');
        const brgySelect = document.getElementById('batchBarangaySelect');
        const daySelect = document.getElementById('batchDaySelect');
        const monthSelect = document.getElementById('batchMonthSelect');
        const yearSelect = document.getElementById('batchYearSelect');
        const catSelect = document.getElementById('batchCategorySelect');
        const offenseInput = document.getElementById('batchOffenseInput');

        const rawCount = parseInt(countInput ? countInput.value : '1') || 0;
        if (rawCount < 1) {
            (window.strategicAlert || alert)({
                title: "Invalid Row Count",
                message: "Please enter a valid number of rows (minimum 1).",
                type: "warning"
            });
            return;
        }
        if (rawCount > 50) {
            (window.strategicAlert || alert)({
                title: "Row Limit Exceeded",
                message: "Maximum row generation limit is 50 rows per batch.",
                type: "warning"
            });
            return;
        }
        const count = rawCount;
        const barangay = (brgySelect ? brgySelect.value : '') || VALID_BARANGAYS[0];
        
        const dayVal = daySelect ? daySelect.value : String(new Date().getDate()).padStart(2, '0');
        const monthVal = monthSelect ? monthSelect.value : String(new Date().getMonth() + 1).padStart(2, '0');
        const yearVal = yearSelect ? yearSelect.value : String(new Date().getFullYear());
        const dateVal = `${yearVal}-${monthVal}-${dayVal}`;

        const category = (catSelect ? catSelect.value : '') || 'Non-Index';
        const offense = offenseInput ? offenseInput.value.trim() : '';

        if (offense && offense.length > 300) {
            (window.strategicAlert || alert)({
                title: "Classification Too Long",
                message: `Crime classification must not exceed 300 letters (currently: ${offense.length}).`,
                type: "warning"
            });
            return;
        }
        const offenseWords = offense ? offense.split(/\s+/).filter(Boolean) : [];
        if (offenseWords.length > 50) {
            (window.strategicAlert || alert)({
                title: "Classification Word Limit Exceeded",
                message: `Crime classification must not exceed 50 words (currently: ${offenseWords.length} words).`,
                type: "warning"
            });
            return;
        }

        const todayStr = new Date().toISOString().split('T')[0];

        if (!dateVal || dateVal > todayStr || dateVal < '2024-01-01') {
            (window.strategicAlert || alert)({
                title: "Invalid Timeline Date",
                message: `Timeline date must be between January 1, 2024 and today (${todayStr}). Future dates are restricted.`,
                type: "warning"
            });
            return;
        }

        const newRows = [];
        for (let i = 0; i < count; i++) {
            newRows.push({
                barangay: barangay,
                date_committed: dateVal,
                incident_date: dateVal,
                offense: offense,
                incident_type: offense,
                category: category,
                description: ''
            });
        }

        if (targetInsertIndex !== null && targetInsertIndex >= 0 && targetInsertIndex <= manualData.length) {
            manualData.splice(targetInsertIndex, 0, ...newRows);
        } else {
            manualData.push(...newRows);
        }
        reviewData = manualData;

        closeBatchGeneratorModal();
        renderManualTable();

        setTimeout(() => {
            const tbody = document.getElementById('manualTableBody');
            const container = tbody ? tbody.closest('.overflow-auto') : null;
            if (container) {
                container.scrollTop = container.scrollHeight;
            }
        }, 50);
    };

    // --- CONFIRMATION & CENTRAL STORAGE ---
    window.confirmManualEntry = async function() {
        if (!manualData || manualData.length === 0) {
            await (window.strategicAlert || alert)({
                title: "No Data",
                message: "There are no manual records to synchronize. Please enter at least one record.",
                type: "warning"
            });
            return;
        }

        // Normalize barangays
        for (let i = 0; i < manualData.length; i++) {
            const r = manualData[i];
            if (r.barangay) {
                const cleanB = String(r.barangay).trim();
                const matchedB = VALID_BARANGAYS.find(b => 
                    b.toLowerCase() === cleanB.toLowerCase() ||
                    b.toLowerCase() === cleanB.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase() ||
                    cleanB.toLowerCase().includes(b.toLowerCase())
                );
                if (matchedB) r.barangay = matchedB;
            }
        }

        // Validate all rows
        const uncorrectedRows = [];
        manualData.forEach((r, idx) => {
            const issues = window.checkRecordIssues(r);
            if (issues.length > 0) {
                uncorrectedRows.push({ rowNumber: idx + 1, issues });
            }
        });

        if (uncorrectedRows.length > 0) {
            let errorWarningMessage = `Validation Block: There are ${uncorrectedRows.length} row(s) containing errors that are not applicable to continue:\n`;
            uncorrectedRows.slice(0, 10).forEach(item => {
                const issueDescriptions = item.issues.map(iss => `${iss.label}: ${iss.msg}`).join(', ');
                errorWarningMessage += `\n• Row #${item.rowNumber}: ${issueDescriptions}`;
            });
            if (uncorrectedRows.length > 10) {
                errorWarningMessage += `\n• ...and ${uncorrectedRows.length - 10} more row(s).`;
            }
            errorWarningMessage += `\n\nPlease resolve all highlighted fields before continuing.`;

            await (window.strategicAlert || (async (opts) => alert(opts.message)))({
                title: "Cannot Continue: Errors Detected",
                message: errorWarningMessage,
                type: "warning"
            });

            const firstInvalid = document.querySelector('#manualTableBody tr.has-error');
            if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }

        const confirmed = await (window.strategicConfirm || (async () => confirm(`Commit ${manualData.length} manual records to the CPICRS Central Database?`)))({
            title: "Manual Dataset Confirmation",
            message: `Commit ${manualData.length} verified manual records to the CPICRS Central Database?\n\nSelect 'Confirm' to synchronize and plot on the map.`,
            confirmText: "Confirm",
            cancelText: "Cancel",
            type: "info"
        });
        if (!confirmed) return;

        const syncBtn = document.getElementById('btnConfirmManual');
        const originalContent = syncBtn ? syncBtn.innerHTML : '';
        if (syncBtn) {
            syncBtn.disabled = true;
            syncBtn.classList.add('opacity-50', 'cursor-not-allowed');
            syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Syncing...';
        }

        try {
            const formattedEntries = manualData.map(r => ({
                barangay: r.barangay,
                incident_date: r.date_committed || r.incident_date,
                date_committed: r.date_committed || r.incident_date,
                category: r.category || 'Non-Index',
                incident_type: (r.offense || r.incident_type || '').trim(),
                offense: (r.offense || r.incident_type || '').trim(),
                description: r.description ? r.description.trim() : 'Manual direct map recording'
            }));

            const response = await fetch('/admin/reports/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                   entries: formattedEntries, 
                   filename: `Manual Entry (${new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })})`,
                   entryType: 'manual' 
                })
            });
            const result = await response.json();

            if (result.success) {
                if (result.report) {
                    if (!window.storedReportsList) window.storedReportsList = [];
                    window.storedReportsList.unshift({
                        id: result.report.id,
                        filename: result.report.filename || 'Manual Entry Session',
                        timestamp: result.report.timestamp || new Date().toISOString(),
                        total_records: result.count || formattedEntries.length,
                        category_stats: result.report.category_stats || {},
                        entry_type: 'manual',
                        barangay: formattedEntries[0]?.barangay || 'All Sectors'
                    });
                    const countBadge = document.getElementById('mapReportsCountBadge');
                    if (countBadge) countBadge.textContent = window.storedReportsList.length;
                    const tabBadge = document.getElementById('tabReportsBadge');
                    if (tabBadge) tabBadge.textContent = window.storedReportsList.length;
                }

                // Invalidate points cache and reload map data immediately so new incidents show on the map!
                allMapPointsCached = [];
                await loadMapPoints(false);

                // Re-render Stored Reports list view
                renderStoredReportsList();

                closeManualEntry();

                if (typeof window.showMapToast === 'function') {
                    showMapToast(`${result.count || formattedEntries.length} record${(result.count || formattedEntries.length) > 1 ? 's' : ''} stored and plotted on map!`);
                } else if (typeof window.strategicAlert === 'function') {
                    await window.strategicAlert({
                        title: "Sync Successful",
                        message: `Archive Updated: ${result.count || formattedEntries.length} manual records committed and plotted on map.`,
                        type: "success"
                    });
                }
            } else {
                await (window.strategicAlert || (async (opts) => alert(opts.message)))({
                    title: "Sync Error",
                    message: result.error || result.message || "Failed to commit manual records.",
                    type: "error"
                });
                if (syncBtn) {
                    syncBtn.disabled = false;
                    syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    syncBtn.innerHTML = originalContent;
                }
            }
        } catch (err) {
            console.error("Sync Error:", err);
            await (window.strategicAlert || (async (opts) => alert(opts.message)))({
                title: "System Error",
                message: "Network or server failure during data synchronization.",
                type: "error"
            });
            if (syncBtn) {
                syncBtn.disabled = false;
                syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                syncBtn.innerHTML = originalContent;
            }
        }
    };

    window.showMapToast = function(msg) {
        let toast = document.getElementById('mapActionToast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'mapActionToast';
            toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-[3000] px-5 py-3 rounded-2xl bg-slate-900 text-white font-black text-xs uppercase tracking-wider border border-pnp-gold/60 shadow-2xl transition-all duration-300 opacity-0 pointer-events-none flex items-center gap-2';
            document.body.appendChild(toast);
        }
        toast.innerHTML = `<i class="fas fa-circle-check text-emerald-400"></i><span>${msg}</span>`;
        toast.classList.remove('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            toast.classList.add('opacity-0', 'pointer-events-none');
        }, 4000);
    };


    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const barangayParam = urlParams.get('barangay');
        targetHighlightBarangay = barangayParam;
        const offenseParam = urlParams.get('offense');
        const latParam = parseFloat(urlParams.get('lat'));
        const lngParam = parseFloat(urlParams.get('lng'));

        if (barangayParam) {
            const barangaySelect = document.getElementById('filterBarangay');
            if (barangaySelect) {
                const options = Array.from(barangaySelect.options);
                const exactMatch = options.find(opt => opt.value.toLowerCase() === barangayParam.toLowerCase());
                if (exactMatch) {
                    barangaySelect.value = exactMatch.value;
                }
            }
        }

        // Prefill default custom range picker dates
        const currentYear = new Date().getFullYear();
        const fromDateInput = document.getElementById('filterFromDate');
        const toDateInput = document.getElementById('filterToDate');
        const todayStr = new Date().toISOString().split('T')[0];
        if (fromDateInput) {
            fromDateInput.value = `${currentYear}-01-01`;
            fromDateInput.setAttribute('max', todayStr);
        }
        if (toDateInput) {
            toDateInput.value = todayStr;
            toDateInput.setAttribute('max', todayStr);
        }

        // Initialize display badge text
        updateActivePeriodDisplay();
        renderStoredReportsList();

        initMap();
        if (typeof updateTopLeftLegend === 'function') {
            updateTopLeftLegend('overview');
        }

        if (!isNaN(latParam) && !isNaN(lngParam) && latParam !== 0 && lngParam !== 0) {
            setTimeout(() => {
                if (window.map) {
                    window.map.flyTo([latParam, lngParam], 16, { duration: 1.5 });
                    
                    const highlightPulse = L.divIcon({
                        className: 'crime-highlight-marker',
                        html: `
                            <div class="relative flex items-center justify-center">
                                <div class="absolute w-12 h-12 bg-red-500/50 rounded-full animate-ping"></div>
                                <div class="w-8 h-8 bg-red-600 rounded-full border-2 border-white flex items-center justify-center text-white shadow-2xl z-10">
                                    <i class="fas fa-bullseye text-xs"></i>
                                </div>
                            </div>
                        `,
                        iconSize: [32, 32],
                        iconAnchor: [16, 16]
                    });

                    const popupContent = `
                        <div class="p-3 text-center min-w-[140px]">
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-red-500 text-white tracking-widest inline-block">${offenseParam || 'CRIME INCIDENT'}</span>
                            <p class="text-xs font-black text-slate-800 dark:text-white mt-2 uppercase">BRGY. ${barangayParam || 'LOCATION'}</p>
                            <p class="text-[10px] text-slate-400 font-mono mt-1">${latParam.toFixed(4)}, ${lngParam.toFixed(4)}</p>
                        </div>
                    `;

                    highlightMarker = L.marker([latParam, lngParam], { icon: highlightPulse }).addTo(window.map).bindPopup(popupContent).openPopup();
                    updateHighlightMarkerVisibility();
                }
            }, 1000);
        }

        // Robust event listeners for all map filters
        const setupListener = (id, callback) => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('change', callback);
                el.addEventListener('input', callback); // Catch changes faster in some browsers
            }
        };

        setupListener('mapDisplayMode', () => {
            updateHeatmap();
            updateLegend();
            updateSidebarStats();
        });

        setupListener('filterBarangay', () => loadMapPoints());
    });
</script>

