    function getBarangayLabel(name, zoom) {
        let shortName = name;
        const pobMatch = name.match(/Poblacion (I{1,3}|IV|V)/);
        if (pobMatch) {
            const romanToNum = { 'I': '1', 'II': '2', 'III': '3', 'IV': '4', 'V': '5' };
            shortName = `Pob ${romanToNum[pobMatch[1]]}`;
        } else {
            shortName = name.replace('Santo Angel ', 'Sto. Angel ').replace('San Pablo ', 'S. Pablo ');
        }

        const selected = document.getElementById('filterBarangay') ? document.getElementById('filterBarangay').value : '';
        const isSelected = selected && selected.toLowerCase() === name.toLowerCase();
        const selClass = isSelected ? ' is-selected' : '';

        // When viewing Stored Files: integrate the count into the label!
        if (window.currentSidebarView === 'reports' || window.activeReportFilter) {
            const pts = currentPoints || [];
            const count = pts.filter(p => p.barangay === name).length;
            const isTop = window.activeReportTopBrgy === name;

            if (count > 0) {
                if (isTop) {
                    return `<div class="brgy-label-unified is-top${selClass}"><span class="brgy-label-name">${shortName}</span><span class="brgy-label-badge top-badge"><i class="fas fa-crown text-yellow-300 text-[6.5px]"></i>${count}</span></div>`;
                } else {
                    return `<div class="brgy-label-unified${selClass}"><span class="brgy-label-name">${shortName}</span><span class="brgy-label-badge">${count}</span></div>`;
                }
            } else {
                return `<div class="brgy-label-unified is-dim${selClass}"><span class="brgy-label-name">${shortName}</span></div>`;
            }
        }

        return `<div class="brgy-label-unified${selClass}"><span class="brgy-label-name">${shortName}</span></div>`;
    }

    function getTacticalColor(name) {
        if (!name) return '#ccc';
        const searchName = name.trim().toUpperCase();
        for (const [key, color] of Object.entries(allColors)) {
            if (key.toUpperCase() === searchName) return color;
        }
        for (const [key, color] of Object.entries(allColors)) {
            if (searchName.includes(key.toUpperCase()) || key.toUpperCase().includes(searchName)) return color;
        }
        return '#ccc';
    }

