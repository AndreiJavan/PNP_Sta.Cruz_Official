    window.locateTopSectorForReport = function(points) {
        if (selectedPinsLayer) selectedPinsLayer.clearLayers();

        const pts = points || currentPoints || [];
        if (!pts.length) {
            window.activeReportTopBrgy = null;
            window.activeReportTopCount = 0;
            window.activeReportBrgyRanking = [];
            fitWholeMapBounds();
            if (typeof updateBarangayLabels === 'function') updateBarangayLabels();
            return null;
        }

        // Aggregate cases by sector/barangay
        const brgyCounts = {};
        pts.forEach(p => {
            if (p.barangay) {
                brgyCounts[p.barangay] = (brgyCounts[p.barangay] || 0) + 1;
            }
        });

        const sorted = Object.entries(brgyCounts).sort((a, b) => b[1] - a[1]);
        if (!sorted.length) {
            window.activeReportTopBrgy = null;
            window.activeReportTopCount = 0;
            window.activeReportBrgyRanking = [];
            fitWholeMapBounds();
            if (typeof updateBarangayLabels === 'function') updateBarangayLabels();
            return null;
        }

        const [topName, topCount] = sorted[0];
        window.activeReportTopBrgy = topName;
        window.activeReportTopCount = topCount;
        window.activeReportBrgyRanking = sorted;

        // 1. Center the whole map comfortably in the visible canvas area
        fitWholeMapBounds();

        // 2. Update the unified labels on the polygons (NO duplicate markers!)
        if (typeof updateBarangayLabels === 'function') updateBarangayLabels();
        setTimeout(() => {
            if (typeof manageTooltipVisibility === 'function') manageTooltipVisibility();
        }, 150);

        return { name: topName, count: topCount, ranking: sorted };
    };

    window.focusBarangay = function(bName) {
        if (!bName) return;
        const barangaySelect = document.getElementById('filterBarangay');
        if (barangaySelect) {
            barangaySelect.value = bName;
