                confirmBtn.innerHTML = `<i class="fas fa-check-circle"></i> <span>Confirm</span>`;
            }
        }
    };

    // --- LIVE CELL INPUT HANDLERS ---
    window.handleStagingOffenseInput = function(type, index, value) {
        if (!manualData[index]) return;
        manualData[index].offense = value;
        manualData[index].incident_type = value;
        
        const issues = window.checkRecordIssues(manualData[index]);
        const crimeIssue = issues.find(i => i.field === 'offense');
        const td = document.getElementById(`manualCrimeTd_${index}`);
        const errSpan = document.getElementById(`manualCrimeError_${index}`);
        const rowEl = document.getElementById(`manualRow_${index}`);
        const fixBadge = document.getElementById(`manualFixBadge_${index}`);

        if (crimeIssue) {
            if (td) td.classList.add('bg-amber-500/15', 'ring-2', 'ring-amber-400', 'ring-inset');
            if (errSpan) {
                errSpan.textContent = crimeIssue.msg;
                errSpan.classList.remove('hidden');
            }
        } else {
            if (td) td.classList.remove('bg-amber-500/15', 'ring-2', 'ring-amber-400', 'ring-inset');
            if (errSpan) errSpan.classList.add('hidden');
        }

        if (issues.length > 0) {
            if (rowEl) {
                rowEl.classList.add('has-error', 'bg-amber-500/10', 'dark:bg-amber-950/20', 'border-amber-400/40');
                rowEl.classList.remove('bg-white', 'dark:bg-slate-900', 'border-gray-100', 'dark:border-slate-800');
            }
            if (fixBadge) fixBadge.classList.remove('hidden');
        } else {
            if (rowEl) {
                rowEl.classList.remove('has-error', 'bg-amber-500/10', 'dark:bg-amber-950/20', 'border-amber-400/40');
                rowEl.classList.add('bg-white', 'dark:bg-slate-900', 'border-gray-100', 'dark:border-slate-800');
            }
            if (fixBadge) fixBadge.classList.add('hidden');
        }

        window.refreshModalErrorState('manual');
    };

    window.handleStagingDateChange = function(type, index, part, value) {
        if (!manualData[index]) return;
        const rawDateStr = manualData[index].date_committed || manualData[index].date || manualData[index].incident_date || new Date().toISOString().split('T')[0];
        const parts = rawDateStr.split('-');
        let y = parts[0] || '2026';
        let m = parts[1] || '01';
        let d = parts[2] || '01';

        if (part === 'day') d = String(value).padStart(2, '0');
        if (part === 'month') m = String(value).padStart(2, '0');
        if (part === 'year') y = String(value);

        const newDate = `${y}-${m}-${d}`;
        manualData[index].date_committed = newDate;
        manualData[index].date = newDate;
        manualData[index].incident_date = newDate;

        const issues = window.checkRecordIssues(manualData[index]);
        const dateIssue = issues.find(i => i.field === 'date');
        const td = document.getElementById(`manualDateTd_${index}`);
        const errSpan = document.getElementById(`manualDateError_${index}`);
        const rowEl = document.getElementById(`manualRow_${index}`);
        const fixBadge = document.getElementById(`manualFixBadge_${index}`);

        if (dateIssue) {
            if (td) td.classList.add('bg-amber-500/15', 'ring-2', 'ring-amber-400', 'ring-inset');
            if (errSpan) {
                errSpan.textContent = dateIssue.msg;
                errSpan.classList.remove('hidden');
            }
        } else {
            if (td) td.classList.remove('bg-amber-500/15', 'ring-2', 'ring-amber-400', 'ring-inset');
            if (errSpan) errSpan.classList.add('hidden');
        }

        if (issues.length > 0) {
            if (rowEl) {
                rowEl.classList.add('has-error', 'bg-amber-500/10', 'dark:bg-amber-950/20', 'border-amber-400/40');
                rowEl.classList.remove('bg-white', 'dark:bg-slate-900', 'border-gray-100', 'dark:border-slate-800');
            }
            if (fixBadge) fixBadge.classList.remove('hidden');
        } else {
            if (rowEl) {
                rowEl.classList.remove('has-error', 'bg-amber-500/10', 'dark:bg-amber-950/20', 'border-amber-400/40');
                rowEl.classList.add('bg-white', 'dark:bg-slate-900', 'border-gray-100', 'dark:border-slate-800');
            }
            if (fixBadge) fixBadge.classList.add('hidden');
        }

        window.refreshModalErrorState('manual');
    };

