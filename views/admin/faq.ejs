<div class="space-y-6">
    <!-- Header Section with Tactical Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-6 rounded-2xl md:rounded-3xl shadow-sm border border-white/80 dark:border-slate-700/80">
        <div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-pnp-blue/10 dark:bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold flex items-center justify-center text-lg font-black shadow-xs">
                    <i class="fas fa-circle-question"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white tracking-tight uppercase">
                        Station FAQ Management
                    </h1>
                    <p class="text-xs md:text-sm text-slate-500 dark:text-slate-400 font-medium">
                        Configure official station questions, verified answers, search keywords, and bilingual responses for the public assistant.
                    </p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button type="button" onclick="openAddFaqModal()"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-pnp-blue to-blue-800 hover:from-blue-800 hover:to-blue-900 text-white font-bold text-xs uppercase tracking-widest shadow-lg shadow-blue-900/20 active:scale-95 transition-all duration-200">
                <i class="fas fa-plus"></i>
                <span>Add New FAQ</span>
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <% 
        const totalCount = faqs.length;
        const categoriesSet = new Set();
        let bilingualCount = 0;
        faqs.forEach(f => {
            if (f.category) categoriesSet.add(f.category);
            if (f.titleFil && f.summaryFil) bilingualCount++;
        });
        const categoriesList = Array.from(categoriesSet);
    %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Total FAQs -->
        <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-5 rounded-2xl shadow-sm border border-white/80 dark:border-slate-700/80 flex items-center justify-between">
            <div>
                <p class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 tracking-widest">Total Knowledge Items</p>
                <h3 class="text-2xl font-black text-pnp-blue dark:text-pnp-gold mt-1"><%= totalCount %></h3>
            </div>
            <div class="w-11 h-11 rounded-xl bg-blue-50 dark:bg-slate-700/60 text-pnp-blue dark:text-pnp-gold flex items-center justify-center text-lg">
                <i class="fas fa-book-bookmark"></i>
            </div>
        </div>

        <!-- Categories -->
        <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-5 rounded-2xl shadow-sm border border-white/80 dark:border-slate-700/80 flex items-center justify-between">
            <div>
                <p class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 tracking-widest">Active Categories</p>
                <h3 class="text-2xl font-black text-indigo-600 dark:text-indigo-400 mt-1"><%= categoriesList.length %></h3>
            </div>
            <div class="w-11 h-11 rounded-xl bg-indigo-50 dark:bg-slate-700/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-lg">
                <i class="fas fa-layer-group"></i>
            </div>
        </div>

        <!-- Bilingual Coverage -->
        <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-5 rounded-2xl shadow-sm border border-white/80 dark:border-slate-700/80 flex items-center justify-between">
            <div>
                <p class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 tracking-widest">Bilingual (EN / FIL)</p>
                <h3 class="text-2xl font-black text-emerald-600 dark:text-emerald-400 mt-1">
                    <%= bilingualCount %> <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">/ <%= totalCount %></span>
                </h3>
            </div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 dark:bg-slate-700/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg">
                <i class="fas fa-language"></i>
            </div>
        </div>

        <!-- Assistant Status -->
        <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-5 rounded-2xl shadow-sm border border-white/80 dark:border-slate-700/80 flex items-center justify-between">
            <div>
                <p class="text-[10px] uppercase font-bold text-slate-400 dark:text-slate-500 tracking-widest">Assistant Sync</p>
                <div class="flex items-center gap-2 mt-1">
                    <span class="inline-flex w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-sm font-black text-slate-800 dark:text-white uppercase tracking-wider">Live Active</span>
                </div>
            </div>
            <div class="w-11 h-11 rounded-xl bg-amber-50 dark:bg-slate-700/60 text-pnp-gold flex items-center justify-center text-lg">
                <i class="fas fa-satellite-dish"></i>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-4 rounded-2xl shadow-sm border border-white/80 dark:border-slate-700/80 space-y-4">
        <div class="flex flex-col md:flex-row items-center gap-3">
            <!-- Search Bar -->
            <div class="relative w-full md:w-96">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400 text-sm">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" id="faqSearchInput" oninput="filterFaqs()"
                    placeholder="Search question, keyword, or answer..."
                    class="w-full pl-10 pr-9 py-2.5 bg-gray-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue transition-all">
                <button type="button" id="faqSearchClear" onclick="clearFaqSearch()" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hidden">
                    <i class="fas fa-circle-xmark text-sm"></i>
                </button>
            </div>

            <!-- Category Pills -->
            <div class="flex items-center gap-1.5 overflow-x-auto w-full pb-1 md:pb-0 scrollbar-none" id="faqCategoryFilterContainer">
                <button type="button" onclick="selectFaqCategory('ALL')"
                    data-category="ALL"
                    class="faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-200 bg-pnp-blue text-white shadow-xs">
                    All (<%= totalCount %>)
                </button>
                <% categoriesList.forEach(cat => { 
                    const countForCat = faqs.filter(f => f.category === cat).length;
                %>
                    <button type="button" onclick="selectFaqCategory('<%= cat %>')"
                        data-category="<%= cat %>"
                        class="faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600">
                        <%= cat %> (<%= countForCat %>)
                    </button>
                <% }) %>
            </div>
        </div>
    </div>

    <!-- FAQ Cards List -->
    <div id="faqListContainer" class="space-y-4">
        <% if (faqs.length === 0) { %>
            <div class="bg-white/85 dark:bg-slate-800/85 backdrop-blur-md p-12 rounded-3xl text-center border border-white/80 dark:border-slate-700/80">
                <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-slate-700/60 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h3 class="text-base font-bold text-slate-700 dark:text-slate-200">No FAQ items found</h3>
                <p class="text-xs text-slate-400 mt-1">Get started by creating your first official FAQ question and answer.</p>
                <button type="button" onclick="openAddFaqModal()"
                    class="mt-4 px-4 py-2 bg-pnp-blue text-white font-bold text-xs uppercase tracking-widest rounded-xl hover:bg-blue-900 transition">
                    + Add New FAQ
                </button>
            </div>
        <% } %>

        <% faqs.forEach((faq, index) => { %>
            <div class="faq-card bg-white/85 dark:bg-slate-800/85 backdrop-blur-md rounded-2xl md:rounded-3xl p-5 md:p-6 shadow-sm border border-white/80 dark:border-slate-700/80 transition-all duration-200 hover:shadow-md"
                data-id="<%= faq.id %>"
                data-category="<%= faq.category || 'General' %>"
                data-title-en="<%= (faq.title || '').toLowerCase() %>"
                data-title-fil="<%= (faq.titleFil || '').toLowerCase() %>"
                data-keywords="<%= ((faq.keywords || []).join(' ')).toLowerCase() %>"
                data-summary-en="<%= (faq.summaryEn || '').toLowerCase() %>">
                
                <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-4">
                    <!-- Left Column: Content -->
                    <div class="space-y-3 flex-1 min-w-0">
                        <!-- Top Metadata Row -->
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 font-mono">
                                #<%= faq.display_order ?? (index + 1) %>
                            </span>
                            
                            <% 
                                const cat = faq.category || 'General';
                                let catColor = 'bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-900/30 dark:text-blue-300 dark:border-blue-800';
                                if (cat === 'Emergency') catColor = 'bg-red-50 text-red-700 border-red-200 dark:bg-red-900/30 dark:text-red-300 dark:border-red-800';
                                else if (cat === 'Clearance') catColor = 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/30 dark:text-emerald-300 dark:border-emerald-800';
                                else if (cat === 'Blotter') catColor = 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800';
                                else if (cat === 'Cybercrime') catColor = 'bg-purple-50 text-purple-700 border-purple-200 dark:bg-purple-900/30 dark:text-purple-300 dark:border-purple-800';
                                else if (cat === 'WCPD') catColor = 'bg-pink-50 text-pink-700 border-pink-200 dark:bg-pink-900/30 dark:text-pink-300 dark:border-pink-800';
                                else if (cat === 'Crime Map') catColor = 'bg-teal-50 text-teal-700 border-teal-200 dark:bg-teal-900/30 dark:text-teal-300 dark:border-teal-800';
                                else if (cat === 'Traffic') catColor = 'bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-900/30 dark:text-orange-300 dark:border-orange-800';
                            %>
                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-wider border <%= catColor %>">
                                <%= cat %>
                            </span>

                            <% if (faq.titleFil && faq.summaryFil) { %>
                                <span class="px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 flex items-center gap-1">
                                    <i class="fas fa-check text-[8px]"></i> EN & FIL
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400">
                                    EN Only
                                </span>
                            <% } %>
                        </div>

                        <!-- Question Headers (Bilingual) -->
                        <div class="space-y-1">
                            <h3 class="text-base md:text-lg font-black text-slate-900 dark:text-white tracking-tight flex items-start gap-2">
                                <span class="text-pnp-blue dark:text-pnp-gold font-mono text-sm mt-0.5">Q:</span>
                                <span><%= faq.title %></span>
                            </h3>
                            <% if (faq.titleFil) { %>
                                <p class="text-xs md:text-sm font-semibold text-slate-500 dark:text-slate-400 italic flex items-start gap-2 pl-5">
                                    <span class="text-slate-400 font-mono text-[10px] uppercase font-bold not-italic">FIL:</span>
                                    <span><%= faq.titleFil %></span>
                                </p>
                            <% } %>
                        </div>

                        <!-- Answer / Summary (Collapsible) -->
                        <div class="mt-2 text-xs md:text-sm text-slate-700 dark:text-slate-300 leading-relaxed bg-slate-50/70 dark:bg-slate-900/50 p-4 rounded-xl border border-slate-200/60 dark:border-slate-800">
                            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-200/60 dark:border-slate-800">
                                <span class="text-[10px] uppercase font-bold tracking-widest text-slate-400 dark:text-slate-500">Official Station Answer</span>
                                <button type="button" onclick="toggleAnswerPreview('<%= faq.id %>')" class="text-xs text-pnp-blue dark:text-pnp-gold font-bold hover:underline">
                                    <span id="answerToggleText_<%= faq.id %>">Show Filipino</span>
                                </button>
                            </div>
                            <!-- English Answer -->
                            <div id="answerEn_<%= faq.id %>" class="space-y-1 whitespace-pre-line font-normal">
                                <%= faq.summaryEn %>
                            </div>
                            <!-- Filipino Answer (Hidden by default toggle) -->
                            <% if (faq.summaryFil) { %>
                                <div id="answerFil_<%= faq.id %>" class="space-y-1 whitespace-pre-line font-normal hidden border-t border-slate-200/60 dark:border-slate-800 pt-3 mt-3 text-slate-600 dark:text-slate-300">
                                    <p class="text-[10px] font-bold text-pnp-blue dark:text-pnp-gold uppercase tracking-wider mb-1">Kasagutan sa Filipino:</p>
                                    <%= faq.summaryFil %>
                                </div>
                            <% } %>
                        </div>

                        <!-- Keywords & Near Questions Tags -->
                        <div class="flex flex-wrap items-center gap-1.5 pt-1">
                            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider mr-1">
                                <i class="fas fa-tags text-[9px] mr-1"></i> Keywords:
                            </span>
                            <% (faq.keywords || []).forEach(kw => { %>
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                    <%= kw %>
                                </span>
                            <% }) %>
                        </div>

                        <% if ((faq.nearQuestionsEn && faq.nearQuestionsEn.length > 0) || (faq.nearQuestionsFil && faq.nearQuestionsFil.length > 0)) { %>
                            <div class="pt-1">
                                <details class="group text-xs text-slate-500 dark:text-slate-400">
                                    <summary class="cursor-pointer font-bold text-[10px] uppercase tracking-wider hover:text-pnp-blue dark:hover:text-pnp-gold transition-colors inline-flex items-center gap-1">
                                        <i class="fas fa-chevron-right text-[8px] transition-transform group-open:rotate-90"></i>
                                        <span>View Suggested Follow-ups (<%= (faq.nearQuestionsEn || []).length %>)</span>
                                    </summary>
                                    <div class="mt-2 pl-3 border-l-2 border-slate-200 dark:border-slate-700 space-y-1">
                                        <% (faq.nearQuestionsEn || []).forEach(nq => { %>
                                            <p class="text-[11px] text-slate-600 dark:text-slate-300">• <%= nq %></p>
                                        <% }) %>
                                    </div>
                                </details>
                            </div>
                        <% } %>
                    </div>

                    <!-- Right Column: Actions -->
                    <div class="flex lg:flex-col items-center gap-2 pt-2 lg:pt-0 shrink-0 border-t lg:border-t-0 border-slate-100 dark:border-slate-700">
                        <button type="button" onclick="openEditFaqModal(<%= JSON.stringify(faq).replace(/"/g, '&quot;') %>)"
                            class="flex-1 lg:flex-initial inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-blue-50 dark:bg-slate-700 hover:bg-blue-100 dark:hover:bg-slate-600 text-pnp-blue dark:text-pnp-gold font-bold text-xs uppercase tracking-wider transition">
                            <i class="fas fa-edit text-xs"></i>
                            <span>Edit</span>
                        </button>

                        <form action="/admin/faq/<%= faq.id %>/delete" method="POST" class="flex-1 lg:flex-initial"
                            onsubmit="confirmOperationalAction(event, { title: 'Delete FAQ', message: 'Are you sure you want to delete this FAQ item? It will be archived in the Recycle Bin for recovery.', confirmText: 'Delete FAQ', type: 'danger' }); return false;">
                            <button type="submit"
                                class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 text-red-600 dark:text-red-400 font-bold text-xs uppercase tracking-wider transition">
                                <i class="fas fa-trash-can text-xs"></i>
                                <span>Delete</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- ========================================================================= -->
<!-- ADD NEW FAQ MODAL                                                         -->
<!-- ========================================================================= -->
<div id="addFaqModal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-3 sm:p-4 transition-all duration-300" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm" onclick="closeAddFaqModal()"></div>
    <div class="relative bg-white dark:bg-slate-900 w-full max-w-4xl max-h-[92vh] rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col overflow-hidden animate-scale-up">
        <!-- Modal Header -->
        <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between shrink-0 bg-gray-50/50 dark:bg-slate-900/50">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-pnp-blue text-white flex items-center justify-center text-base font-bold shadow-sm">
                    <i class="fas fa-plus"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 dark:text-white uppercase tracking-tight">Add New FAQ Item</h3>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Create a verified question, answer, keywords, and follow-ups.</p>
                </div>
            </div>
            <button type="button" onclick="closeAddFaqModal()" class="w-9 h-9 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center transition">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>

        <!-- Modal Body (Form) -->
        <form action="/admin/faq/add" method="POST" class="flex flex-col flex-1 overflow-hidden" onsubmit="return handleFaqSubmit(event, 'add')">
            <div class="p-6 space-y-6 overflow-y-auto flex-1 scrollbar-thin">
                <!-- Meta Settings Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Category -->
                    <div class="space-y-1.5">
                        <label for="addCategory" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest">Category</label>
                        <input type="text" name="category" id="addCategory" list="faqCategoryOptions" required placeholder="Select or type category"
                            class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue">
                        <datalist id="faqCategoryOptions">
                            <option value="Emergency">
                            <option value="Blotter">
                            <option value="Clearance">
                            <option value="Crime Map">
                            <option value="WCPD">
                            <option value="Cybercrime">
                            <option value="Traffic">
                            <option value="General">
                        </datalist>
                    </div>

                    <!-- Display Order -->
                    <div class="space-y-1.5">
                        <label for="addDisplayOrder" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest">Display Order</label>
                        <input type="number" name="display_order" id="addDisplayOrder" value="<%= faqs.length + 1 %>" min="1"
                            class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue">
                    </div>

                    <!-- Search Keywords -->
                    <div class="space-y-1.5">
                        <label for="addKeywords" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest">Keywords (Comma Separated)</label>
                        <input type="text" name="keywords" id="addKeywords" placeholder="e.g. blotter, report, reklamo, pulis"
                            class="w-full px-3.5 py-2.5 bg-gray-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue">
                    </div>
                </div>

                <!-- Tabs: English & Filipino -->
                <div class="border-t border-slate-200 dark:border-slate-800 pt-4">
                    <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-2 mb-4">
                        <button type="button" onclick="switchModalTab('add', 'en')" id="addTabBtn_en"
                            class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white shadow-xs">
                            <i class="fas fa-globe text-[11px] mr-1"></i> English (Primary)
                        </button>
                        <button type="button" onclick="switchModalTab('add', 'fil')" id="addTabBtn_fil"
                            class="px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700">
                            <i class="fas fa-flag text-[11px] mr-1"></i> Filipino / Tagalog
                        </button>
                    </div>

                    <!-- English Section -->
                    <div id="addSection_en" class="space-y-4">
                        <div class="space-y-1.5">
                            <label for="addTitle" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest flex items-center justify-between">
                                <span>Question Title (English) <span class="text-red-500">*</span></span>
                                <span class="text-[9px] text-slate-400 lowercase font-normal">What citizens ask</span>
                            </label>
                            <input type="text" name="title" id="addTitle" required placeholder="e.g. How do I file an official Police Blotter report?"
                                class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-bold dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue">
                        </div>

                        <div class="space-y-1.5">
                            <label for="addSummaryEn" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest flex items-center justify-between">
                                <span>Answer & Advisory Content (English) <span class="text-red-500">*</span></span>
                                <span class="text-[9px] text-slate-400 lowercase font-normal">Supports markdown bullets & bold text</span>
                            </label>
                            <textarea name="summaryEn" id="addSummaryEn" required rows="5" placeholder="Provide step-by-step guidance, required documents, station contact number..."
                                class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-medium dark:text-white focus:outline-none focus:ring-2 focus:ring-pnp-blue leading-relaxed"></textarea>
                        </div>

                        <div class="space-y-1.5">
                            <label for="addNearQuestionsEn" class="text-[10px] uppercase font-bold text-slate-400 tracking-widest flex items-center justify-between">
