<!-- CLIENT SCRIPT                                                             -->
<!-- ========================================================================= -->
<script>
    const FAQ_ITEMS = <%- JSON.stringify(faqs) %>;

    function openEditFaqById(id) {
        const item = FAQ_ITEMS.find(f => String(f.id) === String(id));
        if (item) {
            openEditFaqModal(item);
        }
    }

    let currentCategoryFilter = 'ALL';

    // Filter FAQs by Category
    function selectFaqCategory(category) {
        currentCategoryFilter = category;
        const pills = document.querySelectorAll('.faq-cat-pill');
        pills.forEach(pill => {
            if (pill.getAttribute('data-category') === category) {
                pill.className = 'faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-200 bg-pnp-blue text-white shadow-xs';
            } else {
                pill.className = 'faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600';
            }
        });
        filterFaqs();
    }

    // Filter FAQs by Search Text + Category
    function filterFaqs() {
        const query = (document.getElementById('faqSearchInput').value || '').toLowerCase().trim();
        const clearBtn = document.getElementById('faqSearchClear');
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
        }

        const cards = document.querySelectorAll('.faq-card');
        cards.forEach(card => {
            const cardCat = card.getAttribute('data-category') || 'General';
            const catMatches = currentCategoryFilter === 'ALL' || cardCat.toLowerCase() === currentCategoryFilter.toLowerCase();

            if (!catMatches) {
                card.classList.add('hidden');
                return;
            }

            if (!query) {
                card.classList.remove('hidden');
                return;
            }

            const titleEn = card.getAttribute('data-title-en') || '';
            const titleFil = card.getAttribute('data-title-fil') || '';
            const keywords = card.getAttribute('data-keywords') || '';
            const summaryEn = card.getAttribute('data-summary-en') || '';

            const textMatches = titleEn.includes(query) || titleFil.includes(query) || keywords.includes(query) || summaryEn.includes(query);
            if (textMatches) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        });
    }

    function clearFaqSearch() {
        const input = document.getElementById('faqSearchInput');
        if (input) {
            input.value = '';
            filterFaqs();
            input.focus();
        }
    }

    // Toggle Filipino Answer view on card
    function toggleAnswerPreview(faqId) {
        const filEl = document.getElementById('answerFil_' + faqId);
        const toggleBtnText = document.getElementById('answerToggleText_' + faqId);
        if (!filEl || !toggleBtnText) return;

        if (filEl.classList.contains('hidden')) {
            filEl.classList.remove('hidden');
            toggleBtnText.innerText = 'Hide Filipino';
        } else {
            filEl.classList.add('hidden');
            toggleBtnText.innerText = 'Show Filipino';
        }
    }

    // Switch between English and Filipino tabs in modals
    function switchModalTab(modalPrefix, lang) {
        const enBtn = document.getElementById(`${modalPrefix}TabBtn_en`);
        const filBtn = document.getElementById(`${modalPrefix}TabBtn_fil`);
        const enSec = document.getElementById(`${modalPrefix}Section_en`);
        const filSec = document.getElementById(`${modalPrefix}Section_fil`);

        if (lang === 'en') {
            enBtn.className = 'px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white shadow-xs';
            filBtn.className = 'px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
            enSec.classList.remove('hidden');
            filSec.classList.add('hidden');
        } else {
            filBtn.className = 'px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white shadow-xs';
            enBtn.className = 'px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
            filSec.classList.remove('hidden');
            enSec.classList.add('hidden');
        }
    }

    // Word counter and content validation helper
    function getWordDetails(str) {
        if (!str || typeof str !== 'string') return { words: 0, hasLetters: false, raw: '' };
        const raw = str.trim();
        if (!raw) return { words: 0, hasLetters: false, raw: '' };
        const hasLetters = /[a-zA-Z\u00C0-\u024F\u1E00-\u1EFF]/.test(raw);
        const words = raw.split(/\s+/).filter(Boolean).length;
        return { words, hasLetters, raw };
    }

    function updateWordBadge(inputId, minWords, maxWords, isRequired = true) {
        const input = document.getElementById(inputId);
        const badge = document.getElementById(inputId + 'WordBadge');
        const feedback = document.getElementById(inputId + 'Feedback');
        if (!input || !badge) return;

        const { words, hasLetters, raw } = getWordDetails(input.value);

        if (!raw) {
            badge.className = 'text-[10px] font-bold text-slate-400';
            badge.innerText = isRequired ? `0 / ${maxWords} words (min. ${minWords})` : `0 / ${maxWords} words (optional)`;
            if (feedback) feedback.classList.add('hidden');
            return;
        }

        if (!hasLetters) {
            badge.className = 'text-[10px] font-black text-red-500 dark:text-red-400';
            badge.innerText = `${words} word(s) - Invalid: numbers/symbols only`;
            if (feedback) {
                feedback.className = 'text-[11px] font-semibold text-red-500 dark:text-red-400';
                feedback.innerText = 'Cannot consist only of numbers or spaces. Must contain actual text.';
                feedback.classList.remove('hidden');
            }
            return;
        }

        if (words < minWords) {
            badge.className = 'text-[10px] font-black text-amber-500 dark:text-amber-400';
            badge.innerText = `${words} / ${maxWords} words (need at least ${minWords})`;
            if (feedback) {
                feedback.className = 'text-[11px] font-semibold text-amber-500 dark:text-amber-400';
                feedback.innerText = `Please write at least ${minWords} words (currently ${words}).`;
                feedback.classList.remove('hidden');
            }
            return;
        }

        if (words > maxWords) {
            badge.className = 'text-[10px] font-black text-red-500 dark:text-red-400';
            badge.innerText = `${words} / ${maxWords} words (Exceeded max limit!)`;
            if (feedback) {
                feedback.className = 'text-[11px] font-semibold text-red-500 dark:text-red-400';
                feedback.innerText = `Cannot exceed ${maxWords} words (currently ${words} words).`;
                feedback.classList.remove('hidden');
            }
            return;
        }

        // Perfectly valid
        badge.className = 'text-[10px] font-black text-emerald-600 dark:text-emerald-400';
        badge.innerText = `${words} / ${maxWords} words (Valid)`;
        if (feedback) feedback.classList.add('hidden');
    }

    // Add Modal handlers
    function openAddFaqModal() {
        switchModalTab('add', 'en');
        const modal = document.getElementById('addFaqModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Reset word badges
            updateWordBadge('addTitle', 5, 100, true);
            updateWordBadge('addSummaryEn', 5, 300, true);
            updateWordBadge('addTitleFil', 5, 100, false);
            updateWordBadge('addSummaryFil', 5, 300, false);

            setTimeout(() => {
                const titleInput = document.getElementById('addTitle');
                if (titleInput) titleInput.focus();
            }, 100);
        }
    }

    function closeAddFaqModal() {
        const modal = document.getElementById('addFaqModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    // Edit Modal handlers
    function openEditFaqModal(faq) {
        if (!faq) return;
        switchModalTab('edit', 'en');

        const form = document.getElementById('editFaqForm');
        if (form) form.action = `/admin/faq/${faq.id}/edit`;

        const subTitle = document.getElementById('editModalSubtitle');
        if (subTitle) subTitle.innerText = `Editing: ${faq.title.slice(0, 45)}...`;

        document.getElementById('editCategory').value = faq.category || 'General';
        document.getElementById('editKeywords').value = Array.isArray(faq.keywords) ? faq.keywords.join(', ') : (faq.keywords || '');

        document.getElementById('editTitle').value = faq.title || '';
        document.getElementById('editSummaryEn').value = faq.summaryEn || '';
        document.getElementById('editTitleFil').value = faq.titleFil || '';
        document.getElementById('editSummaryFil').value = faq.summaryFil || '';

        // Update word badges with current values
        updateWordBadge('editTitle', 5, 100, true);
        updateWordBadge('editSummaryEn', 5, 300, true);
        updateWordBadge('editTitleFil', 5, 100, false);
        updateWordBadge('editSummaryFil', 5, 300, false);

        const modal = document.getElementById('editFaqModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                const titleInput = document.getElementById('editTitle');
                if (titleInput) titleInput.focus();
            }, 100);
        }
    }

    function closeEditFaqModal() {
        const modal = document.getElementById('editFaqModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    // Form submit confirmation & rigorous validation
    async function handleFaqSubmit(e, mode) {
        const prefix = mode === 'add' ? 'add' : 'edit';
        const titleEl = document.getElementById(`${prefix}Title`);
        const summaryEnEl = document.getElementById(`${prefix}SummaryEn`);
        const titleFilEl = document.getElementById(`${prefix}TitleFil`);
        const summaryFilEl = document.getElementById(`${prefix}SummaryFil`);

        // 1. Question Title (English) Validation: 5 to 100 words, no spaces/pure numbers
        const qInfo = getWordDetails(titleEl.value);
        if (!qInfo.raw) {
            e.preventDefault();
            alert('Question Title (English) is required.');
            switchModalTab(prefix, 'en');
            titleEl.focus();
            return false;
        }
        if (!qInfo.hasLetters) {
            e.preventDefault();
            alert('Question cannot consist only of numbers or spaces. Please enter actual words.');
            switchModalTab(prefix, 'en');
            titleEl.focus();
            return false;
        }
        if (qInfo.words < 5) {
            e.preventDefault();
            alert(`Question must contain at least 5 words (currently ${qInfo.words} word${qInfo.words === 1 ? '' : 's'}).`);
            switchModalTab(prefix, 'en');
            titleEl.focus();
            return false;
        }
        if (qInfo.words > 100) {
            e.preventDefault();
            alert(`Question cannot exceed 100 words (currently ${qInfo.words} words).`);
            switchModalTab(prefix, 'en');
            titleEl.focus();
            return false;
        }

        // 2. Answer Content (English) Validation: 5 to 300 words, no spaces/pure numbers
        const aInfo = getWordDetails(summaryEnEl.value);
        if (!aInfo.raw) {
            e.preventDefault();
            alert('Answer Content (English) is required.');
            switchModalTab(prefix, 'en');
            summaryEnEl.focus();
            return false;
        }
        if (!aInfo.hasLetters) {
            e.preventDefault();
            alert('Answer cannot consist only of numbers or spaces. Please enter actual words.');
            switchModalTab(prefix, 'en');
            summaryEnEl.focus();
            return false;
        }
        if (aInfo.words < 5) {
            e.preventDefault();
            alert(`Answer must contain at least 5 words (currently ${aInfo.words} word${aInfo.words === 1 ? '' : 's'}).`);
            switchModalTab(prefix, 'en');
            summaryEnEl.focus();
            return false;
        }
        if (aInfo.words > 300) {
            e.preventDefault();
            alert(`Answer cannot exceed 300 words (currently ${aInfo.words} words).`);
            switchModalTab(prefix, 'en');
            summaryEnEl.focus();
            return false;
        }

        // 3. Optional Filipino Question Validation
        if (titleFilEl && titleFilEl.value.trim()) {
            const qFilInfo = getWordDetails(titleFilEl.value);
            if (!qFilInfo.hasLetters) {
                e.preventDefault();
                alert('Katanungan sa Filipino cannot consist only of numbers or spaces.');
                switchModalTab(prefix, 'fil');
                titleFilEl.focus();
                return false;
            }
            if (qFilInfo.words < 5) {
                e.preventDefault();
                alert(`Katanungan sa Filipino must contain at least 5 words (currently ${qFilInfo.words}).`);
                switchModalTab(prefix, 'fil');
                titleFilEl.focus();
                return false;
            }
            if (qFilInfo.words > 100) {
                e.preventDefault();
                alert(`Katanungan sa Filipino cannot exceed 100 words (currently ${qFilInfo.words}).`);
                switchModalTab(prefix, 'fil');
                titleFilEl.focus();
                return false;
            }
        }

        // 4. Optional Filipino Answer Validation
        if (summaryFilEl && summaryFilEl.value.trim()) {
            const aFilInfo = getWordDetails(summaryFilEl.value);
            if (!aFilInfo.hasLetters) {
                e.preventDefault();
                alert('Kasagutan sa Filipino cannot consist only of numbers or spaces.');
                switchModalTab(prefix, 'fil');
                summaryFilEl.focus();
                return false;
            }
            if (aFilInfo.words < 5) {
                e.preventDefault();
                alert(`Kasagutan sa Filipino must contain at least 5 words (currently ${aFilInfo.words}).`);
                switchModalTab(prefix, 'fil');
                summaryFilEl.focus();
                return false;
            }
            if (aFilInfo.words > 300) {
                e.preventDefault();
                alert(`Kasagutan sa Filipino cannot exceed 300 words (currently ${aFilInfo.words}).`);
                switchModalTab(prefix, 'fil');
                summaryFilEl.focus();
                return false;
            }
        }

        const submitBtn = document.getElementById(`${prefix}FaqSubmitBtn`);
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Saving...';
        }
        return true;
    }

    // Dismiss Action Alert Banner
    function dismissFaqAlert() {
        const el = document.getElementById('faqActionAlert');
        if (el) {
            el.style.opacity = '0';
            el.style.transform = 'translateY(-10px)';
            setTimeout(() => el.remove(), 300);
        }
    }

    // Auto-clean URL and trigger toast notification on reload
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const actionAlert = urlParams.get('alert');
        if (actionAlert) {
            let toastMsg = 'Action has been saved successfully.';
            let toastIcon = 'fa-circle-check';
            let toastColor = 'text-emerald-400';

            if (actionAlert === 'added') {
                toastMsg = 'FAQ added and saved successfully!';
            } else if (actionAlert === 'updated') {
                toastMsg = 'FAQ updated and saved successfully!';
                toastIcon = 'fa-check-double';
                toastColor = 'text-blue-400';
            } else if (actionAlert === 'deleted') {
                toastMsg = 'FAQ deleted and archived successfully!';
                toastIcon = 'fa-trash-can';
                toastColor = 'text-rose-400';
            }

            showFaqToast(toastMsg, toastIcon, toastColor);

            // Clean up the URL query param so refresh doesn't trigger again
            if (window.history.replaceState) {
                window.history.replaceState(null, '', window.location.pathname);
            }
        }
    });

    function showFaqToast(msg, icon = 'fa-circle-check', color = 'text-emerald-400') {
        let toast = document.getElementById('faqActionToast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'faqActionToast';
            toast.className = 'fixed bottom-8 right-8 z-[9999] px-5 py-3.5 rounded-2xl bg-slate-900/95 dark:bg-slate-800/95 text-white font-black text-xs uppercase tracking-wider border-2 border-pnp-gold/60 shadow-2xl backdrop-blur-md transition-all duration-300 opacity-0 transform translate-y-4 pointer-events-none flex items-center gap-3';
            document.body.appendChild(toast);
        }
        toast.innerHTML = `<i class="fas ${icon} ${color} text-base"></i><span>${msg}</span>`;
        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        setTimeout(() => {
            toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        }, 4500);
    }

    // Keyboard ESC to close modals
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeAddFaqModal();
            closeEditFaqModal();
        }
    });
</script>
