<!-- CLIENT SCRIPT                                                             -->
<!-- ========================================================================= -->
<script>
    let currentCategoryFilter = 'ALL';

    // Filter FAQs by Category
    function selectFaqCategory(category) {
        currentCategoryFilter = category;
        const pills = document.querySelectorAll('.faq-cat-pill');
        pills.forEach(pill => {
            if (pill.getAttribute('data-category') === category) {
                pill.className = 'faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-200 bg-pnp-blue text-white shadow-xs';
            } else {
                pill.className = 'faq-cat-pill px-3.5 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all duration-200 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600';
            }
        });
        filterFaqs();
    }

    // Filter FAQs by Search Text + Category
    function filterFaqs() {
        const query = (document.getElementById('faqSearchInput').value || '').toLowerCase().trim();
        const clearBtn = document.getElementById('faqSearchClear');
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', query.length === 0);
        }

        const cards = document.querySelectorAll('.faq-card');
        cards.forEach(card => {
            const cardCat = card.getAttribute('data-category') || 'General';
            const catMatches = currentCategoryFilter === 'ALL' || cardCat.toLowerCase() === currentCategoryFilter.toLowerCase();

            if (!catMatches) {
                card.classList.add('hidden');
                return;
            }

            if (!query) {
                card.classList.remove('hidden');
                return;
            }

            const titleEn = card.getAttribute('data-title-en') || '';
            const titleFil = card.getAttribute('data-title-fil') || '';
            const keywords = card.getAttribute('data-keywords') || '';
            const summaryEn = card.getAttribute('data-summary-en') || '';

            const textMatches = titleEn.includes(query) || titleFil.includes(query) || keywords.includes(query) || summaryEn.includes(query);
            if (textMatches) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        });
    }

    function clearFaqSearch() {
        const input = document.getElementById('faqSearchInput');
        if (input) {
            input.value = '';
            filterFaqs();
            input.focus();
        }
    }

    // Toggle Filipino Answer view on card
    function toggleAnswerPreview(faqId) {
        const filEl = document.getElementById('answerFil_' + faqId);
        const toggleBtnText = document.getElementById('answerToggleText_' + faqId);
        if (!filEl || !toggleBtnText) return;

        if (filEl.classList.contains('hidden')) {
            filEl.classList.remove('hidden');
            toggleBtnText.innerText = 'Hide Filipino';
        } else {
            filEl.classList.add('hidden');
            toggleBtnText.innerText = 'Show Filipino';
        }
    }

    // Switch between English and Filipino tabs in modals
    function switchModalTab(modalPrefix, lang) {
        const enBtn = document.getElementById(`${modalPrefix}TabBtn_en`);
        const filBtn = document.getElementById(`${modalPrefix}TabBtn_fil`);
        const enSec = document.getElementById(`${modalPrefix}Section_en`);
        const filSec = document.getElementById(`${modalPrefix}Section_fil`);

        if (lang === 'en') {
            enBtn.className = 'px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white shadow-xs';
            filBtn.className = 'px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
            enSec.classList.remove('hidden');
            filSec.classList.add('hidden');
        } else {
            filBtn.className = 'px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-pnp-blue text-white shadow-xs';
            enBtn.className = 'px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
            filSec.classList.remove('hidden');
            enSec.classList.add('hidden');
        }
    }

    // Add Modal handlers
    function openAddFaqModal() {
        switchModalTab('add', 'en');
        const modal = document.getElementById('addFaqModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                const titleInput = document.getElementById('addTitle');
                if (titleInput) titleInput.focus();
            }, 100);
        }
    }

    function closeAddFaqModal() {
        const modal = document.getElementById('addFaqModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    // Edit Modal handlers
    function openEditFaqModal(faq) {
        if (!faq) return;
        switchModalTab('edit', 'en');

        const form = document.getElementById('editFaqForm');
        if (form) form.action = `/admin/faq/${faq.id}/edit`;

        const subTitle = document.getElementById('editModalSubtitle');
        if (subTitle) subTitle.innerText = `Editing FAQ #${faq.display_order || ''}: ${faq.title.slice(0, 45)}...`;

        document.getElementById('editCategory').value = faq.category || 'General';
        document.getElementById('editDisplayOrder').value = faq.display_order || 1;
        document.getElementById('editKeywords').value = Array.isArray(faq.keywords) ? faq.keywords.join(', ') : (faq.keywords || '');

        document.getElementById('editTitle').value = faq.title || '';
        document.getElementById('editSummaryEn').value = faq.summaryEn || '';
        document.getElementById('editNearQuestionsEn').value = Array.isArray(faq.nearQuestionsEn) ? faq.nearQuestionsEn.join('\n') : (faq.nearQuestionsEn || '');

        document.getElementById('editTitleFil').value = faq.titleFil || '';
        document.getElementById('editSummaryFil').value = faq.summaryFil || '';
        document.getElementById('editNearQuestionsFil').value = Array.isArray(faq.nearQuestionsFil) ? faq.nearQuestionsFil.join('\n') : (faq.nearQuestionsFil || '');

        const modal = document.getElementById('editFaqModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                const titleInput = document.getElementById('editTitle');
                if (titleInput) titleInput.focus();
            }, 100);
        }
    }

    function closeEditFaqModal() {
        const modal = document.getElementById('editFaqModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    // Form submit confirmation & validation
    async function handleFaqSubmit(e, mode) {
        const prefix = mode === 'add' ? 'add' : 'edit';
        const titleVal = (document.getElementById(`${prefix}Title`).value || '').trim();
        const summaryVal = (document.getElementById(`${prefix}SummaryEn`).value || '').trim();

        if (titleVal.length < 5) {
            e.preventDefault();
            alert('Question title must be at least 5 characters long.');
            switchModalTab(prefix, 'en');
            document.getElementById(`${prefix}Title`).focus();
            return false;
        }

        if (summaryVal.length < 10) {
            e.preventDefault();
            alert('Answer summary must be at least 10 characters long.');
            switchModalTab(prefix, 'en');
            document.getElementById(`${prefix}SummaryEn`).focus();
            return false;
        }

        const submitBtn = document.getElementById(`${prefix}FaqSubmitBtn`);
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Saving...';
        }
        return true;
    }

    // Keyboard ESC to close modals
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeAddFaqModal();
            closeEditFaqModal();
        }
    });
</script>

