    async function confirmEditPersonnel(event) {
        event.preventDefault();
        const form = document.getElementById('editPersonnelForm');
        const nameInput = document.getElementById('edit_p_name');
        const posInput = document.getElementById('edit_p_position');

        const name = nameInput ? nameInput.value : '';
        const position = posInput ? posInput.value : '';

        // Validate Officer Name
        const nameCheck = clientValidateName(name, 3, 60);
        if (!nameCheck.valid) {
            const alertFn = window.strategicAlert || (({ message }) => alert(message));
            alertFn({
                title: 'Validation Notice',
                message: nameCheck.error,
                confirmText: 'Understood',
                type: 'warning'
            });
