<div class="space-y-6">
    <!-- Top Action Bar & Layout Switcher -->
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-4 sm:p-5 shadow-sm border border-gray-100 dark:border-slate-700 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div class="flex items-center space-x-3.5">
            <div class="w-10 h-10 rounded-2xl bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-900 flex items-center justify-center shadow-md">
                <i class="fas fa-users-cog text-base"></i>
            </div>
            <div>
                <h2 class="text-base sm:text-lg font-black text-pnp-blue dark:text-white uppercase tracking-wider">
                    Personnel & Administration
                </h2>
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">
                    Registry • Station Directory Roster • System Audit Log
                </p>
            </div>
        </div>

        <!-- Mode Switcher Pills -->
        <div class="flex flex-wrap items-center gap-2 bg-gray-50 dark:bg-slate-900/60 p-1.5 rounded-2xl border border-gray-100 dark:border-slate-700/80 w-full sm:w-auto">
            <button type="button" onclick="toggleActivePanel('personnel')" id="btnTabPersonnel" class="px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all flex items-center space-x-1.5 cursor-pointer text-gray-500 hover:text-slate-800 dark:text-gray-400 dark:hover:text-white">
                <i class="fas fa-user-shield text-xs"></i>
                <span>Personnel (<%= (typeof users !== 'undefined' && users) ? users.length : 0 %>)</span>
            </button>
            <button type="button" onclick="toggleActivePanel('roster')" id="btnTabRoster" class="px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all flex items-center space-x-1.5 cursor-pointer text-gray-500 hover:text-slate-800 dark:text-gray-400 dark:hover:text-white">
                <i class="fas fa-id-badge text-xs"></i>
                <span>Roster (<%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %>)</span>
            </button>
            <button type="button" onclick="toggleActivePanel('audit')" id="btnTabAudit" class="px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all flex items-center space-x-1.5 cursor-pointer text-gray-500 hover:text-slate-800 dark:text-gray-400 dark:hover:text-white">
                <i class="fas fa-fingerprint text-xs"></i>
                <span>Audit Logs (<%= (typeof logs !== 'undefined' && logs) ? logs.length : 0 %>)</span>
            </button>
        </div>
    </div>

    <!-- Main 3-Column Containers Grid (Expandable) -->
    <div id="containersGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        
        <!-- ========================================== -->
        <!-- CONTAINER 1: PERSONNEL REGISTRY            -->
        <!-- ========================================== -->
        <div id="containerPersonnel" class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col transition-all duration-300">
            <% const isUserQuotaFull = (typeof users !== 'undefined' && users && users.length >= 10); %>

            <!-- Summary View (Visible in 3-Column Mode) -->
            <div id="personnelSummaryView" class="p-6 flex flex-col h-full justify-between space-y-5">
                <div>
                    <!-- Header -->
                    <div class="flex justify-between items-start gap-3 pb-4 border-b border-gray-100 dark:border-slate-700/80">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-2xl bg-pnp-blue text-white flex items-center justify-center shadow-md shadow-pnp-blue/20">
                                <i class="fas fa-user-shield text-base"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-xs">Personnel Registry</h3>
                                <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Authorized Accounts</p>
                            </div>
                        </div>
                        <div class="<%= isUserQuotaFull ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30' : 'bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold border-pnp-blue/20' %> px-2.5 py-1 rounded-xl border font-mono font-black text-[10px] tracking-wider uppercase shrink-0">
                            <%= (typeof users !== 'undefined' && users) ? users.length : 0 %> / 10
                        </div>
                    </div>

                    <!-- Action Bar: Create Account Button inside Personnel Registry Container -->
                    <div class="pt-4 flex items-center justify-between gap-2">
                        <% if (user && user.role === 'superadmin') { %>
                            <% if (isUserQuotaFull) { %>
                                <button type="button" onclick="alertPersonnelAccountLimit()"
                                    class="w-full bg-gray-100 dark:bg-slate-700/60 text-gray-400 dark:text-gray-500 font-black py-2.5 px-3 rounded-xl text-[10px] uppercase tracking-wider cursor-not-allowed flex items-center justify-center space-x-1.5 shadow-2xs">
                                    <i class="fas fa-ban text-xs"></i>
                                    <span>Account Limit Reached (10/10)</span>
                                </button>
                            <% } else { %>
                                <button type="button" onclick="openCreateAccountModal()"
                                    class="w-full bg-pnp-blue hover:bg-black text-white font-black py-2.5 px-3 rounded-xl shadow-md shadow-pnp-blue/20 transition-all transform hover:scale-[1.01] active:scale-95 text-[10px] uppercase tracking-wider flex items-center justify-center space-x-2 cursor-pointer">
                                    <i class="fas fa-user-plus text-pnp-gold text-xs"></i>
                                    <span>Create Account</span>
                                </button>
                            <% } %>
                        <% } else { %>
                            <div class="w-full bg-gray-50 dark:bg-slate-900/50 py-2 px-3 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest"><i class="fas fa-lock text-[8px] mr-1"></i> Staff Read-Only Access</span>
                            </div>
                        <% } %>
                    </div>

                    <!-- Mini Stat Chips -->
                    <div class="grid grid-cols-3 gap-2 pt-3">
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Active</span>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400"><%= (typeof users !== 'undefined' && users) ? users.filter(u => u.status === 'active').length : 0 %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Admin</span>
                            <span class="text-xs font-black text-pnp-blue dark:text-pnp-gold"><%= (typeof users !== 'undefined' && users) ? users.filter(u => u.role === 'superadmin').length : 0 %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Staff</span>
                            <span class="text-xs font-black text-slate-600 dark:text-slate-300"><%= (typeof users !== 'undefined' && users) ? users.filter(u => u.role !== 'superadmin').length : 0 %></span>
                        </div>
                    </div>

                    <!-- Summary Preview List (Top 4 Personnel) -->
                    <div class="pt-4 space-y-2">
                        <span class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest block">Active Roster Snapshot</span>
                        <div class="divide-y divide-gray-100 dark:divide-slate-700/60 border border-gray-100 dark:border-slate-700/80 rounded-2xl overflow-hidden bg-gray-50/40 dark:bg-slate-900/30">
                            <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                                <% users.slice(0, 4).forEach(u => { %>
                                    <div class="p-3 flex items-center justify-between gap-2 hover:bg-white dark:hover:bg-slate-800/80 transition-colors">
                                        <div class="flex items-center space-x-2.5 min-w-0">
                                            <div class="w-7 h-7 rounded-lg bg-pnp-blue/10 dark:bg-pnp-gold/10 text-pnp-blue dark:text-pnp-gold flex items-center justify-center text-[10px] font-black shrink-0">
                                                <%= (u.full_name || 'U').charAt(0).toUpperCase() %>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="text-[11px] font-black text-pnp-blue dark:text-white uppercase truncate"><%= u.full_name %></div>
                                                <div class="text-[9px] text-gray-400 font-mono truncate"><%= u.email || 'No email' %></div>
                                            </div>
                                        </div>
                                        <div class="shrink-0 flex items-center space-x-1.5">
                                            <% if (u.role === 'superadmin') { %>
                                                <span class="px-1.5 py-0.5 rounded text-[8px] font-black uppercase bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold">Admin</span>
                                            <% } %>
                                            <% if (u.status === 'active') { %>
                                                <span class="w-2 h-2 rounded-full bg-emerald-500" title="Active"></span>
                                            <% } else { %>
                                                <span class="w-2 h-2 rounded-full bg-amber-500" title="Pending / Inactive"></span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-4 text-center text-gray-400 text-xs font-bold">No accounts registered yet.</div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Expand Button -->
                <div class="pt-4 border-t border-gray-100 dark:border-slate-700/80">
                    <button type="button" onclick="setActivePanel('personnel')" class="w-full py-3 bg-gray-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-700/40 dark:hover:bg-pnp-gold dark:hover:text-slate-900 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300 transition flex items-center justify-center space-x-2 shadow-2xs group cursor-pointer">
                        <span>Expand Full Registry (<%= (typeof users !== 'undefined' && users) ? users.length : 0 %>)</span>
                        <i class="fas fa-expand-alt text-xs group-hover:scale-110 transition"></i>
                    </button>
                </div>
            </div>

            <!-- Expanded Full View (Visible when selected) -->
            <div id="personnelExpandedView" class="hidden flex flex-col h-full animate-fade-in">
                <!-- Expanded Header -->
                <div class="p-6 border-b border-gray-100 dark:border-slate-700 flex flex-wrap justify-between items-center gap-4 bg-gradient-to-r from-pnp-blue/5 to-transparent">
                    <div class="flex items-center space-x-3.5">
                        <div class="w-12 h-12 bg-pnp-blue text-white rounded-2xl flex items-center justify-center shadow-lg shadow-pnp-blue/20">
                            <i class="fas fa-user-shield text-xl"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2.5">
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-sm sm:text-base">Personnel Registry — Complete Directory</h3>
                                <span class="px-2.5 py-0.5 rounded-xl bg-pnp-blue/10 dark:bg-pnp-gold/10 text-pnp-blue dark:text-pnp-gold text-[10px] font-black uppercase">
                                    <%= (typeof users !== 'undefined' && users) ? users.length : 0 %> / 10 Accounts
                                </span>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Authorized Administrative & Operational Personnel</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <!-- Quick Search Box -->
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text" placeholder="Search accounts..." oninput="filterPersonnelTable(this.value)" class="pl-8 pr-3 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-pnp-blue w-44 sm:w-56">
                        </div>

                        <% if (user && user.role === 'superadmin') { %>
                            <% if (isUserQuotaFull) { %>
                                <button type="button" onclick="alertPersonnelAccountLimit()" class="px-3.5 py-2 bg-gray-200 dark:bg-slate-700 text-gray-400 font-black rounded-xl text-[10px] uppercase tracking-wider cursor-not-allowed flex items-center space-x-1.5">
                                    <i class="fas fa-ban"></i>
                                    <span>Quota Full</span>
                                </button>
                            <% } else { %>
                                <button type="button" onclick="openCreateAccountModal()" class="px-4 py-2 bg-pnp-blue hover:bg-black text-white font-black rounded-xl text-[10px] uppercase tracking-wider shadow-md shadow-pnp-blue/20 flex items-center space-x-1.5 transition-all transform hover:scale-105 active:scale-95 cursor-pointer">
                                    <i class="fas fa-user-plus text-pnp-gold text-xs"></i>
                                    <span>Create Account</span>
                                </button>
                            <% } %>
                        <% } %>

                        <!-- Collapse Back Button -->
                        <button type="button" onclick="setActivePanel('all')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-white font-black rounded-xl text-[10px] uppercase tracking-wider flex items-center space-x-1.5 transition shadow-2xs cursor-pointer">
                            <i class="fas fa-compress-alt text-xs"></i>
                            <span>Collapse</span>
                        </button>
                    </div>
                </div>

                <!-- Full Table -->
                <div class="flex-grow overflow-x-auto">
                    <table class="w-full text-left text-xs min-w-[700px]">
                        <thead class="bg-gray-50 dark:bg-slate-900/50 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                            <tr>
                                <th class="px-8 py-5">Full Name</th>
                                <th class="px-8 py-5">Email Address</th>
                                <th class="px-8 py-5">Role</th>
                                <th class="px-8 py-5">Status</th>
                                <th class="px-8 py-5">Date Created</th>
                                <th class="px-8 py-5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="fullPersonnelTableBody" class="divide-y divide-gray-50 dark:divide-slate-700/50">
                            <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
                                <% users.forEach(u => { %>
                                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/20 transition-colors">
                                        <td class="px-8 py-5 font-black text-pnp-blue dark:text-pnp-gold uppercase">
                                            <%= u.full_name %>
                                        </td>
                                        <td class="px-8 py-5">
                                            <div class="text-[11px] text-gray-500 dark:text-gray-400 font-mono lowercase mt-0.5"><%= u.email || 'No email provided' %></div>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider <%= u.role === 'superadmin' ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-900' : 'bg-gray-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300' %>">
                                                <%= u.role || 'staff' %>
                                            </span>
                                        </td>
                                        <td class="px-8 py-5">
                                            <% if (u.status === 'active') { %>
                                                <span class="px-3 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-green-200 dark:border-green-800">Active</span>
                                            <% } else if (u.status === 'rejected') { %>
                                                <span class="px-3 py-1 bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-red-200 dark:border-red-800">Rejected</span>
                                            <% } else { %>
                                                <span class="px-3 py-1 bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-yellow-200 dark:border-yellow-800">Pending</span>
                                            <% } %>
                                        </td>
                                        <td class="px-8 py-5 text-gray-400 font-mono">
                                            <%= new Date(u.created_at).toLocaleDateString(undefined, {month:'short', day:'numeric', year:'numeric'}) %>
                                        </td>
                                        <td class="px-8 py-5 text-right">
                                            <div class="flex items-center justify-end space-x-2">
                                                <% if (user && user.role === 'superadmin') { %>
                                                    <button type="button" 
                                                        data-id="<%= u.id %>"
                                                        data-fullname="<%= u.full_name || '' %>"
                                                        data-email="<%= u.email || '' %>"
                                                        data-role="<%= u.role || 'staff' %>"
                                                        data-status="<%= u.status || 'active' %>"
                                                        onclick="handleUserEditClick(this)"
                                                        class="w-10 h-10 rounded-xl bg-pnp-blue/10 dark:bg-pnp-blue/20 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-blue hover:text-white transition-all flex items-center justify-center shadow-sm cursor-pointer"
                                                        title="Edit Account Details">
                                                        <i class="fas fa-edit text-[11px]"></i>
                                                    </button>
                                                <% } %>
                                                <% if (u.role === 'superadmin') { %>
                                                    <span class="text-[8px] font-black text-pnp-blue/50 dark:text-slate-400 uppercase italic px-3 py-2 bg-pnp-blue/5 dark:bg-slate-800/50 rounded-lg border border-pnp-blue/10 dark:border-slate-700/50">Protected</span>
                                                <% } else if (user && user.role === 'superadmin') { %>
                                                    <button type="button" 
                                                        data-id="<%= u.id %>"
                                                        data-fullname="<%= u.full_name || '' %>"
                                                        onclick="handleUserDeleteClick(this)"
                                                        class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center shadow-sm cursor-pointer"
                                                        title="Neutralize Account">
                                                        <i class="fas fa-trash-alt text-[11px]"></i>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-[8px] font-black text-slate-300 uppercase italic">Locked</span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- CONTAINER 2: STATION DIRECTORY ROSTER      -->
        <!-- ========================================== -->
        <div id="containerRoster" class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col transition-all duration-300">
            <% const isRosterFull = (typeof stationPersonnel !== 'undefined' && stationPersonnel && stationPersonnel.length >= 10); %>

            <!-- Summary View (Visible in 3-Column Mode) -->
            <div id="rosterSummaryView" class="p-6 flex flex-col h-full justify-between space-y-5">
                <div>
                    <!-- Header -->
                    <div class="flex justify-between items-start gap-3 pb-4 border-b border-gray-100 dark:border-slate-700/80">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-2xl bg-pnp-gold/20 text-pnp-gold flex items-center justify-center shadow-md">
                                <i class="fas fa-id-badge text-base"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-xs">Station Directory Roster</h3>
                                <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Public Portal Roster</p>
                            </div>
                        </div>
                        <div class="bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold border border-pnp-gold/30 px-2.5 py-1 rounded-xl font-mono font-black text-[10px] tracking-wider uppercase shrink-0">
                            <%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %> / 10
                        </div>
                    </div>

                    <!-- Action Bar: Add Personnel Button -->
                    <div class="pt-4 flex items-center justify-between gap-2">
                        <% if (user && user.role === 'superadmin') { %>
                            <% if (isRosterFull) { %>
                                <button type="button" onclick="alertRosterLimit()"
                                    class="w-full bg-gray-100 dark:bg-slate-700/60 text-gray-400 dark:text-gray-500 font-black py-2.5 px-3 rounded-xl text-[10px] uppercase tracking-wider cursor-not-allowed flex items-center justify-center space-x-1.5 shadow-2xs">
                                    <i class="fas fa-ban text-xs"></i>
                                    <span>Roster Full (10 Max)</span>
                                </button>
                            <% } else { %>
                                <button type="button" onclick="openAddPersonnelModal()"
                                    class="w-full bg-pnp-gold hover:bg-yellow-500 text-pnp-blue font-black py-2.5 px-3 rounded-xl shadow-md shadow-pnp-gold/20 transition-all transform hover:scale-[1.01] active:scale-95 text-[10px] uppercase tracking-wider flex items-center justify-center space-x-2 cursor-pointer">
                                    <i class="fas fa-user-plus text-xs"></i>
                                    <span>Add Officer</span>
                                </button>
                            <% } %>
                        <% } else { %>
                            <div class="w-full bg-gray-50 dark:bg-slate-900/50 py-2 px-3 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest"><i class="fas fa-eye text-[8px] mr-1"></i> Public Directory View</span>
                            </div>
                        <% } %>
                    </div>

                    <!-- Mini Stat Chips -->
                    <div class="grid grid-cols-3 gap-2 pt-3">
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Officers</span>
                            <span class="text-xs font-black text-pnp-blue dark:text-pnp-gold"><%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Slots</span>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400"><%= 10 - ((typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0) %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Portal</span>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400">Live</span>
                        </div>
                    </div>

                    <!-- Summary Preview List (Top 4 Officers) -->
                    <div class="pt-4 space-y-2">
                        <span class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest block">Leadership Roster Preview</span>
                        <div class="divide-y divide-gray-100 dark:divide-slate-700/60 border border-gray-100 dark:border-slate-700/80 rounded-2xl overflow-hidden bg-gray-50/40 dark:bg-slate-900/30">
                            <% if (typeof stationPersonnel !== 'undefined' && stationPersonnel && stationPersonnel.length > 0) { %>
                                <% stationPersonnel.slice(0, 4).forEach(p => { %>
                                    <div class="p-3 flex items-center justify-between gap-2 hover:bg-white dark:hover:bg-slate-800/80 transition-colors">
                                        <div class="flex items-center space-x-2.5 min-w-0">
                                            <div class="w-7 h-7 rounded-lg bg-pnp-gold/20 text-pnp-gold flex items-center justify-center text-[10px] font-black shrink-0">
                                                <i class="fas fa-shield-alt text-[9px]"></i>
                                            </div>
                                            <div class="min-w-0">
                                                <div class="text-[11px] font-black text-pnp-blue dark:text-white uppercase truncate"><%= p.name %></div>
                                                <div class="text-[9px] text-pnp-blue dark:text-pnp-gold font-bold uppercase truncate"><%= p.position %></div>
                                            </div>
                                        </div>
                                        <span class="px-2 py-0.5 rounded text-[8px] font-black uppercase bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 shrink-0">Listed</span>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-4 text-center text-gray-400 text-xs font-bold">No officers listed yet.</div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Expand Button -->
                <div class="pt-4 border-t border-gray-100 dark:border-slate-700/80">
                    <button type="button" onclick="setActivePanel('roster')" class="w-full py-3 bg-gray-50 hover:bg-pnp-gold hover:text-pnp-blue dark:bg-slate-700/40 dark:hover:bg-pnp-gold dark:hover:text-slate-900 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300 transition flex items-center justify-center space-x-2 shadow-2xs group cursor-pointer">
                        <span>Expand Full Roster (<%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %>)</span>
                        <i class="fas fa-expand-alt text-xs group-hover:scale-110 transition"></i>
                    </button>
                </div>
            </div>

            <!-- Expanded Full View (Visible when selected) -->
            <div id="rosterExpandedView" class="hidden flex flex-col h-full animate-fade-in">
                <!-- Expanded Header -->
                <div class="p-6 border-b border-gray-100 dark:border-slate-700 flex flex-wrap justify-between items-center gap-4 bg-gradient-to-r from-pnp-blue/5 to-transparent">
                    <div class="flex items-center space-x-3.5">
                        <div class="w-12 h-12 bg-pnp-gold text-pnp-blue rounded-2xl flex items-center justify-center shadow-lg shadow-pnp-gold/20">
                            <i class="fas fa-id-badge text-xl"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2.5">
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-sm sm:text-base">Station Directory Roster — Full Roster</h3>
                                <span class="px-2.5 py-0.5 rounded-xl bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold text-[10px] font-black uppercase">
                                    <%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %> / 10 Listed
                                </span>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Displayed on Public Portal Homepage & Official Inquiries</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <!-- Quick Search Box -->
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text" placeholder="Search officers..." oninput="filterRosterTable(this.value)" class="pl-8 pr-3 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-pnp-blue w-44 sm:w-56">
                        </div>

                        <% if (user && user.role === 'superadmin') { %>
                            <% if (isRosterFull) { %>
                                <button type="button" onclick="alertRosterLimit()" class="px-3.5 py-2 bg-gray-200 dark:bg-slate-700 text-gray-400 font-black rounded-xl text-[10px] uppercase tracking-wider cursor-not-allowed flex items-center space-x-1.5">
                                    <i class="fas fa-ban"></i>
                                    <span>Roster Full</span>
                                </button>
                            <% } else { %>
                                <button type="button" onclick="openAddPersonnelModal()" class="px-4 py-2 bg-pnp-gold hover:bg-yellow-500 text-pnp-blue font-black rounded-xl text-[10px] uppercase tracking-wider shadow-md shadow-pnp-gold/20 flex items-center space-x-1.5 transition-all transform hover:scale-105 active:scale-95 cursor-pointer">
                                    <i class="fas fa-user-plus text-xs"></i>
                                    <span>Add Officer</span>
                                </button>
                            <% } %>
                        <% } %>

                        <!-- Collapse Back Button -->
                        <button type="button" onclick="setActivePanel('all')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-white font-black rounded-xl text-[10px] uppercase tracking-wider flex items-center space-x-1.5 transition shadow-2xs cursor-pointer">
                            <i class="fas fa-compress-alt text-xs"></i>
                            <span>Collapse</span>
                        </button>
                    </div>
                </div>

                <!-- Full Table -->
                <div class="flex-grow overflow-x-auto">
                    <table class="w-full text-left text-xs min-w-[600px]">
                        <thead class="bg-gray-50 dark:bg-slate-900/50 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                            <tr>
                                <th class="px-8 py-5">Personnel Name & Rank</th>
                                <th class="px-8 py-5">Designation</th>
                                <th class="px-8 py-5">Public Display</th>
                                <th class="px-8 py-5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="fullRosterTableBody" class="divide-y divide-gray-50 dark:divide-slate-700/50">
                            <% if (typeof stationPersonnel !== 'undefined' && stationPersonnel && stationPersonnel.length > 0) { %>
                                <% stationPersonnel.forEach(p => { %>
                                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/20 transition-colors">
                                        <td class="px-8 py-5 font-black text-pnp-blue dark:text-white uppercase">
                                            <%= p.name %>
                                        </td>
                                        <td class="px-8 py-5 text-gray-600 dark:text-gray-300 font-bold uppercase tracking-tight text-[11px]">
                                            <span class="px-2.5 py-1 bg-blue-50 dark:bg-slate-900/60 rounded-lg text-pnp-blue dark:text-pnp-gold border border-pnp-blue/10">
                                                <%= p.position %>
                                            </span>
                                        </td>
                                        <td class="px-8 py-5">
                                            <span class="px-3 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-green-200 dark:border-green-800">
                                                Published
                                            </span>
                                        </td>
                                        <td class="px-8 py-5 text-right">
                                            <div class="flex items-center justify-end space-x-2">
                                                <% if (user && user.role === 'superadmin') { %>
                                                    <button type="button"
                                                        data-id="<%= p.id %>"
                                                        data-name="<%= p.name || '' %>"
                                                        data-position="<%= p.position || '' %>"
                                                        onclick="handlePersonnelEditClick(this)"
                                                        class="w-10 h-10 rounded-xl bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-gold hover:text-pnp-blue transition-all flex items-center justify-center shadow-sm cursor-pointer"
                                                        title="Edit Directory Officer">
                                                        <i class="fas fa-edit text-xs"></i>
                                                    </button>
                                                    <button type="button"
                                                        data-id="<%= p.id %>"
                                                        data-name="<%= p.name || '' %>"
                                                        onclick="handlePersonnelDeleteClick(this)"
                                                        class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center shadow-sm cursor-pointer"
                                                        title="Remove from Directory">
                                                        <i class="fas fa-trash-alt text-xs"></i>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-[8px] font-black text-slate-300 uppercase italic">Locked</span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- CONTAINER 3: SYSTEM AUDIT LOG              -->
        <!-- ========================================== -->
        <div id="containerAudit" class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col transition-all duration-300">
            <!-- Summary View (Visible in 3-Column Mode) -->
            <div id="auditSummaryView" class="p-6 flex flex-col h-full justify-between space-y-5">
                <div>
                    <!-- Header -->
                    <div class="flex justify-between items-start gap-3 pb-4 border-b border-gray-100 dark:border-slate-700/80">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-2xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shadow-md">
                                <i class="fas fa-fingerprint text-base"></i>
                            </div>
                            <div>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-xs">System Audit Log</h3>
                                <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Live Event Stream</p>
                            </div>
                        </div>
                        <div class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-xl font-mono font-black text-[10px] tracking-wider uppercase shrink-0">
                            <%= (typeof logs !== 'undefined' && logs) ? logs.length : 0 %> Logs
                        </div>
                    </div>

                    <!-- Action Bar: Live Stream / View All Modal -->
                    <div class="pt-4 flex items-center justify-between gap-2">
                        <button type="button" onclick="openUsersLogModal()" class="w-full bg-slate-900 dark:bg-slate-700 hover:bg-pnp-blue text-white font-black py-2.5 px-3 rounded-xl shadow-md transition-all text-[10px] uppercase tracking-wider flex items-center justify-center space-x-2 cursor-pointer">
                            <i class="fas fa-list text-pnp-gold text-xs"></i>
                            <span>View All Logs (<%= (typeof logs !== 'undefined' && logs) ? logs.length : 0 %>)</span>
                        </button>
                    </div>

                    <!-- Mini Stat Chips -->
                    <div class="grid grid-cols-3 gap-2 pt-3">
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Captured</span>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400"><%= (typeof logs !== 'undefined' && logs) ? logs.length : 0 %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Latest</span>
                            <span class="text-xs font-black text-pnp-blue dark:text-pnp-gold truncate block" title="<%= (logs && logs[0]) ? logs[0].username : 'None' %>"><%= (logs && logs[0]) ? logs[0].username.slice(0, 7) : 'None' %></span>
                        </div>
                        <div class="p-2.5 bg-gray-50 dark:bg-slate-900/60 rounded-xl border border-gray-100 dark:border-slate-800 text-center">
                            <span class="block text-[8px] text-gray-400 font-black uppercase tracking-wider">Feed</span>
                            <span class="text-xs font-black text-emerald-600 dark:text-emerald-400">Live</span>
                        </div>
                    </div>

                    <!-- Summary Preview List (Top 4 Logs) -->
                    <div class="pt-4 space-y-2">
                        <span class="text-[9px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest block">Recent Activity Stream</span>
                        <div class="divide-y divide-gray-100 dark:divide-slate-700/60 border border-gray-100 dark:border-slate-700/80 rounded-2xl overflow-hidden bg-gray-50/40 dark:bg-slate-900/30">
                            <% if (typeof logs !== 'undefined' && logs && logs.length > 0) { %>
                                <% logs.slice(0, 4).forEach(l => { %>
                                    <div class="p-3 flex items-center justify-between gap-2 hover:bg-white dark:hover:bg-slate-800/80 transition-colors">
                                        <div class="flex items-center space-x-2.5 min-w-0">
                                            <div class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></div>
                                            <div class="min-w-0">
                                                <div class="text-[11px] font-black text-pnp-blue dark:text-white uppercase truncate"><%= l.username %></div>
                                                <div class="text-[9px] text-gray-500 dark:text-gray-400 truncate max-w-[150px]"><%= l.details %></div>
                                            </div>
                                        </div>
                                        <div class="shrink-0 text-right">
                                            <span class="px-1.5 py-0.5 rounded text-[7.5px] font-black uppercase bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 block"><%= l.action %></span>
                                            <span class="text-[8px] text-gray-400 font-mono mt-0.5 block"><%= new Date(l.timestamp).toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit'}) %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="p-4 text-center text-gray-400 text-xs font-bold">No logs captured yet.</div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Expand Button -->
                <div class="pt-4 border-t border-gray-100 dark:border-slate-700/80">
                    <button type="button" onclick="setActivePanel('audit')" class="w-full py-3 bg-gray-50 hover:bg-emerald-600 hover:text-white dark:bg-slate-700/40 dark:hover:bg-emerald-500 dark:hover:text-slate-950 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-300 transition flex items-center justify-center space-x-2 shadow-2xs group cursor-pointer">
                        <span>Expand Full Audit Stream</span>
                        <i class="fas fa-expand-alt text-xs group-hover:scale-110 transition"></i>
                    </button>
                </div>
            </div>

            <!-- Expanded Full View (Visible when selected) -->
            <div id="auditExpandedView" class="hidden flex flex-col h-full animate-fade-in">
                <!-- Expanded Header -->
                <div class="p-6 border-b border-gray-100 dark:border-slate-700 flex flex-wrap justify-between items-center gap-4 bg-gradient-to-r from-emerald-500/5 to-transparent">
                    <div class="flex items-center space-x-3.5">
                        <div class="w-12 h-12 bg-emerald-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-600/20">
                            <i class="fas fa-fingerprint text-xl"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2.5">
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-wider text-sm sm:text-base">System Audit Log — Operational Stream</h3>
                                <span class="px-2.5 py-0.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-black uppercase">
                                    <%= (typeof logs !== 'undefined' && logs) ? logs.length : 0 %> Total Events
                                </span>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Real-Time Administrative Action Auditing & Security Logging</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2.5">
                        <!-- Quick Search Box -->
                        <div class="relative">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text" placeholder="Filter audit logs..." oninput="filterAuditTable(this.value)" class="pl-8 pr-3 py-2 bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-800 dark:text-white outline-none focus:ring-2 focus:ring-pnp-blue w-44 sm:w-56">
                        </div>

                        <!-- Open Modal Button -->
                        <button type="button" onclick="openUsersLogModal()" class="px-4 py-2 bg-slate-900 dark:bg-slate-700 hover:bg-pnp-blue text-white font-black rounded-xl text-[10px] uppercase tracking-wider flex items-center space-x-1.5 transition shadow-2xs cursor-pointer">
                            <i class="fas fa-list text-pnp-gold text-xs"></i>
                            <span>View All Modal</span>
                        </button>

                        <!-- Collapse Back Button -->
                        <button type="button" onclick="setActivePanel('all')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-white font-black rounded-xl text-[10px] uppercase tracking-wider flex items-center space-x-1.5 transition shadow-2xs cursor-pointer">
                            <i class="fas fa-compress-alt text-xs"></i>
                            <span>Collapse</span>
                        </button>
                    </div>
                </div>

                <!-- Full Table -->
                <div class="flex-grow overflow-x-auto">
                    <table class="w-full text-left text-xs min-w-[700px]">
                        <thead class="bg-gray-50 dark:bg-slate-900 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                            <tr>
                                <th class="px-6 py-4 w-44 shrink-0">Personnel & Action</th>
                                <th class="px-6 py-4">Details</th>
                                <th class="px-6 py-4 text-right w-36 shrink-0">Date & Time</th>
                            </tr>
                        </thead>
                        <tbody id="fullAuditTableBody" class="divide-y divide-gray-50 dark:divide-slate-700/50">
                            <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                                <% logs.forEach(l => { %>
                                    <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-700/20 transition-colors group">
                                        <td class="px-6 py-3.5 whitespace-nowrap">
                                            <div class="font-black text-pnp-blue dark:text-white text-xs truncate max-w-[140px]" title="<%= l.username %>">
                                                <%= l.username %>
                                            </div>
                                            <span class="inline-block mt-1 px-2 py-0.5 bg-slate-100 dark:bg-slate-700 rounded text-[8px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-300 border border-slate-200/50 dark:border-slate-600">
                                                <%= l.action %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-3.5">
                                            <div class="text-[11px] font-medium text-gray-600 dark:text-gray-300 leading-relaxed" title="<%= l.details %>">
                                                <%= l.details %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-3.5 text-right whitespace-nowrap">
                                            <div class="text-[10px] font-bold font-mono text-gray-500 dark:text-gray-300">
                                                <%= new Date(l.timestamp).toLocaleDateString(undefined, {month:'short', day:'numeric', year:'numeric'}) %>
                                            </div>
                                            <div class="text-[9px] font-mono text-gray-400 mt-0.5">
                                                <%= new Date(l.timestamp).toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit', hour12:true}) %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="px-6 py-12 text-center text-slate-300 font-black uppercase tracking-[0.3em] italic opacity-50">
                                        No operational data captured in current session
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- CREATE ACCOUNT MODAL (FOR PERSONNEL REG.)  -->
<!-- ========================================== -->
<div id="createAccountModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-[150] hidden items-center justify-center p-4 animate-modal-backdrop">
    <div class="modal-dialog-card bg-white dark:bg-slate-900 rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 flex flex-col transform scale-95 transition-transform duration-300">
        <!-- Modal Header -->
        <div class="px-6 py-5 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between bg-gradient-to-r from-pnp-blue/5 to-transparent">
            <div class="flex items-center space-x-3.5">
                <div class="w-11 h-11 bg-pnp-blue text-white rounded-2xl flex items-center justify-center shadow-lg shadow-pnp-blue/20">
                    <i class="fas fa-user-plus text-pnp-gold text-base"></i>
                </div>
                <div>
                    <h3 class="text-sm font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider">Create Account</h3>
                    <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">Personnel Registry Credentials</p>
                </div>
            </div>
            <div class="flex items-center space-x-2.5">
                <div class="<%= isUserQuotaFull ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400' : 'bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold' %> px-2.5 py-1 rounded-xl font-mono font-black text-[9px] tracking-wider uppercase">
                    <%= (typeof users !== 'undefined' && users) ? users.length : 0 %> / 10 Accounts
                </div>
                <button type="button" onclick="closeCreateAccountModal()" class="w-8 h-8 rounded-xl bg-gray-100 dark:bg-slate-800 text-gray-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950/40 flex items-center justify-center transition-all cursor-pointer" title="Close">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>
        </div>

        <% if (user && user.role === 'superadmin') { %>
            <% if (isUserQuotaFull) { %>
                <div class="p-6 space-y-4">
                    <div class="p-4 bg-amber-500/10 border border-amber-500/20 rounded-2xl text-amber-700 dark:text-amber-300 space-y-2">
                        <div class="flex items-center space-x-2 font-black text-xs uppercase tracking-wider">
                            <i class="fas fa-exclamation-triangle text-amber-500"></i>
                            <span>Account Quota Limit Reached (10/10)</span>
                        </div>
                        <p class="text-[11px] font-medium leading-relaxed opacity-90">
                            The Personnel Registry has reached the maximum capacity limit of 10 authorized administrative accounts. To create a new personnel account, an existing account must first be neutralized or removed.
                        </p>
                    </div>
                    <div class="flex justify-end pt-2">
                        <button type="button" onclick="closeCreateAccountModal()" class="px-5 py-2.5 rounded-xl bg-gray-100 dark:bg-slate-800 text-gray-500 text-xs font-black uppercase tracking-wider cursor-pointer">
                            Close
                        </button>
                    </div>
                </div>
            <% } else { %>
                <form id="createAccountForm" action="/admin/users/add" method="POST" onsubmit="confirmCreateAccount(event)">
                    <div class="p-6 space-y-4">
                        <div class="space-y-1.5">
                            <div class="flex justify-between items-center">
                                <label for="full_name" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">Full Name</label>
                                <span id="create_fullname_counter" class="text-[8px] text-gray-400 font-bold uppercase tracking-wider">0 / 60 letters • 0 / 6 words</span>
                            </div>
                            <input type="text" name="full_name" id="full_name" required minlength="2" maxlength="60" placeholder="e.g. Patrolman Juan Dela Cruz" oninput="updateCreateUserCounters()"
                                class="w-full px-4 py-3 bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-700 dark:text-gray-200 transition-all">
                        </div>

                        <div class="space-y-1.5">
                            <div class="flex justify-between items-center">
                                <label for="email" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">Email Address</label>
                                <span id="create_email_counter" class="text-[8px] text-gray-400 font-bold uppercase tracking-wider">0 / 100 letters</span>
                            </div>
                            <input type="email" name="email" id="email" required maxlength="100" placeholder="officer@pnp.gov.ph" oninput="updateCreateUserCounters()"
