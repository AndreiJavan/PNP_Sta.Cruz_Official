            return false;
        }

        // Validate Position Designation
        const posCheck = clientValidatePosition(position);
        if (!posCheck.valid) {
            const alertFn = window.strategicAlert || (({ message }) => alert(message));
            alertFn({
                title: 'Validation Notice',
                message: posCheck.error,
                confirmText: 'Understood',
                type: 'warning'
            });
            if (posInput) posInput.focus();
            return false;
        }

        // Check if officer details were changed
        if (window.originalPersonnelData &&
            nameCheck.normalized === window.originalPersonnelData.name &&
            posCheck.normalized === window.originalPersonnelData.position) {
            
            const alertFn = window.strategicAlert || (({ message }) => alert(message));
