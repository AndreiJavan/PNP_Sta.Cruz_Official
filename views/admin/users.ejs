    let currentActivePanel = 'all';

    function toggleActivePanel(panel) {
        if (currentActivePanel === panel) {
            setActivePanel('all');
        } else {
            setActivePanel(panel);
        }
    }

    function setActivePanel(panel) {
        currentActivePanel = panel;
        const grid = document.getElementById('containersGrid');
        const cPersonnel = document.getElementById('containerPersonnel');
        const cRoster = document.getElementById('containerRoster');
        const cAudit = document.getElementById('containerAudit');

        const pSummary = document.getElementById('personnelSummaryView');
        const pExpanded = document.getElementById('personnelExpandedView');
        const rSummary = document.getElementById('rosterSummaryView');
        const rExpanded = document.getElementById('rosterExpandedView');
        const aSummary = document.getElementById('auditSummaryView');
        const aExpanded = document.getElementById('auditExpandedView');

        const tabs = {
            personnel: document.getElementById('btnTabPersonnel'),
            roster: document.getElementById('btnTabRoster'),
            audit: document.getElementById('btnTabAudit')
        };

        const activeClass = 'px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all flex items-center space-x-1.5 cursor-pointer bg-white dark:bg-slate-800 text-pnp-blue dark:text-pnp-gold shadow-xs';
        const inactiveClass = 'px-3.5 py-2 rounded-xl text-[10px] font-black uppercase tracking-wider transition-all flex items-center space-x-1.5 cursor-pointer text-gray-500 hover:text-slate-800 dark:text-gray-400 dark:hover:text-white';

        Object.keys(tabs).forEach(k => {
            if (!tabs[k]) return;
            tabs[k].className = (k === panel) ? activeClass : inactiveClass;
        });

        if (panel === 'all') {
            if (grid) {
                grid.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch';
            }
            if (cPersonnel) cPersonnel.classList.remove('hidden');
            if (cRoster) cRoster.classList.remove('hidden');
            if (cAudit) cAudit.classList.remove('hidden');

            if (pSummary) pSummary.classList.remove('hidden');
            if (pExpanded) pExpanded.classList.add('hidden');
            if (rSummary) rSummary.classList.remove('hidden');
            if (rExpanded) rExpanded.classList.add('hidden');
            if (aSummary) aSummary.classList.remove('hidden');
            if (aExpanded) aExpanded.classList.add('hidden');
        } else if (panel === 'personnel') {
            if (grid) grid.className = 'grid grid-cols-1 gap-6';
            if (cPersonnel) cPersonnel.classList.remove('hidden');
            if (cRoster) cRoster.classList.add('hidden');
            if (cAudit) cAudit.classList.add('hidden');

            if (pSummary) pSummary.classList.add('hidden');
            if (pExpanded) pExpanded.classList.remove('hidden');
        } else if (panel === 'roster') {
            if (grid) grid.className = 'grid grid-cols-1 gap-6';
            if (cPersonnel) cPersonnel.classList.add('hidden');
            if (cRoster) cRoster.classList.remove('hidden');
            if (cAudit) cAudit.classList.add('hidden');

            if (rSummary) rSummary.classList.add('hidden');
            if (rExpanded) rExpanded.classList.remove('hidden');
        } else if (panel === 'audit') {
            if (grid) grid.className = 'grid grid-cols-1 gap-6';
            if (cPersonnel) cPersonnel.classList.add('hidden');
            if (cRoster) cRoster.classList.add('hidden');
            if (cAudit) cAudit.classList.remove('hidden');

            if (aSummary) aSummary.classList.add('hidden');
            if (aExpanded) aExpanded.classList.remove('hidden');
        }
    }

    function filterPersonnelTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#fullPersonnelTableBody tr');
        rows.forEach(r => {
            const text = r.textContent.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    }

    function filterRosterTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#fullRosterTableBody tr');
        rows.forEach(r => {
            const text = r.textContent.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    }

    function filterAuditTable(query) {
        const q = (query || '').toLowerCase().trim();
        const rows = document.querySelectorAll('#fullAuditTableBody tr');
        rows.forEach(r => {
            const text = r.textContent.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateCreateUserCounters();
        const hash = (window.location.hash || '').replace('#', '').toLowerCase();
        if (['personnel', 'roster', 'audit'].includes(hash)) {
            setActivePanel(hash);
        }
    });
</script>