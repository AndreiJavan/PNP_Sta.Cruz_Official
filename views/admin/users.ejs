<div class="space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        <!-- Personnel Configuration -->
        <div class="lg:col-span-1">
            <div
                class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden">
                <div
                    class="p-8 border-b border-gray-50 dark:border-slate-700 bg-gradient-to-r from-pnp-blue/5 to-transparent">
                    <h3 class="font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.2em] text-[11px]">
                        Create Account</h3>
                    <p class="text-[8px] text-gray-400 font-bold uppercase tracking-widest mt-1">Account Credentials
                    </p>
                </div>
                <% if (user && user.role==='superadmin' ) { %>
                    <form action="/admin/users/add" method="POST" class="p-8 space-y-6" onsubmit="confirmOperationalAction(event, { title: 'Account Creation Pending', message: 'An email will be sent to the Police Chief for approval. The new personnel will NOT be able to log in until the account is approved. Proceed?', type: 'info', confirmText: 'Create Account' })">

                        <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <label for="full_name"
                                    class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">Full Name</label>
                                <span class="text-[8px] text-gray-400 font-bold uppercase tracking-wider">2 - 60 chars / max 6 words</span>
                            </div>
                            <input type="text" name="full_name" id="full_name" required minlength="2" maxlength="60" placeholder="User Full Name"
                                class="w-full px-5 py-4 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-700 dark:text-gray-300 transition-all">
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <label for="email"
                                    class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">Email Address</label>
                                <span class="text-[8px] text-gray-400 font-bold uppercase tracking-wider">max 100 chars</span>
                            </div>
                            <input type="email" name="email" id="email" required maxlength="100" placeholder="user@example.com"
                                class="w-full px-5 py-4 bg-gray-50 dark:bg-slate-900 border border-gray-100 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-700 dark:text-gray-300 transition-all">
                        </div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <label for="password"
                                    class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">Password</label>
                                <span class="text-[8px] text-gray-400 font-bold uppercase tracking-wider">8 - 64 chars</span>
                            </div>
                            <input type="password" name="password" id="password" required minlength="8" maxlength="64" placeholder="••••••••"
                                class="w-full px-5 py-4 bg-gray-50 dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-700 dark:text-gray-300 transition-all">
                        </div>
                        <!-- Personnel are always created with 'staff' role by default -->
                        <button type="submit"
                            class="w-full bg-pnp-blue hover:bg-black text-white font-black py-5 rounded-2xl shadow-xl shadow-pnp-blue/20 transition-all transform hover:scale-[1.02] active:scale-95 uppercase tracking-[0.3em] text-[10px]">
                            Create Account
                        </button>
                    </form>
                    <% } else { %>
                        <div class="p-8 py-20 text-center">
                            <div
                                class="w-16 h-16 bg-pnp-blue/5 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-lock text-pnp-blue/20 text-2xl"></i>
                            </div>
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-relaxed">
                                Administrator Access Required<br>
                                <span class="text-[8px] opacity-60">Account management is locked for staff.</span>
                            </p>
                        </div>
                        <% } %>
            </div>
        </div>

        <!-- Active Personnel -->
        <div class="lg:col-span-2">
            <div
                class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col">
                <div class="p-8 border-b border-gray-50 dark:border-slate-700 flex justify-between items-center">
                    <div>
                        <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.2em] text-[11px]">
                            Personnel Registry</h3>
                        <p class="text-[8px] text-gray-400 font-bold uppercase tracking-widest mt-1">Authorized Administrators & Staff</p>
                    </div>
                    <div class="bg-pnp-blue/10 px-3 py-1.5 rounded-xl">
                        <span class="text-[10px] font-black text-pnp-blue tracking-widest uppercase">
                            <%= users.length %> Users
                        </span>
                    </div>
                </div>
                <div class="flex-grow overflow-x-auto">
                    <table class="w-full text-left text-xs min-w-[600px]">
                        <thead
                            class="bg-gray-50 dark:bg-slate-900/50 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                            <tr>
                                <th class="px-8 py-5">Full Name</th>
                                <th class="px-8 py-5">Email Address</th>
                                <th class="px-8 py-5">Status</th>
                                <th class="px-8 py-5">Date Created</th>
                                <th class="px-8 py-5 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 dark:divide-slate-700/50">
                            <% users.forEach(u=> { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/20 transition-colors">
                                    <td class="px-8 py-5 font-black text-pnp-blue dark:text-pnp-gold uppercase">
                                        <%= u.full_name %>
                                    </td>
                                    <td class="px-8 py-5">
                                        <div class="text-[11px] text-gray-500 dark:text-gray-400 font-mono lowercase mt-0.5"><%= u.email || 'No email provided' %></div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <% if (u.status === 'active') { %>
                                            <span class="px-3 py-1 bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-green-200 dark:border-green-800">Active</span>
                                        <% } else if (u.status === 'rejected') { %>
                                            <span class="px-3 py-1 bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-red-200 dark:border-red-800">Rejected</span>
                                        <% } else { %>
                                            <span class="px-3 py-1 bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400 rounded-lg text-[9px] font-black uppercase tracking-widest border border-yellow-200 dark:border-yellow-800">Pending</span>
                                        <% } %>
                                    </td>
                                    <td class="px-8 py-5 text-gray-400 font-mono">
                                        <%= new Date(u.created_at).toLocaleDateString(undefined, {month:'short',
                                            day:'numeric', year:'numeric'}) %>
                                    </td>
                                    <td class="px-8 py-5 text-right">
                                        <div class="flex items-center justify-end space-x-2">
                                            <% if (user && user.role === 'superadmin') { %>
                                                <button type="button" 
                                                    data-id="<%= u.id %>"
                                                    data-fullname="<%= u.full_name || '' %>"
                                                    data-email="<%= u.email || '' %>"
                                                    data-role="<%= u.role || 'staff' %>"
                                                    data-status="<%= u.status || 'active' %>"
                                                    onclick="handleUserEditClick(this)"
                                                    class="w-10 h-10 rounded-xl bg-pnp-blue/10 dark:bg-pnp-blue/20 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-blue hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                    title="Edit Account Details">
                                                    <i class="fas fa-edit text-[11px]"></i>
                                                </button>
                                            <% } %>
                                            <% if (u.role === 'superadmin') { %>
                                                <span class="text-[8px] font-black text-pnp-blue/50 dark:text-slate-400 uppercase italic px-3 py-2 bg-pnp-blue/5 dark:bg-slate-800/50 rounded-lg border border-pnp-blue/10 dark:border-slate-700/50">Protected</span>
                                            <% } else if (user && user.role === 'superadmin') { %>
                                                <button type="button" 
                                                    data-id="<%= u.id %>"
                                                    data-fullname="<%= u.full_name || '' %>"
                                                    onclick="handleUserDeleteClick(this)"
                                                    class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                    title="Neutralize Account">
                                                    <i class="fas fa-trash-alt text-[11px]"></i>
                                                </button>
                                            <% } else { %>
                                                <span class="text-[8px] font-black text-slate-300 uppercase italic">Locked</span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Station Leadership Directory & Operational Audit Logs (Side-by-Side Row) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <!-- Station Directory Roster -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col">
            <div class="p-6 sm:p-8 border-b border-gray-50 dark:border-slate-700 flex flex-wrap justify-between items-center gap-3 bg-gradient-to-r from-pnp-blue/5 to-transparent">
                <div>
                    <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.2em] text-[11px]">
                        Station Directory Roster
                    </h3>
                    <p class="text-[8px] text-gray-400 font-bold uppercase tracking-widest mt-1">Displayed on Public Portal Homepage</p>
                </div>
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <div class="bg-pnp-gold/20 px-3 py-1.5 rounded-xl border border-pnp-gold/30">
                        <span class="text-[10px] font-black text-pnp-blue dark:text-pnp-gold tracking-widest uppercase">
                            <%= (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel.length : 0 %> / 10 Listed
                        </span>
                    </div>
                    <% if (user && user.role === 'superadmin') { %>
                        <% const isRosterFull = (typeof stationPersonnel !== 'undefined' && stationPersonnel && stationPersonnel.length >= 10); %>
                        <% if (isRosterFull) { %>
                            <button type="button" onclick="alertRosterLimit()"
                                class="px-3.5 py-1.5 bg-gray-200 dark:bg-slate-700 text-gray-500 dark:text-gray-400 font-black rounded-xl text-[10px] uppercase tracking-wider flex items-center space-x-1.5 cursor-not-allowed shadow-sm"
                                title="Directory Capacity Reached (10/10)">
                                <i class="fas fa-ban text-xs"></i>
                                <span>Roster Full (10 Max)</span>
                            </button>
                        <% } else { %>
                            <button type="button" onclick="openAddPersonnelModal()"
                                class="px-3.5 py-1.5 bg-pnp-gold hover:bg-yellow-500 text-pnp-blue font-black rounded-xl text-[10px] uppercase tracking-wider shadow-md shadow-pnp-gold/20 flex items-center space-x-1.5 transition-all transform hover:scale-105 active:scale-95"
                                title="Add Directory Personnel">
                                <i class="fas fa-user-plus text-xs"></i>
                                <span>Add Personnel</span>
                            </button>
                        <% } %>
                    <% } %>
                </div>
            </div>
            <div class="flex-grow overflow-x-auto">
                <table class="w-full text-left text-xs min-w-[450px]">
                    <thead class="bg-gray-50 dark:bg-slate-900/50 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                        <tr>
                            <th class="px-5 py-4">Personnel Name & Rank</th>
                            <th class="px-5 py-4">Designation</th>
                            <th class="px-5 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 dark:divide-slate-700/50">
                        <% if (typeof stationPersonnel !== 'undefined' && stationPersonnel && stationPersonnel.length > 0) { %>
                            <% stationPersonnel.forEach(p => { %>
                                <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/20 transition-colors">
                                    <td class="px-5 py-4 font-black text-pnp-blue dark:text-white uppercase">
                                        <%= p.name %>
                                    </td>
                                    <td class="px-5 py-4 text-gray-600 dark:text-gray-300 font-bold uppercase tracking-tight text-[11px]">
                                        <span class="px-2.5 py-1 bg-blue-50 dark:bg-slate-900/60 rounded-lg text-pnp-blue dark:text-pnp-gold border border-pnp-blue/10">
                                            <%= p.position %>
                                        </span>
                                    </td>
                                    <td class="px-5 py-4 text-right">
                                        <div class="flex items-center justify-end space-x-1.5">
                                            <% if (user && user.role === 'superadmin') { %>
                                                <button type="button"
                                                    data-id="<%= p.id %>"
                                                    data-name="<%= p.name || '' %>"
                                                    data-position="<%= p.position || '' %>"
                                                    onclick="handlePersonnelEditClick(this)"
                                                    class="w-8 h-8 rounded-lg bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-gold hover:text-pnp-blue transition-all flex items-center justify-center shadow-sm"
                                                    title="Edit Directory Officer">
                                                    <i class="fas fa-edit text-xs"></i>
                                                </button>
                                                <button type="button"
                                                    data-id="<%= p.id %>"
                                                    data-name="<%= p.name || '' %>"
                                                    onclick="handlePersonnelDeleteClick(this)"
                                                    class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-500 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                    title="Remove from Directory">
                                                    <i class="fas fa-trash-alt text-xs"></i>
                                                </button>
                                            <% } else { %>
                                                <span class="text-[8px] font-black text-slate-300 uppercase italic">Locked</span>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="px-6 py-12 text-center text-slate-400 font-bold uppercase tracking-widest text-xs">
                                    No directory personnel registered yet.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Operational Audit Logs Integration (Shrunk to align in row) -->
        <div class="bg-white dark:bg-slate-800 rounded-3xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden flex flex-col">
            <div class="p-6 sm:p-8 border-b border-gray-50 dark:border-slate-700 flex flex-wrap justify-between items-center gap-3 bg-slate-50 dark:bg-slate-900/50">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-pnp-gold/20 rounded-xl flex items-center justify-center text-pnp-gold shadow-sm">
                        <i class="fas fa-fingerprint text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.2em] text-[11px]">
                            System Audit Log
                        </h3>
                        <p class="text-[8px] text-pnp-gold font-black uppercase tracking-[0.2em] mt-0.5">
                            Live System Tracking
                        </p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <% if (typeof logs !== 'undefined' && logs.length > 5) { %>
                        <button onclick="openUsersLogModal()" class="px-3.5 py-1.5 bg-pnp-blue text-white rounded-xl text-[9px] font-black uppercase tracking-widest hover:bg-blue-800 transition shadow-md shadow-pnp-blue/20 flex items-center space-x-1.5">
                            <i class="fas fa-list text-pnp-gold text-[10px]"></i>
                            <span>View All (<%= logs.length %>)</span>
                        </button>
                    <% } %>
                </div>
            </div>
            <div class="flex-grow overflow-x-auto">
                <table class="w-full text-left text-xs min-w-[500px]">
                    <thead class="bg-gray-50 dark:bg-slate-900 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                        <tr>
                            <th class="px-5 py-4">Personnel</th>
                            <th class="px-5 py-4">Action</th>
                            <th class="px-5 py-4">Details</th>
                            <th class="px-5 py-4 text-right">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 dark:divide-slate-700/50">
                        <% if (typeof logs !=='undefined' && logs.length > 0) { %>
                            <% logs.slice(0, 10).forEach(l=> { %>
                                <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-700/20 transition-colors group">
                                    <td class="px-5 py-4 font-black text-pnp-blue dark:text-white whitespace-nowrap">
                                        <div class="flex items-center space-x-2">
                                            <div class="w-1.5 h-1.5 rounded-full bg-pnp-blue"></div>
                                            <span><%= l.username %></span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-4 shrink-0">
                                        <span class="px-2.5 py-0.5 bg-slate-100 dark:bg-slate-700 rounded-md text-[9px] font-black uppercase tracking-widest text-slate-500 border border-slate-200/50 dark:border-slate-600">
                                            <%= l.action %>
                                        </span>
                                    </td>
                                    <td class="px-5 py-4 text-gray-500 dark:text-gray-400 font-bold max-w-xs truncate uppercase tracking-tighter" title="<%= l.details %>">
                                        <%= l.details %>
                                    </td>
                                    <td class="px-5 py-4 text-right text-gray-400 font-mono font-bold whitespace-nowrap text-[11px]">
                                        <%= new Date(l.timestamp).toLocaleString(undefined, {hour12: true, month:'short', day:'numeric', hour:'numeric', minute:'numeric'}) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center text-slate-300 font-black uppercase tracking-[0.3em] italic opacity-50">
                                    No operational data captured in current session
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- View All Users Audit Log Modal -->
<div id="usersLogModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-[100] hidden items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-slate-900 rounded-3xl w-full max-w-5xl mx-4 overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 flex flex-col max-h-[85vh] transform scale-95 transition-transform duration-300">
        
        <!-- Modal Header -->
        <div class="px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between bg-gray-50 dark:bg-slate-900/50">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-pnp-blue rounded-2xl flex items-center justify-center shadow-lg shadow-pnp-blue/20">
                    <i class="fas fa-list text-pnp-gold text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-800 dark:text-white uppercase tracking-widest">Complete System Logs</h3>
                    <p class="text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em] mt-1">Full administrative activity stream</p>
                </div>
            </div>
            <button onclick="closeUsersLogModal()" class="w-10 h-10 bg-white dark:bg-slate-800 text-gray-400 hover:text-red-500 rounded-xl shadow-sm border border-gray-100 dark:border-slate-700 flex items-center justify-center transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Modal Body (Scrollable Table) -->
        <div class="p-0 overflow-y-auto custom-scrollbar flex-grow bg-white dark:bg-slate-900">
            <table class="w-full text-left text-xs min-w-[600px]">
                <thead class="bg-gray-50 dark:bg-slate-900 sticky top-0 z-10 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em]">
                    <tr>
                        <th class="px-8 py-5">Personnel</th>
                        <th class="px-8 py-5">Action</th>
                        <th class="px-8 py-5">Details</th>
                        <th class="px-8 py-5 text-right">Timestamp</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 dark:divide-slate-800/50">
                    <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
                        <% logs.forEach(l => { %>
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-slate-800/50 transition-colors group">
                                <td class="px-8 py-4 font-black text-pnp-blue dark:text-white whitespace-nowrap">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-pnp-blue"></div>
                                        <span><%= l.username %></span>
                                    </div>
                                </td>
                                <td class="px-8 py-4 shrink-0">
                                    <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-lg text-[9px] font-black uppercase tracking-widest text-slate-500 border border-slate-200/50 dark:border-slate-700">
                                        <%= l.action %>
                                    </span>
                                </td>
                                <td class="px-8 py-4 text-gray-500 dark:text-gray-400 font-bold">
                                    <%= l.details %>
                                </td>
                                <td class="px-8 py-4 text-right text-gray-400 font-mono font-bold whitespace-nowrap">
                                    <%= new Date(l.timestamp).toLocaleString(undefined, {hour12: true, month:'short', day:'numeric', hour:'numeric', minute:'numeric'}) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete User Modal -->
<div id="deleteUserModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-[100] hidden items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-slate-900 rounded-3xl w-full max-w-lg mx-4 overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 flex flex-col transform scale-95 transition-transform duration-300">
        
        <form id="deleteUserForm" method="POST" action="">
            <div class="px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between bg-red-50 dark:bg-red-900/10">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-red-100 dark:bg-red-900/30 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/10">
                        <i class="fas fa-exclamation-triangle text-red-500 text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-red-600 dark:text-red-400 uppercase tracking-widest">Neutralize Account</h3>
                        <p class="text-[10px] text-red-400 font-bold uppercase tracking-[0.2em] mt-1">Permanent action for <span id="deleteUserTargetName"></span></p>
                    </div>
                </div>
                <button type="button" onclick="closeDeleteUserModal()" class="w-10 h-10 bg-white dark:bg-slate-800 text-gray-400 hover:text-red-500 rounded-xl shadow-sm border border-gray-100 dark:border-slate-700 flex items-center justify-center transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="p-8 space-y-6">
                <p class="text-xs font-bold text-gray-600 dark:text-gray-400 uppercase tracking-widest leading-relaxed">
