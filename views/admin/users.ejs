<script>
    function openUsersLogModal() {
        const modal = document.getElementById('usersLogModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeUsersLogModal() {
        const modal = document.getElementById('usersLogModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function handleUserEditClick(btn) {
        const id = btn.getAttribute('data-id');
        const fullName = btn.getAttribute('data-fullname') || '';
        const email = btn.getAttribute('data-email') || '';
        const role = btn.getAttribute('data-role') || 'staff';
        const status = btn.getAttribute('data-status') || 'active';
        openEditUserModal(id, fullName, email, role, status);
    }

    function handleUserDeleteClick(btn) {
        const id = btn.getAttribute('data-id');
        const fullName = btn.getAttribute('data-fullname') || '';
        openDeleteUserModal(id, fullName);
    }

    function openEditUserModal(userId, fullName, email, role, status) {
        document.getElementById('editUserForm').action = `/admin/users/${userId}/edit`;
        document.getElementById('edit_full_name').value = fullName;
        document.getElementById('edit_email').value = email || '';
        document.getElementById('edit_role').value = role || 'staff';
        document.getElementById('edit_status').value = status || 'active';
        document.getElementById('edit_password').value = '';

        const modal = document.getElementById('editUserModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeEditUserModal() {
        const modal = document.getElementById('editUserModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function openDeleteUserModal(userId, userName) {
        document.getElementById('deleteUserForm').action = `/admin/users/${userId}/delete`;
        document.getElementById('deleteUserTargetName').textContent = userName;
        
        // Reset form
        document.getElementById('deleteUserForm').reset();
        toggleCustomReason();

        const modal = document.getElementById('deleteUserModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteUserModal() {
        const modal = document.getElementById('deleteUserModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function alertRosterLimit() {
        const alertFn = window.strategicAlert || (({ message }) => alert(message));
        alertFn({
            title: 'Directory Roster Full',
            message: 'The Station Directory Roster has reached its maximum capacity of 10 personnel. Please remove or update an existing officer before adding a new one.',
            confirmText: 'Understood',
            type: 'warning'
        });
    }

    function openAddPersonnelModal() {
        const currentCount = <%= (typeof stationPersonnel !== 'undefined' && stationPersonnel ? stationPersonnel.length : 0) %>;
        if (currentCount >= 10) {
            alertRosterLimit();
            return;
        }
        const form = document.getElementById('addPersonnelForm');
        if (form) form.reset();
        const modal = document.getElementById('addPersonnelModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeAddPersonnelModal() {
        const modal = document.getElementById('addPersonnelModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    async function confirmAddPersonnel(event) {
        event.preventDefault();
        const form = document.getElementById('addPersonnelForm');
        const name = document.getElementById('add_p_name').value.trim();
        const position = document.getElementById('add_p_position').value.trim();
        if (!name || !position) return false;

        const confirmFn = window.strategicConfirm || (async ({ message }) => confirm(message));
        const confirmed = await confirmFn({
            title: 'Confirm Officer Registration',
            message: `Are you sure you want to add "${name}" with designation "${position}" to the Station Directory Roster? This change will reflect on the public portal.`,
            confirmText: 'Yes, Register Officer',
            cancelText: 'Cancel',
            type: 'warning'
        });

        if (confirmed) {
            form.submit();
        }
        return false;
    }

    function handlePersonnelEditClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name') || '';
        const position = btn.getAttribute('data-position') || '';
        openEditPersonnelModal(id, name, position);
    }

    function handlePersonnelDeleteClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name') || '';
        openDeletePersonnelModal(id, name);
    }

    function openEditPersonnelModal(id, name, position) {
        document.getElementById('editPersonnelForm').action = `/admin/personnel/${id}/edit`;
        document.getElementById('edit_p_name').value = name;
        document.getElementById('edit_p_position').value = position;

        const modal = document.getElementById('editPersonnelModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeEditPersonnelModal() {
        const modal = document.getElementById('editPersonnelModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    async function confirmEditPersonnel(event) {
        event.preventDefault();
        const form = document.getElementById('editPersonnelForm');
        const name = document.getElementById('edit_p_name').value.trim();
        const position = document.getElementById('edit_p_position').value.trim();
        if (!name || !position) return false;

        const confirmFn = window.strategicConfirm || (async ({ message }) => confirm(message));
        const confirmed = await confirmFn({
            title: 'Confirm Roster Modifications',
            message: `Are you sure you want to save changes to "${name}" (${position}) in the Station Directory Roster?`,
            confirmText: 'Save Changes',
            cancelText: 'Cancel',
            type: 'warning'
        });

        if (confirmed) {
            form.submit();
        }
        return false;
    }

    function openDeletePersonnelModal(id, name) {
        document.getElementById('deletePersonnelForm').action = `/admin/personnel/${id}/delete`;
        document.getElementById('deletePersonnelTargetName').textContent = name;

        const modal = document.getElementById('deletePersonnelModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeDeletePersonnelModal() {
        const modal = document.getElementById('deletePersonnelModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function toggleCustomReason() {
        const customContainer = document.getElementById('customReasonContainer');
        const customInput = document.getElementById('custom_reason');
        const otherRadio = document.querySelector('input[name="delete_reason"][value="Other"]');
        
        if (otherRadio && otherRadio.checked) {
            customContainer.classList.remove('hidden');
            customInput.required = true;
        } else {
            customContainer.classList.add('hidden');
            customInput.required = false;
        }
    }
</script>