<% 
    // Safety defaults
    const safeUsers = (typeof users !== 'undefined' && users) ? users : [];
    const safePersonnel = (typeof stationPersonnel !== 'undefined' && stationPersonnel) ? stationPersonnel : [];
    const safeLogs = (typeof logs !== 'undefined' && logs) ? logs : [];
    
    const superAdminCount = safeUsers.filter(u => u.role === 'superadmin').length;
    const staffCount = safeUsers.filter(u => u.role !== 'superadmin').length;
    const activeUsersCount = safeUsers.filter(u => u.status === 'active').length;
%>

<div class="space-y-8 animate-fade-in px-2 lg:px-0">
    <!-- Top KPI Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Card 1: Station Leadership / Public Directory -->
        <div onclick="switchUserTab('directory')" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2.5rem] relative overflow-hidden group transition-all duration-300 cursor-pointer hover:-translate-y-1">
            <div class="absolute -right-4 -bottom-4 w-28 h-28 bg-pnp-gold/10 rounded-full blur-3xl group-hover:bg-pnp-gold/20 transition-all"></div>
            <div class="relative z-10 text-slate-800 dark:text-white">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex flex-col">
                        <span class="text-[9px] text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-[0.25em]">Station Leadership</span>
                        <h3 class="text-xs font-black uppercase tracking-widest mt-1 text-slate-900 dark:text-white">Public Directory</h3>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-pnp-gold/15 dark:bg-pnp-gold/20 flex items-center justify-center text-pnp-blue dark:text-pnp-gold border border-pnp-gold/30 shadow-lg group-hover:scale-110 transition-transform">
                        <i class="fas fa-id-badge text-lg"></i>
                    </div>
                </div>
                <div class="flex items-end space-x-3 mb-2">
                    <h2 class="text-5xl font-black tabular-nums tracking-tighter text-slate-900 dark:text-white"><%= safePersonnel.length %></h2>
                    <div class="flex flex-col mb-1">
                        <span class="text-[9px] font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.1em]">Officers</span>
                        <span class="text-[9px] font-bold text-slate-400 dark:text-white/40 uppercase tracking-tighter leading-none">Public Portal</span>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                    <span class="text-[8px] text-slate-400 dark:text-white/40 font-bold uppercase tracking-widest">Portal Homepage Sync</span>
                    <i class="fas fa-arrow-right text-[9px] text-pnp-gold group-hover:translate-x-1.5 transition-transform"></i>
                </div>
            </div>
        </div>

        <!-- Card 2: Administrative Personnel Accounts -->
        <div onclick="switchUserTab('credentials')" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2.5rem] relative overflow-hidden group transition-all duration-300 cursor-pointer hover:-translate-y-1">
            <div class="absolute -right-4 -bottom-4 w-28 h-28 bg-pnp-blue/10 dark:bg-blue-400/10 rounded-full blur-3xl group-hover:bg-pnp-blue/20 transition-all"></div>
            <div class="relative z-10 text-slate-800 dark:text-white">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex flex-col">
                        <span class="text-[9px] text-pnp-blue dark:text-blue-400 font-black uppercase tracking-[0.25em]">Access Control</span>
                        <h3 class="text-xs font-black uppercase tracking-widest mt-1 text-slate-900 dark:text-white">Admin Accounts</h3>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-pnp-blue/10 dark:bg-blue-500/20 flex items-center justify-center text-pnp-blue dark:text-blue-400 border border-pnp-blue/20 shadow-lg group-hover:scale-110 transition-transform">
                        <i class="fas fa-users-gear text-lg"></i>
                    </div>
                </div>
                <div class="flex items-end space-x-3 mb-2">
                    <h2 class="text-5xl font-black tabular-nums tracking-tighter text-slate-900 dark:text-white"><%= safeUsers.length %></h2>
                    <div class="flex flex-col mb-1">
                        <span class="text-[9px] font-black text-emerald-500 uppercase tracking-[0.1em]"><%= activeUsersCount %> Active</span>
                        <span class="text-[9px] font-bold text-slate-400 dark:text-white/40 uppercase tracking-tighter leading-none"><%= superAdminCount %> Superadmin</span>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                    <span class="text-[8px] text-slate-400 dark:text-white/40 font-bold uppercase tracking-widest">Duty Personnel Clearance</span>
                    <i class="fas fa-arrow-right text-[9px] text-pnp-blue dark:text-blue-400 group-hover:translate-x-1.5 transition-transform"></i>
                </div>
            </div>
        </div>

        <!-- Card 3: System Security & Clearance -->
        <div onclick="switchUserTab('audit')" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2.5rem] relative overflow-hidden group transition-all duration-300 cursor-pointer hover:-translate-y-1">
            <div class="absolute -right-4 -bottom-4 w-28 h-28 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all"></div>
            <div class="relative z-10 text-slate-800 dark:text-white">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex flex-col">
                        <span class="text-[9px] text-emerald-600 dark:text-emerald-400 font-black uppercase tracking-[0.25em]">Operational Audit</span>
                        <h3 class="text-xs font-black uppercase tracking-widest mt-1 text-slate-900 dark:text-white">Security Stream</h3>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 dark:bg-emerald-500/20 flex items-center justify-center text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-lg group-hover:scale-110 transition-transform">
                        <i class="fas fa-shield-halved text-lg"></i>
                    </div>
                </div>
                <div class="flex items-end space-x-3 mb-2">
                    <h2 class="text-3xl font-black tracking-tighter text-slate-900 dark:text-white uppercase">
                        <%= (user && user.role === 'superadmin') ? 'COMMAND' : 'STAFF' %>
                    </h2>
                    <div class="flex flex-col mb-1">
                        <span class="text-[9px] font-black text-emerald-500 uppercase tracking-[0.1em]">Authenticated</span>
                        <span class="text-[9px] font-bold text-slate-400 dark:text-white/40 uppercase tracking-tighter leading-none truncate max-w-[120px]" title="<%= (user && user.full_name) || (user && user.username) || '' %>">
                            <%= (user && user.full_name) ? user.full_name : ((user && user.username) || 'Officer') %>
                        </span>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                    <span class="text-[8px] text-slate-400 dark:text-white/40 font-bold uppercase tracking-widest"><%= safeLogs.length %> Logs Tracked</span>
                    <i class="fas fa-arrow-right text-[9px] text-emerald-500 group-hover:translate-x-1.5 transition-transform"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tactical Segmented Navigation Tabs -->
    <div class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md p-2 rounded-[2rem] border border-gray-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center space-x-2 w-full sm:w-auto">
            <button type="button" id="tabBtn_directory" onclick="switchUserTab('directory')" 
                class="user-tab-btn flex-1 sm:flex-initial flex items-center justify-center space-x-2.5 px-6 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all duration-200 bg-pnp-blue text-white shadow-lg shadow-pnp-blue/20">
                <i class="fas fa-id-badge text-pnp-gold"></i>
                <span>Station Leadership</span>
                <span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] bg-white/20 text-white font-mono"><%= safePersonnel.length %></span>
            </button>

            <button type="button" id="tabBtn_credentials" onclick="switchUserTab('credentials')" 
                class="user-tab-btn flex-1 sm:flex-initial flex items-center justify-center space-x-2.5 px-6 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all duration-200 text-slate-500 hover:text-pnp-blue dark:hover:text-white hover:bg-gray-100/80 dark:hover:bg-slate-800">
                <i class="fas fa-users-gear text-slate-400"></i>
                <span>Admin Accounts</span>
                <span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono"><%= safeUsers.length %></span>
            </button>

            <button type="button" id="tabBtn_audit" onclick="switchUserTab('audit')" 
                class="user-tab-btn flex-1 sm:flex-initial flex items-center justify-center space-x-2.5 px-6 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all duration-200 text-slate-500 hover:text-pnp-blue dark:hover:text-white hover:bg-gray-100/80 dark:hover:bg-slate-800">
                <i class="fas fa-fingerprint text-slate-400"></i>
                <span>Audit Logs</span>
                <span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] bg-slate-100 dark:bg-slate-800 text-slate-500 font-mono"><%= safeLogs.length %></span>
            </button>
        </div>

        <div class="text-[9px] font-bold text-slate-400 uppercase tracking-widest px-4 hidden md:block">
            <i class="fas fa-circle-check text-emerald-500 mr-1.5"></i> Sta. Cruz Police Command Console
        </div>
    </div>

    <!-- ========================================== -->
    <!-- TAB 1: STATION LEADERSHIP & DIRECTORY PANEL -->
    <!-- ========================================== -->
    <div id="panel_directory" class="user-tab-panel space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Add Directory Personnel Form (4 cols) -->
            <div class="lg:col-span-4">
                <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-sm border border-gray-150 dark:border-slate-800 overflow-hidden">
                    <div class="p-8 border-b border-gray-100 dark:border-slate-800 bg-gradient-to-r from-pnp-gold/15 via-pnp-gold/5 to-transparent flex items-center justify-between">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="w-2 h-2 rounded-full bg-pnp-gold"></span>
                                <h3 class="font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.25em] text-[11px]">
                                    Directory Officer
                                </h3>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-1">Station Leadership Roster</p>
                        </div>
                        <div class="w-10 h-10 rounded-2xl bg-pnp-gold/15 flex items-center justify-center text-pnp-blue dark:text-pnp-gold">
                            <i class="fas fa-user-plus text-xs"></i>
                        </div>
                    </div>

                    <% if (user && user.role === 'superadmin') { %>
                        <form action="/admin/personnel/add" method="POST" class="p-8 space-y-6">
                            <div class="space-y-2">
                                <label for="personnel_name" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                    Rank & Full Name
                                </label>
                                <div class="relative">
                                    <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="text" name="name" id="personnel_name" required placeholder="PLT COL JUAN DELA CRUZ"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-800 dark:text-white uppercase transition-all">
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="personnel_position" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                    Position / Designation
                                </label>
                                <div class="relative">
                                    <i class="fas fa-briefcase absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="text" name="position" id="personnel_position" required placeholder="e.g. Chief of Police"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-800 dark:text-white transition-all">
                                </div>
                            </div>

                            <div class="space-y-2">
                                <div class="flex justify-between items-center">
                                    <label for="personnel_order" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                        Display Order (Hierarchy)
                                    </label>
                                    <span class="text-[8px] text-pnp-gold font-black uppercase tracking-wider">Priority 1 = Top</span>
                                </div>
                                <div class="relative">
                                    <i class="fas fa-arrow-down-1-9 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="number" name="display_order" id="personnel_order" min="1" max="99" value="<%= safePersonnel.length + 1 %>"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-black text-gray-800 dark:text-white transition-all">
                                </div>
                                <p class="text-[8px] text-gray-400 font-bold uppercase tracking-wider leading-relaxed">
                                    Officers are ordered on the public homepage by ascending hierarchy sequence.
                                </p>
                            </div>

                            <button type="submit"
                                class="w-full bg-pnp-gold hover:bg-yellow-500 text-slate-900 font-black py-4 rounded-2xl shadow-xl shadow-pnp-gold/20 transition-all transform hover:scale-[1.01] active:scale-95 uppercase tracking-[0.25em] text-[10px] flex items-center justify-center space-x-2">
                                <i class="fas fa-plus-circle text-xs"></i>
                                <span>Add to Directory</span>
                            </button>
                        </form>
                    <% } else { %>
                        <div class="p-8 py-20 text-center">
                            <div class="w-16 h-16 bg-pnp-gold/10 rounded-3xl flex items-center justify-center mx-auto mb-4 border border-pnp-gold/20">
                                <i class="fas fa-lock text-pnp-gold text-2xl"></i>
                            </div>
                            <h4 class="text-xs font-black text-slate-800 dark:text-white uppercase tracking-widest">Clearance Locked</h4>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-2 leading-relaxed">
                                Only Superadministrators have authorization to modify the public station roster.
                            </p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Station Directory Roster Table (8 cols) -->
            <div class="lg:col-span-8">
                <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-sm border border-gray-150 dark:border-slate-800 overflow-hidden flex flex-col">
                    <div class="p-8 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.25em] text-[12px]">
                                    Station Directory Roster
                                </h3>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-1">Officers shown on Official Public Portal</p>
                        </div>

                        <!-- Live Directory Search -->
                        <div class="relative w-full sm:w-64">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text" id="directorySearchInput" onkeyup="filterDirectoryTable()" placeholder="Search officer or rank..."
                                class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none text-[10px] font-bold text-gray-700 dark:text-gray-200 uppercase tracking-widest focus:ring-2 focus:ring-pnp-blue/20 transition-all placeholder:text-gray-400">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs min-w-[650px]" id="directoryTable">
                            <thead class="bg-gray-50/80 dark:bg-slate-950/60 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">
                                <tr>
                                    <th class="px-6 py-4 w-16 text-center">Rank</th>
                                    <th class="px-6 py-4">Officer & Name</th>
                                    <th class="px-6 py-4">Designation</th>
                                    <th class="px-6 py-4 text-right">Operational Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-800" id="directoryTableBody">
                                <% if (safePersonnel.length > 0) { %>
                                    <% safePersonnel.forEach((p, idx) => { %>
                                        <tr class="directory-row hover:bg-pnp-blue/5 dark:hover:bg-slate-800/40 transition-colors">
                                            <td class="px-6 py-4 text-center">
                                                <span class="w-8 h-8 rounded-xl bg-pnp-gold/15 dark:bg-pnp-gold/20 text-pnp-blue dark:text-pnp-gold font-black font-mono text-[11px] inline-flex items-center justify-center border border-pnp-gold/30">
                                                    <%= p.display_order || (idx + 1) %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="flex items-center space-x-3.5">
                                                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-pnp-blue to-slate-900 text-pnp-gold font-black text-xs flex items-center justify-center uppercase shadow-md shadow-pnp-blue/10 shrink-0">
                                                        <%= p.name ? p.name.split(' ').filter(x => x.length > 2).slice(0, 2).map(x => x[0]).join('') || 'PO' : 'PO' %>
                                                    </div>
                                                    <div>
                                                        <div class="font-black text-pnp-blue dark:text-white uppercase tracking-tight text-[11px] dir-name">
                                                            <%= p.name %>
                                                        </div>
                                                        <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider mt-0.5">
                                                            Order #<%= p.display_order || '-' %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="px-3.5 py-1.5 rounded-xl bg-blue-50 dark:bg-slate-800 text-pnp-blue dark:text-pnp-gold text-[10px] font-black uppercase tracking-wider border border-pnp-blue/10 dark:border-slate-700 dir-position inline-block">
                                                    <%= p.position %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <div class="flex items-center justify-end space-x-2">
                                                    <% if (user && user.role === 'superadmin') { %>
                                                        <button type="button"
                                                            data-id="<%= p.id %>"
                                                            data-name="<%= p.name || '' %>"
                                                            data-position="<%= p.position || '' %>"
                                                            data-order="<%= p.display_order || 0 %>"
                                                            onclick="handlePersonnelEditClick(this)"
                                                            class="w-9 h-9 rounded-xl bg-pnp-gold/15 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-gold hover:text-slate-900 transition-all flex items-center justify-center shadow-sm"
                                                            title="Edit Directory Officer">
                                                            <i class="fas fa-edit text-xs"></i>
                                                        </button>
                                                        <button type="button"
                                                            data-id="<%= p.id %>"
                                                            data-name="<%= p.name || '' %>"
                                                            onclick="handlePersonnelDeleteClick(this)"
                                                            class="w-9 h-9 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                            title="Remove from Public Directory">
                                                            <i class="fas fa-trash-alt text-xs"></i>
                                                        </button>
                                                    <% } else { %>
                                                        <span class="text-[9px] font-black text-slate-400 uppercase italic">Restricted</span>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="px-8 py-24 text-center text-gray-400 font-bold uppercase tracking-widest text-xs">
                                            <div class="flex flex-col items-center justify-center">
                                                <i class="fas fa-id-badge text-4xl mb-4 text-gray-300 dark:text-slate-700"></i>
                                                <span>No directory personnel configured yet</span>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- TAB 2: ADMINISTRATIVE PERSONNEL CREDENTIALS -->
    <!-- ============================================== -->
    <div id="panel_credentials" class="user-tab-panel space-y-8 hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Create User Account Form (4 cols) -->
            <div class="lg:col-span-4">
                <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-sm border border-gray-150 dark:border-slate-800 overflow-hidden">
                    <div class="p-8 border-b border-gray-100 dark:border-slate-800 bg-gradient-to-r from-pnp-blue/10 via-pnp-blue/5 to-transparent flex items-center justify-between">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="w-2 h-2 rounded-full bg-pnp-blue"></span>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.25em] text-[11px]">
                                    Deploy Account
                                </h3>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-1">Admin & Duty Staff Credentials</p>
                        </div>
                        <div class="w-10 h-10 rounded-2xl bg-pnp-blue/10 flex items-center justify-center text-pnp-blue dark:text-white">
                            <i class="fas fa-user-shield text-xs"></i>
                        </div>
                    </div>

                    <% if (user && user.role === 'superadmin') { %>
                        <form action="/admin/users/add" method="POST" class="p-8 space-y-5" onsubmit="confirmOperationalAction(event, { title: 'Account Creation Pending', message: 'An email will be sent to the Police Chief for approval. The new personnel will NOT be able to log in until the account is approved. Proceed?', type: 'info', confirmText: 'Create Account' })">
                            
                            <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-start space-x-3 text-amber-700 dark:text-amber-400">
                                <i class="fas fa-info-circle text-sm shrink-0 mt-0.5"></i>
                                <p class="text-[9px] font-bold uppercase tracking-wider leading-relaxed">
                                    New accounts require Chief of Police verification. Access is locked in Pending status until authorized.
                                </p>
                            </div>

                            <div class="space-y-2">
                                <label for="full_name" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                    Full Name & Rank
                                </label>
                                <div class="relative">
                                    <i class="fas fa-user absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="text" name="full_name" id="full_name" required placeholder="User Full Name"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-800 dark:text-white transition-all">
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="email" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                    Official Email Address
                                </label>
                                <div class="relative">
                                    <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="email" name="email" id="email" required placeholder="officer@pnp.gov.ph"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-800 dark:text-white transition-all font-mono">
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="password" class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-black">
                                    Access Password
                                </label>
                                <div class="relative">
                                    <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                                    <input type="password" name="password" id="password" required placeholder="••••••••••••"
                                        class="w-full pl-11 pr-4 py-3.5 bg-gray-50 dark:bg-slate-950 border border-gray-200 dark:border-slate-800 rounded-2xl focus:ring-2 focus:ring-pnp-blue outline-none text-xs font-bold text-gray-800 dark:text-white transition-all font-mono">
                                </div>
                            </div>

                            <button type="submit"
                                class="w-full bg-pnp-blue hover:bg-blue-900 text-white font-black py-4 rounded-2xl shadow-xl shadow-pnp-blue/20 transition-all transform hover:scale-[1.01] active:scale-95 uppercase tracking-[0.25em] text-[10px] flex items-center justify-center space-x-2">
                                <i class="fas fa-shield-alt text-xs"></i>
                                <span>Deploy Credentials</span>
                            </button>
                        </form>
                    <% } else { %>
                        <div class="p-8 py-20 text-center">
                            <div class="w-16 h-16 bg-pnp-blue/5 rounded-3xl flex items-center justify-center mx-auto mb-4 border border-pnp-blue/10">
                                <i class="fas fa-lock text-pnp-blue/40 text-2xl"></i>
                            </div>
                            <h4 class="text-xs font-black text-slate-800 dark:text-white uppercase tracking-widest">Administrator Clearance Required</h4>
                            <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-2 leading-relaxed">
                                Account deployment is restricted to superadministrators.
                            </p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Administrative Personnel Registry Table (8 cols) -->
            <div class="lg:col-span-8">
                <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-sm border border-gray-150 dark:border-slate-800 overflow-hidden flex flex-col">
                    <div class="p-8 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center space-x-2">
                                <span class="w-2 h-2 rounded-full bg-pnp-blue"></span>
                                <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.25em] text-[12px]">
                                    Personnel Registry
                                </h3>
                            </div>
                            <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-1">Authorized Administrators & Staff Accounts</p>
                        </div>

                        <!-- Live Users Search -->
                        <div class="relative w-full sm:w-64">
                            <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            <input type="text" id="usersSearchInput" onkeyup="filterUsersTable()" placeholder="Search user or email..."
                                class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none text-[10px] font-bold text-gray-700 dark:text-gray-200 uppercase tracking-widest focus:ring-2 focus:ring-pnp-blue/20 transition-all placeholder:text-gray-400">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs min-w-[700px]" id="usersTable">
                            <thead class="bg-gray-50/80 dark:bg-slate-950/60 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">
                                <tr>
                                    <th class="px-6 py-4">Full Name</th>
                                    <th class="px-6 py-4">Email Address</th>
                                    <th class="px-6 py-4">Role</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4">Date Created</th>
                                    <th class="px-6 py-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-800" id="usersTableBody">
                                <% safeUsers.forEach(u => { %>
                                    <tr class="user-row hover:bg-pnp-blue/5 dark:hover:bg-slate-800/40 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="flex items-center space-x-3">
                                                <div class="w-9 h-9 rounded-xl bg-pnp-blue/10 dark:bg-slate-800 text-pnp-blue dark:text-pnp-gold font-black text-xs flex items-center justify-center uppercase shrink-0">
                                                    <%= u.full_name ? u.full_name.split(' ').map(n => n[0]).slice(0, 2).join('') : 'U' %>
                                                </div>
                                                <div class="font-black text-pnp-blue dark:text-white uppercase tracking-tight text-[11px] user-name">
                                                    <%= u.full_name %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-[11px] text-gray-500 dark:text-gray-400 font-mono lowercase user-email">
                                                <%= u.email || 'No email provided' %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% if (u.role === 'superadmin') { %>
                                                <span class="px-3 py-1 bg-pnp-gold/15 text-pnp-blue dark:text-pnp-gold rounded-full text-[9px] font-black uppercase tracking-wider border border-pnp-gold/40">
                                                    Superadmin
                                                </span>
                                            <% } else { %>
                                                <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full text-[9px] font-black uppercase tracking-wider border border-slate-200 dark:border-slate-700">
                                                    Staff
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% if (u.status === 'active') { %>
                                                <span class="inline-flex items-center space-x-1.5 px-3 py-1 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded-full text-[9px] font-black uppercase tracking-widest border border-emerald-500/20">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                                    <span>Active</span>
                                                </span>
                                            <% } else if (u.status === 'rejected') { %>
                                                <span class="inline-flex items-center space-x-1.5 px-3 py-1 bg-rose-500/10 text-rose-600 dark:text-rose-400 rounded-full text-[9px] font-black uppercase tracking-widest border border-rose-500/20">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                                    <span>Rejected</span>
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center space-x-1.5 px-3 py-1 bg-amber-500/10 text-amber-600 dark:text-amber-400 rounded-full text-[9px] font-black uppercase tracking-widest border border-amber-500/20">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                    <span>Pending</span>
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 text-gray-400 font-mono text-[11px]">
                                            <%= new Date(u.created_at).toLocaleDateString(undefined, {month:'short', day:'numeric', year:'numeric'}) %>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <div class="flex items-center justify-end space-x-2">
                                                <% if (user && user.role === 'superadmin') { %>
                                                    <button type="button" 
                                                        data-id="<%= u.id %>"
                                                        data-fullname="<%= u.full_name || '' %>"
                                                        data-email="<%= u.email || '' %>"
                                                        data-role="<%= u.role || 'staff' %>"
                                                        data-status="<%= u.status || 'active' %>"
                                                        onclick="handleUserEditClick(this)"
                                                        class="w-9 h-9 rounded-xl bg-pnp-blue/10 dark:bg-pnp-blue/20 text-pnp-blue dark:text-pnp-gold hover:bg-pnp-blue hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                        title="Edit Account Details">
                                                        <i class="fas fa-edit text-xs"></i>
                                                    </button>
                                                <% } %>
                                                <% if (u.role === 'superadmin') { %>
                                                    <span class="text-[8px] font-black text-pnp-gold uppercase px-2.5 py-1.5 bg-pnp-gold/10 rounded-lg border border-pnp-gold/20">Protected</span>
                                                <% } else if (user && user.role === 'superadmin') { %>
                                                    <button type="button" 
                                                        data-id="<%= u.id %>"
                                                        data-fullname="<%= u.full_name || '' %>"
                                                        onclick="handleUserDeleteClick(this)"
                                                        class="w-9 h-9 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-500 hover:bg-rose-500 hover:text-white transition-all flex items-center justify-center shadow-sm"
                                                        title="Neutralize Account">
                                                        <i class="fas fa-trash-alt text-xs"></i>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-[9px] font-black text-slate-300 uppercase italic">Locked</span>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- TAB 3: OPERATIONAL AUDIT LOGS PANEL -->
    <!-- ============================================== -->
    <div id="panel_audit" class="user-tab-panel space-y-8 hidden">
        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-sm border border-gray-150 dark:border-slate-800 overflow-hidden">
            <div class="p-8 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-pnp-gold/20 rounded-2xl flex items-center justify-center text-pnp-gold shadow-md">
                        <i class="fas fa-fingerprint text-xl"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            <h3 class="font-black text-pnp-blue dark:text-white uppercase tracking-[0.25em] text-[12px]">
                                Master Audit Stream
                            </h3>
                        </div>
                        <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mt-1">Live Administrative Activity Tracking</p>
                    </div>
                </div>

                <div class="flex items-center space-x-3">
                    <!-- Live Log Search -->
                    <div class="relative w-full sm:w-64">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                        <input type="text" id="logsSearchInput" onkeyup="filterLogsTable()" placeholder="Search action or details..."
                            class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 rounded-xl outline-none text-[10px] font-bold text-gray-700 dark:text-gray-200 uppercase tracking-widest focus:ring-2 focus:ring-pnp-blue/20 transition-all placeholder:text-gray-400">
                    </div>

                    <% if (safeLogs.length > 5) { %>
                        <button onclick="openUsersLogModal()" class="px-5 py-2.5 bg-pnp-blue text-white rounded-xl text-[9px] font-black uppercase tracking-widest hover:bg-blue-800 transition shadow-md shadow-pnp-blue/20 flex items-center space-x-2 shrink-0">
                            <i class="fas fa-list text-pnp-gold text-[10px]"></i>
                            <span>View All (<%= safeLogs.length %>)</span>
                        </button>
                    <% } %>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs min-w-[700px]" id="logsTable">
                    <thead class="bg-gray-50/80 dark:bg-slate-950/60 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">
                        <tr>
                            <th class="px-6 py-4">Personnel</th>
                            <th class="px-6 py-4">Action</th>
                            <th class="px-6 py-4">Details</th>
                            <th class="px-6 py-4 text-right">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-slate-800" id="logsTableBody">
                        <% if (safeLogs.length > 0) { %>
                            <% safeLogs.slice(0, 15).forEach(l => { %>
                                <tr class="log-row hover:bg-pnp-blue/5 dark:hover:bg-slate-800/40 transition-colors">
                                    <td class="px-6 py-4 font-black text-pnp-blue dark:text-white log-user whitespace-nowrap">
                                        <div class="flex items-center space-x-2.5">
                                            <div class="w-2 h-2 rounded-full bg-pnp-blue"></div>
                                            <span><%= l.username %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 shrink-0 log-action">
                                        <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-lg text-[9px] font-black uppercase tracking-wider text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
                                            <%= l.action %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-500 dark:text-gray-400 font-bold max-w-md truncate uppercase tracking-tight log-details" title="<%= l.details %>">
                                        <%= l.details %>
                                    </td>
                                    <td class="px-6 py-4 text-right text-gray-400 font-mono font-bold whitespace-nowrap text-[11px]">
                                        <%= new Date(l.timestamp).toLocaleString(undefined, {hour12: true, month:'short', day:'numeric', hour:'numeric', minute:'numeric'}) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="px-8 py-20 text-center text-slate-300 font-black uppercase tracking-[0.4em] italic opacity-50">
                                    No operational data captured in current session
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODALS (Full Feature & Backward Compatibility) -->
<!-- ============================================== -->

<!-- View All Users Audit Log Modal -->
<div id="usersLogModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-[100] hidden items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] w-full max-w-5xl mx-4 overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 flex flex-col max-h-[85vh] transform scale-95 transition-transform duration-300">
        
        <!-- Modal Header -->
        <div class="px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between bg-gray-50 dark:bg-slate-950/60">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 bg-pnp-blue rounded-2xl flex items-center justify-center shadow-lg shadow-pnp-blue/20">
                    <i class="fas fa-list text-pnp-gold text-lg"></i>
                </div>
                <div>
                    <h3 class="text-base font-black text-slate-900 dark:text-white uppercase tracking-widest">Complete System Logs</h3>
                    <p class="text-[9px] text-gray-400 font-bold uppercase tracking-[0.2em] mt-0.5">Full administrative activity stream</p>
                </div>
            </div>
            <button onclick="closeUsersLogModal()" class="w-10 h-10 bg-white dark:bg-slate-800 text-gray-400 hover:text-red-500 rounded-xl shadow-sm border border-gray-100 dark:border-slate-700 flex items-center justify-center transition-colors">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Modal Body (Scrollable Table) -->
        <div class="p-0 overflow-y-auto flex-grow bg-white dark:bg-slate-900">
            <table class="w-full text-left text-xs min-w-[650px]">
                <thead class="bg-gray-50 dark:bg-slate-950 sticky top-0 z-10 text-gray-400 dark:text-gray-500 uppercase text-[9px] font-black tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">
                    <tr>
                        <th class="px-8 py-4">Personnel</th>
                        <th class="px-8 py-4">Action</th>
                        <th class="px-8 py-4">Details</th>
                        <th class="px-8 py-4 text-right">Timestamp</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                    <% if (safeLogs.length > 0) { %>
                        <% safeLogs.forEach(l => { %>
                            <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-8 py-4 font-black text-pnp-blue dark:text-white whitespace-nowrap">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-pnp-blue"></div>
                                        <span><%= l.username %></span>
                                    </div>
                                </td>
                                <td class="px-8 py-4 shrink-0">
                                    <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 rounded-lg text-[9px] font-black uppercase tracking-wider text-slate-500 border border-slate-200 dark:border-slate-700">
                                        <%= l.action %>
                                    </span>
                                </td>
                                <td class="px-8 py-4 text-gray-500 dark:text-gray-400 font-bold text-[11px]">
                                    <%= l.details %>
                                </td>
                                <td class="px-8 py-4 text-right text-gray-400 font-mono font-bold whitespace-nowrap text-[11px]">
                                    <%= new Date(l.timestamp).toLocaleString(undefined, {hour12: true, month:'short', day:'numeric', hour:'numeric', minute:'numeric'}) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete User Modal -->
<div id="deleteUserModal" class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-[100] hidden items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] w-full max-w-lg mx-4 overflow-hidden shadow-2xl border border-gray-100 dark:border-slate-800 flex flex-col transform scale-95 transition-transform duration-300">
        
        <form id="deleteUserForm" method="POST" action="">
            <div class="px-8 py-6 border-b border-gray-100 dark:border-slate-800 flex items-center justify-between bg-red-500/10">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 bg-red-500/15 rounded-2xl flex items-center justify-center text-red-500 shadow-md">
                        <i class="fas fa-exclamation-triangle text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-red-600 dark:text-red-400 uppercase tracking-widest">Neutralize Account</h3>
                        <p class="text-[9px] text-red-400 font-bold uppercase tracking-[0.2em] mt-0.5">Permanent action for <span id="deleteUserTargetName" class="font-black text-slate-900 dark:text-white"></span></p>
                    </div>
                </div>
                <button type="button" onclick="closeDeleteUserModal()" class="w-10 h-10 bg-white dark:bg-slate-800 text-gray-400 hover:text-red-500 rounded-xl shadow-sm border border-gray-100 dark:border-slate-700 flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <div class="p-8 space-y-5">
                <p class="text-[11px] font-bold text-gray-600 dark:text-gray-400 uppercase tracking-wider leading-relaxed">
                    Please select the authorization reason for neutralizing this personnel's credentials. An automated dispatch will be logged.
                </p>

                <div class="space-y-2.5 max-h-48 overflow-y-auto pr-1">
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Security Breach / Compromised Credentials" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" required onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Security Breach / Compromised Credentials</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Violation of Operational Protocols" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Violation of Operational Protocols</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Reassignment / Transfer of Duties" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Reassignment / Transfer of Duties</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Inactive / Dormant Account" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Inactive / Dormant Account</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Request from Higher Command" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Request from Higher Command</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3.5 rounded-2xl border border-gray-150 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800 cursor-pointer transition">
                        <input type="radio" name="delete_reason" value="Other" class="w-4 h-4 text-pnp-blue focus:ring-pnp-blue border-gray-300" onchange="toggleCustomReason()">
                        <span class="text-xs font-bold text-gray-700 dark:text-gray-300">Other (Specify Custom Reason)</span>
                    </label>
                </div>

