<script>
    // --- Segmented Tab Switcher ---
    function switchUserTab(tabKey) {
        const tabs = ['directory', 'credentials', 'audit'];
        tabs.forEach(t => {
            const btn = document.getElementById(`tabBtn_${t}`);
            const panel = document.getElementById(`panel_${t}`);
            if (t === tabKey) {
                panel.classList.remove('hidden');
                btn.className = 'user-tab-btn flex-1 sm:flex-initial flex items-center justify-center space-x-2.5 px-6 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all duration-200 bg-pnp-blue text-white shadow-lg shadow-pnp-blue/20';
            } else {
                panel.classList.add('hidden');
                btn.className = 'user-tab-btn flex-1 sm:flex-initial flex items-center justify-center space-x-2.5 px-6 py-3.5 rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all duration-200 text-slate-500 hover:text-pnp-blue dark:hover:text-white hover:bg-gray-100/80 dark:hover:bg-slate-800';
            }
        });
        localStorage.setItem('cpicrs_users_tab', tabKey);
    }

    // Restore last active tab on load
    document.addEventListener('DOMContentLoaded', () => {
        const savedTab = localStorage.getItem('cpicrs_users_tab');
        if (savedTab && ['directory', 'credentials', 'audit'].includes(savedTab)) {
            switchUserTab(savedTab);
        }
    });

    // --- Live Table Filtering ---
    function filterDirectoryTable() {
        const q = (document.getElementById('directorySearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.directory-row');
        rows.forEach(r => {
            const name = (r.querySelector('.dir-name')?.textContent || '').toLowerCase();
            const pos = (r.querySelector('.dir-position')?.textContent || '').toLowerCase();
            if (name.includes(q) || pos.includes(q)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function filterUsersTable() {
        const q = (document.getElementById('usersSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.user-row');
        rows.forEach(r => {
            const name = (r.querySelector('.user-name')?.textContent || '').toLowerCase();
            const email = (r.querySelector('.user-email')?.textContent || '').toLowerCase();
            if (name.includes(q) || email.includes(q)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    function filterLogsTable() {
        const q = (document.getElementById('logsSearchInput').value || '').toLowerCase().trim();
        const rows = document.querySelectorAll('.log-row');
        rows.forEach(r => {
            const user = (r.querySelector('.log-user')?.textContent || '').toLowerCase();
            const action = (r.querySelector('.log-action')?.textContent || '').toLowerCase();
            const details = (r.querySelector('.log-details')?.textContent || '').toLowerCase();
            if (user.includes(q) || action.includes(q) || details.includes(q)) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // --- Audit Log Modal Logic ---
    function openUsersLogModal() {
        const modal = document.getElementById('usersLogModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeUsersLogModal() {
        const modal = document.getElementById('usersLogModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    // --- Action Button Handlers (using data-* attributes) ---
    function handleUserEditClick(btn) {
        const id = btn.getAttribute('data-id');
        const fullName = btn.getAttribute('data-fullname') || '';
        const email = btn.getAttribute('data-email') || '';
        const role = btn.getAttribute('data-role') || 'staff';
        const status = btn.getAttribute('data-status') || 'active';
        openEditUserModal(id, fullName, email, role, status);
    }

    function handleUserDeleteClick(btn) {
        const id = btn.getAttribute('data-id');
        const fullName = btn.getAttribute('data-fullname') || '';
        openDeleteUserModal(id, fullName);
    }

    function handlePersonnelEditClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name') || '';
        const position = btn.getAttribute('data-position') || '';
        const order = parseInt(btn.getAttribute('data-order'), 10) || 1;
        openEditPersonnelModal(id, name, position, order);
    }

    function handlePersonnelDeleteClick(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name') || '';
        openDeletePersonnelModal(id, name);
    }

    // --- User Modal Implementations ---
    function openEditUserModal(userId, fullName, email, role, status) {
        document.getElementById('editUserForm').action = `/admin/users/${userId}/edit`;
        document.getElementById('edit_full_name').value = fullName;
        document.getElementById('edit_email').value = email || '';
        document.getElementById('edit_role').value = role || 'staff';
        document.getElementById('edit_status').value = status || 'active';
        document.getElementById('edit_password').value = '';

        const modal = document.getElementById('editUserModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeEditUserModal() {
        const modal = document.getElementById('editUserModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function openDeleteUserModal(userId, userName) {
        document.getElementById('deleteUserForm').action = `/admin/users/${userId}/delete`;
        document.getElementById('deleteUserTargetName').textContent = userName;
        
        document.getElementById('deleteUserForm').reset();
        toggleCustomReason();

        const modal = document.getElementById('deleteUserModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteUserModal() {
        const modal = document.getElementById('deleteUserModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    // --- Personnel Modal Implementations ---
    function openEditPersonnelModal(id, name, position, displayOrder) {
        document.getElementById('editPersonnelForm').action = `/admin/personnel/${id}/edit`;
        document.getElementById('edit_p_name').value = name;
        document.getElementById('edit_p_position').value = position;
        document.getElementById('edit_p_order').value = displayOrder || 1;

        const modal = document.getElementById('editPersonnelModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeEditPersonnelModal() {
        const modal = document.getElementById('editPersonnelModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function openDeletePersonnelModal(id, name) {
        document.getElementById('deletePersonnelForm').action = `/admin/personnel/${id}/delete`;
        document.getElementById('deletePersonnelTargetName').textContent = name;

        const modal = document.getElementById('deletePersonnelModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        void modal.offsetWidth;
        modal.classList.remove('opacity-0');
        modal.children[0].classList.remove('scale-95');
        modal.children[0].classList.add('scale-100');
        document.body.style.overflow = 'hidden';
    }

    function closeDeletePersonnelModal() {
        const modal = document.getElementById('deletePersonnelModal');
        modal.classList.add('opacity-0');
        modal.children[0].classList.remove('scale-100');
        modal.children[0].classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 300);
    }

    function toggleCustomReason() {
        const customContainer = document.getElementById('customReasonContainer');
        const customInput = document.getElementById('custom_reason');
        const otherRadio = document.querySelector('input[name="delete_reason"][value="Other"]');
        
        if (otherRadio && otherRadio.checked) {
            customContainer.classList.remove('hidden');
            customInput.required = true;
        } else {
            customContainer.classList.add('hidden');
            customInput.required = false;
        }
    }
</script>