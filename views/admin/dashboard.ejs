    window.openLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (!modal) return;

        function computeTop(countsObj, totalScope) {
            const sorted = Object.entries(countsObj || {}).sort((a, b) => b[1] - a[1]);
            if (sorted.length === 0 || sorted[0][1] === 0) {
                return { name: 'NONE', cases: 0, share: '0' };
            }
            const topName = sorted[0][0];
            const topCases = sorted[0][1];
            const share = totalScope > 0 ? ((topCases / totalScope) * 100).toFixed(1) : '0';
            return { name: topName, cases: topCases, share };
        }

        const overallTop = computeTop(window.currentOverallCounts, window.currentMatchedCount);
        const top8Focus = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {}).reduce((a, b) => a + b, 0)
        );
        const topNonIndex = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {}).reduce((a, b) => a + b, 0)
        );
        const topPSI = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {}).reduce((a, b) => a + b, 0)
        );

        const updateChoice = (catKey, topObj) => {
            const crimeEl = document.getElementById(`choiceCrime_${catKey}`);
            const statsEl = document.getElementById(`choiceStats_${catKey}`);
            if (crimeEl) crimeEl.textContent = topObj.name;
            if (statsEl) statsEl.innerHTML = `(${topObj.cases} cases &bull; ${topObj.share}%)`;
        };

        updateChoice('ALL', overallTop);
        updateChoice('8Focus', top8Focus);
        updateChoice('NonIndex', topNonIndex);
        updateChoice('PSI', topPSI);

        const allCatKeys = [
            { id: 'choiceCat_ALL', cat: 'ALL' },
            { id: 'choiceCat_8Focus', cat: '8-Focus' },
            { id: 'choiceCat_NonIndex', cat: 'Non-Index' },
            { id: 'choiceCat_PSI', cat: 'PSI' }
        ];

        allCatKeys.forEach(item => {
            const btn = document.getElementById(item.id);
            if (!btn) return;
            const check = btn.querySelector('.choiceCheckmark');
            if (item.cat === (window.activeLeadingCategory || 'ALL')) {
                btn.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.remove('text-transparent');
                }
            } else {
                btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.add('text-transparent');
                }
            }
        });

        modal.classList.remove('hidden');
    };

    window.closeLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (modal) modal.classList.add('hidden');
    };

    // --- Ultra-Fast Monthly Crime Trends Filtering Logic ---
    window.filterMonthlyTrends = function() {
        const brgyDropdown = document.getElementById('monthlyTrendBarangayFilter');
        const yrDropdown = document.getElementById('monthlyTrendYearFilter');
        const selectedBrgy = brgyDropdown ? brgyDropdown.value : 'ALL';
        const selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;

        // 1. Single O(N) pass for instant 12-month buckets, bento details, and sector distribution (<1ms)
        const buckets = Array.from({ length: 12 }, () => [0, 0, 0, 0, 0, 0]); // [focusM, focusS, nonIndexM, nonIndexS, psiM, psiS]
        const sectorCounts = {};
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let matchedCount = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;

            const sector = item.barangay || 'Unknown';
            sectorCounts[sector] = (sectorCounts[sector] || 0) + 1;

            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            matchedCount++;

            const m = item.month;
            if (m >= 0 && m < 12) {
                const isScan = item.isScanned ? 1 : 0;
                if (item.category === '8-Focus') {
                    buckets[m][isScan]++;
                } else if (item.category === 'PSI') {
                    buckets[m][4 + isScan]++;
                } else {
                    buckets[m][2 + isScan]++;
                }
            }

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        // Save current counts for synchronization
        window.currentBuckets = buckets;
        window.currentOverallCounts = overallCounts;
        window.currentCategoryCounts = categoryCounts;
        window.currentMatchedCount = matchedCount;

        // STEP 1: INSTANT BARGRAPH DATA REFRESH (0ms)
        if (window.trendChart) {
            window.trendChart.data.labels = MONTH_LABELS;
            window.trendChart.data.datasets[0].data = buckets.map(b => b[0]);
            window.trendChart.data.datasets[1].data = buckets.map(b => b[1]);
            window.trendChart.data.datasets[2].data = buckets.map(b => b[2]);
            window.trendChart.data.datasets[3].data = buckets.map(b => b[3]);
            window.trendChart.data.datasets[4].data = buckets.map(b => b[4]);
            window.trendChart.data.datasets[5].data = buckets.map(b => b[5]);
            window.trendChart.update('none');
        }

        // STEP 2: APPLY CURRENT ACTIVE CATEGORY FILTER
        const activeCat = window.activeLeadingCategory || 'ALL';
        applyCategoryFilterToChart(activeCat);
        updateCategoryButtonsUI(activeCat);

        const trendScopeYear = document.getElementById('trendScopeYear');
        if (trendScopeYear) {
            trendScopeYear.textContent = selectedYear;
        }

        // STEP 3: INSTANT BENTO STATS UPDATE
        updateBentoDetailsFromCounts(overallCounts, categoryCounts, matchedCount, selectedBrgy);

        // STEP 4: INSTANT DISTRIBUTION PIE UPDATE
        updateDistributionChartFromCounts(sectorCounts, selectedYear);

        // STEP 5: INSTANT SYNCHRONIZED KPIS & INTELLIGENCE ANALYSIS
        updateKpisAndIntelligence();
    };

    // --- Background AI Trends Integration ---
    window.generateAITrends = async function(selectedBrgy, selectedYear, activeCat, leadingCrime) {
        if (window.currentAITrendController) {
            window.currentAITrendController.abort();
        }
        window.currentAITrendController = new AbortController();

        if (!selectedBrgy) {
            const dropdown = document.getElementById('monthlyTrendBarangayFilter');
            selectedBrgy = dropdown ? dropdown.value : 'ALL';
        }
        if (!selectedYear) {
            const yrDropdown = document.getElementById('monthlyTrendYearFilter');
            selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;
        }
        if (!activeCat) {
            activeCat = window.activeLeadingCategory || 'ALL';
        }
        if (!leadingCrime) {
            const topEl = document.getElementById('modalKpiTopCrime');
            leadingCrime = topEl ? topEl.textContent : '';
        }

        const generateBtn = document.getElementById('aiGenerateBtn');
        if (generateBtn) {
            generateBtn.disabled = true;
            generateBtn.innerHTML = '<i class="fas fa-spinner animate-spin text-xs"></i>';
        }

        try {
            const timeoutId = setTimeout(() => {
                if (window.currentAITrendController) window.currentAITrendController.abort();
            }, 6000);

            const url = `/admin/api/ai-trends?barangay=${encodeURIComponent(selectedBrgy)}&year=${selectedYear}&category=${encodeURIComponent(activeCat)}&leadingOffense=${encodeURIComponent(leadingCrime)}`;
            const response = await fetch(url, { signal: window.currentAITrendController.signal });
            clearTimeout(timeoutId);
            const result = await response.json();

            // Verify filter state hasn't drifted while waiting for network
            const curBrgy = document.getElementById('monthlyTrendBarangayFilter')?.value || 'ALL';
            const curYr = parseInt(document.getElementById('monthlyTrendYearFilter')?.value || '<%= defaultYearVal %>', 10);
            const curCat = window.activeLeadingCategory || 'ALL';

            if (curBrgy === selectedBrgy && curYr === selectedYear && curCat === activeCat) {
                if (result && result.success && result.analysis) {
                    updateModalTrendsFromMarkdown(result.analysis, selectedBrgy, selectedYear, activeCat);
                }
            }
        } catch (err) {
            if (err.name !== 'AbortError') {
                console.info('AI Trends background sync notice:', err);
            }
        } finally {
            if (generateBtn) {
                generateBtn.disabled = false;
                generateBtn.innerHTML = '<i class="fas fa-sync-alt text-xs"></i>';
            }
        }
    };

    function formatMarkdown(text) {
        if (!text) return '';
        let raw = text.replace(/```markdown|```/g, '').trim().replace(/\\n/g, '\n');

        const sectionConfigs = {
            'trend': {
                title: 'Trend Analysis',
                subtitle: 'Directional Trajectory & Baseline',
                icon: 'fas fa-chart-line',
                iconColor: 'text-blue-600 dark:text-blue-400',
                badgeBg: 'bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300',
                border: 'border-blue-200/80 dark:border-blue-800/60',
                bg: 'bg-gradient-to-br from-blue-50/90 to-slate-50/50 dark:from-blue-950/20 dark:to-slate-900/40',
                titleColor: 'text-pnp-blue dark:text-blue-300'
            },
            'pattern': {
                title: 'Crime Pattern',
                subtitle: 'Concentration & Key Drivers',
                icon: 'fas fa-bullseye',
                iconColor: 'text-amber-600 dark:text-amber-400',
                badgeBg: 'bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300',
                border: 'border-amber-200/80 dark:border-amber-800/60',
                bg: 'bg-gradient-to-br from-amber-50/80 to-slate-50/50 dark:from-amber-950/20 dark:to-slate-900/40',
                titleColor: 'text-amber-900 dark:text-amber-300'
            },
            'suggestion': {
                title: 'Strategic Suggestions',
                subtitle: 'Law Enforcement Directives',
                icon: 'fas fa-lightbulb',
                iconColor: 'text-emerald-600 dark:text-emerald-400',
                badgeBg: 'bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300',
                border: 'border-emerald-200/80 dark:border-emerald-800/60',
                bg: 'bg-gradient-to-br from-emerald-50/80 to-slate-50/50 dark:from-emerald-950/20 dark:to-slate-900/40',
                titleColor: 'text-emerald-900 dark:text-emerald-300'
            }
        };

        // Match section markers like **Trend**: or ### Trend or Trend: or **Suggestions**:
        const sectionRegex = /(?:^|\n)(?:\#{1,4}\s*|\*{1,2}\s*)?(Trend|Pattern|Suggestions?|Recommendations?)(?:\*{1,2})?\s*[\:\-]?/gi;
        
        let matches = [];
        let match;
        while ((match = sectionRegex.exec(raw)) !== null) {
            matches.push({
                index: match.index,
                length: match[0].length,
                key: match[1].toLowerCase()
            });
        }

        if (matches.length > 0) {
            let cardsHtml = '<div class="grid grid-cols-1 gap-2 my-1 overflow-hidden">';
            
            for (let i = 0; i < matches.length; i++) {
                const cur = matches[i];
                const startPos = cur.index + cur.length;
                const endPos = (i + 1 < matches.length) ? matches[i + 1].index : raw.length;
                let bodyText = raw.substring(startPos, endPos).trim();

                let normalizedKey = 'trend';
                if (cur.key.startsWith('pattern')) normalizedKey = 'pattern';
                else if (cur.key.startsWith('sug') || cur.key.startsWith('rec')) normalizedKey = 'suggestion';

                const config = sectionConfigs[normalizedKey];

                let formattedBody = bodyText
                    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
                    .replace(/^[-*•]\s+(.*?)$/gm, '<li class="ml-2 list-disc marker:text-pnp-gold text-slate-700 dark:text-slate-300 mb-0.5">$1</li>')
                    .replace(/\n\n+/g, '</p><p class="mt-1">')
                    .replace(/\n/g, ' ');

                if (formattedBody.includes('<li')) {
                    formattedBody = `<ul class="my-0.5">${formattedBody}</ul>`;
                } else {
                    formattedBody = `<p>${formattedBody}</p>`;
                }

                cardsHtml += `
                    <div class="p-3 rounded-xl border ${config.border} ${config.bg} shadow-2xs transition-all hover:shadow-xs overflow-hidden break-words">
                        <div class="flex items-center justify-between mb-1 pb-1 border-b border-black/5 dark:border-white/5">
                            <div class="flex items-center gap-2">
                                <span class="w-5 h-5 rounded-lg flex items-center justify-center text-[10px] shadow-2xs ${config.badgeBg}">
                                    <i class="${config.icon} ${config.iconColor}"></i>
                                </span>
                                <div>
                                    <h5 class="text-[10px] font-black uppercase tracking-wider ${config.titleColor}">
                                        ${config.title}
                                    </h5>
                                </div>
                            </div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 hidden sm:inline">
                                ${config.subtitle}
                            </span>
                        </div>
                        <div class="text-[11px] leading-relaxed text-slate-700 dark:text-slate-300 font-medium pl-0.5 break-words">
                            ${formattedBody}
                        </div>
                    </div>
                `;
            }

            cardsHtml += '</div>';
            return cardsHtml;
        }

        // Standard markdown fallback
        let formatted = raw
            .replace(/^(?:###|##|#)\s+(.*?)$/gm, '<h5 class="text-xs font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider mt-2 mb-1 flex items-center gap-1.5"><i class="fas fa-shield-halved text-[10px]"></i> $1</h5>')
            .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
            .replace(/^[-*•]\s+(.*?)$/gm, '<div class="flex items-start gap-1.5 ml-1 mb-1 text-slate-700 dark:text-slate-300"><span class="text-pnp-gold font-bold text-xs">•</span><span>$1</span></div>');

        const blocks = formatted.split(/\n\n+/);
        return blocks.map(b => `<p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300 mb-2 last:mb-0">${b.replace(/\n/g, '<br>')}</p>`).join('');
    }

    // ==========================================
    // CRIME TREND CONTROLS & DIRECTIVES SYNC
    // ==========================================
    window.lastRawMarkdown = null;

    window.refreshAITrends = function() {
        const selectedYear = parseInt(document.getElementById('monthlyTrendYearFilter')?.value || '<%= defaultYearVal %>', 10);
        const selectedBrgy = document.getElementById('monthlyTrendBarangayFilter')?.value || 'ALL';
        window.generateAITrends(selectedBrgy, selectedYear);
    };

    function updateModalKpiSummary(selectedBrgy, selectedYear, monthlyTrends) {
        const scopePoints = points.filter(p => {
            const rawDate = p.incident_date || p.date_committed || p.dateCommitted;
            if (!rawDate) return false;
            if (selectedBrgy !== 'ALL' && p.barangay !== selectedBrgy) return false;
            const pd = new Date(rawDate);
            return pd.getUTCFullYear() === selectedYear;
        });

        const total = scopePoints.length;
        const kpiTotal = document.getElementById('modalKpiTotal');
        if (kpiTotal) kpiTotal.textContent = total;

        const monthCounts = monthlyTrends.map(m => m.total);
        const offenseCounts = {};

        scopePoints.forEach(p => {
            const off = p.incident_type || p.crime_type || 'Unknown';
            offenseCounts[off] = (offenseCounts[off] || 0) + 1;
        });

        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        let maxMonthIdx = 0;
        let maxMonthVal = 0;

        monthCounts.forEach((cnt, idx) => {
            if (cnt > maxMonthVal) {
                maxMonthVal = cnt;
                maxMonthIdx = idx;
            }
        });

        const kpiPeakMonth = document.getElementById('modalKpiPeakMonth');
        const kpiPeakCount = document.getElementById('modalKpiPeakCount');
        if (kpiPeakMonth) kpiPeakMonth.textContent = total > 0 ? FULL_MONTH_NAMES[maxMonthIdx] : 'None';
        if (kpiPeakCount) kpiPeakCount.textContent = total > 0 ? `${maxMonthVal} records (${((maxMonthVal/Math.max(total, 1))*100).toFixed(0)}%)` : '0 records';

        const sortedOffenses = Object.entries(offenseCounts).sort((a, b) => b[1] - a[1]);
        const topOffense = sortedOffenses.length > 0 ? sortedOffenses[0] : ['N/A', 0];
        const kpiTopCrime = document.getElementById('modalKpiTopCrime');
        const kpiTopShare = document.getElementById('modalKpiTopShare');
        if (kpiTopCrime) {
            kpiTopCrime.textContent = topOffense[0];
            kpiTopCrime.title = topOffense[0];
        }
        if (kpiTopShare) {
            const share = total > 0 ? ((topOffense[1] / total) * 100).toFixed(1) : '0';
            kpiTopShare.textContent = `${topOffense[1]} cases (${share}%)`;
        }

        const scopeSubtitle = document.getElementById('modalScopeSubtitle');
        if (scopeSubtitle) {
            const brgyLabel = selectedBrgy === 'ALL' ? 'All Barangays' : `Barangay ${selectedBrgy}`;
            scopeSubtitle.textContent = `Sta. Cruz Municipal Police Station • ${brgyLabel} • Year ${selectedYear}`;
        }
    }

    function updateModalTrendsFromMarkdown(rawMarkdown, selectedBrgy, selectedYear, category) {
        if (!rawMarkdown) return;
        window.lastRawMarkdown = rawMarkdown;

        const trendEl = document.getElementById('modalTrendText');
        const patternEl = document.getElementById('modalPatternText');
        const suggEl = document.getElementById('modalSuggestionsText');
        const trendBadge = document.getElementById('modalTrendBadge');
        const patternBadge = document.getElementById('modalPatternBadge');
        const suggBadge = document.getElementById('modalSuggestionsBadge');

        let raw = rawMarkdown.replace(/\`\`\`markdown|\`\`\`/g, '').trim().replace(/\\n/g, '\n');
        const sectionRegex = /(?:^|\n)(?:\#{1,4}\s*|\*{1,2}\s*)?(Trend|Pattern|Suggestions?|Recommendations?)(?:\*{1,2})?\s*[\:\-]?/gi;
        
        let matches = [];
        let match;
        while ((match = sectionRegex.exec(raw)) !== null) {
            matches.push({
                index: match.index,
                length: match[0].length,
                key: match[1].toLowerCase()
            });
        }

        let parsedSections = { trend: '', pattern: '', suggestion: '' };

        if (matches.length > 0) {
            for (let i = 0; i < matches.length; i++) {
                const cur = matches[i];
                const startPos = cur.index + cur.length;
                const endPos = (i + 1 < matches.length) ? matches[i + 1].index : raw.length;
                let bodyText = raw.substring(startPos, endPos).trim();

                let normalizedKey = 'trend';
                if (cur.key.startsWith('pattern')) normalizedKey = 'pattern';
                else if (cur.key.startsWith('sug') || cur.key.startsWith('rec')) normalizedKey = 'suggestion';

                let formattedBody = bodyText
                    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
                    .replace(/^[-*•]\s+(.*?)$/gm, '<li class="ml-2 list-disc marker:text-pnp-gold text-slate-800 dark:text-slate-100 mb-1">$1</li>')
                    .replace(/\n\n+/g, '</p><p class="mt-2">')
                    .replace(/\n/g, ' ');

                if (formattedBody.includes('<li')) {
                    formattedBody = `<ul class="my-1 space-y-1">${formattedBody}</ul>`;
                } else {
                    formattedBody = `<p class="leading-relaxed">${formattedBody}</p>`;
                }

                parsedSections[normalizedKey] = formattedBody;
            }
        }

        if (trendEl && parsedSections.trend) {
            trendEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.trend}</div>`;
            if (trendBadge) trendBadge.textContent = 'Verified';
        }
        if (patternEl && parsedSections.pattern) {
            patternEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.pattern}</div>`;
            if (patternBadge) patternBadge.textContent = 'Identified';
        }
        if (suggEl && parsedSections.suggestion) {
            suggEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.suggestion}</div>`;
            if (suggBadge) suggBadge.textContent = 'Directives';
        }
    }

    window.printTrendModalBrief = function() {
        window.print();
    };
</script>



