        <!-- 1. TREND ANALYSIS -->
        <div id="modalCardTrend" class="p-5 rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
