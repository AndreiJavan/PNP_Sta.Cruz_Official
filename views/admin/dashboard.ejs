            } else {
                btn8Focus.className = "px-2.5 py-1.5 rounded-lg text-[11px] font-medium uppercase tracking-wider bg-red-50/40 text-red-400 dark:bg-red-950/20 dark:text-red-500/60 border border-red-200/60 dark:border-red-900/40 opacity-40 line-through flex items-center gap-1.5 cursor-pointer transition-all";
