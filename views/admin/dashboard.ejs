                <div class="flex flex-col items-start">
                    <p class="text-[10px] text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-widest animate-pulse">Generating Trend Analysis for ${selectedYear}...</p>
                    <p class="text-[8px] text-slate-400 dark:text-slate-500 font-mono tracking-tighter">DATA CORRELATION IN PROGRESS</p>
                </div>
            </div>
        `;

        try {
            const response = await fetch(`/admin/api/ai-trends?barangay=${encodeURIComponent(selectedBrgy)}&year=${selectedYear}`);
