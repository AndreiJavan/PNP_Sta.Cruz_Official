    // High-performance direct bento DOM updates
    function updateBentoDetailsFromCounts(overallCounts, categoryCounts, totalMatchedCount, selectedBrgy) {
        function getTop(countsObj) {
            let topName = 'NONE';
            let topCount = 0;
            for (const [name, count] of Object.entries(countsObj)) {
                if (count > topCount) {
                    topCount = count;
                    topName = name;
                }
            }
            return { name: topName, count: topCount };
        }

        const overallTop = getTop(overallCounts);
        const top8Focus = getTop(categoryCounts['8-Focus']);
        const topNonIndex = getTop(categoryCounts['Non-Index']);
        const topPSI = getTop(categoryCounts['PSI']);

        const setDomSafe = (id, value) => {
            const el = document.getElementById(id);
            if (el) {
                el.textContent = value;
                if (el.hasAttribute('title')) el.setAttribute('title', value);
            }
        };

        const textAnalysisContainer = document.querySelector('#municipalTextAnalysis p');
        if (textAnalysisContainer) {
            const targetLoc = selectedBrgy === 'ALL' ? 'Sta. Cruz, Laguna' : selectedBrgy.toUpperCase();
            if (overallTop.count > 0) {
                textAnalysisContainer.innerHTML = `The most common incident in <span class="font-extrabold text-pnp-blue dark:text-pnp-gold">${targetLoc}</span> is currently <span id="overallTopCrime" class="font-black text-indigo-600 dark:text-indigo-400 uppercase px-1">${overallTop.name}</span> with <span id="overallTopCount" class="font-black text-indigo-600 dark:text-indigo-400">${overallTop.count}</span> recorded occurrences.`;
            } else {
                textAnalysisContainer.innerHTML = `There are no active or recorded incidents currently registered in <span class="font-extrabold text-pnp-blue dark:text-pnp-gold">${targetLoc}</span>.`;
            }
        } else {
            setDomSafe('overallTopCrime', overallTop.name);
            setDomSafe('overallTopCount', overallTop.count);
        }

        setDomSafe('top8Focus', top8Focus.name);
        setDomSafe('count8Focus', top8Focus.count);
        setDomSafe('topNonIndex', topNonIndex.name);
        setDomSafe('countNonIndex', topNonIndex.count);
        setDomSafe('topPSI', topPSI.name);
        setDomSafe('countPSI', topPSI.count);
        setDomSafe('kpiTotalCrimes', totalMatchedCount);
    }

    // Define bento details update function
    window.updateBentoDetails = function(selectedBrgy, selectedYear) {
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let count = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;
            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            count++;

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        updateBentoDetailsFromCounts(overallCounts, categoryCounts, count, selectedBrgy);
    };

    // --- Unified Crime Intelligence & Trend State ---
    window.activeLeadingCategory = 'ALL';
    window.activeSpecificOffense = null;
    window.currentBuckets = Array.from({ length: 12 }, () => [0, 0, 0, 0, 0, 0]);
    window.currentOverallCounts = {};
    window.currentCategoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
    window.currentMatchedCount = 0;
    window.currentAITrendController = null;

    // --- High-Level PNP Tactical Directives Knowledge Base ---
    function getTacticalDirectives(crimeName, category, barangayName, totalCount) {
        const bName = (!barangayName || barangayName === 'ALL') ? 'the entire municipality' : barangayName;
        if (!totalCount || totalCount === 0) {
            return [
                `Maintain high-visibility preventive cruiser and beat foot patrols across all sectors of ${bName} to sustain this zero-incident operational baseline.`,
                `Sustain proactive liaison meetings with Barangay Tanods and Barangay Peacekeeping Action Teams (BPATs) along major community accessways.`,
                `Conduct periodic public safety dialogues and keep confidential hotlines active to support continuous community vigilance.`
            ];
        }

        const lower = (crimeName || '').toLowerCase();

        // Property Crimes (Theft, Robbery, Burglary)
        if (lower.includes('theft') || lower.includes('robbery') || lower.includes('burglary')) {
            return [
                `Deploy dedicated beat foot patrols and mobile cruiser visibility along commercial strips, public markets, and financial establishments in ${bName} during peak transaction hours (10:00–14:00 & 18:00–22:00).`,
                `Coordinate with barangay tanods for continuous CCTV perimeter surveillance, target-hardening inspections, and immediate restoration of defunct public street lighting.`,
                `Implement strategic Oplan Sita chokepoints along primary ingress and egress routes of ${bName} to intercept fleeing motorcycle-riding suspects.`
            ];
        }
        // Carnapping (Motorcycle & Motor Vehicle)
        if (lower.includes('carnapping')) {
            return [
                `Deploy dedicated Oplan Bakal/Sita checkpoints at major arterial exits and boundary intersections connecting ${bName} during late-night and early-morning hours (22:00–04:00).`,
                `Coordinate with LTO and Highway Patrol Group (HPG) for strict spot-checks on suspicious unregistered, plate-less, and open-pipe motorcycles.`,
                `Distribute anti-carnapping security bulletins urging vehicle owners in ${bName} to install dual physical locks, secure parking perimeters, and GPS trackers.`
            ];
        }
        // Violent Crimes (Physical Injury, Assault, Homicide, Murder)
        if (lower.includes('injury') || lower.includes('assault') || lower.includes('brawl') || lower.includes('physical') || lower.includes('homicide') || lower.includes('murder')) {
            return [
                `Strictly enforce municipal curfew ordinances for unchaperoned minors and enforce local liquor licensing hours around commercial bars, videoke hubs, and public plazas in ${bName}.`,
                `Deploy joint PNP-Barangay standby security units at recreation spots and gathering hubs during weekend evening windows (20:00–02:00).`,
                `Coordinate closely with Barangay Lupon Tagapamayapa for early dispute mediation in neighborhood friction before physical escalation occurs.`
            ];
        }
        // Crimes Against Persons / Gender (Rape, VAWC, Child Abuse)
        if (lower.includes('rape') || lower.includes('vawc') || lower.includes('child abuse') || lower.includes('ra 9262') || lower.includes('ra 7610')) {
            return [
                `Direct Women and Children Protection Desk (WCPD) officers to conduct proactive monitoring and coordinated case interventions in collaboration with MSWDO and Barangay VAW desks in ${bName}.`,
                `Execute multi-agency safety assessments and prompt issuance of Barangay Protection Orders (BPOs) for identified high-risk households.`,
                `Expedite forensic documentation and case buildup for inquest proceedings under DIDM standards while maintaining strict victim confidentiality.`
            ];
        }
        // Dangerous Drugs (RA 9165)
        if (lower.includes('drugs') || lower.includes('ra 9165') || lower.includes('dangerous drugs')) {
            return [
                `Intensify intelligence surveillance and synchronized barangay clearing operations in close coordination with PDEA and the local BADAC in ${bName}.`,
                `Deploy random mobile interdiction checkpoints along transit corridors commonly exploited by couriers and street-level pushers.`,
                `Sustain community-based drug rehabilitation monitoring (CBDRP) and strengthen anonymous community reporting hotlines across all puroks.`
            ];
        }
        // Traffic Incidents / Public Safety (PSI)
        if (lower.includes('traffic') || lower.includes('accident') || lower.includes('reckless') || lower.includes('damage to property') || category === 'PSI') {
            return [
                `Station static traffic police visibility units and radar speed enforcement teams along high-density highways and accident-prone intersections in ${bName} during morning and evening rush hours.`,
                `Conduct joint enforcement operations with LGU Traffic Enforcers targeting motorcycle helmet compliance, unauthorized vehicle modifications, and driving under the influence (RA 10586).`,
                `Coordinate with DPWH and Municipal Engineering to repair blind curves, install reflectorized road markings, and clear road shoulder obstructions.`
            ];
        }
        // Cybercrime (RA 10175, Fraud, Estafa)
        if (lower.includes('cyber') || lower.includes('scam') || lower.includes('fraud') || lower.includes('estafa')) {
            return [
                `Publish targeted cybercrime advisories via PNP social media bulletins educating ${bName} residents on prevailing phishing, fake parcel deliveries, and e-wallet fraudulent schemes.`,
                `Guide victims through electronic evidence preservation for immediate referral to Regional Anti-Cybercrime Units (RACU).`,
                `Conduct digital literacy and online fraud awareness workshops at local barangay halls and schools.`
            ];
        }
        // Non-Index General
        if (category === 'Non-Index') {
            return [
                `Execute targeted regulatory inspections and special law enforcement sweeps in coordination with municipal licensing and regulatory officers in ${bName}.`,
                `Establish proactive intelligence surveillance networks to detect and interdict clandestine illicit activities and special law violations.`,
                `Conduct regular legal orientation briefings for Barangay Tanods on evidentiary preservation for special penal law infractions.`
            ];
        }
        // 8-Focus General
        if (category === '8-Focus') {
            return [
                `Maintain high-visibility beat foot and mobile cruiser patrols across critical commercial corridors and residential boundaries during peak crime hours.`,
                `Coordinate with Barangay Tanods for continuous CCTV monitoring, target hardening, and rapid incident dispatch.`,
                `Execute strategic Oplan Sita operations to deter opportunistic criminal elements and motorized offenders.`
            ];
        }
        // Default cross-category
        return [
            `Maintain high-visibility proactive patrol operations and motorized checkpoints during peak incident hours (18:00–23:00) in ${bName}.`,
            `Coordinate with Barangay Tanods and BPATs along high-density thoroughfares and residential boundaries.`,
            `Maintain strict enforcement of local municipal ordinances (curfew, liquor ban) and ensure rapid incident dispatch.`
        ];
    }

    // --- Ultra-Fast Real-Time Dynamic Intelligence Generator ---
    window.renderDynamicTrendAnalysis = function(selectedBrgy, selectedYear, activeCat, leadingCrimeName, leadingCrimeCount, scopeTotal, scopeMonthlyTotals, scopeCounts, overallCounts, categoryCounts) {
        const trendEl = document.getElementById('modalTrendText');
        const patternEl = document.getElementById('modalPatternText');
        const suggEl = document.getElementById('modalSuggestionsText');
        const trendBadge = document.getElementById('modalTrendBadge');
        const patternBadge = document.getElementById('modalPatternBadge');
        const suggBadge = document.getElementById('modalSuggestionsBadge');

        const bName = selectedBrgy === 'ALL' ? 'All Barangays' : `Barangay ${selectedBrgy}`;
        const catLabel = activeCat === '8-Focus'
            ? '8-Focus Crimes (Index Crimes)'
            : (activeCat === 'Non-Index'
                ? 'Non-Index Crimes (Special Laws)'
                : (activeCat === 'PSI'
                    ? 'Public Safety Incidents (PSI / Traffic)'
                    : 'All Recorded Crime Categories'));

        // Case 1: ZERO INCIDENTS IN SCOPE
        if (!scopeTotal || scopeTotal === 0) {
            if (trendEl) {
                trendEl.innerHTML = `
                    <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                        Operational tracking for <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${bName}</strong> across calendar year <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${selectedYear}</strong> demonstrates a pristine baseline with <strong class="font-bold text-slate-900 dark:text-white">0 recorded incidents</strong> under <strong class="font-bold text-slate-900 dark:text-white">${catLabel}</strong>. Public peace and order indicators remain fully intact across all monitored sectors.
                    </p>
                `;
            }
            if (patternEl) {
                patternEl.innerHTML = `
                    <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                        Pattern mapping for <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${bName}</strong> reveals a consistent zero-incident baseline across all 12 operational months. No recurring modus operandi, geographic clusters, or tactical hot zones were detected in this scope.
                    </p>
                `;
            }
            if (suggEl) {
                const directives = getTacticalDirectives('none', activeCat, bName, 0);
                suggEl.innerHTML = `
                    <ul class="space-y-1.5 my-0.5">
                        ${directives.map(d => `
                            <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium">
                                <span class="text-emerald-500 font-bold text-base leading-none shrink-0">•</span>
                                <span>${d}</span>
                            </li>
                        `).join('')}
                    </ul>
                `;
            }
            if (trendBadge) trendBadge.textContent = 'Pristine Baseline';
            if (patternBadge) patternBadge.textContent = 'Baseline';
            if (suggBadge) suggBadge.textContent = 'Preventive SOP';
            return;
        }

        // Case 2: ACTIVE INCIDENTS
        const mTotals = scopeMonthlyTotals || [];
        const h1 = mTotals.slice(0, 6).reduce((a, b) => a + b, 0);
        const h2 = mTotals.slice(6, 12).reduce((a, b) => a + b, 0);

        let trendDirection = "a stable and balanced month-to-month distribution";
        let trendBadgeText = "Stable";
        if (h1 > 0 && h2 > h1) {
            const pct = Math.round(((h2 - h1) / h1) * 100);
            trendDirection = `an upward trajectory (+${pct}% increase in the second semester compared to H1)`;
            trendBadgeText = `Upward +${pct}%`;
        } else if (h1 > 0 && h2 < h1) {
            const pct = Math.round(((h1 - h2) / h1) * 100);
            trendDirection = `a steady downward trajectory (-${pct}% reduction in the second semester compared to H1)`;
            trendBadgeText = `Downward -${pct}%`;
        } else if (h1 === 0 && h2 > 0) {
            trendDirection = `incident activity concentrated exclusively during the second semester of ${selectedYear}`;
            trendBadgeText = "Active H2";
        } else if (h2 === 0 && h1 > 0) {
            trendDirection = `activity successfully contained during the first semester with zero incidents in H2`;
            trendBadgeText = "Contained H1";
        }

        // Peak and quietest months
        let peakIdx = 0;
        let peakVal = 0;
        let quietIdx = 0;
        let quietVal = Infinity;

        mTotals.forEach((val, idx) => {
            if (val > peakVal) {
                peakVal = val;
                peakIdx = idx;
            }
            if (val < quietVal) {
                quietVal = val;
                quietIdx = idx;
            }
        });

        const peakMonthName = FULL_MONTH_NAMES[peakIdx] || 'N/A';
        const quietMonthName = FULL_MONTH_NAMES[quietIdx] || 'N/A';
        const peakShare = scopeTotal > 0 ? Math.round((peakVal / scopeTotal) * 100) : 0;

        // Top crimes in scope
        const sortedCrimes = Object.entries(scopeCounts || {}).sort((a, b) => b[1] - a[1]);
        const primaryCrime = leadingCrimeName || (sortedCrimes.length > 0 ? sortedCrimes[0][0] : 'None');
        const primaryCount = leadingCrimeCount || (sortedCrimes.length > 0 ? sortedCrimes[0][1] : 0);
        const primaryShare = scopeTotal > 0 ? ((primaryCount / scopeTotal) * 100).toFixed(1) : '0';

        // Secondary crimes
        const secondaryCrimes = sortedCrimes.filter(([n]) => n !== primaryCrime).slice(0, 2);
        let secondaryStr = "";
        if (secondaryCrimes.length > 0) {
            secondaryStr = "Secondary patterns include " + secondaryCrimes.map(([n, c]) => {
                const s = scopeTotal > 0 ? Math.round((c / scopeTotal) * 100) : 0;
                return `<strong class="font-bold text-slate-900 dark:text-white">${n}</strong> (${c} case${c > 1 ? 's' : ''}, ${s}%)`;
            }).join(' and ') + ".";
        }

        // Qualitative characterization
        let qualitativeNature = "The pattern reflects general municipal incident activity requiring steady preventive police presence.";
        const lowP = primaryCrime.toLowerCase();
        if (activeCat === '8-Focus') {
            if (lowP.includes('theft') || lowP.includes('robbery') || lowP.includes('carnapping')) {
                qualitativeNature = "Classified under PNP Index property crimes, this pattern highlights opportunistic theft and property-directed offenses along commercial hubs, transport corridors, and residential access points.";
            } else {
                qualitativeNature = "Classified under PNP Index crimes against persons, this indicates interpersonal disputes and physical altercations requiring strict curfew and liquor ordinance enforcement.";
            }
        } else if (activeCat === 'Non-Index') {
            if (lowP.includes('drugs') || lowP.includes('ra 9165')) {
                qualitativeNature = "Classified under Special Penal Laws, this profile is driven by proactive law enforcement interdiction and anti-illegal drug clearing operations in coordination with BADAC.";
            } else if (lowP.includes('vawc') || lowP.includes('ra 9262') || lowP.includes('child abuse') || lowP.includes('ra 7610')) {
                qualitativeNature = "Classified under Special Penal Laws for women and child protection, this indicates domestic or neighborhood disputes requiring WCPD intervention and barangay VAW desk coordination.";
            } else {
                qualitativeNature = "Classified under Special Penal Laws and regulatory statutes, this concentration reflects targeted statutory interdictions and municipal code enforcement.";
            }
        } else if (activeCat === 'PSI') {
            qualitativeNature = "Classified under Public Safety Incidents, this volume represents vehicular friction, traffic collisions, and reckless imprudence along arterial highways and transit intersections.";
        } else {
            qualitativeNature = `Across all monitored categories, ${primaryCrime} serves as the prevailing contributor, accounting for ${primaryShare}% of overall municipal recorded volume.`;
        }

        // Render Card 1: Trend Analysis
        if (trendEl) {
            trendEl.innerHTML = `
                <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    Incident velocity for <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${catLabel}</strong> in <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${bName}</strong> during calendar year <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${selectedYear}</strong> exhibits ${trendDirection}, totaling <strong class="text-slate-900 dark:text-white font-bold">${scopeTotal}</strong> recorded case${scopeTotal === 1 ? '' : 's'}. Activity is heavily driven by <strong class="text-slate-900 dark:text-white font-bold">${primaryCrime}</strong> (${primaryCount} case${primaryCount === 1 ? '' : 's'}, representing ${primaryShare}% of volume). Tactical peak occurred during <strong class="font-bold text-slate-900 dark:text-white">${peakMonthName}</strong> (${peakVal} case${peakVal === 1 ? '' : 's'}, ${peakShare}%), while <strong class="font-bold text-slate-900 dark:text-white">${quietMonthName}</strong> recorded the lowest volume (${quietVal} case${quietVal === 1 ? '' : 's'}).
                </p>
            `;
        }
        if (trendBadge) trendBadge.textContent = trendBadgeText;

        // Render Card 2: Crime Pattern
        if (patternEl) {
            const h1Pct = Math.round((h1 / scopeTotal) * 100);
            const h2Pct = Math.round((h2 / scopeTotal) * 100);
            patternEl.innerHTML = `
                <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    Pattern analysis confirms that <strong class="text-slate-900 dark:text-white font-bold">${primaryCrime}</strong> is the primary operational driver with <strong class="font-bold text-slate-900 dark:text-white">${primaryCount} of ${scopeTotal}</strong> cases (<strong class="text-amber-600 dark:text-amber-400 font-bold">${primaryShare}%</strong> dominance). ${secondaryStr} ${qualitativeNature} Semester distribution shows <strong class="font-bold text-slate-900 dark:text-white">${h1}</strong> case${h1 === 1 ? '' : 's'} (${h1Pct}%) in H1 (Jan–Jun) versus <strong class="font-bold text-slate-900 dark:text-white">${h2}</strong> case${h2 === 1 ? '' : 's'} (${h2Pct}%) in H2 (Jul–Dec).
                </p>
            `;
        }
        if (patternBadge) {
            patternBadge.textContent = primaryCrime.length > 14 ? primaryCrime.substring(0, 14) + '...' : primaryCrime;
        }

        // Render Card 3: Strategic Directives
        if (suggEl) {
            const directives = getTacticalDirectives(primaryCrime, activeCat, bName, scopeTotal);
            suggEl.innerHTML = `
                <ul class="space-y-1.5 my-0.5">
                    ${directives.map(d => `
                        <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium">
                            <span class="text-emerald-500 font-bold text-base leading-none shrink-0">•</span>
                            <span>${d}</span>
                        </li>
                    `).join('')}
                </ul>
            `;
        }
        if (suggBadge) {
            suggBadge.textContent = activeCat === '8-Focus'
                ? 'Index Ops'
                : (activeCat === 'Non-Index'
                    ? 'Special Laws'
                    : (activeCat === 'PSI' ? 'Traffic SOP' : 'Directives'));
        }
    };

