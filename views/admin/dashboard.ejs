<% 
    // Safety defaults
    let safeStats = {};
    safeStats.total = 0;
    safeStats.focus = 0;
    safeStats.nonIndex = 0;
    safeStats.psi = 0;
    safeStats.totalTips = 0;
    safeStats.totalBulletins = 0;
    safeStats.totalReports = 0;

    if (typeof todayStats !== 'undefined' && todayStats) {
        safeStats = todayStats;
    }

    let safeTrends = '[]';
    if (typeof monthlyTrends !== 'undefined' && monthlyTrends) {
        safeTrends = monthlyTrends;
    }

    let safePoints = [];
    if (typeof points !== 'undefined' && points) {
        safePoints = points;
    }
    let defaultYearVal = new Date().getFullYear();
    if (typeof defaultYear !== 'undefined' && defaultYear) {
        defaultYearVal = defaultYear;
    }
    
    // Calculate acceptable official barangays covered
    const official26Barangays = [
        "Alipit", "Bagumbayan", "Bubukal", "Calios", "Duhat", "Gatid", "Jasaan",
        "Labuin", "Malinao", "Oogong", "Pagsawitan", "Palasan", "Patimbao",
        "Poblacion I (Barangay I)", "Poblacion II (Barangay II)",
        "Poblacion III (Barangay III)", "Poblacion IV (Barangay IV)",
        "Poblacion V (Barangay V)", "San Jose", "San Juan", "San Pablo Norte",
        "San Pablo Sur", "Santisima Cruz", "Santo Angel Central",
        "Santo Angel Norte", "Santo Angel Sur"
    ];
    const officialNormSet = new Set(official26Barangays.map(b => b.toLowerCase().replace(/[^a-z0-9]/g, '')));
    const acceptableActiveBarangays = new Set(
        safePoints.map(p => (p.barangay || '').trim())
                  .filter(b => b && officialNormSet.has(b.toLowerCase().replace(/[^a-z0-9]/g, '')))
    );
    const acceptableCount = acceptableActiveBarangays.size;
%>
<%
    const curHour = new Date().getHours();
    let timeOfDayGreeting = 'Good morning';
    if (curHour >= 12 && curHour < 18) {
        timeOfDayGreeting = 'Good afternoon';
    } else if (curHour >= 18 || curHour < 5) {
        timeOfDayGreeting = 'Good evening';
    }

    let rawPersonnelName = '';
    if (typeof user !== 'undefined' && user) {
        rawPersonnelName = (user.full_name || user.firstName || user.first_name || user.name || user.username || user.email || '').trim();
    }

    function extractCleanFirstName(str) {
        if (!str) return 'Personnel';
        let s = str.trim();
        // Remove email domain
        if (s.includes('@')) s = s.split('@')[0];
        
        // Remove random hash-like suffixes at end (e.g. _5zk9u4, -7x8y)
        s = s.replace(/[_\-][a-z0-9]{5,}$/i, '');

        // Separate words by spaces, dots, underscores, hyphens
        let tokens = s.replace(/[._\-]/g, ' ').split(/\s+/).filter(Boolean);

        // Filter out rank prefixes if more words exist
        const rankPrefixes = /^(pmaj|plt|pcpt|pcol|pmsgt|pssg|pcms|pat|po1|po2|po3|spo1|spo2|spo3|spo4|admin|officer|mr|ms|mrs|dr)$/i;
        if (tokens.length > 1 && rankPrefixes.test(tokens[0])) {
            tokens.shift();
        }

        let target = tokens[0] || 'Personnel';

        // Strip trailing digits (e.g. andreijavan06 -> andreijavan)
        target = target.replace(/\d+$/, '');

        // Check if concatenated name starts with Andrei or similar
        if (/^andreijavan/i.test(target) || /^andrei/i.test(target)) {
            target = 'Andrei';
        } else if (/^[a-z]+[A-Z][a-z]+/.test(target)) {
            // camelCase like andreiJavan -> Andrei
            target = target.replace(/([A-Z].*)$/, '');
        }

        if (!target) return 'Personnel';
        return target.charAt(0).toUpperCase() + target.slice(1).toLowerCase();
    }

    let personnelFirstName = extractCleanFirstName(rawPersonnelName);
%>
