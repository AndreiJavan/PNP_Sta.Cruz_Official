    window.toggleTrendDataset = function(groupIndex) {
        if (!window.trendChart) return;
        
        // 0 = 8-Focus (datasets 0, 1), 1 = Non-Index (datasets 2, 3), 2 = PSI (datasets 4, 5)
        const targetIndices = [groupIndex * 2, groupIndex * 2 + 1];
