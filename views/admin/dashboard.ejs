    // Define bento details update function
    window.updateBentoDetails = function(selectedBrgy, selectedYear) {
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let count = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;
            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            count++;

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        updateBentoDetailsFromCounts(overallCounts, categoryCounts, count, selectedBrgy);
    };

    // --- Ultra-Fast Monthly Crime Trends Filtering Logic ---
    window.filterMonthlyTrends = function() {
        const brgyDropdown = document.getElementById('monthlyTrendBarangayFilter');
        const yrDropdown = document.getElementById('monthlyTrendYearFilter');
        const selectedBrgy = brgyDropdown ? brgyDropdown.value : 'ALL';
        const selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;

        // 1. Single O(N) pass for instant 12-month buckets, bento details, and sector distribution (<1ms)
        const buckets = Array.from({ length: 12 }, () => [0, 0, 0, 0, 0, 0]); // [focusM, focusS, nonIndexM, nonIndexS, psiM, psiS]
        const sectorCounts = {};
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let matchedCount = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;

            const sector = item.barangay || 'Unknown';
            sectorCounts[sector] = (sectorCounts[sector] || 0) + 1;

            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            matchedCount++;

            const m = item.month;
            if (m >= 0 && m < 12) {
                const isScan = item.isScanned ? 1 : 0;
                if (item.category === '8-Focus') {
                    buckets[m][isScan]++;
                } else if (item.category === 'PSI') {
                    buckets[m][4 + isScan]++;
                } else {
                    buckets[m][2 + isScan]++;
                }
            }

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        // STEP 1: INSTANT BARGRAPH UPDATE (0ms)
        if (window.trendChart) {
            window.trendChart.data.labels = MONTH_LABELS;
            window.trendChart.data.datasets[0].data = buckets.map(b => b[0]);
            window.trendChart.data.datasets[1].data = buckets.map(b => b[1]);
            window.trendChart.data.datasets[2].data = buckets.map(b => b[2]);
            window.trendChart.data.datasets[3].data = buckets.map(b => b[3]);
            window.trendChart.data.datasets[4].data = buckets.map(b => b[4]);
            window.trendChart.data.datasets[5].data = buckets.map(b => b[5]);
            window.trendChart.update('none'); // Render immediately!
        }

        // STEP 2: INSTANT TOP KPI METRICS UPDATE (Total Incidents, Peak Month, Leading Offense)
        const kpiTotalEl = document.getElementById('modalKpiTotal');
        if (kpiTotalEl) kpiTotalEl.textContent = matchedCount;

        // Calculate Peak Month
        const monthTotals = buckets.map(b => b.reduce((acc, curr) => acc + curr, 0));
        let maxMonthIdx = 0;
        let maxMonthVal = 0;
        monthTotals.forEach((val, idx) => {
            if (val > maxMonthVal) {
                maxMonthVal = val;
                maxMonthIdx = idx;
            }
        });

        const kpiPeakMonthEl = document.getElementById('modalKpiPeakMonth');
        const kpiPeakCountEl = document.getElementById('modalKpiPeakCount');
        if (kpiPeakMonthEl) kpiPeakMonthEl.textContent = matchedCount > 0 ? FULL_MONTH_NAMES[maxMonthIdx] : '--';
        if (kpiPeakCountEl) {
            kpiPeakCountEl.textContent = matchedCount > 0 
                ? `${maxMonthVal} records (${((maxMonthVal / Math.max(matchedCount, 1)) * 100).toFixed(0)}%)` 
                : '0 records';
        }

        // Save current counts for Leading Offense category selection
        window.currentOverallCounts = overallCounts;
        window.currentCategoryCounts = categoryCounts;
        window.currentMatchedCount = matchedCount;

        // Update Leading Offense based on active category (ALL, 8-Focus, Non-Index, PSI)
        window.updateLeadingOffenseCard(window.activeLeadingCategory || 'ALL');
        if (window.activeLeadingCategory && window.activeLeadingCategory !== 'ALL') {
            window.applyCategoryFilterToChart(window.activeLeadingCategory);
        }

        const trendScopeYear = document.getElementById('trendScopeYear');
        if (trendScopeYear) {
            trendScopeYear.textContent = selectedYear;
        }

        // STEP 3: INSTANT BENTO STATS UPDATE
        updateBentoDetailsFromCounts(overallCounts, categoryCounts, matchedCount, selectedBrgy);

        // STEP 4: INSTANT DISTRIBUTION PIE UPDATE
        updateDistributionChartFromCounts(sectorCounts, selectedYear);

        // STEP 5: BACKGROUND AI TRENDS (non-blocking)
        if (typeof window.generateAITrends === 'function') {
            window.generateAITrends(selectedBrgy, selectedYear);
        }
    };

    window.activeLeadingCategory = 'ALL';

    window.openLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (!modal) return;

        function computeTop(countsObj, totalScope) {
            const sorted = Object.entries(countsObj || {}).sort((a, b) => b[1] - a[1]);
            if (sorted.length === 0 || sorted[0][1] === 0) {
                return { name: 'NONE', cases: 0, share: '0' };
            }
            const topName = sorted[0][0];
            const topCases = sorted[0][1];
            const share = totalScope > 0 ? ((topCases / totalScope) * 100).toFixed(1) : '0';
            return { name: topName, cases: topCases, share };
        }

        const overallTop = computeTop(window.currentOverallCounts, window.currentMatchedCount);
        const top8Focus = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {}).reduce((a, b) => a + b, 0)
        );
        const topNonIndex = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {}).reduce((a, b) => a + b, 0)
        );
        const topPSI = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {}).reduce((a, b) => a + b, 0)
        );

        const updateChoice = (catKey, topObj) => {
            const crimeEl = document.getElementById(`choiceCrime_${catKey}`);
            const statsEl = document.getElementById(`choiceStats_${catKey}`);
            if (crimeEl) crimeEl.textContent = topObj.name;
            if (statsEl) statsEl.innerHTML = `(${topObj.cases} cases &bull; ${topObj.share}%)`;
        };

        updateChoice('ALL', overallTop);
        updateChoice('8Focus', top8Focus);
        updateChoice('NonIndex', topNonIndex);
        updateChoice('PSI', topPSI);

        const allCatKeys = [
            { id: 'choiceCat_ALL', cat: 'ALL' },
            { id: 'choiceCat_8Focus', cat: '8-Focus' },
            { id: 'choiceCat_NonIndex', cat: 'Non-Index' },
            { id: 'choiceCat_PSI', cat: 'PSI' }
        ];

        allCatKeys.forEach(item => {
            const btn = document.getElementById(item.id);
            if (!btn) return;
            const check = btn.querySelector('.choiceCheckmark');
            if (item.cat === window.activeLeadingCategory) {
                btn.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.remove('text-transparent');
                }
            } else {
                btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.add('text-transparent');
                }
            }
        });

        modal.classList.remove('hidden');
    };

    window.closeLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (modal) modal.classList.add('hidden');
    };

    window.selectLeadingOffenseCategory = function(cat) {
