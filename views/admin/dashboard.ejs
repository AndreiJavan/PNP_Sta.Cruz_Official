<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let distChart;
    const points = <%- JSON.stringify(safePoints) %>;
    const MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const FULL_MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];

    // High-performance incident pre-indexing for instantaneous filtering
    const preprocessedPoints = points.map(p => {
        const rawDate = p.incident_date || p.date_committed || p.dateCommitted;
        let yr = -1;
        let mo = -1;
        if (rawDate) {
            const d = new Date(rawDate);
            if (!isNaN(d.getTime())) {
                yr = d.getUTCFullYear();
                mo = d.getUTCMonth();
            }
        }
        return {
            p,
            year: yr,
            month: mo,
            barangay: p.barangay || '',
            category: p.category || 'Non-Index',
            incident_type: String(p.incident_type || p.offense || 'Unknown').trim().toUpperCase(),
            isScanned: p.entry_type === 'scanned'
        };
    });

    const allColors = {
        'Murder': '#EF4444', 'Homicide': '#F87171', 'Physical Injuries': '#10B981', 'Rape': '#A855F7', 'Carnapping (Motorcycle)': '#F59E0B',
        'Carnapping (Motor Vehicle)': '#F97316', 'Violence Against Women and Children (VAWC)': '#E11D48',
        'Cybercrime': '#3B82F6', 'Estafa': '#0891B2', 'Swindling / Fraud': '#06B6D4',
        'Drug Possession': '#059669', 'Drug Sale': '#10B981', 'Drug Use': '#34D399',
        'Illegal Gambling': '#7C3AED', 'Illegal Possession of Firearms': '#475569',
