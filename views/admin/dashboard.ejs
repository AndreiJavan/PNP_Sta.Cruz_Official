    window.updateLeadingOffenseCard = function(cat) {
        if (!cat) cat = window.activeLeadingCategory || 'ALL';

        const badge = document.getElementById('leadingOffenseCategoryBadge');
        if (badge) badge.textContent = cat;

        let counts = {};
        let totalScope = 0;
        if (cat === 'ALL') {
            counts = window.currentOverallCounts || {};
            totalScope = window.currentMatchedCount || 0;
        } else {
            counts = (window.currentCategoryCounts && window.currentCategoryCounts[cat]) || {};
            totalScope = Object.values(counts).reduce((a, b) => a + b, 0);
        }

        const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
        const top = sorted.length > 0 ? sorted[0] : ['None', 0];

        const kpiTopCrimeEl = document.getElementById('modalKpiTopCrime');
        const kpiTopShareEl = document.getElementById('modalKpiTopShare');

        if (kpiTopCrimeEl) {
            kpiTopCrimeEl.textContent = top[0];
            kpiTopCrimeEl.title = top[0];
        }
        if (kpiTopShareEl) {
            const share = totalScope > 0 ? ((top[1] / totalScope) * 100).toFixed(1) : '0';
            const catLabel = cat === 'ALL' ? 'total' : cat;
            kpiTopShareEl.textContent = totalScope > 0 ? `${top[1]} cases (${share}% of ${catLabel})` : `0 cases (0% of ${catLabel})`;
