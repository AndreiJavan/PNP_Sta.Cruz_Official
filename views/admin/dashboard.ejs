            <div id="card8Focus" onclick="toggleTrendChartDataset(0)" class="cursor-pointer flex items-center justify-between p-4 bg-gray-50 dark:bg-slate-900/50 rounded-2xl border-l-4 border-red-500 shadow-sm hover:bg-white dark:hover:bg-slate-700 hover:shadow-md transition-all group/legend">
