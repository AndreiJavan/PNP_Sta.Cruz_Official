            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                <div class="lg:col-span-5 relative h-[240px] w-full flex items-center justify-center">
                    <canvas id="crimeDistributionChart"></canvas>
                </div>
                <div class="lg:col-span-7">
                    <div id="topSectorsList" class="space-y-2 max-h-[260px] overflow-y-auto custom-scrollbar pr-2">
