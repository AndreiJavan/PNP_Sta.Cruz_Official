<!-- Middle Row: Top 5 Barangays Distribution & Incident Feed -->
<div class="mb-8">
    <div class="bg-white dark:bg-slate-800 rounded-[2.5rem] shadow-sm border border-gray-100 dark:border-slate-700 p-6 flex flex-col transition-all hover:shadow-xl relative overflow-hidden group">
        <!-- View 1: Recorded Crime Distribution -->
        <div id="distributionView" class="relative z-10 flex flex-col animate-fade-in">
            <div class="mb-4 pb-4 border-b border-gray-50 dark:border-slate-700 flex justify-between items-center">
