<% 
    // Safety defaults
    let safeStats = {};
    safeStats.total = 0;
    safeStats.focus = 0;
    safeStats.nonIndex = 0;
    safeStats.psi = 0;
    safeStats.totalTips = 0;
    safeStats.totalBulletins = 0;
    safeStats.totalReports = 0;

    if (typeof todayStats !== 'undefined' && todayStats) {
        safeStats = todayStats;
    }

    let safeTrends = '[]';
    if (typeof monthlyTrends !== 'undefined' && monthlyTrends) {
        safeTrends = monthlyTrends;
    }

    let safePoints = [];
    if (typeof points !== 'undefined' && points) {
        safePoints = points;
    }
    let defaultYearVal = new Date().getFullYear();
    if (typeof defaultYear !== 'undefined' && defaultYear) {
        defaultYearVal = defaultYear;
    }
    
    // Calculate unique barangays covered
    const uniqueBarangays = new Set(safePoints.map(p => p.barangay).filter(b => b));
    const uniqueBarangaysCount = uniqueBarangays.size;
%>
<!-- Top Section: Monthly Crime Trends & Strategic Directives (Picture 1 Inspired Theme) -->
<div class="bg-slate-50/70 dark:bg-slate-800 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-700/80 p-6 sm:p-7 mb-7 transition-all relative">
    
    <!-- Header & Controls -->
    <div class="pb-5 mb-6 border-b border-slate-200/80 dark:border-slate-700/60">
        <!-- Title Text -->
        <div class="flex items-center space-x-3.5 mb-4">
            <div class="w-10 h-10 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center border border-blue-500/20 shadow-xs shrink-0">
                <i class="fas fa-chart-column text-base"></i>
            </div>
            <div>
                <h2 class="text-base sm:text-lg font-black text-slate-900 dark:text-white uppercase tracking-wider">
                    Monthly Crime Trends
                </h2>
                <p id="trendScopeSubtitle" class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider mt-0.5">
                    Sta. Cruz Municipal Police Station &bull; All Barangays &bull; Year <%= defaultYearVal %>
                </p>
            </div>
        </div>

        <!-- Filter Controls & Category Toggles Below Title Text -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <!-- Category Filter Legend Buttons (8-Focus, Non-Index, PSI) -->
            <div class="flex items-center gap-2 flex-wrap">
                <button type="button" onclick="toggleTrendDataset(0)" id="legend8Focus" class="px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400 border border-red-300 dark:border-red-800/60 hover:bg-red-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-700"></span>
                    <span>8-Focus</span>
                </button>
                <button type="button" onclick="toggleTrendDataset(1)" id="legendNonIndex" class="px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-400 border border-blue-300 dark:border-blue-800/60 hover:bg-blue-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-blue-700"></span>
                    <span>Non-Index</span>
                </button>
                <button type="button" onclick="toggleTrendDataset(2)" id="legendPSI" class="px-3.5 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-300 dark:border-amber-800/60 hover:bg-amber-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-700"></span>
                    <span>PSI</span>
                </button>
            </div>

            <!-- Dropdowns of Date (Year) and Barangay -->
            <div class="flex items-center gap-2.5 flex-wrap">
                <!-- Year Dropdown -->
                <div class="relative w-32">
                    <% 
                        const availableYears = [...new Set(safePoints.map(p => {
                            const rawDate = p.incident_date || p.date_committed || p.dateCommitted;
                            if(!rawDate) return null;
                            const d = new Date(rawDate);
                            return !isNaN(d.getTime()) ? d.getUTCFullYear() : null;
                        }).filter(y => y !== null))].sort((a, b) => b - a);

                        if(availableYears.length === 0) availableYears.push(new Date().getFullYear());
                    %>
                    <select id="monthlyTrendYearFilter" onchange="filterMonthlyTrends()" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-bold uppercase text-slate-800 dark:text-white focus:ring-2 focus:ring-blue-500 cursor-pointer shadow-2xs">
                        <% availableYears.forEach(year => { %>
                            <option value="<%= year %>" <%= year === defaultYearVal ? 'selected' : '' %>><%= year %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Barangay Dropdown -->
                <div class="relative w-48 sm:w-60">
                    <select id="monthlyTrendBarangayFilter" onchange="filterMonthlyTrends()" class="w-full bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-xs font-bold uppercase text-slate-800 dark:text-white focus:ring-2 focus:ring-blue-500 cursor-pointer shadow-2xs truncate">
                        <option value="ALL">ALL BARANGAYS</option>
                        <% ["Alipit", "Bagumbayan" , "Bubukal" , "Calios" , "Duhat" , "Gatid" , "Jasaan"
                            , "Labuin" , "Malinao" , "Oogong" , "Pagsawitan" , "Palasan" , "Patimbao"
                            , "Poblacion I (Barangay I)" , "Poblacion II (Barangay II)"
                            , "Poblacion III (Barangay III)" , "Poblacion IV (Barangay IV)"
                            , "Poblacion V (Barangay V)" , "San Jose" , "San Juan" , "San Pablo Norte"
                            , "San Pablo Sur" , "Santisima Cruz" , "Santo Angel Central"
                            , "Santo Angel Norte" , "Santo Angel Sur" ].forEach(brgy=> { %>
                            <option value="<%= brgy %>"><%= brgy.toUpperCase() %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Section: Bar Graph (Left) & KPIs in 1 Column (Right) aligned to Bar Graph height -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch mb-7">
        <!-- Left: Bar Graph Canvas (Darker background on white) -->
        <div class="lg:col-span-9 bg-slate-100/90 dark:bg-slate-900/60 rounded-2xl p-4 sm:p-5 border border-slate-200/90 dark:border-slate-800 flex flex-col justify-between">
