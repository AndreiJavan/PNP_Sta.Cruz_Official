            </div>
        </div>

        <!-- Right: 1 Column with Total Incidents, Peak Month, and Leading Offense (MIMPA/Picture 1 inspired) -->
        <div class="lg:col-span-3 flex flex-col justify-between gap-3.5">
            <!-- 1. Total Incidents Card -->
            <div class="p-4 sm:p-4.5 bg-white dark:bg-slate-900/70 rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between flex-1 shadow-xs hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-1.5">
