<% 
    // Safety defaults
    let safeStats = {};
    safeStats.total = 0;
    safeStats.focus = 0;
    safeStats.nonIndex = 0;
    safeStats.psi = 0;
    safeStats.totalTips = 0;
    safeStats.totalBulletins = 0;
    safeStats.totalReports = 0;

    if (typeof todayStats !== 'undefined' && todayStats) {
        safeStats = todayStats;
    }

    let safeTrends = '[]';
    if (typeof monthlyTrends !== 'undefined' && monthlyTrends) {
        safeTrends = monthlyTrends;
    }

    let safePoints = [];
    if (typeof points !== 'undefined' && points) {
        safePoints = points;
    }
    let defaultYearVal = new Date().getFullYear();
    if (typeof defaultYear !== 'undefined' && defaultYear) {
        defaultYearVal = defaultYear;
    }
    
    // Calculate unique barangays covered
    const uniqueBarangays = new Set(safePoints.map(p => p.barangay).filter(b => b));
    const uniqueBarangaysCount = uniqueBarangays.size;
%>
<!-- Top Section 1: User Greeting & Aligned Sector Map Quick Access -->
<div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl border border-slate-200/90 dark:border-slate-800 p-4 sm:p-5 mb-5 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
    <!-- Greeting on Left -->
    <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-2xl bg-blue-500/10 text-pnp-blue dark:text-pnp-gold flex items-center justify-center border border-blue-500/20 shadow-xs shrink-0">
            <i class="fas fa-shield-halved text-2xl"></i>
        </div>
        <div>
            <h1 class="text-base sm:text-lg font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <span>Welcome back, <%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Officer' %></span>
            </h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium mt-0.5">
                MIMPA Incident Command & Geospatial Analytics Console &bull; Sta. Cruz MPS
            </p>
        </div>
    </div>

    <!-- Sector Map Quick Button Aligned on Right -->
    <a href="/admin/map" class="flex items-center gap-3.5 px-4 sm:px-5 py-2.5 sm:py-3 rounded-2xl bg-slate-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-800 dark:hover:bg-pnp-blue text-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 transition-all duration-200 shadow-xs group shrink-0" title="Launch Sector Map">
        <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-pnp-blue dark:text-blue-400 group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
            <i class="fas fa-map-location-dot text-base"></i>
        </div>
        <div class="text-left">
            <span class="text-[9px] font-black uppercase tracking-wider block text-slate-400 dark:text-slate-400 group-hover:text-blue-100 transition-colors">Tactical Map</span>
            <span class="text-xs font-black uppercase tracking-tight block">Sector Map (<%= uniqueBarangaysCount || 26 %> Sectors)</span>
        </div>
        <div class="w-6 h-6 rounded-lg bg-slate-200/70 dark:bg-slate-700 group-hover:bg-white/20 flex items-center justify-center text-slate-500 dark:text-slate-300 group-hover:text-white group-hover:translate-x-0.5 transition-all ml-1">
            <i class="fas fa-chevron-right text-[10px]"></i>
        </div>
    </a>
</div>

<!-- Top Section 2: Monthly Crime Trends & Strategic Directives -->
<div class="bg-white dark:bg-slate-900 rounded-2xl sm:rounded-3xl shadow-xs border border-slate-200/90 dark:border-slate-800 p-4 sm:p-5 mb-5 transition-all relative">
    
    <!-- Header: Title Text on top, Dropdowns & Category Buttons BELOW LEFT -->
    <div class="flex flex-col gap-2.5 pb-3.5 mb-4 border-b border-slate-200/80 dark:border-slate-700/60">
        <!-- Title Text (Single Line, No Logo) -->
        <div class="flex items-center">
            <h2 class="text-sm sm:text-base font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                <span>Monthly Crime Trends</span>
                <span class="text-slate-400 dark:text-slate-500 font-bold">&bull;</span>
                <span class="text-slate-600 dark:text-slate-300 font-black text-xs sm:text-sm">Year <span id="trendScopeYear"><%= defaultYearVal %></span></span>
            </h2>
        </div>

        <!-- Controls: Below LEFT of the title text -->
        <div class="flex items-center gap-2 flex-wrap">
            <!-- Year Dropdown -->
            <div class="relative w-24">
                <% 
                    const availableYears = [...new Set(safePoints.map(p => {
                        const rawDate = p.incident_date || p.date_committed || p.dateCommitted;
                        if(!rawDate) return null;
                        const d = new Date(rawDate);
                        return !isNaN(d.getTime()) ? d.getUTCFullYear() : null;
                    }).filter(y => y !== null))].sort((a, b) => b - a);

                    if(availableYears.length === 0) availableYears.push(new Date().getFullYear());
                %>
                <select id="monthlyTrendYearFilter" onchange="filterMonthlyTrends()" class="w-full bg-slate-50 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] font-bold uppercase text-slate-800 dark:text-white focus:ring-1 focus:ring-blue-500 cursor-pointer shadow-2xs">
                    <% availableYears.forEach(year => { %>
                        <option value="<%= year %>" <%= year === defaultYearVal ? 'selected' : '' %>><%= year %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Barangay Dropdown -->
            <div class="relative w-40 sm:w-48">
                <select id="monthlyTrendBarangayFilter" onchange="filterMonthlyTrends()" class="w-full bg-slate-50 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 rounded-lg px-2.5 py-1.5 text-[11px] font-bold uppercase text-slate-800 dark:text-white focus:ring-1 focus:ring-blue-500 cursor-pointer shadow-2xs truncate">
                    <option value="ALL">ALL BARANGAYS</option>
                    <% ["Alipit", "Bagumbayan" , "Bubukal" , "Calios" , "Duhat" , "Gatid" , "Jasaan"
                        , "Labuin" , "Malinao" , "Oogong" , "Pagsawitan" , "Palasan" , "Patimbao"
                        , "Poblacion I (Barangay I)" , "Poblacion II (Barangay II)"
                        , "Poblacion III (Barangay III)" , "Poblacion IV (Barangay IV)"
                        , "Poblacion V (Barangay V)" , "San Jose" , "San Juan" , "San Pablo Norte"
                        , "San Pablo Sur" , "Santisima Cruz" , "Santo Angel Central"
                        , "Santo Angel Norte" , "Santo Angel Sur" ].forEach(brgy=> { %>
                        <option value="<%= brgy %>"><%= brgy.toUpperCase() %></option>
                    <% }) %>
                </select>
            </div>

            <!-- Category Filter Buttons (8-Focus, Non-Index, PSI) -->
            <div class="flex items-center gap-1.5 flex-wrap">
                <button type="button" onclick="toggleTrendDataset(0)" id="legend8Focus" class="px-2.5 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400 border border-red-300 dark:border-red-800/60 hover:bg-red-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-red-700"></span>
                    <span>8-Focus</span>
                </button>
                <button type="button" onclick="toggleTrendDataset(1)" id="legendNonIndex" class="px-2.5 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider bg-blue-50 text-blue-700 dark:bg-blue-950/40 dark:text-blue-400 border border-blue-300 dark:border-blue-800/60 hover:bg-blue-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-blue-700"></span>
                    <span>Non-Index</span>
                </button>
                <button type="button" onclick="toggleTrendDataset(2)" id="legendPSI" class="px-2.5 py-1.5 rounded-lg text-[11px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 dark:bg-amber-950/40 dark:text-amber-400 border border-amber-300 dark:border-amber-800/60 hover:bg-amber-700 hover:text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-amber-700"></span>
                    <span>PSI</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main Section: Bar Graph (Left) & 4 KPI Cards in 1 Column (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch mb-4 sm:mb-5">
        <!-- Left: Bar Graph Canvas -->
        <div class="lg:col-span-9 bg-slate-50 dark:bg-slate-950/60 rounded-xl sm:rounded-2xl p-3 sm:p-4 border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between">
            <div class="relative w-full h-[320px] sm:h-[340px]">
                <canvas id="crimeTrendChart"></canvas>
            </div>
        </div>

        <!-- Right: 1 Column with Total Incidents, PNP Bulletins, Peak Month, and Leading Offense (Selection) -->
        <div class="lg:col-span-3 flex flex-col justify-between gap-2 sm:gap-2.5">
            <!-- 1. Total Incidents Card (Quick button to crime reports) -->
            <a href="/admin/reports" class="p-2.5 sm:p-3 bg-slate-50 dark:bg-slate-800/70 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between flex-1 shadow-xs hover:shadow-md hover:border-blue-400 dark:hover:border-blue-600 transition-all cursor-pointer group" title="Open Crime Reports">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-widest group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">Total Incidents</span>
                        <i class="fas fa-arrow-up-right-from-square text-[8px] text-slate-400 group-hover:text-blue-500 transition-colors"></i>
                    </div>
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <i class="fas fa-folder-open text-xs"></i>
                    </div>
                </div>
                <div>
                    <span id="modalKpiTotal" class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tabular-nums block tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">0</span>
                    <span class="text-[8px] sm:text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mt-0.5">Recorded Cases &bull; View Reports</span>
                </div>
            </a>

            <!-- 2. PNP Bulletins Card (Exact Same UI as Total Incidents) -->
            <a href="/admin/bulletins" class="p-2.5 sm:p-3 bg-slate-50 dark:bg-slate-800/70 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between flex-1 shadow-xs hover:shadow-md hover:border-blue-400 dark:hover:border-blue-600 transition-all cursor-pointer group" title="Open PNP Bulletins">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center gap-1.5">
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-widest group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">PNP Bulletins</span>
                        <i class="fas fa-arrow-up-right-from-square text-[8px] text-slate-400 group-hover:text-blue-500 transition-colors"></i>
                    </div>
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <i class="fas fa-bullhorn text-xs"></i>
                    </div>
                </div>
                <div>
                    <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tabular-nums block tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"><%= safeStats.totalBulletins || 0 %></span>
                    <span class="text-[8px] sm:text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mt-0.5">Active Advisories &bull; View Bulletins</span>
                </div>
            </a>

            <!-- 3. Peak Month Card -->
            <div class="p-2.5 sm:p-3 bg-slate-50 dark:bg-slate-800/70 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between flex-1 shadow-xs hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-[9px] sm:text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-widest">Peak Month</span>
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-red-50 dark:bg-red-900/30 text-red-500 flex items-center justify-center shrink-0">
                        <i class="fas fa-arrow-trend-up text-xs"></i>
                    </div>
                </div>
                <div>
                    <span id="modalKpiPeakMonth" class="text-sm sm:text-base font-black text-red-600 dark:text-red-400 uppercase leading-snug block break-words">--</span>
                    <span id="modalKpiPeakCount" class="text-[8px] sm:text-[9px] font-semibold text-slate-500 dark:text-slate-400 block mt-0.5">0 records</span>
                </div>
            </div>

            <!-- 4. Leading Offense Card (Click whole container to open category selection popup) -->
            <div onclick="openLeadingOffenseModal()" class="p-2.5 sm:p-3 bg-slate-50 dark:bg-slate-800/70 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 flex flex-col justify-between flex-1 shadow-xs hover:shadow-md hover:border-amber-400 dark:hover:border-amber-500 transition-all cursor-pointer group" title="Click to filter by category: ALL, 8-Focus, Non-Index, or PSI">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="text-[9px] sm:text-[10px] font-black text-slate-500 dark:text-slate-400 uppercase tracking-wider">Leading Offense:</span>
                        <span id="leadingOffenseCategoryBadge" class="text-[8px] sm:text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300/80 dark:border-amber-700">ALL</span>
                    </div>
                    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-amber-50 dark:bg-amber-900/30 text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
                        <i class="fas fa-bullseye text-xs"></i>
                    </div>
                </div>
                <div class="min-w-0">
                    <span id="modalKpiTopCrime" class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase break-words whitespace-normal leading-tight block group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors" title="--">--</span>
                    <span id="modalKpiTopShare" class="text-[8px] sm:text-[9px] font-semibold text-slate-500 dark:text-slate-400 block mt-0.5">0 cases (0% of total)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row of Container: Trend Analysis, Crime Pattern, and Strategic Directives (20% decreased size) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 sm:gap-4 items-stretch pt-2 border-t border-slate-200/80 dark:border-slate-700/60">
        
        <!-- 1. TREND ANALYSIS -->
        <div id="modalCardTrend" class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xs shrink-0">
                            <i class="fas fa-chart-line text-[11px]"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white">
                                Trend Analysis
                            </h4>
                            <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block">
                                Directional Trajectory
                            </span>
                        </div>
                    </div>
                    <span id="modalTrendBadge" class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider bg-blue-50 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60 shrink-0">
                        Evaluated
                    </span>
                </div>
                <div id="modalTrendText" class="text-xs leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    <div class="flex items-center gap-2 py-2 text-slate-400">
                        <div class="w-3.5 h-3.5 rounded-full border-2 border-blue-500 border-t-transparent animate-spin"></div>
                        <span class="text-[11px] uppercase tracking-widest font-bold">Computing trend direction...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CRIME PATTERN -->
        <div id="modalCardPattern" class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-amber-50 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xs shrink-0">
                            <i class="fas fa-bullseye text-[11px]"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white">
                                Crime Pattern
                            </h4>
                            <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block">
                                Concentration & Drivers
                            </span>
                        </div>
                    </div>
                    <span id="modalPatternBadge" class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 shrink-0">
                        Identified
                    </span>
                </div>
                <div id="modalPatternText" class="text-xs leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    <div class="flex items-center gap-2 py-2 text-slate-400">
                        <div class="w-3.5 h-3.5 rounded-full border-2 border-amber-500 border-t-transparent animate-spin"></div>
                        <span class="text-[11px] uppercase tracking-widest font-bold">Identifying crime patterns...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. STRATEGIC DIRECTIVES -->
        <div id="modalCardSuggestions" class="p-3.5 sm:p-4 rounded-xl sm:rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-100 dark:border-slate-800">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-emerald-50 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs shrink-0">
                            <i class="fas fa-shield-halved text-[11px]"></i>
                        </div>
                        <div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white">
                                Strategic Directives
                            </h4>
                            <span class="text-[8px] sm:text-[9px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block">
                                Tactical Suggestions
                            </span>
                        </div>
                    </div>
                    <span id="modalSuggestionsBadge" class="px-2 py-0.5 rounded-full text-[8px] font-black uppercase tracking-wider bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shrink-0">
                        Directives
                    </span>
                </div>
                <div id="modalSuggestionsText" class="text-xs leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    <div class="flex items-center gap-2 py-2 text-slate-400">
                        <div class="w-3.5 h-3.5 rounded-full border-2 border-emerald-500 border-t-transparent animate-spin"></div>
                        <span class="text-[11px] uppercase tracking-widest font-bold">Synthesizing recommendations...</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Leading Offense Category Selection Modal -->
<div id="leadingOffenseModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs transition-opacity duration-300 hidden" onclick="if(event.target === this) closeLeadingOffenseModal()">
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl max-w-lg w-full overflow-hidden animate-scale-up">
        <!-- Modal Header -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center border border-amber-500/20 shrink-0">
                    <i class="fas fa-bullseye text-base"></i>
                </div>
                <div>
                    <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-white uppercase tracking-wider">
                        Select Leading Offense Category
                    </h3>
                    <p class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">
                        Choose a category to display top crimes and filter the monthly bar graph
                    </p>
                </div>
            </div>
            <button onclick="closeLeadingOffenseModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white flex items-center justify-center transition cursor-pointer">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>

        <!-- Modal Choices List -->
        <div class="p-5 sm:p-6 space-y-3">
            <!-- Choice 1: ALL CATEGORIES -->
            <button type="button" onclick="selectLeadingOffenseCategory('ALL')" id="choiceCat_ALL" class="w-full text-left p-3.5 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-blue-500 bg-slate-50/70 dark:bg-slate-800/60 hover:bg-blue-50/50 dark:hover:bg-blue-950/30 transition-all flex items-center justify-between group cursor-pointer">
                <div class="flex items-center gap-3.5 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                        <i class="fas fa-layer-group text-sm"></i>
                    </div>
                    <div class="min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-black uppercase tracking-wider text-slate-900 dark:text-white">All Categories</span>
                            <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300">Complete Overview</span>
                        </div>
                        <div class="mt-1 flex items-baseline gap-1.5 flex-wrap">
                            <span class="text-[10px] text-slate-400 font-bold uppercase">Leading:</span>
