    // --- Synchronized KPI & Intelligence Engine ---
    window.updateKpisAndIntelligence = function() {
        const brgyDropdown = document.getElementById('monthlyTrendBarangayFilter');
        const yrDropdown = document.getElementById('monthlyTrendYearFilter');
        const selectedBrgy = brgyDropdown ? brgyDropdown.value : 'ALL';
        const selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;
        const cat = window.activeLeadingCategory || 'ALL';

        const buckets = window.currentBuckets || Array.from({ length: 12 }, () => [0, 0, 0, 0, 0, 0]);
        let scopeCounts = {};
        let scopeTotal = 0;
        let scopeMonthlyTotals = [];
        let kpiSubtitle = "Recorded Cases • View Reports";

        if (cat === 'ALL') {
            scopeCounts = window.currentOverallCounts || {};
            scopeTotal = window.currentMatchedCount || 0;
            scopeMonthlyTotals = buckets.map(b => b.reduce((acc, curr) => acc + curr, 0));
            kpiSubtitle = "All Recorded Cases • View Reports";
        } else if (cat === '8-Focus') {
            scopeCounts = (window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {};
            scopeTotal = Object.values(scopeCounts).reduce((a, b) => a + b, 0);
            scopeMonthlyTotals = buckets.map(b => b[0] + b[1]);
            kpiSubtitle = "8-Focus Index Cases • View Reports";
        } else if (cat === 'Non-Index') {
            scopeCounts = (window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {};
            scopeTotal = Object.values(scopeCounts).reduce((a, b) => a + b, 0);
            scopeMonthlyTotals = buckets.map(b => b[2] + b[3]);
            kpiSubtitle = "Non-Index Cases • View Reports";
        } else if (cat === 'PSI') {
            scopeCounts = (window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {};
            scopeTotal = Object.values(scopeCounts).reduce((a, b) => a + b, 0);
            scopeMonthlyTotals = buckets.map(b => b[4] + b[5]);
            kpiSubtitle = "Public Safety Incidents • View Reports";
        }

        // Top Crime Calculation
        const sortedCrimes = Object.entries(scopeCounts).sort((a, b) => b[1] - a[1]);
        let topCrimeName = 'NONE';
        let topCrimeCount = 0;

        if (window.activeSpecificOffense && scopeCounts[window.activeSpecificOffense] !== undefined) {
            topCrimeName = window.activeSpecificOffense;
            topCrimeCount = scopeCounts[topCrimeName];
        } else if (sortedCrimes.length > 0) {
            topCrimeName = sortedCrimes[0][0];
            topCrimeCount = sortedCrimes[0][1];
        }

        // Peak Month Calculation for the scope
        let maxMonthIdx = 0;
        let maxMonthVal = 0;
        scopeMonthlyTotals.forEach((val, idx) => {
            if (val > maxMonthVal) {
                maxMonthVal = val;
                maxMonthIdx = idx;
            }
        });

        // Update KPI 1: Total Incidents
        const kpiTotalEl = document.getElementById('modalKpiTotal');
        const kpiTotalSub = document.getElementById('modalKpiTotalSub');
        if (kpiTotalEl) kpiTotalEl.textContent = scopeTotal;
        if (kpiTotalSub) kpiTotalSub.textContent = kpiSubtitle;

        // Update KPI 2: Peak Month
        const kpiPeakMonthEl = document.getElementById('modalKpiPeakMonth');
        const kpiPeakCountEl = document.getElementById('modalKpiPeakCount');
        if (kpiPeakMonthEl) kpiPeakMonthEl.textContent = scopeTotal > 0 ? FULL_MONTH_NAMES[maxMonthIdx] : '--';
        if (kpiPeakCountEl) {
            kpiPeakCountEl.textContent = scopeTotal > 0 
                ? `${maxMonthVal} records (${((maxMonthVal / Math.max(scopeTotal, 1)) * 100).toFixed(0)}%)` 
                : '0 records';
        }

        // Update KPI 3: Leading Offense Card
        const badge = document.getElementById('leadingOffenseCategoryBadge');
        if (badge) badge.textContent = cat;

        const kpiTopCrimeEl = document.getElementById('modalKpiTopCrime');
        const kpiTopShareEl = document.getElementById('modalKpiTopShare');
        if (kpiTopCrimeEl) {
            kpiTopCrimeEl.textContent = topCrimeName;
            kpiTopCrimeEl.title = topCrimeName;
        }
        if (kpiTopShareEl) {
            const share = scopeTotal > 0 ? ((topCrimeCount / scopeTotal) * 100).toFixed(1) : '0';
            const catLabel = cat === 'ALL' ? 'total' : cat;
            kpiTopShareEl.textContent = scopeTotal > 0 
                ? `${topCrimeCount} cases (${share}% of ${catLabel})` 
                : `0 cases (0% of ${catLabel})`;
        }

        // Update Dynamic Intelligence Cards (0ms instant)
        if (typeof window.renderDynamicTrendAnalysis === 'function') {
            window.renderDynamicTrendAnalysis(
                selectedBrgy, 
                selectedYear, 
                cat, 
                topCrimeName, 
                topCrimeCount, 
                scopeTotal, 
                scopeMonthlyTotals, 
                scopeCounts, 
                window.currentOverallCounts, 
                window.currentCategoryCounts
            );
        }

        // Trigger Non-Blocking Background AI Trends
        if (typeof window.generateAITrends === 'function') {
            window.generateAITrends(selectedBrgy, selectedYear, cat, topCrimeName);
        }
    };

    // --- Master Category Filter Controller ---
    window.setDashboardCategoryFilter = function(cat, specificOffense) {
        if (!cat) cat = 'ALL';
        // If clicking the active category button (and no specific offense specified), toggle back to 'ALL'
        if (window.activeLeadingCategory === cat && cat !== 'ALL' && !specificOffense) {
            cat = 'ALL';
        }
        window.activeLeadingCategory = cat;
        window.activeSpecificOffense = specificOffense || null;

        // Synchronize category button visuals
        updateCategoryButtonsUI(cat);

        // Apply dataset visibility to Chart
        applyCategoryFilterToChart(cat);

        // Update KPI metrics & Intelligence Cards
        updateKpisAndIntelligence();
    };

