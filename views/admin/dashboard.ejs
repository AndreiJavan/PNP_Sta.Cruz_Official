    // High-performance direct bento DOM updates
    function updateBentoDetailsFromCounts(overallCounts, categoryCounts, totalMatchedCount, selectedBrgy) {
        function getTop(countsObj) {
            let topName = 'NONE';
            let topCount = 0;
            for (const [name, count] of Object.entries(countsObj)) {
                if (count > topCount) {
                    topCount = count;
                    topName = name;
                }
            }
            return { name: topName, count: topCount };
        }

        const overallTop = getTop(overallCounts);
        const top8Focus = getTop(categoryCounts['8-Focus']);
        const topNonIndex = getTop(categoryCounts['Non-Index']);
        const topPSI = getTop(categoryCounts['PSI']);

        const setDomSafe = (id, value) => {
            const el = document.getElementById(id);
            if (el) {
                el.textContent = value;
                if (el.hasAttribute('title')) el.setAttribute('title', value);
            }
        };

        const textAnalysisContainer = document.querySelector('#municipalTextAnalysis p');
        if (textAnalysisContainer) {
            const targetLoc = selectedBrgy === 'ALL' ? 'Sta. Cruz, Laguna' : selectedBrgy.toUpperCase();
            if (overallTop.count > 0) {
                textAnalysisContainer.innerHTML = `The most common incident in <span class="font-extrabold text-pnp-blue dark:text-pnp-gold">${targetLoc}</span> is currently <span id="overallTopCrime" class="font-black text-indigo-600 dark:text-indigo-400 uppercase px-1">${overallTop.name}</span> with <span id="overallTopCount" class="font-black text-indigo-600 dark:text-indigo-400">${overallTop.count}</span> recorded occurrences.`;
            } else {
                textAnalysisContainer.innerHTML = `There are no active or recorded incidents currently registered in <span class="font-extrabold text-pnp-blue dark:text-pnp-gold">${targetLoc}</span>.`;
            }
        } else {
            setDomSafe('overallTopCrime', overallTop.name);
            setDomSafe('overallTopCount', overallTop.count);
        }

        setDomSafe('top8Focus', top8Focus.name);
        setDomSafe('count8Focus', top8Focus.count);
        setDomSafe('topNonIndex', topNonIndex.name);
        setDomSafe('countNonIndex', topNonIndex.count);
        setDomSafe('topPSI', topPSI.name);
        setDomSafe('countPSI', topPSI.count);
        setDomSafe('kpiTotalCrimes', totalMatchedCount);
    }

    // Define bento details update function
    window.updateBentoDetails = function(selectedBrgy, selectedYear) {
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let count = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;
            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            count++;

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        updateBentoDetailsFromCounts(overallCounts, categoryCounts, count, selectedBrgy);
    };

    // --- Ultra-Fast Real-Time Dynamic Intelligence Generator ---
    window.renderDynamicTrendAnalysis = function(selectedBrgy, selectedYear, totalCount, buckets, overallCounts) {
        const trendEl = document.getElementById('modalTrendText');
        const patternEl = document.getElementById('modalPatternText');
        const suggEl = document.getElementById('modalSuggestionsText');
        const trendBadge = document.getElementById('modalTrendBadge');
        const patternBadge = document.getElementById('modalPatternBadge');
        const suggBadge = document.getElementById('modalSuggestionsBadge');

        const barangayName = selectedBrgy === 'ALL' ? 'All Barangays' : `Barangay ${selectedBrgy}`;

        if (totalCount === 0) {
            if (trendEl) {
                trendEl.innerHTML = `<p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">Recorded incidents across <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${barangayName}</strong> for <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${selectedYear}</strong> remain exceptionally calm with zero active or reported crimes.</p>`;
            }
            if (patternEl) {
                patternEl.innerHTML = `<p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">A consistent zero-incident baseline is maintained across all 12 operational months.</p>`;
            }
            if (suggEl) {
                suggEl.innerHTML = `
                    <ul class="space-y-1.5 my-0.5">
                        <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium">
                            <span class="text-emerald-500 font-bold text-base leading-none shrink-0">•</span>
                            <span>Maintain high-visibility preventive patrols and routine barangay tanod coordination.</span>
                        </li>
                        <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium">
                            <span class="text-emerald-500 font-bold text-base leading-none shrink-0">•</span>
                            <span>Conduct proactive community outreach to preserve a crime-free environment.</span>
                        </li>
                    </ul>
                `;
            }
            if (trendBadge) trendBadge.textContent = 'Stable';
            if (patternBadge) patternBadge.textContent = 'Baseline';
            if (suggBadge) suggBadge.textContent = 'Preventive';
            return;
        }

        // 1. Calculate monthly totals and H1 vs H2
        const monthTotals = buckets.map(b => b.reduce((acc, curr) => acc + curr, 0));
        const h1 = monthTotals.slice(0, 6).reduce((a, b) => a + b, 0);
        const h2 = monthTotals.slice(6, 12).reduce((a, b) => a + b, 0);

        let trendDirection = "a stable and balanced distribution";
        let trendBadgeText = "Stable";
        if (h1 > 0 && h2 > h1) {
            const pct = Math.round(((h2 - h1) / h1) * 100);
            trendDirection = `an upward trajectory (+${pct}% increase in H2 compared to H1)`;
            trendBadgeText = `Upward +${pct}%`;
        } else if (h1 > 0 && h2 < h1) {
            const pct = Math.round(((h1 - h2) / h1) * 100);
            trendDirection = `a steady downward trajectory (-${pct}% reduction in H2 compared to H1)`;
            trendBadgeText = `Downward -${pct}%`;
        } else if (h1 === 0 && h2 > 0) {
            trendDirection = `incident activity concentrated during the second half of ${selectedYear}`;
            trendBadgeText = "Active H2";
        }

        // 2. Identify peak month and quietest month
        let peakIdx = 0;
        let peakVal = 0;
        let quietIdx = 0;
        let quietVal = Infinity;

        monthTotals.forEach((val, idx) => {
            if (val > peakVal) {
                peakVal = val;
                peakIdx = idx;
            }
            if (val < quietVal) {
                quietVal = val;
                quietIdx = idx;
            }
        });

        const peakMonthName = FULL_MONTH_NAMES[peakIdx] || 'N/A';
        const quietMonthName = FULL_MONTH_NAMES[quietIdx] || 'N/A';

        // 3. Top crimes from overallCounts
        const sortedCrimes = Object.entries(overallCounts || {}).sort((a, b) => b[1] - a[1]);
        const topCrimeList = sortedCrimes.slice(0, 3).map(([name, cnt]) => {
            const share = Math.round((cnt / totalCount) * 100);
            return `<strong class="font-bold text-slate-900 dark:text-white">${name}</strong> (${cnt} case${cnt > 1 ? 's' : ''}, ${share}%)`;
        });
        const topCrimeStr = topCrimeList.length > 0 ? topCrimeList.join(', ') : 'general offenses';

        const leadingCrimeName = (sortedCrimes.length > 0 ? sortedCrimes[0][0] : '').toLowerCase();

        // 4. Tailored Strategic Directives
        let directives = [
            "Sustain targeted mobile checkpoint visibility during peak transit hours (18:00 - 23:00).",
            "Coordinate with Barangay Tanod patrols along high-density thoroughfares and residential boundaries.",
            "Maintain strict enforcement of local municipal ordinances and public illumination monitoring."
        ];

        if (leadingCrimeName.includes('theft') || leadingCrimeName.includes('robbery') || leadingCrimeName.includes('burglary')) {
            directives = [
                "Increase foot and mobile patrols in commercial areas, public markets, and transport hubs during peak business hours.",
                "Coordinate with barangay tanods for continuous CCTV monitoring and perimeter lighting enhancements.",
                "Conduct community crime-prevention seminars on property security for local commercial establishments."
            ];
        } else if (leadingCrimeName.includes('injury') || leadingCrimeName.includes('assault') || leadingCrimeName.includes('brawl') || leadingCrimeName.includes('physical')) {
            directives = [
                "Strictly enforce municipal liquor ban ordinances and night youth curfew across barangay perimeters.",
                "Deploy joint police-tanod standby teams near commercial plazas, recreation halls, and gathering spots during weekend evening hours.",
                "Establish rapid dispute mediation protocols with barangay lupon tagapamayapa."
            ];
        } else if (leadingCrimeName.includes('traffic') || leadingCrimeName.includes('accident') || leadingCrimeName.includes('reckless') || leadingCrimeName.includes('damage to property')) {
            directives = [
                "Establish speed control checkpoints and position traffic enforcers along key barangay arterial roads and accident-prone intersections.",
                "Coordinate with local DPWH/engineering office to repair street signage, road markings, and high-visibility lane dividers.",
                "Intensify roadside random breath testing and anti-drunk driving patrols during late night hours."
            ];
        } else if (leadingCrimeName.includes('drugs') || leadingCrimeName.includes('ra 9165') || leadingCrimeName.includes('comprehensive dangerous')) {
            directives = [
                "Intensify intelligence surveillance and coordinated anti-illegal drug clearing operations with PDEA and local BADAC.",
                "Strengthen barangay-level monitoring checkpoints and confidential reporting hotlines for residents.",
                "Conduct proactive community education and rehabilitation advocacy in coordination with municipal social welfare."
            ];
        } else if (leadingCrimeName.includes('cyber') || leadingCrimeName.includes('scam') || leadingCrimeName.includes('fraud')) {
            directives = [
                "Conduct cyber-safety awareness workshops at local barangay halls regarding digital scams and identity theft.",
                "Publish regular PNP advisory bulletins on common e-wallet and online banking fraud methods.",
                "Establish a dedicated digital evidence intake desk for cybercrime complaints."
            ];
        }

        // Render Card 1: Trend Analysis
        if (trendEl) {
            trendEl.innerHTML = `
                <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    Crime incidents in <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${barangayName}</strong> for <strong class="text-pnp-blue dark:text-pnp-gold font-bold">${selectedYear}</strong> show ${trendDirection}, totaling <strong class="text-slate-900 dark:text-white font-bold">${totalCount}</strong> recorded incident${totalCount === 1 ? '' : 's'}. Peak volume was recorded in <strong class="font-bold text-slate-900 dark:text-white">${peakMonthName}</strong> (${peakVal} case${peakVal === 1 ? '' : 's'}), while <strong class="font-bold text-slate-900 dark:text-white">${quietMonthName}</strong> recorded the lowest volume (${quietVal} case${quietVal === 1 ? '' : 's'}).
                </p>
            `;
        }
        if (trendBadge) trendBadge.textContent = trendBadgeText;

        // Render Card 2: Crime Pattern
        if (patternEl) {
            const h1Pct = Math.round((h1 / totalCount) * 100);
            const h2Pct = Math.round((h2 / totalCount) * 100);
            patternEl.innerHTML = `
                <p class="text-xs sm:text-sm leading-relaxed text-slate-700 dark:text-slate-200 font-medium">
                    Incident distribution is driven primarily by ${topCrimeStr}. The first half of the year (H1) accounted for <strong class="font-bold text-slate-900 dark:text-white">${h1}</strong> incident${h1 === 1 ? '' : 's'} (${h1Pct}%), while the second half (H2) recorded <strong class="font-bold text-slate-900 dark:text-white">${h2}</strong> incident${h2 === 1 ? '' : 's'} (${h2Pct}%).
                </p>
            `;
        }
        if (patternBadge) patternBadge.textContent = sortedCrimes.length > 0 ? (sortedCrimes[0][0].length > 14 ? sortedCrimes[0][0].substring(0, 14) + '...' : sortedCrimes[0][0]) : 'Identified';

        // Render Card 3: Strategic Directives
        if (suggEl) {
            const listItems = directives.map(d => `
                <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700 dark:text-slate-200 font-medium">
                    <span class="text-emerald-500 font-bold text-base leading-none shrink-0">•</span>
                    <span>${d}</span>
                </li>
            `).join('');
            suggEl.innerHTML = `<ul class="space-y-1.5 my-0.5">${listItems}</ul>`;
        }
        if (suggBadge) suggBadge.textContent = 'Directives';
    };

    // --- Ultra-Fast Monthly Crime Trends Filtering Logic ---
    window.filterMonthlyTrends = function() {
        const brgyDropdown = document.getElementById('monthlyTrendBarangayFilter');
        const yrDropdown = document.getElementById('monthlyTrendYearFilter');
        const selectedBrgy = brgyDropdown ? brgyDropdown.value : 'ALL';
        const selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;

        // 1. Single O(N) pass for instant 12-month buckets, bento details, and sector distribution (<1ms)
        const buckets = Array.from({ length: 12 }, () => [0, 0, 0, 0, 0, 0]); // [focusM, focusS, nonIndexM, nonIndexS, psiM, psiS]
        const sectorCounts = {};
        const overallCounts = {};
        const categoryCounts = { '8-Focus': {}, 'Non-Index': {}, 'PSI': {} };
        let matchedCount = 0;

        for (let i = 0; i < preprocessedPoints.length; i++) {
            const item = preprocessedPoints[i];
            if (item.year !== selectedYear) continue;

            const sector = item.barangay || 'Unknown';
            sectorCounts[sector] = (sectorCounts[sector] || 0) + 1;

            if (selectedBrgy !== 'ALL' && item.barangay !== selectedBrgy) continue;
            matchedCount++;

            const m = item.month;
            if (m >= 0 && m < 12) {
                const isScan = item.isScanned ? 1 : 0;
                if (item.category === '8-Focus') {
                    buckets[m][isScan]++;
                } else if (item.category === 'PSI') {
                    buckets[m][4 + isScan]++;
                } else {
                    buckets[m][2 + isScan]++;
                }
            }

            const type = item.incident_type;
            if (type && type !== 'UNKNOWN') {
                overallCounts[type] = (overallCounts[type] || 0) + 1;
                const cat = item.category === '8-Focus' || item.category === 'PSI' ? item.category : 'Non-Index';
                categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
            }
        }

        // STEP 1: INSTANT BARGRAPH UPDATE (0ms)
        if (window.trendChart) {
            window.trendChart.data.labels = MONTH_LABELS;
            window.trendChart.data.datasets[0].data = buckets.map(b => b[0]);
            window.trendChart.data.datasets[1].data = buckets.map(b => b[1]);
            window.trendChart.data.datasets[2].data = buckets.map(b => b[2]);
            window.trendChart.data.datasets[3].data = buckets.map(b => b[3]);
            window.trendChart.data.datasets[4].data = buckets.map(b => b[4]);
            window.trendChart.data.datasets[5].data = buckets.map(b => b[5]);
            window.trendChart.update('none'); // Render immediately!
        }

        // STEP 2: INSTANT TOP KPI METRICS UPDATE (Total Incidents, Peak Month, Leading Offense)
        const kpiTotalEl = document.getElementById('modalKpiTotal');
        if (kpiTotalEl) kpiTotalEl.textContent = matchedCount;

        // Calculate Peak Month
        const monthTotals = buckets.map(b => b.reduce((acc, curr) => acc + curr, 0));
        let maxMonthIdx = 0;
        let maxMonthVal = 0;
        monthTotals.forEach((val, idx) => {
            if (val > maxMonthVal) {
                maxMonthVal = val;
                maxMonthIdx = idx;
            }
        });

        const kpiPeakMonthEl = document.getElementById('modalKpiPeakMonth');
        const kpiPeakCountEl = document.getElementById('modalKpiPeakCount');
        if (kpiPeakMonthEl) kpiPeakMonthEl.textContent = matchedCount > 0 ? FULL_MONTH_NAMES[maxMonthIdx] : '--';
        if (kpiPeakCountEl) {
            kpiPeakCountEl.textContent = matchedCount > 0 
                ? `${maxMonthVal} records (${((maxMonthVal / Math.max(matchedCount, 1)) * 100).toFixed(0)}%)` 
                : '0 records';
        }

        // Save current counts for Leading Offense category selection
        window.currentOverallCounts = overallCounts;
        window.currentCategoryCounts = categoryCounts;
        window.currentMatchedCount = matchedCount;

        // Update Leading Offense based on active category (ALL, 8-Focus, Non-Index, PSI)
        window.updateLeadingOffenseCard(window.activeLeadingCategory || 'ALL');
        if (window.activeLeadingCategory && window.activeLeadingCategory !== 'ALL') {
            window.applyCategoryFilterToChart(window.activeLeadingCategory);
        }

        const trendScopeYear = document.getElementById('trendScopeYear');
        if (trendScopeYear) {
            trendScopeYear.textContent = selectedYear;
        }

        // STEP 3: INSTANT BENTO STATS UPDATE
        updateBentoDetailsFromCounts(overallCounts, categoryCounts, matchedCount, selectedBrgy);

        // STEP 4: INSTANT DISTRIBUTION PIE UPDATE
        updateDistributionChartFromCounts(sectorCounts, selectedYear);

        // STEP 5: INSTANT REAL-TIME DYNAMIC INTELLIGENCE ANALYSIS (0ms, no waiting!)
        if (typeof window.renderDynamicTrendAnalysis === 'function') {
            window.renderDynamicTrendAnalysis(selectedBrgy, selectedYear, matchedCount, buckets, overallCounts);
        }

        // STEP 6: BACKGROUND AI TRENDS (non-blocking, enriches insights if available)
        if (typeof window.generateAITrends === 'function') {
            window.generateAITrends(selectedBrgy, selectedYear);
        }
    };

    window.activeLeadingCategory = 'ALL';

    window.openLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (!modal) return;

        function computeTop(countsObj, totalScope) {
            const sorted = Object.entries(countsObj || {}).sort((a, b) => b[1] - a[1]);
            if (sorted.length === 0 || sorted[0][1] === 0) {
                return { name: 'NONE', cases: 0, share: '0' };
            }
            const topName = sorted[0][0];
            const topCases = sorted[0][1];
            const share = totalScope > 0 ? ((topCases / totalScope) * 100).toFixed(1) : '0';
            return { name: topName, cases: topCases, share };
        }

        const overallTop = computeTop(window.currentOverallCounts, window.currentMatchedCount);
        const top8Focus = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['8-Focus']) || {}).reduce((a, b) => a + b, 0)
        );
        const topNonIndex = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['Non-Index']) || {}).reduce((a, b) => a + b, 0)
        );
        const topPSI = computeTop(
            (window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {},
            Object.values((window.currentCategoryCounts && window.currentCategoryCounts['PSI']) || {}).reduce((a, b) => a + b, 0)
        );

        const updateChoice = (catKey, topObj) => {
            const crimeEl = document.getElementById(`choiceCrime_${catKey}`);
            const statsEl = document.getElementById(`choiceStats_${catKey}`);
            if (crimeEl) crimeEl.textContent = topObj.name;
            if (statsEl) statsEl.innerHTML = `(${topObj.cases} cases &bull; ${topObj.share}%)`;
        };

        updateChoice('ALL', overallTop);
        updateChoice('8Focus', top8Focus);
        updateChoice('NonIndex', topNonIndex);
        updateChoice('PSI', topPSI);

        const allCatKeys = [
            { id: 'choiceCat_ALL', cat: 'ALL' },
            { id: 'choiceCat_8Focus', cat: '8-Focus' },
            { id: 'choiceCat_NonIndex', cat: 'Non-Index' },
            { id: 'choiceCat_PSI', cat: 'PSI' }
        ];

        allCatKeys.forEach(item => {
            const btn = document.getElementById(item.id);
            if (!btn) return;
            const check = btn.querySelector('.choiceCheckmark');
            if (item.cat === window.activeLeadingCategory) {
                btn.classList.add('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.add('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.remove('text-transparent');
                }
            } else {
                btn.classList.remove('ring-2', 'ring-blue-500', 'bg-blue-50/70', 'dark:bg-blue-950/40');
                if (check) {
                    check.classList.remove('bg-blue-600', 'text-white', 'border-blue-600');
                    check.classList.add('text-transparent');
                }
            }
        });

        modal.classList.remove('hidden');
    };

    window.closeLeadingOffenseModal = function() {
        const modal = document.getElementById('leadingOffenseModal');
        if (modal) modal.classList.add('hidden');
    };

    window.selectLeadingOffenseCategory = function(cat) {
        window.activeLeadingCategory = cat || 'ALL';
        window.closeLeadingOffenseModal();

        // 1. Update Leading Offense Card
        window.updateLeadingOffenseCard(window.activeLeadingCategory);

        // 2. Filter Bar Graph to the selected category
        window.applyCategoryFilterToChart(window.activeLeadingCategory);
    };

    window.applyCategoryFilterToChart = function(cat) {
        if (!window.trendChart) return;

        if (cat === 'ALL') {
            for (let i = 0; i < 6; i++) {
                window.trendChart.getDatasetMeta(i).hidden = false;
            }
            ['legend8Focus', 'legendNonIndex', 'legendPSI'].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) btn.classList.remove('opacity-40', 'line-through');
            });
        } else if (cat === '8-Focus') {
            window.trendChart.getDatasetMeta(0).hidden = false;
            window.trendChart.getDatasetMeta(1).hidden = false;
            window.trendChart.getDatasetMeta(2).hidden = true;
            window.trendChart.getDatasetMeta(3).hidden = true;
            window.trendChart.getDatasetMeta(4).hidden = true;
            window.trendChart.getDatasetMeta(5).hidden = true;

            const b0 = document.getElementById('legend8Focus');
            const b1 = document.getElementById('legendNonIndex');
            const b2 = document.getElementById('legendPSI');
            if (b0) b0.classList.remove('opacity-40', 'line-through');
            if (b1) b1.classList.add('opacity-40', 'line-through');
            if (b2) b2.classList.add('opacity-40', 'line-through');
        } else if (cat === 'Non-Index') {
            window.trendChart.getDatasetMeta(0).hidden = true;
            window.trendChart.getDatasetMeta(1).hidden = true;
            window.trendChart.getDatasetMeta(2).hidden = false;
            window.trendChart.getDatasetMeta(3).hidden = false;
            window.trendChart.getDatasetMeta(4).hidden = true;
            window.trendChart.getDatasetMeta(5).hidden = true;

            const b0 = document.getElementById('legend8Focus');
            const b1 = document.getElementById('legendNonIndex');
            const b2 = document.getElementById('legendPSI');
            if (b0) b0.classList.add('opacity-40', 'line-through');
            if (b1) b1.classList.remove('opacity-40', 'line-through');
            if (b2) b2.classList.add('opacity-40', 'line-through');
        } else if (cat === 'PSI') {
            window.trendChart.getDatasetMeta(0).hidden = true;
            window.trendChart.getDatasetMeta(1).hidden = true;
            window.trendChart.getDatasetMeta(2).hidden = true;
            window.trendChart.getDatasetMeta(3).hidden = true;
            window.trendChart.getDatasetMeta(4).hidden = false;
            window.trendChart.getDatasetMeta(5).hidden = false;

            const b0 = document.getElementById('legend8Focus');
            const b1 = document.getElementById('legendNonIndex');
            const b2 = document.getElementById('legendPSI');
            if (b0) b0.classList.add('opacity-40', 'line-through');
            if (b1) b1.classList.add('opacity-40', 'line-through');
            if (b2) b2.classList.remove('opacity-40', 'line-through');
        }
        window.trendChart.update();
    };

    window.updateLeadingOffenseCard = function(cat) {
        if (!cat) cat = window.activeLeadingCategory || 'ALL';

        const badge = document.getElementById('leadingOffenseCategoryBadge');
        if (badge) badge.textContent = cat;

        let counts = {};
        let totalScope = 0;
        if (cat === 'ALL') {
            counts = window.currentOverallCounts || {};
            totalScope = window.currentMatchedCount || 0;
        } else {
            counts = (window.currentCategoryCounts && window.currentCategoryCounts[cat]) || {};
            totalScope = Object.values(counts).reduce((a, b) => a + b, 0);
        }

        const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
        const top = sorted.length > 0 ? sorted[0] : ['None', 0];

        const kpiTopCrimeEl = document.getElementById('modalKpiTopCrime');
        const kpiTopShareEl = document.getElementById('modalKpiTopShare');

        if (kpiTopCrimeEl) {
            kpiTopCrimeEl.textContent = top[0];
            kpiTopCrimeEl.title = top[0];
        }
        if (kpiTopShareEl) {
            const share = totalScope > 0 ? ((top[1] / totalScope) * 100).toFixed(1) : '0';
            const catLabel = cat === 'ALL' ? 'total' : cat;
            kpiTopShareEl.textContent = totalScope > 0 ? `${top[1]} cases (${share}% of ${catLabel})` : `0 cases (0% of ${catLabel})`;
        }
    };

    // Toggle datasets on the top bar graph via category buttons
    window.toggleTrendDataset = function(groupIndex) {
        if (!window.trendChart) return;
        
        // 0 = 8-Focus (datasets 0, 1), 1 = Non-Index (datasets 2, 3), 2 = PSI (datasets 4, 5)
        const targetIndices = [groupIndex * 2, groupIndex * 2 + 1];
        const currentHidden = window.trendChart.getDatasetMeta(targetIndices[0]).hidden;
        const newHidden = !currentHidden;

        targetIndices.forEach(idx => {
            const meta = window.trendChart.getDatasetMeta(idx);
            meta.hidden = newHidden;
        });
        window.trendChart.update();

        // Update button appearance
        const btnIds = ['legend8Focus', 'legendNonIndex', 'legendPSI'];
        const btn = document.getElementById(btnIds[groupIndex]);
        if (btn) {
            if (newHidden) {
                btn.classList.add('opacity-40', 'line-through');
            } else {
                btn.classList.remove('opacity-40', 'line-through');
            }
        }
    };

    window.generateAITrends = async function(selectedBrgy, selectedYear) {
        const generateBtn = document.getElementById('aiGenerateBtn');

        // If not passed, find the active value in the dropdowns
        if (!selectedBrgy) {
            const dropdown = document.getElementById('monthlyTrendBarangayFilter');
            selectedBrgy = dropdown ? dropdown.value : 'ALL';
        }
        if (!selectedYear) {
            const yrDropdown = document.getElementById('monthlyTrendYearFilter');
            selectedYear = yrDropdown ? parseInt(yrDropdown.value, 10) : <%= defaultYearVal %>;
        }

        if (generateBtn) {
            generateBtn.disabled = true;
            generateBtn.innerHTML = '<i class="fas fa-spinner animate-spin text-xs"></i>';
        }

        try {
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 5000);

            const response = await fetch(`/admin/api/ai-trends?barangay=${encodeURIComponent(selectedBrgy)}&year=${selectedYear}`, {
                signal: controller.signal
            });
            clearTimeout(timeoutId);
            const result = await response.json();

            if (result && result.success && result.analysis) {
                updateModalTrendsFromMarkdown(result.analysis, selectedBrgy, selectedYear);
            }
        } catch (err) {
            console.info('AI Trends background sync:', err);
        } finally {
            if (generateBtn) {
                generateBtn.disabled = false;
                generateBtn.innerHTML = '<i class="fas fa-sync-alt text-xs"></i>';
            }
        }
    };

    function formatMarkdown(text) {
        if (!text) return '';
        let raw = text.replace(/```markdown|```/g, '').trim().replace(/\\n/g, '\n');

        const sectionConfigs = {
            'trend': {
                title: 'Trend Analysis',
                subtitle: 'Directional Trajectory & Baseline',
                icon: 'fas fa-chart-line',
                iconColor: 'text-blue-600 dark:text-blue-400',
                badgeBg: 'bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300',
                border: 'border-blue-200/80 dark:border-blue-800/60',
                bg: 'bg-gradient-to-br from-blue-50/90 to-slate-50/50 dark:from-blue-950/20 dark:to-slate-900/40',
                titleColor: 'text-pnp-blue dark:text-blue-300'
            },
            'pattern': {
                title: 'Crime Pattern',
                subtitle: 'Concentration & Key Drivers',
                icon: 'fas fa-bullseye',
                iconColor: 'text-amber-600 dark:text-amber-400',
                badgeBg: 'bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300',
                border: 'border-amber-200/80 dark:border-amber-800/60',
                bg: 'bg-gradient-to-br from-amber-50/80 to-slate-50/50 dark:from-amber-950/20 dark:to-slate-900/40',
                titleColor: 'text-amber-900 dark:text-amber-300'
            },
            'suggestion': {
                title: 'Strategic Suggestions',
                subtitle: 'Law Enforcement Directives',
                icon: 'fas fa-lightbulb',
                iconColor: 'text-emerald-600 dark:text-emerald-400',
                badgeBg: 'bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300',
                border: 'border-emerald-200/80 dark:border-emerald-800/60',
                bg: 'bg-gradient-to-br from-emerald-50/80 to-slate-50/50 dark:from-emerald-950/20 dark:to-slate-900/40',
                titleColor: 'text-emerald-900 dark:text-emerald-300'
            }
        };

        // Match section markers like **Trend**: or ### Trend or Trend: or **Suggestions**:
        const sectionRegex = /(?:^|\n)(?:\#{1,4}\s*|\*{1,2}\s*)?(Trend|Pattern|Suggestions?|Recommendations?)(?:\*{1,2})?\s*[\:\-]?/gi;
        
        let matches = [];
        let match;
        while ((match = sectionRegex.exec(raw)) !== null) {
            matches.push({
                index: match.index,
                length: match[0].length,
                key: match[1].toLowerCase()
            });
        }

        if (matches.length > 0) {
            let cardsHtml = '<div class="grid grid-cols-1 gap-2 my-1 overflow-hidden">';
            
            for (let i = 0; i < matches.length; i++) {
                const cur = matches[i];
                const startPos = cur.index + cur.length;
                const endPos = (i + 1 < matches.length) ? matches[i + 1].index : raw.length;
                let bodyText = raw.substring(startPos, endPos).trim();

                let normalizedKey = 'trend';
                if (cur.key.startsWith('pattern')) normalizedKey = 'pattern';
                else if (cur.key.startsWith('sug') || cur.key.startsWith('rec')) normalizedKey = 'suggestion';

                const config = sectionConfigs[normalizedKey];

                let formattedBody = bodyText
                    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
                    .replace(/^[-*•]\s+(.*?)$/gm, '<li class="ml-2 list-disc marker:text-pnp-gold text-slate-700 dark:text-slate-300 mb-0.5">$1</li>')
                    .replace(/\n\n+/g, '</p><p class="mt-1">')
                    .replace(/\n/g, ' ');

                if (formattedBody.includes('<li')) {
                    formattedBody = `<ul class="my-0.5">${formattedBody}</ul>`;
                } else {
                    formattedBody = `<p>${formattedBody}</p>`;
                }

                cardsHtml += `
                    <div class="p-3 rounded-xl border ${config.border} ${config.bg} shadow-2xs transition-all hover:shadow-xs overflow-hidden break-words">
                        <div class="flex items-center justify-between mb-1 pb-1 border-b border-black/5 dark:border-white/5">
                            <div class="flex items-center gap-2">
                                <span class="w-5 h-5 rounded-lg flex items-center justify-center text-[10px] shadow-2xs ${config.badgeBg}">
                                    <i class="${config.icon} ${config.iconColor}"></i>
                                </span>
                                <div>
                                    <h5 class="text-[10px] font-black uppercase tracking-wider ${config.titleColor}">
                                        ${config.title}
                                    </h5>
                                </div>
                            </div>
                            <span class="text-[8px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 hidden sm:inline">
                                ${config.subtitle}
                            </span>
                        </div>
                        <div class="text-[11px] leading-relaxed text-slate-700 dark:text-slate-300 font-medium pl-0.5 break-words">
                            ${formattedBody}
                        </div>
                    </div>
                `;
            }

            cardsHtml += '</div>';
            return cardsHtml;
        }

        // Standard markdown fallback
        let formatted = raw
            .replace(/^(?:###|##|#)\s+(.*?)$/gm, '<h5 class="text-xs font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-wider mt-2 mb-1 flex items-center gap-1.5"><i class="fas fa-shield-halved text-[10px]"></i> $1</h5>')
            .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
            .replace(/^[-*•]\s+(.*?)$/gm, '<div class="flex items-start gap-1.5 ml-1 mb-1 text-slate-700 dark:text-slate-300"><span class="text-pnp-gold font-bold text-xs">•</span><span>$1</span></div>');

        const blocks = formatted.split(/\n\n+/);
        return blocks.map(b => `<p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300 mb-2 last:mb-0">${b.replace(/\n/g, '<br>')}</p>`).join('');
    }

    // ==========================================
    // CRIME TREND CONTROLS & DIRECTIVES SYNC
    // ==========================================
    window.lastRawMarkdown = null;

    window.refreshAITrends = function() {
        const selectedYear = parseInt(document.getElementById('monthlyTrendYearFilter')?.value || '<%= defaultYearVal %>', 10);
        const selectedBrgy = document.getElementById('monthlyTrendBarangayFilter')?.value || 'ALL';
        window.generateAITrends(selectedBrgy, selectedYear);
    };

    function updateModalKpiSummary(selectedBrgy, selectedYear, monthlyTrends) {
        const scopePoints = points.filter(p => {
            const rawDate = p.incident_date || p.date_committed || p.dateCommitted;
            if (!rawDate) return false;
            if (selectedBrgy !== 'ALL' && p.barangay !== selectedBrgy) return false;
            const pd = new Date(rawDate);
            return pd.getUTCFullYear() === selectedYear;
        });

        const total = scopePoints.length;
        const kpiTotal = document.getElementById('modalKpiTotal');
        if (kpiTotal) kpiTotal.textContent = total;

        const monthCounts = monthlyTrends.map(m => m.total);
        const offenseCounts = {};

        scopePoints.forEach(p => {
            const off = p.incident_type || p.crime_type || 'Unknown';
            offenseCounts[off] = (offenseCounts[off] || 0) + 1;
        });

        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        let maxMonthIdx = 0;
        let maxMonthVal = 0;

        monthCounts.forEach((cnt, idx) => {
            if (cnt > maxMonthVal) {
                maxMonthVal = cnt;
                maxMonthIdx = idx;
            }
        });

        const kpiPeakMonth = document.getElementById('modalKpiPeakMonth');
        const kpiPeakCount = document.getElementById('modalKpiPeakCount');
        if (kpiPeakMonth) kpiPeakMonth.textContent = total > 0 ? FULL_MONTH_NAMES[maxMonthIdx] : 'None';
        if (kpiPeakCount) kpiPeakCount.textContent = total > 0 ? `${maxMonthVal} records (${((maxMonthVal/Math.max(total, 1))*100).toFixed(0)}%)` : '0 records';

        const sortedOffenses = Object.entries(offenseCounts).sort((a, b) => b[1] - a[1]);
        const topOffense = sortedOffenses.length > 0 ? sortedOffenses[0] : ['N/A', 0];
        const kpiTopCrime = document.getElementById('modalKpiTopCrime');
        const kpiTopShare = document.getElementById('modalKpiTopShare');
        if (kpiTopCrime) {
            kpiTopCrime.textContent = topOffense[0];
            kpiTopCrime.title = topOffense[0];
        }
        if (kpiTopShare) {
            const share = total > 0 ? ((topOffense[1] / total) * 100).toFixed(1) : '0';
            kpiTopShare.textContent = `${topOffense[1]} cases (${share}%)`;
        }

        const scopeSubtitle = document.getElementById('modalScopeSubtitle');
        if (scopeSubtitle) {
            const brgyLabel = selectedBrgy === 'ALL' ? 'All Barangays' : `Barangay ${selectedBrgy}`;
            scopeSubtitle.textContent = `Sta. Cruz Municipal Police Station • ${brgyLabel} • Year ${selectedYear}`;
        }
    }

    function updateModalTrendsFromMarkdown(rawMarkdown, selectedBrgy, selectedYear) {
        if (!rawMarkdown) return;
        window.lastRawMarkdown = rawMarkdown;

        const trendEl = document.getElementById('modalTrendText');
        const patternEl = document.getElementById('modalPatternText');
        const suggEl = document.getElementById('modalSuggestionsText');

        let raw = rawMarkdown.replace(/```markdown|```/g, '').trim().replace(/\\n/g, '\n');
        const sectionRegex = /(?:^|\n)(?:\#{1,4}\s*|\*{1,2}\s*)?(Trend|Pattern|Suggestions?|Recommendations?)(?:\*{1,2})?\s*[\:\-]?/gi;
        
        let matches = [];
        let match;
        while ((match = sectionRegex.exec(raw)) !== null) {
            matches.push({
                index: match.index,
                length: match[0].length,
                key: match[1].toLowerCase()
            });
        }

        let parsedSections = { trend: '', pattern: '', suggestion: '' };

        if (matches.length > 0) {
            for (let i = 0; i < matches.length; i++) {
                const cur = matches[i];
                const startPos = cur.index + cur.length;
                const endPos = (i + 1 < matches.length) ? matches[i + 1].index : raw.length;
                let bodyText = raw.substring(startPos, endPos).trim();

                let normalizedKey = 'trend';
                if (cur.key.startsWith('pattern')) normalizedKey = 'pattern';
                else if (cur.key.startsWith('sug') || cur.key.startsWith('rec')) normalizedKey = 'suggestion';

                let formattedBody = bodyText
                    .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>')
                    .replace(/^[-*•]\s+(.*?)$/gm, '<li class="ml-2 list-disc marker:text-pnp-gold text-slate-800 dark:text-slate-100 mb-1">$1</li>')
                    .replace(/\n\n+/g, '</p><p class="mt-2">')
                    .replace(/\n/g, ' ');

                if (formattedBody.includes('<li')) {
                    formattedBody = `<ul class="my-1 space-y-1">${formattedBody}</ul>`;
                } else {
                    formattedBody = `<p class="leading-relaxed">${formattedBody}</p>`;
                }

                parsedSections[normalizedKey] = formattedBody;
            }
        }

        if (trendEl && parsedSections.trend) {
            trendEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.trend}</div>`;
        }
        if (patternEl && parsedSections.pattern) {
            patternEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.pattern}</div>`;
        }
        if (suggEl && parsedSections.suggestion) {
            suggEl.innerHTML = `<div class="text-xs sm:text-sm leading-relaxed text-slate-800 dark:text-slate-100 font-medium">${parsedSections.suggestion}</div>`;
        }
    }

    window.printTrendModalBrief = function() {
        window.print();
    };
</script>



