     window.renderEditTable = function() {
         const tbody = document.getElementById('editTableBody');
         if (!tbody) return;

         const filter = (document.getElementById('editCategoryFilter')?.value) || 'All';
         const data = window.editReportData || [];
         const totalRows = data.length;

         // 1. Instant stats calculation
         let count8 = 0, countNon = 0, countPsi = 0;
         const filteredItems = [];

         for (let i = 0; i < totalRows; i++) {
             const item = data[i];
             const cat = item.category || 'Non-Index';
             if (cat === '8-Focus') count8++;
             else if (cat === 'PSI') countPsi++;
             else countNon++;

             if (filter === 'All' || cat === filter) {
                 filteredItems.push({ item, origIndex: i });
             }
         }

         // Update header and footer indicators
         const rowCountSubtitle = document.getElementById('editRowCountSubtitle');
         if (rowCountSubtitle) rowCountSubtitle.textContent = `${totalRows} Records In Batch`;

         const totalRowIndicator = document.getElementById('editTotalRowIndicator');
         if (totalRowIndicator) totalRowIndicator.textContent = `${totalRows} Total Rows`;

         const elCount8 = document.getElementById('editCount8Focus');
         if (elCount8) elCount8.textContent = count8;

         const elCountNon = document.getElementById('editCountNonIndex');
         if (elCountNon) elCountNon.textContent = countNon;

         const elCountPsi = document.getElementById('editCountPSI');
         if (elCountPsi) elCountPsi.textContent = countPsi;

         // 2. Pagination calculation (50 rows/page for smooth 60fps rendering)
         const pageSize = window.editPageSize || 50;
         const totalPages = Math.max(1, Math.ceil(filteredItems.length / pageSize));
         if (window.editCurrentPage > totalPages) window.editCurrentPage = totalPages;
         if (window.editCurrentPage < 1) window.editCurrentPage = 1;

         const btnPrev = document.getElementById('btnEditPrev');
         const btnNext = document.getElementById('btnEditNext');
         const pageText = document.getElementById('editPaginationPageText');

         if (btnPrev) btnPrev.disabled = (window.editCurrentPage <= 1);
         if (btnNext) btnNext.disabled = (window.editCurrentPage >= totalPages);
         if (pageText) {
             pageText.textContent = `Page ${window.editCurrentPage} of ${totalPages} (${filteredItems.length} rows)`;
         }

         // 3. Current page slice
         const startIndex = (window.editCurrentPage - 1) * pageSize;
         const pageSlice = filteredItems.slice(startIndex, startIndex + pageSize);

         if (pageSlice.length === 0) {
             tbody.innerHTML = `<tr><td colspan="7" class="py-12 text-center text-slate-400 font-bold uppercase tracking-wider text-xs">No records matching classification "${filter}"</td></tr>`;
             return;
         }

         const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
         const years = ['2026', '2025', '2024'];

         let rowsHtml = '';
         for (let p = 0; p < pageSlice.length; p++) {
             const { item, origIndex } = pageSlice[p];
             const displayNum = startIndex + p + 1;
             const cat = item.category || 'Non-Index';
             const isFocus = cat === '8-Focus';
             const isPSI = cat === 'PSI';
             const badgeClass = isFocus ? 'bg-red-500/10 text-red-500' : isPSI ? 'bg-blue-500/10 text-blue-500' : 'bg-slate-500/10 text-slate-500';
             const offenseValue = (item.offense || item.incident_type || '').replace(/"/g, '&quot;');
             const datalistId = isFocus ? 'editCrimes_8Focus' : (isPSI ? 'editCrimes_PSI' : 'editCrimes_NonIndex');

             const rawDateStr = item.date_committed || item.incident_date || item.date || new Date().toISOString().split('T')[0];
             const dateParts = rawDateStr.split('-');
             const itemYear = dateParts[0] || '2026';
             const itemMonth = dateParts[1] || '01';
             const itemDay = dateParts[2] || '01';

             // Barangay options
             let brgyOpts = '';
             for (let b = 0; b < VALID_BARANGAYS.length; b++) {
                 const bName = VALID_BARANGAYS[b];
                 brgyOpts += `<option value="${bName}" ${bName === item.barangay ? 'selected' : ''} class="dark:bg-slate-900">${bName}</option>`;
