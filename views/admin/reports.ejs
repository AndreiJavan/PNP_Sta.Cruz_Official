            paginationTheme = 'bg-rose-50/70 dark:bg-rose-950/40 border-rose-200 dark:border-rose-900/50';
        } else if (category === 'Non-Index') {
            // Non-Index: Blue theme
            headerTheme = 'bg-blue-50/80 dark:bg-blue-950/30 border-blue-200 dark:border-blue-900/50';
            cardTheme = 'bg-blue-50/30 dark:bg-slate-800/95 border-blue-200 dark:border-blue-900/50 shadow-blue-100/30 dark:shadow-none';
            theadTheme = 'bg-blue-100/70 dark:bg-blue-950/60 border-blue-200 dark:border-blue-900/50 text-blue-900 dark:text-blue-300';
            rowHoverTheme = 'hover:bg-blue-50/80 dark:hover:bg-blue-900/25';
            rowBorderTheme = 'border-l-4 border-l-blue-500';
            paginationTheme = 'bg-blue-50/70 dark:bg-blue-950/40 border-blue-200 dark:border-blue-900/50';
        } else if (category === 'PSI') {
            // PSI: Yellow / Amber theme
            headerTheme = 'bg-amber-50/80 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/50';
            cardTheme = 'bg-amber-50/30 dark:bg-slate-800/95 border-amber-200 dark:border-amber-900/50 shadow-amber-100/30 dark:shadow-none';
            theadTheme = 'bg-amber-100/70 dark:bg-amber-950/60 border-amber-200 dark:border-amber-900/50 text-amber-900 dark:text-amber-300';
            rowHoverTheme = 'hover:bg-amber-50/80 dark:hover:bg-amber-900/25';
            rowBorderTheme = 'border-l-4 border-l-amber-500';
            paginationTheme = 'bg-amber-50/70 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900/50';
        } else {
            // Default / ALL: Pure White theme
            headerTheme = 'bg-white dark:bg-slate-900 border-gray-200 dark:border-slate-800';
            cardTheme = 'bg-white dark:bg-slate-800/95 border-gray-200 dark:border-slate-800 shadow-sm';
            theadTheme = 'bg-gray-50/90 dark:bg-slate-900 border-gray-200 dark:border-slate-800 text-slate-700 dark:text-slate-300';
            rowHoverTheme = 'hover:bg-gray-50/80 dark:hover:bg-slate-700/50';
            rowBorderTheme = 'border-l-4 border-l-slate-300 dark:border-l-slate-600';
