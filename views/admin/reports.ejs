                                 ${dayOpts}
                             </select>
                             <span class="text-slate-400 font-bold text-[10px]">/</span>
                             <select onchange="updateEditItemDate(${origIndex}, 'month', this.value)" title="Month" class="w-16 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg text-[10px] font-black text-slate-800 dark:text-white px-1 py-1.5 outline-none focus:ring-1 focus:ring-pnp-blue cursor-pointer text-center">
