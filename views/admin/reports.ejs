                         <select onchange="updateEditItem(${origIndex}, 'barangay', this.value)" class="w-full h-full bg-transparent border-none text-[11px] font-black text-slate-700 dark:text-white uppercase outline-none focus:ring-0 p-4 cursor-pointer">
                             ${brgyOpts}
                         </select>
                     </td>
                     <td class="px-2 py-2 border-r border-gray-100 dark:border-slate-800 focus-within:bg-pnp-blue/5 transition-colors w-56">
                         <div class="flex items-center space-x-1 justify-center">
