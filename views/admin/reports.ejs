     window.confirmManualEntry = async function() {
         if (!manualData || manualData.length === 0) {
             await window.strategicAlert({
                 title: "No Data",
                 message: "There are no manual records to synchronize. Please enter at least one record.",
                 type: "warning"
             });
             return;
         }

         // Normalize barangays
         for (let i = 0; i < manualData.length; i++) {
             const r = manualData[i];
             if (r.barangay) {
                 const cleanB = String(r.barangay).trim();
                 const matchedB = VALID_BARANGAYS.find(b => 
                     b.toLowerCase() === cleanB.toLowerCase() ||
                     b.toLowerCase() === cleanB.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase() ||
                     cleanB.toLowerCase().includes(b.toLowerCase())
                 );
                 if (matchedB) r.barangay = matchedB;
             }
         }

         // Validate all rows
         const uncorrectedRows = [];
         manualData.forEach((r, idx) => {
             const issues = window.checkRecordIssues(r);
             if (issues.length > 0) {
                 uncorrectedRows.push({ rowNumber: idx + 1, issues });
             }
         });

         if (uncorrectedRows.length > 0) {
             let errorWarningMessage = `Validation Block: There are ${uncorrectedRows.length} row(s) containing errors that are not applicable to continue:\n`;
             uncorrectedRows.slice(0, 10).forEach(item => {
                 const issueDescriptions = item.issues.map(iss => `${iss.label}: ${iss.msg}`).join(', ');
                 errorWarningMessage += `\n• Row #${item.rowNumber}: ${issueDescriptions}`;
             });
             if (uncorrectedRows.length > 10) {
                 errorWarningMessage += `\n• ...and ${uncorrectedRows.length - 10} more row(s).`;
             }
             errorWarningMessage += `\n\nPlease resolve all highlighted fields before continuing.`;

             await (window.strategicAlert || (async (opts) => alert(opts.message)))({
                 title: "Cannot Continue: Errors Detected",
                 message: errorWarningMessage,
                 type: "warning"
             });

             const firstInvalid = document.querySelector('#manualTableBody tr.has-error');
             if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
             return;
         }

         const confirmed = await (window.strategicConfirm || (async () => confirm(`Commit ${manualData.length} manual records to the CPICRS Central Database?`)))({
             title: "Manual Dataset Confirmation",
             message: `Commit ${manualData.length} verified manual records to the CPICRS Central Database?\n\nSelect 'Confirm' to synchronize or 'Cancel' to review.`,
             confirmText: "Confirm",
             cancelText: "Cancel",
             type: "info"
         });
         if (!confirmed) return;

         const syncBtn = document.getElementById('btnConfirmManual') || document.querySelector('button[onclick="confirmManualEntry()"]');
         const originalContent = syncBtn ? syncBtn.innerHTML : '';
         if (syncBtn) {
             syncBtn.disabled = true;
             syncBtn.classList.add('opacity-50', 'cursor-not-allowed');
             syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Syncing...';
         }

         try {
             const response = await fetch('/admin/reports/save', {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({ 
                    entries: manualData, 
                    filename: 'Manual Entry Session',
                    entryType: 'manual' 
                 })
             });
             const result = await response.json();

             if (result.success) {
                 closeManualEntry();
                 const alertFn = window.strategicAlert || (async ({ message }) => alert(message));
                 await alertFn({
                     title: "Sync Successful",
                     message: `Archive Updated: ${result.count} manual records committed.`,
                     type: "success"
                 });
                 const urlParams = new URLSearchParams(window.location.search);
                 if (urlParams.get('return_to') === 'map') {
                     window.location.href = '/admin/map';
                 } else {
                     location.reload();
                 }
             } else {
                 await window.strategicAlert({
                     title: "Sync Error",
                     message: result.error || "Failed to commit manual records.",
                     type: "error"
                 });
                 if (syncBtn) {
                     syncBtn.disabled = false;
                     syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                     syncBtn.innerHTML = originalContent;
                 }
             }
         } catch (err) {
             console.error("Sync Error:", err);
             await window.strategicAlert({
                 title: "System Error",
                 message: "Network or server failure during data synchronization.",
                 type: "error"
             });
             if (syncBtn) {
                 syncBtn.disabled = false;
                 syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                 syncBtn.innerHTML = originalContent;
             }
         }
     };

