    window.reports = <%- JSON.stringify(displayReports) %>;
    const allIncidents = <%- JSON.stringify(displayIncidents) %>;

    const allColors = {
        'Murder': '#EF4444', 'Homicide': '#F87171', 'Physical Injuries': '#10B981', 'Rape': '#A855F7', 'Carnapping (Motorcycle)': '#F59E0B',
        'Carnapping (Motor Vehicle)': '#F97316', 'Violence Against Women and Children (VAWC)': '#E11D48',
        'Cybercrime': '#3B82F6', 'Estafa': '#0891B2', 'Swindling / Fraud': '#06B6D4',
        'Drug Possession': '#059669', 'Drug Sale': '#10B981', 'Drug Use': '#34D399',
        'Illegal Gambling': '#7C3AED', 'Illegal Possession of Firearms': '#475569',
        'Human Trafficking': '#DB2777', 'Child Abuse (RA 7610)': '#F43F5E', 'Damage to Property': '#B45309',
        'Malicious Mischief': '#D97706', 'Cybercrime (Online Fraud, Hacking, Identity Theft, Cyber Libel)': '#2563EB',
        'Illegal Recruitment': '#9333EA', 'Ordinance Violations': '#94A3B8', 'Grave Threats': '#64748B',
        'Alarm and Scandal': '#CBD5E1', 'Vehicular Accident': '#2563EB', 'Road Accident / Traffic Incident': '#1D4ED8',
        'Fire Incident': '#EA580C', 'Flood Incident': '#3B82F6', 'Earthquake Incident': '#78350F',
        'Landslide Incident': '#451A03', 'Disaster Incident Reports': '#4B5563', 'Public Disturbance Incident': '#4338CA',
        'Emergency Response Incident': '#0891B2', 'Missing Person Report': '#0D9488', 'Rescue Operation Cases': '#059669'
    };

    function getTacticalColor(name) {
        if (!name) return '#94A3B8';
        const searchName = name.trim().toUpperCase();
        for (const [key, color] of Object.entries(allColors)) {
            if (key.toUpperCase() === searchName) return color;
        }
        for (const [key, color] of Object.entries(allColors)) {
            if (searchName.includes(key.toUpperCase()) || key.toUpperCase().includes(searchName)) return color;
        }
        return '#94A3B8';
    }

    function updateReportColors() {
        // Find the highest incident in each category from allIncidents
        const categoryCounts = {
            '8-Focus': {},
            'Non-Index': {},
            'PSI': {}
        };
        
        allIncidents.forEach(item => {
            const cat = item.category || 'Non-Index';
            const type = String(item.incident_type || item.offense || 'Unknown').trim().toUpperCase();
            if (type && type !== 'UNKNOWN') {
                if (categoryCounts[cat]) {
                    categoryCounts[cat][type] = (categoryCounts[cat][type] || 0) + 1;
                }
            }
        });

        function getTop(countsObj) {
            let topName = 'NONE';
            let topCount = 0;
            for (const [name, count] of Object.entries(countsObj)) {
                if (count > topCount) {
                    topCount = count;
                    topName = name;
                }
            }
            return { name: topName, count: topCount };
        }

        const top8Focus = getTop(categoryCounts['8-Focus']);
        const topNonIndex = getTop(categoryCounts['Non-Index']);
        const topPSI = getTop(categoryCounts['PSI']);

        const color8Focus = '#EF4444'; // Red
        const colorNonIndex = '#3B82F6'; // Blue
        const colorPSI = '#F59E0B'; // Gold

        // Save in window for global access
        window.categoryHighestColors = {
            '8-Focus': color8Focus,
            'Non-Index': colorNonIndex,
            'PSI': colorPSI
        };

        // Update top cards dynamic borders and text colors
        const card8 = document.getElementById('statsCard_8Focus');
        const label8 = document.getElementById('statsLabel_8Focus');
        const count8 = document.getElementById('statsCount_8Focus');
        if (card8) card8.style.borderColor = `${color8Focus}40`;
        if (label8) label8.style.color = color8Focus;
        if (count8) {
            count8.style.color = color8Focus;
            count8.style.textShadow = `0 0 10px ${color8Focus}30`;
        }

        const cardNon = document.getElementById('statsCard_NonIndex');
        const labelNon = document.getElementById('statsLabel_NonIndex');
        const countNon = document.getElementById('statsCount_NonIndex');
        if (cardNon) cardNon.style.borderColor = `${colorNonIndex}40`;
        if (labelNon) labelNon.style.color = colorNonIndex;
        if (countNon) {
            countNon.style.color = colorNonIndex;
            countNon.style.textShadow = `0 0 10px ${colorNonIndex}30`;
        }

        const cardPSI = document.getElementById('statsCard_PSI');
        const labelPSI = document.getElementById('statsLabel_PSI');
        const countPSI = document.getElementById('statsCount_PSI');
        if (cardPSI) cardPSI.style.borderColor = `${colorPSI}40`;
        if (labelPSI) labelPSI.style.color = colorPSI;
        if (countPSI) {
            countPSI.style.color = colorPSI;
            countPSI.style.textShadow = `0 0 10px ${colorPSI}30`;
        }

        // Also style Intelligence Review category counts dots if they exist
        const dot8 = document.getElementById('reviewDot_8Focus');
        if (dot8) { dot8.style.backgroundColor = color8Focus; dot8.style.boxShadow = `0 0 8px ${color8Focus}`; }
        const dotNon = document.getElementById('reviewDot_NonIndex');
        if (dotNon) { dotNon.style.backgroundColor = colorNonIndex; dotNon.style.boxShadow = `0 0 8px ${colorNonIndex}`; }
        const dotPSI = document.getElementById('reviewDot_PSI');
        if (dotPSI) { dotPSI.style.backgroundColor = colorPSI; dotPSI.style.boxShadow = `0 0 8px ${colorPSI}`; }
    }

    // Call updateReportColors on load
    document.addEventListener('DOMContentLoaded', () => {
        updateReportColors();
    });

    window.filterDataset = function(category) {
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.classList.remove('bg-pnp-blue', 'text-white', 'shadow-lg');
            tab.classList.add('text-gray-400', 'hover:text-pnp-blue');
        });
        const activeTab = document.getElementById(`tab-${category}`);
        if (activeTab) activeTab.classList.add('bg-pnp-blue', 'text-white', 'shadow-lg');

        document.querySelectorAll('.incident-row').forEach(row => {
            row.style.display = (category === 'all' || row.dataset.category === category) ? '' : 'none';
        });
    }

    window.openStatsSpreadsheet = function(category) {
        window.isGlobalStats = true;
        window.currentStatsCategory = category || 'All';
        window.currentStatsClassification = 'All'; // Reset classification filter on tab change
        window.statsCurrentPage = 1;
        window.renderGlobalStatsModalContent();
    };

    window.changeStatsPage = function(delta) {
        window.statsCurrentPage = (window.statsCurrentPage || 1) + delta;
        window.renderGlobalStatsModalContent();
        const content = document.getElementById('reportDetailsContent');
        if (content) content.scrollTop = 0;
    };

    window.renderGlobalStatsModalContent = function() {
        if (!window.currentStatsBarangay) window.currentStatsBarangay = 'All Barangays';
        if (!window.currentStatsClassification) window.currentStatsClassification = 'All';
        const category = window.currentStatsCategory || 'All';
        
        // Base incidents filtered by sector
        let baseData = window.currentStatsBarangay === 'All Barangays' 
            ? (typeof allIncidents !== 'undefined' ? allIncidents : []) 
            : (typeof allIncidents !== 'undefined' ? allIncidents : []).filter(item => item.barangay === window.currentStatsBarangay);
        
        // Filter by category: support 'All', '8-Focus', 'Non-Index', 'PSI'
        let filteredData = category === 'All' ? baseData : baseData.filter(item => (item.category || 'Non-Index') === category);
        
        // Dynamic Classification Filter Options base on current category & sector data
        const existingOffenses = new Set();
        filteredData.forEach(item => {
            const off = item.incident_type || item.offense;
            if (off) existingOffenses.add(off);
        });
        const combinedOffenses = Array.from(existingOffenses).sort();

        // Check if previously selected classification is still valid, if not default to 'All'
        if (window.currentStatsClassification !== 'All' && !existingOffenses.has(window.currentStatsClassification)) {
            window.currentStatsClassification = 'All';
        }

        // Apply classification filtering
        let displayData = filteredData;
        if (window.currentStatsClassification !== 'All') {
            displayData = filteredData.filter(item => {
                const off = item.incident_type || item.offense || '';
                return off.toUpperCase() === window.currentStatsClassification.toUpperCase();
            });
        }

        const content = document.getElementById('reportDetailsContent');
        
        // Stats for the header tabs
        const stats = {
            'All': baseData.length,
            '8-Focus': baseData.filter(item => item.category === '8-Focus').length,
            'Non-Index': baseData.filter(item => item.category === 'Non-Index').length,
            'PSI': baseData.filter(item => item.category === 'PSI').length
        };

        // Container colors:
        // Default / ALL: Pure White
        // 8-Focus: Red
        // Non-Index: Blue
        // PSI: Yellow
