    window.getCategoryExamples = function(cat) {
        if (cat === '8-Focus') {
            return "Murder, Homicide, Physical Injuries, Rape, Robbery, Theft, Carnapping (Motorcycle), Carnapping (Motor Vehicle)";
        } else if (cat === 'Non-Index') {
            return "VAWC (RA 9262), Drugs (RA 9165), Cybercrime, Estafa, Qualified Theft, Child Abuse (RA 7610), Firearms (RA 10591), Gambling, Malicious Mischief, Local Ordinances, etc.";
        } else if (cat === 'PSI') {
            return "Vehicular Accident, RIR - Damage to Property, RIR - Physical Injuries, RIR - Homicide, Hit and Run, Traffic Collisions, etc.";
        } else if (cat === 'All') {
