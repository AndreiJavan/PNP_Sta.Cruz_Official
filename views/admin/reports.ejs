                             class="w-full h-full bg-transparent border-none text-[11px] font-black text-pnp-blue dark:text-pnp-gold uppercase focus:ring-0 p-4 outline-none">
                     </td>
                     <td class="px-0 py-0 border-r border-gray-100 dark:border-slate-800 focus-within:bg-pnp-blue/5 transition-colors w-36">
                         <select onchange="updateEditItem(${origIndex}, 'category', this.value)" class="w-full h-full bg-transparent border-none text-[10px] font-black uppercase tracking-widest ${badgeClass} outline-none focus:ring-0 p-4 cursor-pointer">
                             <option value="8-Focus" ${cat === '8-Focus' ? 'selected' : ''} class="text-red-500">8-Focus</option>
                             <option value="Non-Index" ${cat === 'Non-Index' ? 'selected' : ''} class="text-slate-500">Non-Index</option>
                             <option value="PSI" ${cat === 'PSI' ? 'selected' : ''} class="text-blue-500" title="PUBLIC SAFETY INCIDENT">PSI</option>
                         </select>
                     </td>
                     <td class="px-2 py-0 text-center w-16">
                         <button type="button" onclick="deleteEditRow(${origIndex})" class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-900/20 text-red-400 hover:bg-red-500 hover:text-white transition-all flex items-center justify-center mx-auto opacity-70 hover:opacity-100 scale-90 hover:scale-100" title="Delete Row">
