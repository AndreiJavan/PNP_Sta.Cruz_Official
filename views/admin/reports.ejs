     window.showIntelReview = function(data, filename = "") {
         scannerData = Array.isArray(data) ? data.map(item => {
             const cleanOff = String(item.offense || item.incident_type || '').trim().slice(0, 300);
             return {
                 ...item,
                 offense: cleanOff
             };
         }) : [];

         // Automatically sort rows with errors to the top
         scannerData.sort((a, b) => {
             const aIssues = window.checkRecordIssues(a).length;
             const bIssues = window.checkRecordIssues(b).length;
             if (aIssues > 0 && bIssues === 0) return -1;
             if (bIssues > 0 && aIssues === 0) return 1;
             return 0;
         });

         currentFilename = (filename || '').slice(0, 100);
         currentEntryType = "scanned";
         reviewData = scannerData;
         
         const modal = document.getElementById('scannerReviewModal');
         if (modal) {
             renderScannerTable();
             modal.classList.remove('hidden');
             modal.classList.add('flex');
         }
     };

     window.closeScannerReview = function() {
         const modal = document.getElementById('scannerReviewModal');
         if (modal) {
             modal.classList.add('hidden');
             modal.classList.remove('flex');
         }
     };

     window.addNewScannerRow = function(insertIndex = null) {
         const todayStr = new Date().toISOString().split('T')[0];
         const newRow = {
             barangay: VALID_BARANGAYS[0],
             date_committed: todayStr,
             offense: '',
             category: 'Non-Index',
             description: ''
         };
         if (insertIndex !== null && typeof insertIndex === 'number' && insertIndex >= 0 && insertIndex <= scannerData.length) {
             scannerData.splice(insertIndex, 0, newRow);
         } else {
             scannerData.push(newRow);
         }
         reviewData = scannerData;
         renderScannerTable();
         setTimeout(() => {
             const tbody = document.getElementById('scannerTableBody');
             const container = tbody ? tbody.closest('.overflow-auto') : null;
             if (container) {
                 container.scrollTop = container.scrollHeight;
             }
         }, 50);
     };

     window.deleteScannerRow = function(index) {
         scannerData.splice(index, 1);
         reviewData = scannerData;
         renderScannerTable();
     };

