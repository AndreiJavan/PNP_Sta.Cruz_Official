                                <span class="text-[9px] font-black uppercase tracking-wider leading-none mb-0.5 cursor-help ${category === 'PSI' ? 'opacity-90' : 'text-amber-500'}" title="PUBLIC SAFETY INCIDENT">PSI</span>
