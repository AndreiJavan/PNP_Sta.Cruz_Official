     window.addNewEditSingleRow = function(insertIndex = null) {
         const todayStr = new Date().toISOString().split('T')[0];
         const newRow = {
             barangay: VALID_BARANGAYS[0],
             date_committed: todayStr,
             offense: '',
             category: 'Non-Index',
             description: ''
         };
         const pageSize = window.editPageSize || 50;
         if (insertIndex !== null && typeof insertIndex === 'number' && insertIndex >= 0 && insertIndex <= window.editReportData.length) {
             window.editReportData.splice(insertIndex, 0, newRow);
             window.editCurrentPage = Math.max(1, Math.ceil((insertIndex + 1) / pageSize));
         } else {
             window.editReportData.push(newRow);
             window.editCurrentPage = Math.max(1, Math.ceil(window.editReportData.length / pageSize));
         }
         window.renderEditTable();
         setTimeout(() => {
             const tbody = document.getElementById('editTableBody');
             const container = tbody ? tbody.closest('.overflow-auto') : null;
             if (container) {
                 container.scrollTop = container.scrollHeight;
             }
         }, 50);
     };

     window.insertEditRowAt = function(index) {
         window.addNewEditSingleRow(index);
     };

     window.deleteEditRow = function(index) {
         if (window.editReportData.length <= 1) {
             window.strategicAlert({
                 title: "Minimum Row Required",
                 message: "A batch must contain at least one record. You can edit this row instead of deleting it.",
                 type: "warning"
             });
             return;
         }
         window.editReportData.splice(index, 1);
         window.renderEditTable();
     };

     window.updateEditItem = function(index, field, value) {
         const todayStr = new Date().toISOString().split('T')[0];
         if (field === 'date_committed') {
             if (value && value > todayStr) {
                 window.strategicAlert({
                     title: "Invalid Timeline Date",
                     message: `Future dates are restricted. The maximum allowed date is today (${todayStr}).`,
                     type: "warning"
                 });
                 value = todayStr;
             } else if (value && value < '2024-01-01') {
                 window.strategicAlert({
                     title: "Invalid Timeline Date",
                     message: "Selectable date range cannot be prior to January 1, 2024.",
                     type: "warning"
                 });
                 value = '2024-01-01';
             }
         }

         if (!window.editReportData[index]) return;
         window.editReportData[index][field] = value;

         if (field === 'category') {
             window.editReportData[index].offense = '';
             window.renderEditTable();
         }
     };

     window.updateEditItemDate = function(index, part, value) {
         if (!window.editReportData[index]) return;
         const rawDateStr = window.editReportData[index].date_committed || window.editReportData[index].date || new Date().toISOString().split('T')[0];
         const parts = rawDateStr.split('-');
         let y = parts[0] || '2026';
         let m = parts[1] || '01';
         let d = parts[2] || '01';

         if (part === 'day') d = String(value).padStart(2, '0');
         if (part === 'month') m = String(value).padStart(2, '0');
         if (part === 'year') y = String(value);

         const newDate = `${y}-${m}-${d}`;
         window.editReportData[index].date_committed = newDate;
         window.editReportData[index].date = newDate;
     };

     window.saveEditReport = async function() {
         const saveBtn = document.getElementById('btnSaveEditReport');
         if (saveBtn && saveBtn.disabled) return;

         if (!window.editingReportId) {
             window.strategicAlert({
                 title: "Missing Batch Identifier",
                 message: "No report batch is currently targeted for modification.",
                 type: "warning"
             });
             return;
         }

         if (!window.editReportData || window.editReportData.length === 0) {
             window.strategicAlert({
                 title: "Empty Batch",
                 message: "A batch must contain at least one record to be saved.",
                 type: "warning"
             });
             return;
         }

         // Check if user changed anything in the batch
         const currentFilename = (document.getElementById('editBatchFilename')?.value || '').trim();
         const currentEntries = (window.editReportData || []).map(e => ({
             barangay: (e.barangay || '').trim(),
             date_committed: (e.date_committed || e.date || '').trim(),
             offense: (e.offense || '').trim(),
             category: (e.category || '').trim(),
             description: (e.description || '').trim()
         }));
         const currentSnapshot = JSON.stringify({
             filename: currentFilename,
             entries: currentEntries
         });

         if (window.initialEditReportSnapshot && currentSnapshot === window.initialEditReportSnapshot) {
             await window.strategicAlert({
                 title: "No Changes Detected",
                 message: "No modifications were made to this batch. The record batch was not re-saved or reloaded.",
                 confirmText: "Confirm",
                 cancelText: "Cancel",
                 type: "info"
             });
             window.closeEditReportModal();
             return;
         }

         const todayStr = new Date().toISOString().split('T')[0];
         const validCategories = ['8-Focus', 'Non-Index', 'PSI'];

         for (let i = 0; i < window.editReportData.length; i++) {
             const r = window.editReportData[i];
             const rowNum = i + 1;

             if (!r.barangay || !String(r.barangay).trim()) {
                 await window.strategicAlert({
                     title: "Validation Failure",
                     message: `Row #${rowNum}: Sector / Barangay is missing. Please select a valid Barangay before saving.`,
                     type: "warning"
                 });
                 return;
             }

             const cleanB = String(r.barangay).trim();
             const matchedB = VALID_BARANGAYS.find(b => 
                 b.toLowerCase() === cleanB.toLowerCase() ||
                 b.toLowerCase() === cleanB.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase() ||
                 cleanB.toLowerCase().includes(b.toLowerCase())
             );
             if (matchedB) {
                 r.barangay = matchedB;
             }

             if (!VALID_BARANGAYS.includes(r.barangay)) {
                 await window.strategicAlert({
                     title: "Invalid Sector",
                     message: `Row #${rowNum}: "${r.barangay}" is not a recognized Santa Cruz Barangay.`,
                     type: "warning"
                 });
                 return;
             }

             const rawDate = (r.date_committed || r.incident_date || r.date || '').trim();
             if (!rawDate || !/^\d{4}-\d{2}-\d{2}$/.test(rawDate) || isNaN(new Date(rawDate).getTime())) {
                 await window.strategicAlert({
                     title: "Invalid Timeline Date",
                     message: `Row #${rowNum}: Invalid date format. Please check the day, month, and year.`,
                     type: "warning"
                 });
                 return;
             }

             if (rawDate > todayStr) {
                 await window.strategicAlert({
                     title: "Future Date Restricted",
                     message: `Row #${rowNum}: Timeline date (${rawDate}) cannot be in the future.`,
                     type: "warning"
                 });
                 return;
             }

             if (rawDate < '2024-01-01') {
                 await window.strategicAlert({
                     title: "Historical Boundary",
                     message: `Row #${rowNum}: Timeline date cannot precede January 1, 2024.`,
                     type: "warning"
                 });
                 return;
             }

             const offenseVal = (r.offense || r.incident_type || '').replace(/\s+/g, ' ').trim();
             if (!offenseVal || offenseVal.length < 2) {
                 await window.strategicAlert({
                     title: "Incomplete Classification",
                     message: `Row #${rowNum}: Crime classification / offense cannot be empty or blank spaces (minimum 2 characters).`,
                     type: "warning"
                 });
                 return;
             }

             if (offenseVal.length > 300) {
                 await window.strategicAlert({
                     title: "Classification Too Long",
                     message: `Row #${rowNum}: Classification exceeds 300 letters limit (currently: ${offenseVal.length} letters). Please shorten it.`,
                     type: "warning"
                 });
                 return;
             }

             const editWords = offenseVal.split(' ').filter(Boolean);
             if (editWords.length > 50) {
                 await window.strategicAlert({
                     title: "Classification Word Limit Exceeded",
                     message: `Row #${rowNum}: Classification exceeds 50 words limit (currently: ${editWords.length} words).`,
                     type: "warning"
                 });
                 return;
             }

             for (const w of editWords) {
                 const cleanW = w.replace(/[^a-zA-Z0-9ñÑ]/g, '');
                 if (!cleanW || cleanW.length <= 3 || /^[\d\.\-\/]+$/.test(cleanW) || /\d/.test(cleanW) || /^[ivxlcdm]+$/i.test(cleanW)) continue;
                 const recognized = ['PNP', 'MPS', 'RIR', 'PSI', 'RA', 'PD', 'BP', 'RPC', 'VAWC', 'WCPD'];
                 if (recognized.includes(cleanW.toUpperCase())) continue;
                 const lettersOnly = cleanW.replace(/[^a-zA-ZñÑ]/g, '');
                 if (lettersOnly.length >= 4 && !/[aeiouy]/i.test(lettersOnly)) {
                     await window.strategicAlert({
                         title: "Unworkable Classification Word",
                         message: `Row #${rowNum}: "${w}" does not appear to be a workable or recognizable word.`,
                         type: "warning"
                     });
                     return;
                 }
             }

             const categoryVal = r.category || 'Non-Index';
             if (!validCategories.includes(categoryVal)) {
                 await window.strategicAlert({
                     title: "Invalid Category",
                     message: `Row #${rowNum}: Category must be 8-Focus, Non-Index, or PSI.`,
                     type: "warning"
                 });
                 return;
             }
         }

         const confirmed = await (window.strategicConfirm || (async () => confirm(`Save changes to this batch (${window.editReportData.length} records)?`)))({
             title: "Confirm Batch Update",
             message: `Save changes and regenerate tactical map coordinates for ${window.editReportData.length} records?`,
             confirmText: "Confirm",
             cancelText: "Cancel",
             type: "info"
         });
         if (!confirmed) return;

         const originalBtnContent = saveBtn ? saveBtn.innerHTML : '';
         if (saveBtn) {
             saveBtn.disabled = true;
             saveBtn.classList.add('opacity-50', 'cursor-not-allowed');
             saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Saving...';
         }

         try {
             const filenameInput = document.getElementById('editBatchFilename');
             const batchFilename = filenameInput ? filenameInput.value.trim() : '';

             if (batchFilename.length > 100) {
                 await window.strategicAlert({
                     title: "Batch Name Too Long",
                     message: `Batch / File Name cannot exceed 100 characters (currently: ${batchFilename.length} letters).`,
                     type: "warning"
                 });
                 if (saveBtn) {
                     saveBtn.disabled = false;
                     saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                     saveBtn.innerHTML = originalBtnContent;
                 }
                 return;
             }

             const filenameWords = batchFilename.split(/\s+/).filter(Boolean);
             if (filenameWords.length > 15) {
                 await window.strategicAlert({
                     title: "Batch Name Word Limit Exceeded",
                     message: `Batch / File Name cannot exceed 15 words (currently: ${filenameWords.length} words).`,
                     type: "warning"
                 });
                 if (saveBtn) {
                     saveBtn.disabled = false;
                     saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                     saveBtn.innerHTML = originalBtnContent;
                 }
                 return;
             }

             const response = await fetch(`/admin/reports/${window.editingReportId}/update`, {
                 method: 'POST',
                 headers: { 'Content-Type': 'application/json' },
                 body: JSON.stringify({
                     filename: batchFilename,
                     entries: window.editReportData
                 })
             });

             const result = await response.json();

             if (result.success) {
                 if (typeof window.closeEditReportModal === 'function') {
                     window.closeEditReportModal();
                 }
                 const alertFn = window.strategicAlert || (async ({ message }) => alert(message));
                 await alertFn({
                     title: "Update Successful",
                     message: `Batch updated successfully: ${result.total || window.editReportData.length} records synchronized.`,
                     type: "success"
                 });
                 window.location.reload();
             } else {
                 throw new Error(result.message || "Failed to update record batch.");
             }
         } catch (err) {
             window.strategicAlert({
                 title: "Update Error",
                 message: err.message || "An error occurred while saving the report batch.",
                 type: "danger"
             });
             if (saveBtn) {
                 saveBtn.disabled = false;
                 saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                 saveBtn.innerHTML = originalBtnContent;
             }
         }
     };

     let currentReportPage = 1;
     const reportsPerPage = 5;
     let reportClickTimer = null;

     window.handleReportRowClick = function(event, reportId) {
         if (event && event.target && (event.target.closest('form') || event.target.closest('button'))) return;
         window.viewReportDetails(reportId);
     };

     window.handleReportRowDblClick = function(event, reportId, barangay = '') {
         if (event && event.target && (event.target.closest('form') || event.target.closest('button'))) return;
         let targetUrl = `/admin/map?report_id=${reportId}`;
         if (barangay && barangay !== 'undefined') targetUrl += `&barangay=${barangay}`;
         window.location.href = targetUrl;
     };

     window.changeReportsPage = function(delta) {
         currentReportPage += delta;
         renderReportsTable();
     };

     window.navigateToMapForCrime = function(barangay, offense, lat, lng, reportId) {
         const params = new URLSearchParams();
         if (barangay && barangay !== 'undefined') params.append('barangay', decodeURIComponent(barangay));
         if (offense && offense !== 'undefined') params.append('offense', decodeURIComponent(offense));
         if (lat && lat !== 'undefined') params.append('lat', lat);
         if (lng && lng !== 'undefined') params.append('lng', lng);
         if (reportId && reportId !== 'undefined') params.append('report_id', reportId);
         window.location.href = `/admin/map?${params.toString()}`;
     };

     window.renderReportsTable = function() {
         const tbody = document.querySelector('tbody.divide-y');
         if (!tbody) return;

         const searchVal = (document.getElementById('reportSearchInput')?.value || '').toLowerCase().trim();
         
         const reportsList = window.reports || (typeof reports !== 'undefined' ? reports : []);
         const filteredReports = reportsList.filter(r => {
             if (!searchVal) return true;
             const filename = (r.filename || '').toLowerCase();
             const adminName = (r.admin_name || '').toLowerCase();
             return filename.includes(searchVal) || adminName.includes(searchVal);
         }).sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());

         const totalItems = filteredReports.length;
         const totalPages = Math.ceil(totalItems / reportsPerPage) || 1;

         if (currentReportPage > totalPages) currentReportPage = totalPages;
         if (currentReportPage < 1) currentReportPage = 1;

         const startIndex = (currentReportPage - 1) * reportsPerPage;
         const pageReports = filteredReports.slice(startIndex, startIndex + reportsPerPage);

         // Update Pagination UI Labels
         const rangeTextEl = document.getElementById('paginationRangeText');
         const totalTextEl = document.getElementById('paginationTotalText');
         const pageIndicatorEl = document.getElementById('paginationPageIndicator');
         const btnPrev = document.getElementById('btnPrevPage');
         const btnNext = document.getElementById('btnNextPage');

         if (rangeTextEl) rangeTextEl.textContent = totalItems > 0 ? `${startIndex + 1} - ${Math.min(startIndex + reportsPerPage, totalItems)}` : '0 - 0';
         if (totalTextEl) totalTextEl.textContent = totalItems;
         if (pageIndicatorEl) pageIndicatorEl.textContent = `Page ${currentReportPage} of ${totalPages}`;
         if (btnPrev) btnPrev.disabled = currentReportPage <= 1;
         if (btnNext) btnNext.disabled = currentReportPage >= totalPages;

         if (pageReports.length === 0) {
             tbody.innerHTML = `<tr><td colspan="8" class="px-8 py-20 text-center"><i class="fas fa-search text-gray-300 dark:text-slate-700 text-4xl mb-4 block opacity-40"></i><span class="text-xs text-gray-400 font-bold uppercase tracking-widest">No intelligence scans captured yet</span></td></tr>`;
             return;
         }

         tbody.innerHTML = pageReports.map((report, index) => {
             const reportBarangay = encodeURIComponent(report.barangay || '');
             return `
                 <tr class="hover:bg-pnp-blue/5 dark:hover:bg-slate-800/40 transition-all group relative overflow-hidden cursor-pointer"
                     onclick="window.handleReportRowClick(event, '${report.id}')"
                     ondblclick="window.handleReportRowDblClick(event, '${report.id}', '${reportBarangay}')">
                     <td class="px-8 py-6">
                         <div class="flex flex-col">
                             <span class="text-[11px] font-black text-slate-800 dark:text-white uppercase tracking-tighter">
                                 ${new Date(report.timestamp).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
                             </span>
                         </div>
                     </td>
                     <td class="px-8 py-6">
                         <div class="flex flex-col truncate max-w-[250px]">
                             <span class="text-[11px] font-black uppercase text-slate-700 dark:text-slate-200 tracking-tight leading-tight group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition duration-300">${report.filename || 'Manual Transmission'}</span>
                             <div class="flex items-center space-x-2 mt-1">
                                 <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest italic opacity-70">${report.admin_name || 'Sys Admin'}</span>

                                 </div>
                         </div>
                     </td>
                     <td class="w-24 px-2 py-6 text-center">
                         <span class="text-sm font-black text-slate-800 dark:text-white tabular-nums tracking-tighter">${report.total_records || 0}</span>
                     </td>
                     <td class="w-24 px-2 py-6 text-center">
                         <span class="px-3 py-1.5 rounded-xl text-[10px] font-black ${(report.category_stats && report.category_stats['8-Focus']) > 0 ? 'bg-red-500/10 text-red-600 border border-red-500/10' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700'}">
                             ${(report.category_stats && report.category_stats['8-Focus']) || 0}
                         </span>
                     </td>
                     <td class="w-24 px-2 py-6 text-center">
                         <span class="px-3 py-1.5 rounded-xl text-[10px] font-black ${(report.category_stats && report.category_stats['Non-Index']) > 0 ? 'bg-blue-500/10 text-blue-500 border border-blue-500/10' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700'}">
                             ${(report.category_stats && report.category_stats['Non-Index']) || 0}
                         </span>
                     </td>
                     <td class="w-24 px-2 py-6 text-center">
                         <span title="PUBLIC SAFETY INCIDENT" class="px-3 py-1.5 rounded-xl text-[10px] font-black cursor-help ${(report.category_stats && report.category_stats['PSI']) > 0 ? 'bg-pnp-gold/10 text-pnp-gold border border-pnp-gold/20' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700'}">
                             ${(report.category_stats && report.category_stats['PSI']) || 0}
                         </span>
                     </td>
                     <td class="w-28 px-4 py-6 text-center">
                         ${(report.category_stats?.entry_type === 'manual' || report.filename === 'Manual Intelligence Session' || report.filename === 'Manual Entry Session' || report.filename?.includes('Manual')) ? `
                             <span class="px-4 py-2 rounded-2xl bg-emerald-500/5 text-emerald-500 group-hover:bg-emerald-500/15 text-[10px] font-black uppercase tracking-[0.2em] border border-emerald-500/10 transition-all inline-block shadow-sm">MANUAL</span>
                         ` : `
                             <span class="px-4 py-2 rounded-2xl bg-pnp-blue/5 text-pnp-blue-300 group-hover:bg-pnp-blue/15 text-[10px] font-black uppercase tracking-[0.2em] border border-pnp-blue/10 transition-all inline-block shadow-sm">SCANNED</span>
                         `}
                     </td>
                     <td class="w-40 px-3 py-6 text-center">
                         <div class="flex items-center justify-center space-x-2.5">
                             <button onclick="editReportBatch(event, '${report.id}')" type="button" class="w-10 h-10 min-w-[2.5rem] min-h-[2.5rem] flex-shrink-0 aspect-square rounded-2xl bg-gray-50 dark:bg-slate-800 text-slate-400 hover:text-pnp-blue dark:hover:text-pnp-gold hover:bg-white dark:hover:bg-slate-700 transition-all flex items-center justify-center border border-gray-200/50 dark:border-slate-700/60 shadow-sm" title="Edit Record Batch">
                                 <i class="fas fa-edit text-xs"></i>
                             </button>
                             <form id="deleteReportForm_${report.id}" action="/admin/reports/${report.id}/delete" method="POST" class="inline-block flex-shrink-0" onsubmit="confirmDeleteReport(event, '${report.id}'); return false;">
                                 <button type="submit" class="w-10 h-10 min-w-[2.5rem] min-h-[2.5rem] flex-shrink-0 aspect-square rounded-2xl bg-gray-50 dark:bg-slate-800 text-slate-400 hover:text-red-500 hover:bg-white dark:hover:bg-slate-700 transition-all flex items-center justify-center border border-gray-200/50 dark:border-slate-700/60 shadow-sm" title="Delete Record Batch">
                                     <i class="fas fa-trash-alt text-xs"></i>
                                 </button>
                             </form>
                         </div>
                     </td>
                 </tr>
             `;
         }).join('');
     };

     document.addEventListener('DOMContentLoaded', () => {
         animateStats();
         renderReportsTable();
         
         const urlParams = new URLSearchParams(window.location.search);
         const barangay = urlParams.get('barangay');
         const crime = urlParams.get('crime');
         
         if (urlParams.has('barangay') || crime) {
             setTimeout(() => {
                 window.currentStatsBarangay = barangay || 'All Barangays';
                 openStatsSpreadsheet('All');
             }, 100);
         }

         // Automatically open manual input if add_new param is set (such as from the map view)
         if (urlParams.get('add_new') === 'true') {
             setTimeout(() => {
                 if (typeof window.openManualEntry === 'function') {
                     window.openManualEntry();
                 }
             }, 300);
         }
     });

     function animateStats() {
         document.querySelectorAll('.count-up').forEach(el => {
             const target = parseInt(el.dataset.target || el.textContent || '0');
             let count = 0;
             const duration = 1500;
             const startTime = performance.now();
             
             const updateCount = (currentTime) => {
                 const elapsed = currentTime - startTime;
                 const progress = Math.min(elapsed / duration, 1);
                 // Easing function: outQuad
                 const easedProgress = progress * (2 - progress);
                 const currentCount = Math.floor(easedProgress * target);
                 el.textContent = currentCount;
                 
                 if (progress < 1) {
                     requestAnimationFrame(updateCount);
                 } else {
                     el.textContent = target;
                 }
             };
             requestAnimationFrame(updateCount);
         });
     }

    window.updateDashboardStats = function() {
         // Sum up from the live reports list
         const reportsList = window.reports || (typeof reports !== 'undefined' ? reports : []);
         let total8FocusAll = reportsList.reduce((sum, r) => sum + ((r.category_stats?.['8-Focus']) || 0), 0);
         let totalPSIAll = reportsList.reduce((sum, r) => sum + ((r.category_stats?.['PSI']) || 0), 0);
         let totalNonIndexAll = reportsList.reduce((sum, r) => sum + ((r.category_stats?.['Non-Index']) || 0), 0);
 
         const el8 = document.querySelector('[data-stat="8-Focus"]');
         const elPSI = document.querySelector('[data-stat="PSI"]');
         const elNon = document.querySelector('[data-stat="Non-Index"]');

         if (el8) { el8.dataset.target = total8FocusAll; el8.textContent = total8FocusAll; }
         if (elPSI) { elPSI.dataset.target = totalPSIAll; elPSI.textContent = totalPSIAll; }
         if (elNon) { elNon.dataset.target = totalNonIndexAll; elNon.textContent = totalNonIndexAll; }

         animateStats();
     }

     window.purgeTacticalData = async function() {
        const btn = document.querySelector('span[onclick*="purgeTacticalData"]');
        if (btn && btn.dataset.isPurging === 'true') return;

        const confirmed = await (window.strategicConfirm || (async () => confirm("This will purge all system placeholders and test intelligence batches. Dashboard counts will be reset. Proceed?")))({
            title: "Tactical Data Purge",
            message: "This will purge all system placeholders and test intelligence batches. Dashboard counts will be reset. Proceed?",
            confirmText: "Confirm",
            cancelText: "Cancel",
            type: "danger"
        });
        if (!confirmed) return;

        if (btn) btn.dataset.isPurging = 'true';

        try {
            const res = await fetch('/admin/map/purge-placeholders', { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                await window.strategicAlert({
                    title: "Purge Executed",
                    message: `${result.count} pins and ${result.reportsPurged} records have been identified and neutralized.`,
                    type: "info"
                });
                location.reload();
            }
        } catch (error) {
            window.strategicAlert({
                title: "Command Failure",
                message: "Intelligence link lost. Purge sequence interrupted.",
                type: "danger"
            });
            if (btn) btn.dataset.isPurging = 'false';
        }
     }

    window.confirmDeleteReport = async function(event, reportId) {
        if (event) event.preventDefault();
        
        const btn = document.querySelector(`#deleteReportForm_${reportId} button`);
        if (btn && btn.disabled) return false;

        const confirmed = await window.strategicConfirm({
            title: "Archive Confirmation",
            message: "Are you sure you want to move this record to the Archive?",
            confirmText: "Confirm",
            cancelText: "Cancel",
            type: "warning"
        });

        if (confirmed) {
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }
            const form = document.getElementById(`deleteReportForm_${reportId}`);
            if (form) form.submit();
        }
        return false;
    }

    window.filterReports = function() {
        currentReportPage = 1;
        renderReportsTable();
    }
</script>

