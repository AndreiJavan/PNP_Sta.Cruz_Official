                        <span class="text-xs font-black text-slate-500 uppercase tracking-widest">
                            Showing ${displayData.length === 0 ? 0 : startIndex + 1} - ${Math.min(startIndex + statsPageSize, displayData.length)} of ${displayData.length} records
                        </span>
                        <div class="flex items-center space-x-2">
                            <button type="button" onclick="window.changeStatsPage(-1)" ${window.statsCurrentPage <= 1 ? 'disabled' : ''} class="px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-xs font-black text-slate-700 dark:text-white hover:bg-pnp-blue hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                                <i class="fas fa-chevron-left mr-1"></i> Prev
                            </button>
                            <span class="text-xs font-black text-slate-700 dark:text-white px-2">Page ${window.statsCurrentPage} of ${totalPages}</span>
                            <button type="button" onclick="window.changeStatsPage(1)" ${window.statsCurrentPage >= totalPages ? 'disabled' : ''} class="px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-xs font-black text-slate-700 dark:text-white hover:bg-pnp-blue hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                                Next <i class="fas fa-chevron-right ml-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        `;

        const modal = document.getElementById('reportDetailsModal');
        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    };

    window.viewReportDetails = function(reportId) {
        window.isGlobalStats = false;
        const reportsList = window.reports || (typeof reports !== 'undefined' ? reports : []);
        const report = reportsList.find(r => String(r.id) === String(reportId) || String(r._id) === String(reportId));
        if (!report) return;
        
        window.currentViewingReport = report;
        window.detailsCurrentPage = 1;
        window.renderReportDetailsModalContent('All', 'All');
    };

    window.changeDetailsPage = function(delta) {
        window.detailsCurrentPage = (window.detailsCurrentPage || 1) + delta;
        window.renderReportDetailsModalContent(window.lastDetailsFilter || 'All', window.lastDetailsOffense || 'All');
        const content = document.getElementById('reportDetailsContent');
        if (content) content.scrollTop = 0;
    };

    window.renderReportDetailsModalContent = function(filter = 'All', selectedOffense = 'All') {
        window.lastDetailsFilter = filter;
        window.lastDetailsOffense = selectedOffense;

        if (window.isGlobalStats) {
            window.currentStatsCategory = filter;
            window.renderGlobalStatsModalContent();
            return;
        }
        const report = window.currentViewingReport;
        const rawData = report ? (report.raw_data || []) : [];
        
        // Filter by category: support 'All', '8-Focus', 'Non-Index', 'PSI'
        let filteredData = filter === 'All' ? rawData : rawData.filter(item => (item.category || 'Non-Index') === filter);
        
        // Dynamic Classification Filter Options base on current category
        const existingOffenses = new Set();
        rawData.forEach(item => {
            const off = item.offense || item.incident_type;
            if (off && (filter === 'All' || (item.category || 'Non-Index') === filter)) {
                existingOffenses.add(off);
            }
        });
        const combinedOffenses = Array.from(existingOffenses).sort();

        // Check if selected classification is valid in current category filter; if not default to 'All'
        if (selectedOffense && selectedOffense !== 'All' && !existingOffenses.has(selectedOffense)) {
            selectedOffense = 'All';
            window.lastDetailsOffense = 'All';
        }

        // Filter by selected offense / classification
        if (selectedOffense && selectedOffense !== 'All') {
            filteredData = filteredData.filter(item => {
                const itemOffense = (item.offense || item.incident_type || '').toUpperCase();
                return itemOffense === selectedOffense.toUpperCase();
            });
        }
        
        const content = document.getElementById('reportDetailsContent');
        const timestamp = report ? new Date(report.timestamp).toLocaleString(undefined, { 
            month: 'short', day: 'numeric', year: 'numeric', 
            hour: '2-digit', minute: '2-digit'
        }) : '';

        // Category stats counts
        const stats = {
            'All': rawData.length,
            '8-Focus': rawData.filter(item => (item.category || 'Non-Index') === '8-Focus').length,
            'Non-Index': rawData.filter(item => (item.category || 'Non-Index') === 'Non-Index').length,
            'PSI': rawData.filter(item => (item.category || 'Non-Index') === 'PSI').length
        };

        // Container colors:
        // Default / ALL: Pure White
        // 8-Focus: Red
        // Non-Index: Blue
        // PSI: Yellow
        let headerTheme = '';
        let cardTheme = '';
        let theadTheme = '';
        let rowHoverTheme = '';
        let rowBorderTheme = '';
        let paginationTheme = '';
        let activeBadgeClass = '';

        if (filter === '8-Focus') {
            // 8-Focus: Red theme
            headerTheme = 'bg-rose-50/80 dark:bg-rose-950/30 border-rose-200 dark:border-rose-900/50';
            cardTheme = 'bg-rose-50/30 dark:bg-slate-800/95 border-rose-200 dark:border-rose-900/50 shadow-rose-100/30 dark:shadow-none';
            theadTheme = 'bg-rose-100/70 dark:bg-rose-950/60 border-rose-200 dark:border-rose-900/50 text-rose-900 dark:text-rose-300';
            rowHoverTheme = 'hover:bg-rose-50/80 dark:hover:bg-rose-900/25';
            rowBorderTheme = 'border-l-4 border-l-rose-500';
            paginationTheme = 'bg-rose-50/70 dark:bg-rose-950/40 border-rose-200 dark:border-rose-900/50';
            activeBadgeClass = 'bg-rose-500 text-white shadow-md shadow-rose-500/25 ring-2 ring-rose-400/40';
        } else if (filter === 'Non-Index') {
            // Non-Index: Blue theme
            headerTheme = 'bg-blue-50/80 dark:bg-blue-950/30 border-blue-200 dark:border-blue-900/50';
            cardTheme = 'bg-blue-50/30 dark:bg-slate-800/95 border-blue-200 dark:border-blue-900/50 shadow-blue-100/30 dark:shadow-none';
            theadTheme = 'bg-blue-100/70 dark:bg-blue-950/60 border-blue-200 dark:border-blue-900/50 text-blue-900 dark:text-blue-300';
            rowHoverTheme = 'hover:bg-blue-50/80 dark:hover:bg-blue-900/25';
            rowBorderTheme = 'border-l-4 border-l-blue-500';
            paginationTheme = 'bg-blue-50/70 dark:bg-blue-950/40 border-blue-200 dark:border-blue-900/50';
            activeBadgeClass = 'bg-blue-600 text-white shadow-md shadow-blue-600/25 ring-2 ring-blue-400/40';
        } else if (filter === 'PSI') {
            // PSI: Yellow / Amber theme
            headerTheme = 'bg-amber-50/80 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900/50';
            cardTheme = 'bg-amber-50/30 dark:bg-slate-800/95 border-amber-200 dark:border-amber-900/50 shadow-amber-100/30 dark:shadow-none';
            theadTheme = 'bg-amber-100/70 dark:bg-amber-950/60 border-amber-200 dark:border-amber-900/50 text-amber-900 dark:text-amber-300';
            rowHoverTheme = 'hover:bg-amber-50/80 dark:hover:bg-amber-900/25';
            rowBorderTheme = 'border-l-4 border-l-amber-500';
            paginationTheme = 'bg-amber-50/70 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900/50';
            activeBadgeClass = 'bg-amber-500 text-white shadow-md shadow-amber-500/25 ring-2 ring-amber-400/40';
        } else {
            // Default / ALL: Pure White theme
            headerTheme = 'bg-white dark:bg-slate-900 border-gray-200 dark:border-slate-800';
            cardTheme = 'bg-white dark:bg-slate-800/95 border-gray-200 dark:border-slate-800 shadow-sm';
            theadTheme = 'bg-gray-50/90 dark:bg-slate-900 border-gray-200 dark:border-slate-800 text-slate-700 dark:text-slate-300';
            rowHoverTheme = 'hover:bg-gray-50/80 dark:hover:bg-slate-700/50';
            rowBorderTheme = 'border-l-4 border-l-slate-300 dark:border-l-slate-600';
            paginationTheme = 'bg-white dark:bg-slate-900 border-gray-200 dark:border-slate-800';
            activeBadgeClass = 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm ring-2 ring-slate-400/30';
        }

        // Update Modal Title with Highlighted Category Badge ("ALL" instead of "ALL INTEL")
        const titleEl = document.getElementById('reportDetailsTitle');
        if (titleEl) {
            let catBadge = '';
            if (filter === '8-Focus') {
                catBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-black bg-rose-500 text-white shadow-sm tracking-wider">8-FOCUS</span>';
            } else if (filter === 'Non-Index') {
                catBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-black bg-blue-600 text-white shadow-sm tracking-wider">NON-INDEX</span>';
            } else if (filter === 'PSI') {
                catBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-black bg-amber-500 text-white shadow-sm tracking-wider cursor-help" title="PUBLIC SAFETY INCIDENT">PSI</span>';
            } else {
                catBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-black bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm tracking-wider">ALL</span>';
            }
            titleEl.innerHTML = `<span>Recorded Crime | Incident</span> <span class="text-slate-300 dark:text-slate-600 font-light">|</span> ${catBadge}`;
        }

        // 50-Item Pagination
        window.detailsCurrentPage = window.detailsCurrentPage || 1;
        const detailsPageSize = 50;
        const totalPages = Math.max(1, Math.ceil(filteredData.length / detailsPageSize));
        if (window.detailsCurrentPage > totalPages) window.detailsCurrentPage = totalPages;
        if (window.detailsCurrentPage < 1) window.detailsCurrentPage = 1;

        const startIndex = (window.detailsCurrentPage - 1) * detailsPageSize;
        const pageSlice = filteredData.slice(startIndex, startIndex + detailsPageSize);

        content.innerHTML = `
            <!-- Prominent, Visible Container Header (White by default, Colored by category) -->
            <div class="${headerTheme} border-b px-6 sm:px-8 py-4 sm:py-5 flex-shrink-0 transition-colors duration-200 min-h-[68px]">
                <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
                    
                    <!-- Left Section: Intake Source & Timeline (Spacious & Visible) -->
                    <div class="flex items-center space-x-5 flex-shrink-0">
                        <!-- Intake Source -->
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-xs font-black shadow-sm flex-shrink-0">
                                ${(report?.admin_name || 'A').charAt(0)}
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none">Intake Source</span>
                                <p class="text-sm font-black text-slate-800 dark:text-white uppercase leading-tight mt-0.5">${report?.admin_name || 'System Administrator'}</p>
                                <p class="text-[10px] text-slate-400 font-bold uppercase whitespace-normal break-words leading-tight max-w-[200px]" title="${report?.filename || 'Sorted Batch Buffer'}">${report?.filename || 'Sorted Batch Buffer'}</p>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="hidden sm:block w-px h-7 bg-gray-200 dark:bg-slate-700"></div>

                        <!-- Extraction Timeline -->
                        <div class="hidden sm:flex flex-col">
                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none">Extraction Timeline</span>
                            <div class="flex items-center space-x-2 text-slate-700 dark:text-white mt-0.5">
                                <i class="far fa-clock text-xs text-slate-500 dark:text-pnp-gold"></i>
                                <p class="text-xs font-black uppercase font-mono tracking-tight leading-none">${timestamp}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Section: Fixed Selections & Category Tabs ("ALL" instead of "ALL INTEL") -->
                    <div class="flex flex-wrap items-center justify-end gap-3 flex-shrink-0">
                        
                        <!-- Category Switcher Tabs: ALL, 8-Focus, Non-Index (Blue), PSI (Yellow) -->
                        <div class="flex items-center space-x-1.5 bg-white/90 dark:bg-slate-800/90 p-1 rounded-2xl border border-gray-200 dark:border-slate-700 shadow-sm flex-shrink-0">
                            <!-- ALL -->
                            <button type="button" onclick="window.detailsCurrentPage = 1; renderReportDetailsModalContent('All', 'All')" class="px-3.5 py-1.5 text-xs font-black uppercase rounded-xl transition-all cursor-pointer flex items-center space-x-1.5 ${filter === 'All' ? activeBadgeClass : 'text-slate-500 hover:text-slate-800 dark:hover:text-white'}">
                                <span>ALL</span>
                                <span class="px-2 py-0.5 rounded-lg text-[9px] ${filter === 'All' ? 'bg-white/20 text-white' : 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300'} tabular-nums">${stats['All']}</span>
                            </button>
                            <!-- 8-Focus (Red) -->
                            <button type="button" onclick="window.detailsCurrentPage = 1; renderReportDetailsModalContent('8-Focus', 'All')" class="px-3.5 py-1.5 text-xs font-black uppercase rounded-xl transition-all cursor-pointer flex items-center space-x-1.5 ${filter === '8-Focus' ? activeBadgeClass : 'text-slate-500 hover:text-rose-600'}">
                                <span>8-Focus</span>
                                <span class="px-2 py-0.5 rounded-lg text-[9px] ${filter === '8-Focus' ? 'bg-white/20 text-white' : 'bg-rose-100/70 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300'} tabular-nums">${stats['8-Focus']}</span>
                            </button>
                            <!-- Non-Index (Blue) -->
                            <button type="button" onclick="window.detailsCurrentPage = 1; renderReportDetailsModalContent('Non-Index', 'All')" class="px-3.5 py-1.5 text-xs font-black uppercase rounded-xl transition-all cursor-pointer flex items-center space-x-1.5 ${filter === 'Non-Index' ? activeBadgeClass : 'text-slate-500 hover:text-blue-600'}">
                                <span>Non-Index</span>
                                <span class="px-2 py-0.5 rounded-lg text-[9px] ${filter === 'Non-Index' ? 'bg-white/20 text-white' : 'bg-blue-100/70 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300'} tabular-nums">${stats['Non-Index']}</span>
                            </button>
                            <!-- PSI (Yellow) -->
                            <button type="button" onclick="window.detailsCurrentPage = 1; renderReportDetailsModalContent('PSI', 'All')" title="PUBLIC SAFETY INCIDENT" class="px-3.5 py-1.5 text-xs font-black uppercase rounded-xl transition-all cursor-pointer flex items-center space-x-1.5 ${filter === 'PSI' ? activeBadgeClass : 'text-slate-500 hover:text-amber-600'}">
                                <span title="PUBLIC SAFETY INCIDENT" class="cursor-help">PSI</span>
                                <span class="px-2 py-0.5 rounded-lg text-[9px] ${filter === 'PSI' ? 'bg-white/20 text-white' : 'bg-amber-100/70 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300'} tabular-nums">${stats['PSI']}</span>
                            </button>
                        </div>

                        <!-- Classification Selection Dropdown (h-9 w-52 sm:w-60) -->
                        <div class="flex flex-col flex-shrink-0">
                            <select id="modalClassificationDropdown" onchange="window.detailsCurrentPage = 1; renderReportDetailsModalContent('${filter}', this.value)" class="h-9 px-3 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-black text-slate-800 dark:text-white uppercase focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer w-52 sm:w-60 shadow-sm">
                                <option value="All" ${selectedOffense === 'All' ? 'selected' : ''} class="dark:bg-slate-900">All Classifications</option>
                                ${combinedOffenses.map(o => {
                                    return `<option value="${o}" title="${o}" ${o.toUpperCase() === selectedOffense.toUpperCase() ? 'selected' : ''} class="dark:bg-slate-900">${o}</option>`;
                                }).join('')}
                            </select>
                        </div>

                        <!-- Divider -->
                        <div class="hidden sm:block w-px h-7 bg-gray-200 dark:bg-slate-700 flex-shrink-0"></div>

                        <!-- Total Staged -->
                        <div class="text-right min-w-[70px] flex-shrink-0">
                            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block leading-none">Total Staged</span>
                            <p class="text-xl font-black text-slate-800 dark:text-white leading-none mt-1 tabular-nums">${filteredData.length}</p>
                        </div>
                    </div>

                </div>
            </div>
            
            <!-- Table Container (Takes remaining height, completely stable, container-colored) -->
            <div class="flex-1 min-h-0 p-4 sm:p-5 flex flex-col overflow-hidden">
                <div class="${cardTheme} flex-1 min-h-0 flex flex-col rounded-2xl border shadow-sm overflow-hidden transition-colors duration-200">
                    
                    <!-- Scrollable Table Section -->
                    <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar">
                        <table class="w-full text-left border-collapse">
                            <thead class="sticky top-0 z-10 shadow-sm">
                                <tr class="${theadTheme} border-b">
                                    <th class="px-5 py-3 text-[10px] font-black uppercase tracking-widest border-r border-inherit w-16 text-center">ROW</th>
                                    <th class="px-5 py-3 text-[10px] font-black uppercase tracking-widest border-r border-inherit w-36">Timeline</th>
                                    <th class="px-5 py-3 text-[10px] font-black uppercase tracking-widest border-r border-inherit min-w-[340px]">Classification</th>
                                    <th class="px-5 py-3 text-[10px] font-black uppercase tracking-widest border-r border-inherit w-48">Sector (Barangay)</th>
                                    <th class="px-5 py-3 text-[10px] font-black uppercase tracking-widest text-center w-36">Category</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
                                ${pageSlice.length === 0 ? `
                                    <tr>
                                        <td colspan="5" class="px-8 py-20 text-center">
                                            <div class="flex flex-col items-center space-y-3 opacity-40">
                                                <i class="fas fa-satellite-dish text-3xl text-slate-400"></i>
                                                <span class="text-xs font-black uppercase tracking-[0.2em] italic">Intelligence Grid Empty: No records match filter</span>
                                            </div>
                                        </td>
                                    </tr>
                                ` : pageSlice.map((item, idx) => {
                                    const cat = item.category || 'Non-Index';
                                    const is8Focus = cat === '8-Focus';
                                    const isNonIndex = cat === 'Non-Index';
                                    const isPSI = cat === 'PSI';
                                    
                                    const itemBorderAccent = is8Focus ? 'border-l-4 border-l-rose-500' : isNonIndex ? 'border-l-4 border-l-blue-500' : 'border-l-4 border-l-amber-500';
                                    const badgeClass = is8Focus 
                                        ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/30 font-black' 
                                        : isNonIndex 
                                        ? 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/30 font-black' 
                                        : 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 font-black';

                                    const dateStr = item.date || item.date_committed || 'N/A';
                                    const crimeText = item.offense || item.incident_type || 'Unknown';

                                    return `
                                        <tr class="${rowHoverTheme} transition-colors group cursor-pointer ${itemBorderAccent}" ondblclick="navigateToMapForCrime('${encodeURIComponent(item.barangay || '')}', '${encodeURIComponent(crimeText)}', '${item.latitude || item.lat || ''}', '${item.longitude || item.lng || ''}', '${report?.id || ''}')">
                                            <td class="px-5 py-3 text-[10px] font-black text-gray-400 border-r border-gray-100 dark:border-slate-800 text-center tabular-nums">${startIndex + idx + 1}</td>
                                            <td class="px-5 py-3 text-xs font-bold text-slate-500 dark:text-slate-400 font-mono border-r border-gray-100 dark:border-slate-800 tracking-tighter whitespace-nowrap">${dateStr}</td>
                                            <td class="px-5 py-3 text-xs font-black text-slate-800 dark:text-white uppercase border-r border-gray-100 dark:border-slate-800 whitespace-normal break-words leading-relaxed min-w-[340px]">${crimeText}</td>
                                            <td class="px-5 py-3 text-xs font-black text-slate-600 dark:text-slate-300 uppercase border-r border-gray-100 dark:border-slate-800 whitespace-nowrap">BRGY. ${item.barangay || 'UNKNOWN'}</td>
                                            <td class="px-5 py-3 text-center whitespace-nowrap">
                                                <div class="flex items-center justify-center">
                                                    <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider ${badgeClass} ${isPSI ? 'cursor-help' : ''}" ${isPSI ? 'title="PUBLIC SAFETY INCIDENT"' : ''}>
                                                        ${cat}
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    `;
                                }).join('')}
                            </tbody>
                        </table>
                    </div>

                    <!-- Fixed Pagination Docked At Card Bottom -->
                    <div class="flex-shrink-0 flex flex-col sm:flex-row items-center justify-between p-3.5 ${paginationTheme} border-t gap-3 transition-colors duration-200">
                        <span class="text-xs font-black text-slate-500 uppercase tracking-widest">
                            Showing ${filteredData.length === 0 ? 0 : startIndex + 1} - ${Math.min(startIndex + detailsPageSize, filteredData.length)} of ${filteredData.length} records
                        </span>
                        <div class="flex items-center space-x-2">
                            <button type="button" onclick="window.changeDetailsPage(-1)" ${window.detailsCurrentPage <= 1 ? 'disabled' : ''} class="px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-xs font-black text-slate-700 dark:text-white hover:bg-pnp-blue hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                                <i class="fas fa-chevron-left mr-1"></i> Prev
                            </button>
                            <span class="text-xs font-black text-slate-700 dark:text-white px-2">Page ${window.detailsCurrentPage} of ${totalPages}</span>
                            <button type="button" onclick="window.changeDetailsPage(1)" ${window.detailsCurrentPage >= totalPages ? 'disabled' : ''} class="px-3.5 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-xs font-black text-slate-700 dark:text-white hover:bg-pnp-blue hover:text-white disabled:opacity-30 disabled:cursor-not-allowed transition shadow-sm cursor-pointer">
                                Next <i class="fas fa-chevron-right ml-1"></i>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        `;

        const modal = document.getElementById('reportDetailsModal');
        if (modal.classList.contains('hidden')) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
    };

    window.closeReportDetails = function() {
        const modal = document.getElementById('reportDetailsModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    };
</script>

