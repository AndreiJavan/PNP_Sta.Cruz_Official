                        <i class="fas fa-trash-alt text-[10px]"></i>
                     </button>
                 </td>
             `;
             tbody.appendChild(tr);
         });

         const scannerRowCount = document.getElementById('scannerRowCount');
         if (scannerRowCount) scannerRowCount.textContent = `${scannerData.length} records detected from ${currentFilename || 'File'}`;
         
         const count8Focus = document.getElementById('scannerCount8Focus');
         if (count8Focus) count8Focus.textContent = stats['8-Focus'] || 0;
         
         const countNonIndex = document.getElementById('scannerCountNonIndex');
         if (countNonIndex) countNonIndex.textContent = stats['Non-Index'] || 0;
         
         const countPSI = document.getElementById('scannerCountPSI');
         if (countPSI) countPSI.textContent = stats['PSI'] || 0;

         window.refreshModalErrorState('scanner');
     };

     window.confirmScannerReview = async function() {
         if (!scannerData || scannerData.length === 0) {
             await window.strategicAlert({
                 title: "No Data",
                 message: "There are no scanned records to synchronize.",
                 type: "warning"
             });
             return;
         }

         // Auto-normalize barangays across records where matched
         for (let i = 0; i < scannerData.length; i++) {
             const r = scannerData[i];
             if (r.barangay) {
                 const cleanB = String(r.barangay).trim();
                 const matchedB = VALID_BARANGAYS.find(b => 
                     b.toLowerCase() === cleanB.toLowerCase() ||
                     b.toLowerCase() === cleanB.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase() ||
                     cleanB.toLowerCase().includes(b.toLowerCase())
                 );
                 if (matchedB) r.barangay = matchedB;
             }
         }

         // Collect all uncorrected errors across all staged rows
         const uncorrectedRows = [];
         scannerData.forEach((r, idx) => {
             const issues = window.checkRecordIssues(r);
             if (issues.length > 0) {
                 uncorrectedRows.push({
                     rowNumber: idx + 1,
                     issues: issues
                 });
             }
         });

         if (uncorrectedRows.length > 0) {
             let errorWarningMessage = `Validation Block: There are ${uncorrectedRows.length} row(s) containing errors that are not applicable to continue:\n`;
             uncorrectedRows.slice(0, 10).forEach(item => {
                 const issueDescriptions = item.issues.map(iss => `${iss.label}: ${iss.msg}`).join(', ');
                 errorWarningMessage += `\n• Row #${item.rowNumber}: ${issueDescriptions}`;
             });
             if (uncorrectedRows.length > 10) {
                 errorWarningMessage += `\n• ...and ${uncorrectedRows.length - 10} more row(s).`;
             }
             errorWarningMessage += `\n\nPlease resolve all highlighted fields before continuing.`;

             await (window.strategicAlert || (async (opts) => alert(opts.message)))({
                 title: "Cannot Continue: Errors Detected",
                 message: errorWarningMessage,
                 type: "warning"
             });

             const firstInvalid = document.querySelector('#scannerTableBody tr.has-error');
             if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
             return;
         }

         // ALL VALIDATIONS PASSED -> DISPLAY CONFIRMATION DIALOG WITH DIAGNOSTIC SUMMARY
         let confirmMsg = `Ready to synchronize ${scannerData.length} validated records to the CPICRS Central Database.`;
         if (window.lastSortingReport) {
             const rep = window.lastSortingReport;
             const hasIssues = rep.duplicatesRemoved > 0 || rep.cancelledBarangayErrors.length > 0 || rep.dateErrors.length > 0;
             if (hasIssues) {
                 confirmMsg += `\n\nSorting & Filtering Diagnostic Summary:`;
                 if (rep.duplicatesRemoved > 0) {
                     confirmMsg += `\n• Duplicates Filtered: ${rep.duplicatesRemoved} duplicate record(s) removed.`;
                 }
                 if (rep.cancelledBarangayErrors.length > 0) {
                     confirmMsg += `\n• Invalid Sectors Detected: ${rep.cancelledBarangayErrors.length} row(s) sorted for review.`;
                 }
                 if (rep.dateErrors.length > 0) {
                     confirmMsg += `\n• Date Limit Violations Detected: ${rep.dateErrors.length} row(s) sorted for review.`;
                 }
             }
         }
         confirmMsg += `\n\nAll ${scannerData.length} records have been verified without errors. Select 'Confirm' to commit these verified records or 'Cancel' to abort.`;

         const confirmed = await (window.strategicConfirm || (async () => confirm(`Commit ${scannerData.length} records to the CPICRS Central Database?`)))({
              title: "Dataset Synchronization Confirmation",
              message: confirmMsg,
              confirmText: "Confirm",
              cancelText: "Cancel",
              type: "info"
          });
          if (!confirmed) return;
          
          const syncBtn = document.getElementById('btnConfirmScanner') || document.querySelector('button[onclick="confirmScannerReview()"]');
          const originalContent = syncBtn ? syncBtn.innerHTML : '';
          if (syncBtn) {
              syncBtn.disabled = true;
              syncBtn.classList.add('opacity-50', 'cursor-not-allowed');
              syncBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Syncing...';
          }

          try {
              const response = await fetch('/admin/reports/save', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ 
                     entries: scannerData, 
                     filename: currentFilename,
                     entryType: 'scanned' 
                  })
              });
              const result = await response.json();

              if (result.success) {
                  closeScannerReview();
                  const alertFn = window.strategicAlert || (async ({ message }) => alert(message));
                  await alertFn({
                      title: "Sync Successful",
                      message: `Archive Updated: ${result.count} tactical records committed.`,
                      type: "success"
                  });
                  const urlParams = new URLSearchParams(window.location.search);
                  if (urlParams.get('return_to') === 'map') {
                      window.location.href = '/admin/map';
                  } else {
                      location.reload();
                  }
              } else {
                  await window.strategicAlert({
                      title: "Sync Error",
                      message: result.error || "Failed to commit records to CPICRS Central Database.",
                      type: "error"
                  });
                  if (syncBtn) {
                      syncBtn.disabled = false;
                      syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                      syncBtn.innerHTML = originalContent;
                  }
              }
          } catch (err) {
              console.error("Sync Error:", err);
              await window.strategicAlert({
                  title: "System Error",
                  message: "Network or server failure during data synchronization.",
                  type: "error"
              });
              if (syncBtn) {
                  syncBtn.disabled = false;
                  syncBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                  syncBtn.innerHTML = originalContent;
              }
          }
     };

