            titleEl.innerHTML = `<span>Crime Records</span> <span class="text-slate-300 dark:text-slate-600 font-light">|</span> ${catBadge}`;
        }

        // 50-Item Pagination
        window.statsCurrentPage = window.statsCurrentPage || 1;
        const statsPageSize = 50;
        const totalPages = Math.max(1, Math.ceil(displayData.length / statsPageSize));
        if (window.statsCurrentPage > totalPages) window.statsCurrentPage = totalPages;
        if (window.statsCurrentPage < 1) window.statsCurrentPage = 1;

        const startIndex = (window.statsCurrentPage - 1) * statsPageSize;
        const pageSlice = displayData.slice(startIndex, startIndex + statsPageSize);

        content.innerHTML = `
            <!-- Prominent, Visible Container Header (White by default, Colored when Category selected) -->
