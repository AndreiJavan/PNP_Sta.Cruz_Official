     window.editReportBatch = function(event, reportId) {
         if (event) {
             event.stopPropagation();
             event.preventDefault();
         }

         const modal = document.getElementById('editReportModal');
         // Instantly display modal immediately (< 1ms UI feedback)
         if (modal) {
             modal.classList.remove('hidden');
             modal.classList.add('flex');
         }

         const reportsList = window.reports || (typeof reports !== 'undefined' ? reports : []);
         const targetReport = reportsList.find(r => String(r.id) === String(reportId));
         if (!targetReport) {
             window.strategicAlert({
                 title: "Report Not Found",
                 message: `Unable to locate report with ID: ${reportId}`,
                 type: "warning"
             });
             if (modal) {
                 modal.classList.add('hidden');
                 modal.classList.remove('flex');
             }
             return;
         }

         window.editingReportId = reportId;
         window.editCurrentPage = 1;

         // Extract raw entries: check raw_data first, then fallback to incidents matching report_id
         let entries = [];
         if (Array.isArray(targetReport.raw_data) && targetReport.raw_data.length > 0) {
             entries = JSON.parse(JSON.stringify(targetReport.raw_data));
         } else {
             const allInc = window.allIncidents || (typeof allIncidents !== 'undefined' ? allIncidents : []);
             const matchingPoints = allInc.filter(p => String(p.report_id) === String(reportId));
             entries = matchingPoints.map(p => ({
                 barangay: p.barangay || 'Alipit',
                 date_committed: p.incident_date ? p.incident_date.split('T')[0] : (p.date || new Date().toISOString().split('T')[0]),
                 offense: p.incident_type || p.offense || '',
                 category: p.category || 'Non-Index',
                 description: p.description || ''
             }));
         }

         if (entries.length === 0) {
             entries.push({
                 barangay: VALID_BARANGAYS[0],
                 date_committed: new Date().toISOString().split('T')[0],
                 offense: '',
                 category: 'Non-Index',
                 description: ''
             });
         }

         window.editReportData = entries;

         const filenameInput = document.getElementById('editBatchFilename');
         const typeBadge = document.getElementById('editBatchTypeBadge');

         if (filenameInput) {
             filenameInput.value = targetReport.filename || 'Intelligence Batch';
         }

         // Capture initial snapshot to detect if user changed anything
         window.initialEditReportSnapshot = JSON.stringify({
             filename: (targetReport.filename || 'Intelligence Batch').trim(),
             entries: entries.map(e => ({
                 barangay: (e.barangay || '').trim(),
                 date_committed: (e.date_committed || e.date || '').trim(),
                 offense: (e.offense || '').trim(),
                 category: (e.category || '').trim(),
                 description: (e.description || '').trim()
             }))
         });

         const isManual = (targetReport.category_stats?.entry_type === 'manual' || 
                           targetReport.filename === 'Manual Intelligence Session' || 
                           targetReport.filename === 'Manual Entry Session' || 
                           targetReport.filename?.includes('Manual'));

         if (typeBadge) {
             typeBadge.textContent = isManual ? 'MANUAL' : 'SCANNED';
             typeBadge.className = isManual
                 ? 'px-3 py-1 rounded-xl text-[9px] font-black uppercase tracking-widest bg-emerald-500/10 text-emerald-500 border border-emerald-500/20'
                 : 'px-3 py-1 rounded-xl text-[9px] font-black uppercase tracking-widest bg-pnp-blue/10 text-pnp-blue dark:text-pnp-gold border border-pnp-blue/20 dark:border-pnp-gold/20';
         }

         const filterSelect = document.getElementById('editCategoryFilter');
         if (filterSelect) filterSelect.value = 'All';

         window.renderEditTable();
     };

