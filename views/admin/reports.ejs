            <div class="w-36 h-36 bg-white/10 backdrop-blur-md rounded-full border border-white/50 flex items-center justify-center shadow-[0_0_60px_rgba(255,255,255,0.25)] z-10">
                <div class="relative flex items-center justify-center">
                    <i class="fas fa-radar text-white text-5xl animate-radar-ping drop-shadow-[0_0_20px_rgba(255,255,255,0.9)]"></i>
