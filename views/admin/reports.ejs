     window.renderManualTable = function() {
         const tbody = document.getElementById('manualTableBody');
         if (!tbody) return;
         const filterEl = document.getElementById('manualCategoryFilter');
         const filter = filterEl ? filterEl.value : 'All';
         tbody.innerHTML = '';
         let stats = { '8-Focus': 0, 'Non-Index': 0, 'PSI': 0 };
         let displayIndex = 1;

         const CRIMES_BY_PILLAR = window.CRIMES_BY_PILLAR;

         manualData.forEach((item, index) => {
             const cat = item.category || 'Non-Index';
             stats[cat] = (stats[cat] || 0) + 1;
             if (filter !== 'All' && cat !== filter) return;

             const issues = window.checkRecordIssues(item);
             const hasError = issues.length > 0;
             const hasBrgyError = issues.some(i => i.field === 'barangay');
             const hasDateError = issues.some(i => i.field === 'date');
             const hasCrimeError = issues.some(i => i.field === 'offense');

             const dateIssue = issues.find(i => i.field === 'date');
             const crimeIssue = issues.find(i => i.field === 'offense');

             const tr = document.createElement('tr');
             tr.id = `manualRow_${index}`;
