<% 
    // Ensure all critical variables have defaults to prevent EJS crashes
    const displayReports = (typeof reports !== 'undefined' && reports) ? reports : [];
    const displayStats = (typeof stats !== 'undefined' && stats) ? stats : { '8-Focus': 0, 'PSI': 0, 'Non-Index': 0 };
    const displayIncidents = (typeof allIncidents !== 'undefined' && allIncidents) ? allIncidents : [];
%>
<div class="space-y-8 animate-fade-in px-4 lg:px-0">
    <!-- Header Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
        <div id="statsCard_8Focus" onclick="openStatsSpreadsheet('8-Focus')" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2rem] flex flex-col justify-center text-left group cursor-pointer hover:scale-105 transition-all">
            <span id="statsLabel_8Focus" class="text-[10px] text-red-500 font-black uppercase tracking-[0.2em] mb-2">8-Focus</span>
            <div id="statsCount_8Focus" class="text-4xl font-black text-red-500 leading-none count-up-glow" data-target="<%= displayStats['8-Focus'] || 0 %>" data-stat="8-Focus"><%= displayStats['8-Focus'] || 0 %></div>
            <p class="text-[10px] text-slate-400 font-bold uppercase mt-4 tracking-wider leading-tight">Critical Targets</p>
        </div>

        <div id="statsCard_NonIndex" onclick="openStatsSpreadsheet('Non-Index')" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2rem] flex flex-col justify-center text-left group cursor-pointer hover:scale-105 transition-all">
            <span id="statsLabel_NonIndex" class="text-[10px] text-pnp-blue dark:text-blue-400 font-black uppercase tracking-[0.2em] mb-2">Non-Index</span>
            <div id="statsCount_NonIndex" class="text-4xl font-black text-pnp-blue dark:text-blue-400 leading-none count-up-glow" data-target="<%= displayStats['Non-Index'] || 0 %>" data-stat="Non-Index"><%= displayStats['Non-Index'] || 0 %></div>
            <p class="text-[10px] text-slate-400 font-bold uppercase mt-4 tracking-wider leading-tight">Incident Data</p>
        </div>

        <div id="statsCard_PSI" onclick="openStatsSpreadsheet('PSI')" title="PUBLIC SAFETY INCIDENT" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2rem] flex flex-col justify-center text-left group cursor-pointer hover:scale-105 transition-all">
            <span id="statsLabel_PSI" class="text-[10px] text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-[0.2em] mb-2 cursor-help" title="PUBLIC SAFETY INCIDENT">PSI</span>
            <div id="statsCount_PSI" class="text-4xl font-black text-pnp-blue dark:text-pnp-gold leading-none count-up-glow" data-target="<%= displayStats['PSI'] || 0 %>" data-stat="PSI" title="PUBLIC SAFETY INCIDENT"><%= displayStats['PSI'] || 0 %></div>
            <p class="text-[10px] text-slate-400 font-bold uppercase mt-4 tracking-wider leading-tight">PSI Operations</p>
        </div>

        <button onclick="openManualEntry()" class="bg-white dark:bg-slate-900 border border-gray-150 dark:border-slate-800/60 shadow-sm hover:shadow-2xl p-6 rounded-[2rem] flex flex-col justify-center text-left group hover:scale-105 hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden">
            <div class="absolute inset-0 bg-pnp-blue/5 dark:bg-pnp-gold/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            <div class="flex justify-between items-start w-full relative z-10">
                <span class="text-[10px] text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-[0.3em] mb-2 group-hover:animate-pulse">Direct Entry</span>
                <div class="w-8 h-8 bg-pnp-blue/10 dark:bg-white/5 rounded-xl flex items-center justify-center text-pnp-blue dark:text-pnp-gold group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 border border-pnp-blue/10 dark:border-white/10">
                    <i class="fas fa-keyboard text-xs"></i>
                </div>
            </div>
            <div class="text-xl font-black text-slate-800 dark:text-white leading-none uppercase tracking-tighter relative z-10">Manual Input</div>
            <p class="text-[10px] text-slate-400 dark:text-white/40 font-bold uppercase mt-3 tracking-widest relative z-10">Direct Grid Recording</p>
        </button>

        <button onclick="document.getElementById('fileConverterInput').click()" class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 p-6 rounded-[2rem] shadow-sm hover:shadow-2xl flex flex-col justify-center border-2 border-cyan-400/30 text-left group hover:scale-105 hover:-translate-y-1.5 transition-all duration-300 relative overflow-hidden cursor-pointer">
            <div class="absolute inset-0 bg-cyan-400/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
            <div class="flex justify-between items-start w-full relative z-10">
                <span class="text-[10px] text-cyan-400 font-black uppercase tracking-[0.3em] mb-2 group-hover:animate-pulse">Automated Scanner</span>
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 bg-cyan-400/10 rounded-xl flex items-center justify-center text-cyan-400 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 border border-cyan-400/30">
                        <i class="fas fa-file-invoice text-xs"></i>
                    </div>
                </div>
            </div>
            <div class="text-xl font-black text-white leading-none uppercase tracking-tighter relative z-10">Report Scanner</div>
            <p class="text-[10px] text-cyan-200/60 font-bold uppercase mt-3 tracking-widest relative z-10">Sorting & Validation Engine</p>
            <input type="file" id="fileConverterInput" accept=".xlsx,.xls,.docx,.pdf" class="hidden" onchange="handleIntelConvert(this)">
        </button>
    </div>

        <!-- Recorded Case Reports Container -->
        <div class="bg-white/85 dark:bg-slate-900/85 backdrop-blur-md rounded-2xl md:rounded-3xl border border-white/80 dark:border-slate-800 shadow-sm overflow-hidden">
            <!-- Header Section (Clean outstand header) -->
            <div class="p-6 sm:p-8 border-b border-gray-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h3 class="font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.3em] text-sm">Recorded Case Reports</h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase mt-1 tracking-widest italic">Recorded Cases & Intelligence Datasets</p>
                </div>
                <div class="flex items-center space-x-4 w-full md:w-auto mt-4 md:mt-0">
                    <div class="relative w-full md:w-72">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                        <input type="text" id="reportSearchInput" maxlength="100" oninput="if(this.value.length>100)this.value=this.value.slice(0,100);" onkeyup="filterReports()" placeholder="Search reports..." class="w-full pl-10 pr-4 py-4 bg-gray-50 dark:bg-slate-950 border border-gray-100 dark:border-slate-800 rounded-2xl outline-none text-[10px] font-black text-slate-600 dark:text-white uppercase tracking-widest focus:ring-2 focus:ring-pnp-blue/20 transition-all placeholder:text-gray-300">
                    </div>
                </div>
            </div>
    
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse min-w-[1000px] table-fixed">
                    <thead class="bg-gray-50/50 dark:bg-slate-950/50">
                        <tr>
                            <th class="w-44 px-8 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">Date</th>
                            <th class="px-8 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800">File Name</th>
                            <th class="w-24 px-2 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-center">Volume</th>
                            <th class="w-24 px-2 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-center">8-Focus</th>
                            <th class="w-24 px-2 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-center">Non-Index</th>
                            <th class="w-24 px-2 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-center cursor-help" title="PUBLIC SAFETY INCIDENT">PSI</th>
                            <th class="w-32 px-8 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-center">Signal</th>
                            <th class="w-32 px-8 py-6 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] border-b border-gray-100 dark:border-slate-800 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50 dark:divide-slate-800">
                        <% if (displayReports.length === 0) { %>
                            <tr>
                                <td colspan="8" class="px-8 py-40 text-center text-gray-300 dark:text-slate-700 font-black uppercase tracking-[0.5em] italic">
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="fas fa-barcode text-6xl mb-6 opacity-20"></i>
                                        <span>No tactical data signals found</span>
                                    </div>
                                </td>
                            </tr>
                        <% } else { %>
                            <% displayReports.sort((a,b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()).forEach(report => { %>
                                <tr class="hover:bg-pnp-blue/5 dark:hover:bg-slate-800/40 transition-all group relative overflow-hidden cursor-pointer" onclick="handleReportRowClick(event, '<%= report.id %>')" ondblclick="handleReportRowDblClick(event, '<%= report.id %>', '<%= encodeURIComponent(report.barangay || '') %>')">
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col">
                                            <span class="text-[11px] font-black text-slate-800 dark:text-white uppercase tracking-tighter">
                                                <%= new Date(report.timestamp).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6">
                                        <div class="flex flex-col truncate max-w-[250px]">
                                            <span class="text-[11px] font-black uppercase text-slate-700 dark:text-slate-200 tracking-tight leading-tight group-hover:text-pnp-blue dark:group-hover:text-pnp-gold transition duration-300"><%= report.filename || 'Manual Transmission' %></span>
                                            <div class="flex items-center space-x-2 mt-1">
                                                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest italic opacity-70"><%= report.admin_name || 'Sys Admin' %></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="w-24 px-2 py-6 text-center">
                                        <span class="text-sm font-black text-slate-800 dark:text-white tabular-nums tracking-tighter"><%= report.total_records || 0 %></span>
                                    </td>
                                    <td class="w-24 px-2 py-6 text-center">
                                        <span class="px-3 py-1.5 rounded-xl text-[10px] font-black <%= (report.category_stats && report.category_stats['8-Focus']) > 0 ? 'bg-red-500/10 text-red-600 border border-red-500/10' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700' %>">
                                            <%= (report.category_stats && report.category_stats['8-Focus']) || 0 %>
                                        </span>
                                    </td>
                                    <td class="w-24 px-2 py-6 text-center">
                                        <span class="px-3 py-1.5 rounded-xl text-[10px] font-black <%= (report.category_stats && report.category_stats['Non-Index']) > 0 ? 'bg-blue-500/10 text-blue-500 border border-blue-500/10' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700' %>">
                                            <%= (report.category_stats && report.category_stats['Non-Index']) || 0 %>
                                        </span>
                                    </td>
                                    <td class="w-24 px-2 py-6 text-center">
                                        <span title="PUBLIC SAFETY INCIDENT" class="px-3 py-1.5 rounded-xl text-[10px] font-black cursor-help <%= (report.category_stats && report.category_stats['PSI']) > 0 ? 'bg-pnp-gold/10 text-pnp-gold border border-pnp-gold/20' : 'bg-gray-50 dark:bg-slate-800 text-gray-300 dark:text-slate-700' %>">
                                            <%= (report.category_stats && report.category_stats['PSI']) || 0 %>
                                        </span>
                                    </td>
                                    <td class="w-28 px-4 py-6 text-center">
                                        <% if (report.category_stats?.entry_type === 'manual' || report.filename?.includes('Manual')) { %>
                                            <span class="px-4 py-2 rounded-2xl bg-emerald-500/5 text-emerald-500 group-hover:bg-emerald-500/15 text-[10px] font-black uppercase tracking-[0.2em] border border-emerald-500/10 transition-all inline-block shadow-sm">MANUAL</span>
                                        <% } else { %>
                                            <span class="px-4 py-2 rounded-2xl bg-pnp-blue/5 text-pnp-blue-300 group-hover:bg-pnp-blue/15 text-[10px] font-black uppercase tracking-[0.2em] border border-pnp-blue/10 transition-all inline-block shadow-sm">SCANNED</span>
                                        <% } %>
                                    </td>
                                    <td class="w-40 px-3 py-6 text-center">
                                        <div class="flex items-center justify-center space-x-2.5">
                                            <button onclick="editReportBatch(event, '<%= report.id %>')" type="button" class="w-10 h-10 min-w-[2.5rem] min-h-[2.5rem] flex-shrink-0 aspect-square rounded-2xl bg-gray-50 dark:bg-slate-800 text-slate-400 hover:text-pnp-blue dark:hover:text-pnp-gold hover:bg-white dark:hover:bg-slate-700 transition-all flex items-center justify-center border border-gray-200/50 dark:border-slate-700/60 shadow-sm" title="Edit Record Batch">
                                                <i class="fas fa-edit text-xs"></i>
                                            </button>
                                            <form id="deleteReportForm_<%= report.id %>" action="/admin/reports/<%= report.id %>/delete" method="POST" class="inline-block flex-shrink-0" onsubmit="confirmDeleteReport(event, '<%= report.id %>'); return false;">
                                                <button type="submit" class="w-10 h-10 min-w-[2.5rem] min-h-[2.5rem] flex-shrink-0 aspect-square rounded-2xl bg-gray-50 dark:bg-slate-800 text-slate-400 hover:text-red-500 hover:bg-white dark:hover:bg-slate-700 transition-all flex items-center justify-center border border-gray-200/50 dark:border-slate-700/60 shadow-sm" title="Delete Record Batch">
                                                    <i class="fas fa-trash-alt text-xs"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Records Archive Pagination Controls (5 per page) -->
            <div id="reportsPaginationContainer" class="px-8 py-5 border-t border-gray-100 dark:border-slate-800 flex flex-col sm:flex-row justify-between items-center bg-gray-50/50 dark:bg-slate-900/50 gap-4">
                <div class="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">
                    Showing <span id="paginationRangeText" class="font-black text-slate-700 dark:text-slate-200">1 - 5</span> of <span id="paginationTotalText" class="font-black text-slate-700 dark:text-slate-200">0</span> Records
                </div>
                <div class="flex items-center space-x-3">
                    <button id="btnPrevPage" type="button" onclick="changeReportsPage(-1)" class="px-4 py-2.5 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-[10px] font-black text-slate-600 dark:text-slate-300 uppercase tracking-wider hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-900 transition disabled:opacity-30 disabled:cursor-not-allowed shadow-sm flex items-center space-x-2">
                        <i class="fas fa-chevron-left text-[9px]"></i>
                        <span>Previous</span>
                    </button>
                    <span id="paginationPageIndicator" class="px-3 py-2 text-[10px] font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-widest bg-pnp-blue/5 dark:bg-slate-800 rounded-xl border border-pnp-blue/10">
                        Page 1 of 1
                    </span>
                    <button id="btnNextPage" type="button" onclick="changeReportsPage(1)" class="px-4 py-2.5 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-[10px] font-black text-slate-600 dark:text-slate-300 uppercase tracking-wider hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-900 transition disabled:opacity-30 disabled:cursor-not-allowed shadow-sm flex items-center space-x-2">
                        <span>Next</span>
                        <i class="fas fa-chevron-right text-[9px]"></i>
                    </button>
                </div>
            </div>
        </div>
</div>

<!-- Modal for raw data view (Polished Spreadsheet Style) -->
<div id="reportDetailsModal" class="fixed inset-0 z-[1500] hidden items-center justify-center bg-slate-900/90 backdrop-blur-md p-3 sm:p-5">
    <div class="bg-white dark:bg-slate-800 w-full max-w-[95vw] lg:max-w-7xl rounded-[2.5rem] shadow-2xl border border-gray-200 dark:border-slate-700/80 overflow-hidden flex flex-col h-[90vh] max-h-[90vh] animate-fade-in-up">
        <!-- Prominent, Visible Top Header (Bigger & Clear) -->
        <div class="px-6 sm:px-8 py-5 sm:py-6 border-b border-gray-100 dark:border-slate-700 flex justify-between items-center bg-gray-50/50 dark:bg-slate-900/50 relative overflow-hidden flex-shrink-0 min-h-[76px]">
            <div class="flex items-center space-x-5">
                <!-- White Logo (PNP-Blue Badge with White Icon, NOT Yellow) -->
                <div class="w-12 h-12 rounded-2xl bg-pnp-blue text-white shadow-md flex items-center justify-center border-2 border-white/20 flex-shrink-0">
                    <i class="fas fa-file-invoice text-white text-xl"></i>
                </div>
                <div>
                    <h3 id="reportDetailsTitle" class="font-black text-pnp-blue dark:text-pnp-gold uppercase tracking-[0.25em] text-base sm:text-lg flex items-center flex-wrap gap-2">Recorded Intelligence</h3>
                </div>
            </div>
            <button onclick="closeReportDetails()" class="w-11 h-11 rounded-2xl bg-gray-100 dark:bg-slate-700 text-gray-500 hover:bg-red-500 hover:text-white transition-all transform hover:rotate-90 flex items-center justify-center shadow-sm cursor-pointer flex-shrink-0" title="Close">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
        <div id="reportDetailsContent" class="p-0 flex flex-col flex-1 min-h-0 overflow-hidden bg-white dark:bg-slate-900"></div>
    </div>
</div>

<style>
  .no-calendar-picker::-webkit-calendar-picker-indicator,
  .no-calendar-picker::-webkit-inner-spin-button {
      display: none !important;
      -webkit-appearance: none !important;
  }
  .no-calendar-picker {
      -moz-appearance: textfield !important;
  }
</style>

<!-- ========================================== -->
<!-- 1. DEDICATED MANUAL ENTRY MODAL           -->
<!-- ========================================== -->
<div id="manualEntryModal" class="fixed inset-0 z-[2500] hidden items-center justify-center bg-slate-950/60 backdrop-blur-sm p-2 sm:p-4">
    <div class="bg-white dark:bg-slate-800 w-full max-w-[95vw] lg:max-w-7xl rounded-2xl md:rounded-[2.5rem] shadow-2xl border border-gray-200 dark:border-slate-800 overflow-hidden animate-fade-in-up flex flex-col h-[90vh] max-h-[90vh]">
        <!-- Header -->
        <div class="p-6 sm:p-8 border-b border-gray-100 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-900/50 flex flex-col lg:flex-row justify-between items-start lg:items-center space-y-4 lg:space-y-0 flex-shrink-0 min-h-[80px]">
            <div class="flex items-center space-x-5">
                <div class="w-14 h-14 bg-pnp-blue text-white rounded-2xl flex items-center justify-center border-2 border-white/20 shadow-lg flex-shrink-0">
                    <i class="fas fa-keyboard text-2xl text-white"></i>
                </div>
                <div>
                    <h3 class="text-pnp-blue dark:text-pnp-gold font-black uppercase tracking-[0.3em] text-base sm:text-lg">Manual Input</h3>
                    <p id="manualRowCount" class="text-xs text-gray-400 font-bold uppercase tracking-widest mt-1">Direct Grid Recording Session</p>
                </div>
            </div>

            <!-- Filters & Counters -->
            <div class="flex items-center space-x-4 bg-white dark:bg-slate-700 p-2 rounded-2xl border border-gray-100 dark:border-slate-600 shadow-inner">
                <select id="manualCategoryFilter" onchange="renderManualTable()" class="bg-transparent border-none text-xs font-black text-pnp-blue dark:text-pnp-gold uppercase px-6 py-2 outline-none cursor-pointer">
                    <option value="All">All Categories</option>
                    <option value="8-Focus">8-Focus Target</option>
                    <option value="Non-Index">Non-Index</option>
                    <option value="PSI" title="PUBLIC SAFETY INCIDENT">PSI Sector</option>
                </select>
                <div class="w-px h-6 bg-gray-100 dark:bg-slate-600"></div>
                <div class="flex items-center space-x-5 px-6 py-2">
                    <div class="flex items-center space-x-2" title="8-Focus Total"><div class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-sm shadow-red-500/50"></div><span id="manualCount8Focus" class="text-sm font-black text-pnp-blue dark:text-white">0</span></div>
                    <div class="flex items-center space-x-2" title="Non-Index Total"><div class="w-2.5 h-2.5 rounded-full bg-slate-500 shadow-sm shadow-slate-500/50"></div><span id="manualCountNonIndex" class="text-sm font-black text-pnp-blue dark:text-white">0</span></div>
                    <div class="flex items-center space-x-2 cursor-help" title="PUBLIC SAFETY INCIDENT Total"><div class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-sm shadow-blue-500/50"></div><span id="manualCountPSI" class="text-sm font-black text-pnp-blue dark:text-white">0</span></div>
                </div>
            </div>

            <button onclick="closeManualEntry()" class="w-11 h-11 rounded-2xl bg-gray-100 dark:bg-slate-700 text-gray-500 hover:bg-red-500 hover:text-white transition-all transform hover:rotate-90 flex items-center justify-center shadow-sm cursor-pointer flex-shrink-0" title="Close">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Top Error Notification Banner for Detected Issues in Manual Entry -->
        <div id="manualModalErrorAlert" class="hidden px-8 py-4 bg-amber-500/10 dark:bg-amber-950/40 border-b border-amber-500/20 flex flex-col md:flex-row md:items-center justify-between gap-3 flex-shrink-0 animate-fade-in">
            <div class="flex items-start md:items-center space-x-3">
                <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-exclamation-triangle text-sm"></i>
                </div>
                <div>
                    <h4 id="manualModalErrorTitle" class="text-xs font-black uppercase tracking-wider text-amber-700 dark:text-amber-300">Errors Detected in Manual Input</h4>
                    <p id="manualModalErrorDesc" class="text-[11px] font-bold text-amber-600/90 dark:text-amber-400/90 mt-0.5">Rows containing invalid Date, Sector, or Classification are highlighted below. Correct them to continue.</p>
                </div>
            </div>
            <div class="flex items-center space-x-2 flex-shrink-0">
                <span id="manualModalErrorBadge" class="px-3 py-1 rounded-lg bg-amber-500 text-slate-900 font-black text-[10px] uppercase tracking-wider">0 Issues to Fix</span>
            </div>
        </div>

        <!-- Table View -->
        <div class="flex-grow overflow-auto p-6 sm:p-8 bg-gray-50/50 dark:bg-slate-900/30 custom-scrollbar min-h-0">
