                        <option value="8-Focus" ${cat === '8-Focus' ? 'selected' : ''} class="text-red-500 font-bold">8-Focus</option>
                        <option value="Non-Index" ${cat === 'Non-Index' ? 'selected' : ''} class="text-blue-500 font-bold">Non-Index</option>
                        <option value="PSI" ${cat === 'PSI' ? 'selected' : ''} class="text-amber-500 font-bold" title="PUBLIC SAFETY INCIDENT">PSI</option>
