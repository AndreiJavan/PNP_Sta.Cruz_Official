                            ${["All Barangays", ...window.VALID_BARANGAYS].map(b => `<option value="${b}" ${b === window.currentStatsBarangay ? 'selected' : ''} class="dark:bg-slate-800 dark:text-white">${b}</option>`).join('')}
                        </select>
                    </div>

                    <!-- Classification Filter (Visible Dropdown) -->
                    <div class="lg:col-span-4 space-y-1">
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block leading-none">Classification Filter</span>
                        <select onchange="window.currentStatsClassification = this.value; window.statsCurrentPage = 1; renderGlobalStatsModalContent()" class="w-full h-9 px-3 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-xs font-black text-slate-800 dark:text-white shadow-sm focus:ring-2 focus:ring-blue-500 outline-none transition-all cursor-pointer">
                            <option value="All" ${window.currentStatsClassification === 'All' ? 'selected' : ''} class="dark:bg-slate-800 dark:text-white">All Classifications</option>
                            ${combinedOffenses.map(off => {
                                return `<option value="${off}" title="${off}" ${off === window.currentStatsClassification ? 'selected' : ''} class="dark:bg-slate-800 dark:text-white">${off}</option>`;
                            }).join('')}
                        </select>
                    </div>

                    <!-- Category Tabs with Highlight: ALL, 8-Focus, Non-Index (Blue), PSI (Yellow) -->
                    <div class="lg:col-span-3 flex items-center justify-center">
                        <div class="grid grid-cols-4 gap-1.5 w-full bg-white/90 dark:bg-slate-800/90 p-1 rounded-2xl border border-gray-200 dark:border-slate-700 shadow-sm">
                            <!-- ALL -->
                            <button type="button" onclick="openStatsSpreadsheet('All')" class="p-1.5 rounded-xl transition-all flex flex-col items-center cursor-pointer ${category === 'All' ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm ring-2 ring-slate-400/30' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700'}">
                                <span class="text-[9px] font-black uppercase tracking-wider leading-none mb-0.5 ${category === 'All' ? 'opacity-90' : 'text-slate-400'}">ALL</span>
                                <span class="text-xs font-black tabular-nums leading-none">${stats['All']}</span>
                            </button>
                            <!-- 8-Focus (Red) -->
                            <button type="button" onclick="openStatsSpreadsheet('8-Focus')" class="p-1.5 rounded-xl transition-all flex flex-col items-center cursor-pointer ${category === '8-Focus' ? 'bg-rose-500 text-white shadow-sm ring-2 ring-rose-400/40' : 'text-slate-600 dark:text-slate-300 hover:bg-rose-50 dark:hover:bg-rose-950/40'}">
                                <span class="text-[9px] font-black uppercase tracking-wider leading-none mb-0.5 ${category === '8-Focus' ? 'opacity-90' : 'text-rose-500'}">8-Focus</span>
                                <span class="text-xs font-black tabular-nums leading-none">${stats['8-Focus']}</span>
                            </button>
                            <!-- Non-Index (Blue) -->
