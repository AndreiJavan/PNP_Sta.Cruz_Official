      window.handleIntelConvert = async function(input) {
        if (!input.files || !input.files[0]) return;

        const file = input.files[0];
        
        // 1. Verification Protocol: Check for existing intelligence batches (Duplicate Dataset Detection)
        if (window.reports && window.reports.some(r => r.filename && r.filename.toLowerCase() === file.name.toLowerCase())) {
            await window.strategicAlert({
                title: "Duplicate File Detected",
                message: `The dataset file [${file.name}] is already archived in the CPICRS database. Re-sorting duplicate files is restricted to prevent duplicate records.`,
                type: "warning"
            });
            input.value = '';
            return;
        }

        const loadingOverlay = document.getElementById('intelLoadingOverlay');
        const statusText = document.getElementById('intelLoadingText');

        loadingOverlay.classList.remove('hidden');

        try {
            const formData = new FormData();
            formData.append('file', file);

            statusText.textContent = `Sorting File: ${file.name} - Reading & classifying records...`;

            const res = await fetch('/admin/process-ai', {
                method: 'POST',
                body: formData
            });

            if (!res.ok) {
                const errText = await res.text();
                throw new Error(errText);
            }

            const result = await res.json();

            if (!result.success) {
                throw new Error(result.error || "File sorting and intake failed.");
            }

            const rawRecords = result.data || [];

            if (rawRecords.length === 0) {
                await window.strategicAlert({
                    title: "Sorting Result: Empty",
                    message: "No incident records found in this document. Please ensure the file contains valid rows.",
                    type: "warning"
                });
                return;
            }

            // 2. Client-side Sorting & Verification Engine:
            // Checks each record for:
            // - Sector / Barangay: Must match one of 26 Santa Cruz barangays
            // - Timeline Date limitation: Must be between 2024-01-01 and present date
            // - Crime Classification: Must be non-empty, 2-300 chars, <= 50 words, and contain workable words
            // - Internal duplicate records detection within the file

            const todayStr = new Date().toISOString().split('T')[0];
            const processedRecords = [];
            const seenKeys = new Set();
            let duplicatesFiltered = 0;

            rawRecords.forEach((item, idx) => {
                const rawLoc = String(item.barangay || item.location || '').trim();
                const rawOff = String(item.offense || item.incident_type || '').replace(/\s+/g, ' ').trim();
                let rawDate = String(item.date_committed || item.date || '').trim();

                // Barangay Validation
                const cleanLoc = rawLoc.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase();
                const matchedBarangay = VALID_BARANGAYS.find(b => 
                    b.toLowerCase() === rawLoc.toLowerCase() ||
                    b.toLowerCase() === cleanLoc ||
                    b.toLowerCase().includes(cleanLoc) ||
                    cleanLoc.includes(b.toLowerCase())
                );
                const isBarangayValid = !!matchedBarangay;
                const assignedBarangay = matchedBarangay || rawLoc;

                // Date Validation: 2024 - present
                let formattedDate = rawDate.split('T')[0].split(' ')[0];
                let isDateValid = false;
                if (/^\d{4}-\d{2}-\d{2}$/.test(formattedDate) && !isNaN(new Date(formattedDate).getTime())) {
                    if (formattedDate >= '2024-01-01' && formattedDate <= todayStr) {
                        isDateValid = true;
                    }
                }
                if (!formattedDate) formattedDate = rawDate || 'INVALID-DATE';

                // Crime Classification Validation
                let isCrimeValid = false;
                if (rawOff && rawOff.length >= 2 && rawOff.length <= 300) {
                    const words = rawOff.split(' ').filter(Boolean);
                    if (words.length <= 50) {
                        const hasUnworkable = words.some(w => {
                            const cleanW = w.replace(/[^a-zA-Z0-9ñÑ]/g, '');
                            // Allow numbers, years (2002), statute numbers (7610, 9165), roman numerals, and legal acronyms
                            if (!cleanW || cleanW.length <= 3 || /^[\d\.\-\/]+$/.test(cleanW) || /\d/.test(cleanW) || /^[ivxlcdm]+$/i.test(cleanW)) return false;
                            const recognized = ['PNP', 'MPS', 'RIR', 'PSI', 'RA', 'PD', 'BP', 'RPC', 'VAWC', 'WCPD'];
                            if (recognized.includes(cleanW.toUpperCase())) return false;
                            const lettersOnly = cleanW.replace(/[^a-zA-ZñÑ]/g, '');
                            return lettersOnly.length >= 4 && !/[aeiouy]/i.test(lettersOnly);
                        });
                        if (!hasUnworkable) isCrimeValid = true;
                    }
                }

                // Duplicate Check within the file
                const timeKey = item.time_committed ? String(item.time_committed).trim() : '';
                const dupKey = `${assignedBarangay.toLowerCase()}|${formattedDate}|${timeKey}|${rawOff.toLowerCase()}`;
                if (seenKeys.has(dupKey)) {
                    duplicatesFiltered++;
                    return; // Filter out identical duplicate records from file
                }
                seenKeys.add(dupKey);

                processedRecords.push({
                    barangay: assignedBarangay,
                    date_committed: formattedDate,
                    time_committed: item.time_committed || null,
                    offense: rawOff.slice(0, 300),
                    category: item.category || 'Non-Index',
                    description: item.description || '',
                    _isBarangayValid: isBarangayValid,
                    _isDateValid: isDateValid,
                    _isCrimeValid: isCrimeValid
                });
            });

            if (processedRecords.length === 0) {
                await window.strategicAlert({
                    title: "No Records Found",
                    message: "The document contains no records or only duplicate entries.",
                    type: "warning"
                });
                return;
            }

            // Save file info and pass processed records to review modal
            lastProcessedFile = { name: file.name, size: file.size };
            window.lastDuplicatesFiltered = duplicatesFiltered;

            showIntelReview(processedRecords, file.name);

        } catch (error) {
            console.error("Sorting Engine Error:", error);
            await window.strategicAlert({
                title: "File Sorting Error",
                message: error.message,
                type: "danger"
            });
        } finally {
            loadingOverlay.classList.add('hidden');
            input.value = '';
        }
    };
     let reviewData = [];
     let currentFilename = "";
     let currentEntryType = "scanned";
     let lastProcessedFile = { name: "", size: 0 };     let targetInsertIndex = null;

     window.openBatchGeneratorModal = function(insertIndex = null) {
         targetInsertIndex = insertIndex;
         const now = new Date();
         const todayDay = String(now.getDate()).padStart(2, '0');
         const todayMonth = String(now.getMonth() + 1).padStart(2, '0');
         const todayYear = String(now.getFullYear());
         
         const modal = document.getElementById('batchGeneratorModal');
         const brgySelect = document.getElementById('batchBarangaySelect');
         const daySelect = document.getElementById('batchDaySelect');
         const monthSelect = document.getElementById('batchMonthSelect');
         const yearSelect = document.getElementById('batchYearSelect');
         const countInput = document.getElementById('batchCount');
         const offenseInput = document.getElementById('batchOffenseInput');
         const catSelect = document.getElementById('batchCategorySelect');

         if (brgySelect) {
             brgySelect.innerHTML = VALID_BARANGAYS.map(b => `<option value="${b}">${b}</option>`).join('');
         }
         
         if (daySelect) daySelect.value = todayDay;
         if (monthSelect) monthSelect.value = todayMonth;
         if (yearSelect) yearSelect.value = todayYear;

         if (countInput) countInput.value = '1';
         if (offenseInput) offenseInput.value = '';
         if (catSelect) catSelect.value = 'Non-Index';
         
         window.onBatchCategoryChange('Non-Index');

         if (modal) {
             modal.classList.remove('hidden');
             modal.classList.add('flex');
         }
     };

     window.closeBatchGeneratorModal = function() {
         const modal = document.getElementById('batchGeneratorModal');
         if (modal) {
             modal.classList.add('hidden');
             modal.classList.remove('flex');
         }
     };

     window.onBatchCategoryChange = function(cat) {
         const datalist = document.getElementById('batchCrimesList');
         const crimeOptions = CRIMES_BY_PILLAR[cat] || [];
         if (datalist) {
             datalist.innerHTML = crimeOptions.map(o => `<option value="${o}">`).join('');
         }
         const offenseInput = document.getElementById('batchOffenseInput');
         if (offenseInput) offenseInput.value = '';
     };

     window.executeBatchGeneration = function() {
         const countInput = document.getElementById('batchCount');
         const brgySelect = document.getElementById('batchBarangaySelect');
         const daySelect = document.getElementById('batchDaySelect');
         const monthSelect = document.getElementById('batchMonthSelect');
         const yearSelect = document.getElementById('batchYearSelect');
         const catSelect = document.getElementById('batchCategorySelect');
         const offenseInput = document.getElementById('batchOffenseInput');

         const rawCount = parseInt(countInput ? countInput.value : '1') || 0;
         if (rawCount < 1) {
             window.strategicAlert({
                 title: "Invalid Row Count",
                 message: "Please enter a valid number of rows (minimum 1).",
                 type: "warning"
             });
             return;
         }
         if (rawCount > 50) {
             window.strategicAlert({
                 title: "Row Limit Exceeded",
                 message: "Maximum row generation limit is 50 rows per batch.",
                 type: "warning"
             });
             return;
         }
         const count = rawCount;
         const barangay = (brgySelect ? brgySelect.value : '') || VALID_BARANGAYS[0];
         
         const dayVal = daySelect ? daySelect.value : String(new Date().getDate()).padStart(2, '0');
         const monthVal = monthSelect ? monthSelect.value : String(new Date().getMonth() + 1).padStart(2, '0');
         const yearVal = yearSelect ? yearSelect.value : String(new Date().getFullYear());
         const dateVal = `${yearVal}-${monthVal}-${dayVal}`;

         const category = (catSelect ? catSelect.value : '') || 'Non-Index';
         const offense = offenseInput ? offenseInput.value.trim() : '';

         if (offense && offense.length > 300) {
             window.strategicAlert({
                 title: "Classification Too Long",
                 message: `Crime classification must not exceed 300 letters (currently: ${offense.length}).`,
                 type: "warning"
             });
             return;
         }
         const offenseWords = offense ? offense.split(/\s+/).filter(Boolean) : [];
         if (offenseWords.length > 50) {
             window.strategicAlert({
                 title: "Classification Word Limit Exceeded",
                 message: `Crime classification must not exceed 50 words (currently: ${offenseWords.length} words).`,
                 type: "warning"
             });
             return;
         }

         const todayStr = new Date().toISOString().split('T')[0];

         if (!dateVal || dateVal > todayStr || dateVal < '2024-01-01') {
             window.strategicAlert({
                 title: "Invalid Timeline Date",
                 message: `Timeline date must be between January 1, 2024 and today (${todayStr}). Future dates are restricted.`,
                 type: "warning"
             });
             return;
         }

         const newRows = [];
         for (let i = 0; i < count; i++) {
             newRows.push({
                 barangay: barangay,
                 date_committed: dateVal,
                 offense: offense,
                 category: category,
                 description: ''
             });
         }

         if (targetInsertIndex !== null && targetInsertIndex >= 0 && targetInsertIndex <= reviewData.length) {
             reviewData.splice(targetInsertIndex, 0, ...newRows);
         } else {
             reviewData.push(...newRows);
         }

         const activeDataset = currentEntryType === 'manual' ? manualData : scannerData;
         if (targetInsertIndex !== null && targetInsertIndex >= 0 && targetInsertIndex <= activeDataset.length) {
             activeDataset.splice(targetInsertIndex, 0, ...newRows);
         } else {
             activeDataset.push(...newRows);
         }
         reviewData = activeDataset;

         closeBatchGeneratorModal();
         if (currentEntryType === 'manual') {
             renderManualTable();
         } else {
             renderScannerTable();
         }

         setTimeout(() => {
             const tbody = currentEntryType === 'manual' ? document.getElementById('manualTableBody') : document.getElementById('scannerTableBody');
             const container = tbody ? tbody.closest('.overflow-auto') : null;
             if (container) {
                 container.scrollTop = container.scrollHeight;
             }
         }, 50);
     };

     // =========================================================================
     // DEDICATED DATASETS FOR SEPARATED MANUAL ENTRY AND SCANNER REVIEW MODALS
     // =========================================================================
     let manualData = [];
     let scannerData = [];

     window.checkRecordIssues = function(item) {
         const issues = [];
         const todayStr = new Date().toISOString().split('T')[0];

         // 1. Sector / Barangay Check
         const rawLoc = String(item.barangay || item.location || '').trim();
         const cleanLoc = rawLoc.replace(/^(brgy\.?|bgy\.?|barangay)\s+/i, '').toLowerCase();
         const matchedBarangay = VALID_BARANGAYS.find(b => 
             b.toLowerCase() === rawLoc.toLowerCase() ||
             b.toLowerCase() === cleanLoc ||
             b.toLowerCase().includes(cleanLoc) ||
             cleanLoc.includes(b.toLowerCase())
         );
         if (!rawLoc || !matchedBarangay) {
             issues.push({ field: 'barangay', label: 'Barangay (Sector)', msg: `"${rawLoc || 'EMPTY'}" is not a recognized Santa Cruz Barangay.` });
         }

         // 2. Date Issue Check (Allowed: 2024 to present)
         const rawDate = String(item.date_committed || item.date || '').trim();
         const formattedDate = rawDate.split('T')[0].split(' ')[0];
         if (!formattedDate || !/^\d{4}-\d{2}-\d{2}$/.test(formattedDate) || isNaN(new Date(formattedDate).getTime())) {
             issues.push({ field: 'date', label: 'Date', msg: `Invalid date format "${rawDate}".` });
         } else if (formattedDate < '2024-01-01') {
             issues.push({ field: 'date', label: 'Date', msg: `Date (${formattedDate}) is prior to 2024 (Allowed: 2024-present).` });
         } else if (formattedDate > todayStr) {
             issues.push({ field: 'date', label: 'Date', msg: `Future date (${formattedDate}) is not allowed.` });
         }

         // 3. Crime Classification Check (2-300 chars, max 50 words, legitimacy & keyboard mash check)
         const rawOff = String(item.offense || item.incident_type || '').replace(/\s+/g, ' ').trim();
         const rowCategory = item.category || 'Non-Index';

         if (!rawOff || rawOff.length < 2) {
             issues.push({ field: 'offense', label: 'Crime Classification', msg: 'Classification required (min 2 characters).' });
         } else if (rawOff.length > 300) {
             issues.push({ field: 'offense', label: 'Crime Classification', msg: `Exceeds 300 characters limit (${rawOff.length}/300).` });
         } else if (!/[a-zA-ZñÑ]/.test(rawOff)) {
             issues.push({ field: 'offense', label: 'Crime Classification', msg: 'Must contain a valid crime name (cannot be pure numbers).' });
         } else {
             const words = rawOff.split(' ').filter(Boolean);
             if (words.length > 50) {
                 issues.push({ field: 'offense', label: 'Crime Classification', msg: `Exceeds 50 words limit (${words.length}/50 words).` });
             } else {
                 // A. Detect keyboard mash, sequences, repeated chars, or gibberish in any word
                 const mashSeqs = ['qwerty', 'qwert', 'asdfg', 'asdf', 'zxcvb', 'zxcv', 'poiuy', 'lkjhg', 'mnbvc'];
                 const recognized = ['PNP', 'MPS', 'RIR', 'PSI', 'RA', 'PD', 'BP', 'RPC', 'VAWC', 'WCPD'];
                 let detectedMash = null;

                 for (const w of words) {
                     const cleanW = w.replace(/[^a-zA-Z0-9ñÑ]/g, '');
                     if (!cleanW || cleanW.length <= 3) continue;
                     if (/^[\d\.\-\/]+$/.test(cleanW) || /\d/.test(cleanW) || /^[ivxlcdm]+$/i.test(cleanW)) continue;
                     if (recognized.includes(cleanW.toUpperCase())) continue;

                     const letters = cleanW.toLowerCase();
                     if (/(.)\1{2,}/i.test(letters)) {
                         detectedMash = `Repeated characters in "${w}".`;
                         break;
                     }
                     if (letters.length >= 4 && /(.{2,4})\1{1,}/i.test(letters)) {
                         detectedMash = `Keyboard mash pattern in "${w}".`;
                         break;
                     }
                     const uniqueChars = new Set(letters.split(''));
                     if (letters.length >= 5 && (uniqueChars.size <= 2 || (letters.length >= 7 && uniqueChars.size <= 3))) {
                         detectedMash = `Unworkable keyboard mash in "${w}".`;
                         break;
                     }
                     if (mashSeqs.some(seq => letters.includes(seq))) {
                         detectedMash = `Keyboard sequence in "${w}".`;
                         break;
                     }
                     if (letters.length >= 4 && !/[aeiouy]/.test(letters)) {
                         detectedMash = `Unworkable word "${w}".`;
                         break;
                     }
                 }

                 if (detectedMash) {
                     issues.push({ field: 'offense', label: 'Crime Classification', msg: detectedMash });
                 } else {
                     // B. Crime Legitimacy & Category Alignment Check
                     const normOff = rawOff.toLowerCase().replace(/[^a-z0-9]/gi, '');
                     const currentCategoryCrimes = (window.CRIMES_BY_PILLAR && window.CRIMES_BY_PILLAR[rowCategory]) || [];
                     const matchesCurrent = currentCategoryCrimes.some(c => {
                         const normC = c.toLowerCase().replace(/[^a-z0-9]/gi, '');
                         return normC === normOff || normC.includes(normOff) || normOff.includes(normC);
                     });

                     if (!matchesCurrent) {
                         let belongsToOther = null;
                         const allPillars = window.CRIMES_BY_PILLAR || {};
                         for (const [otherCat, otherList] of Object.entries(allPillars)) {
                             if (otherCat === rowCategory) continue;
                             const found = otherList.find(c => {
                                 const normC = c.toLowerCase().replace(/[^a-z0-9]/gi, '');
                                 return normC === normOff || normC.includes(normOff) || normOff.includes(normC);
                             });
                             if (found) {
                                 belongsToOther = otherCat;
                                 break;
                             }
                         }

                         const aliases = {
                             '8-Focus': ['theft', 'robbery', 'murder', 'homicide', 'rape', 'carnapping', 'physical injury'],
                             'PSI': ['accident', 'vehicular', 'traffic', 'collision', 'rir', 'reckless imprudence', 'hit and run', 'dui', 'reckless driving', 'pedestrian hit', 'road crash'],
                             'Non-Index': ['drugs', 'vawc', 'estafa', 'swindling', 'cybercrime', 'gambling', 'firearms', 'child abuse', 'fencing', 'ordinance', 'curfew', 'drinking in public', 'smoking', 'threats', 'coercion', 'lasciviousness', 'malicious mischief', 'perjury', 'libel', 'slander', 'trespass', 'vexation', 'trafficking', 'recruitment', 'alarm and scandal', 'bouncing check']
                         };

                         const currentAliases = aliases[rowCategory] || [];
                         const cleanLower = rawOff.toLowerCase();
                         const matchesCurrentAlias = currentAliases.some(a => cleanLower.includes(a));

                         if (!matchesCurrentAlias) {
                             if (belongsToOther) {
                                 issues.push({ field: 'offense', label: 'Crime Classification', msg: `Belongs to ${belongsToOther}, not ${rowCategory}.` });
                             } else {
                                 let aliasOther = null;
                                 for (const [otherCat, aList] of Object.entries(aliases)) {
                                     if (otherCat === rowCategory) continue;
                                     if (aList.some(a => cleanLower.includes(a))) {
                                         aliasOther = otherCat;
                                         break;
                                     }
                                 }
                                 if (aliasOther) {
                                     issues.push({ field: 'offense', label: 'Crime Classification', msg: `Belongs to ${aliasOther}, not ${rowCategory}.` });
                                 } else {
                                     issues.push({ field: 'offense', label: 'Crime Classification', msg: `Unrecognized crime for ${rowCategory}. Select from dropdown.` });
                                 }
                             }
                         }
                     }
                 }
             }
         }

         return issues;
     };

     // =========================================================================
     // REAL-TIME VALIDATION & ERROR REFRESH DISPATCHERS (MINUS ERRORS AS FIXED)
     // =========================================================================
     window.refreshModalErrorState = function(type) {
         const dataset = type === 'manual' ? manualData : scannerData;
         let totalErrorRows = 0;
         const errorRowNumbers = [];
         const errorBreakdown = { barangay: 0, date: 0, crime: 0 };

         dataset.forEach((item, index) => {
             const issues = window.checkRecordIssues(item);
             if (issues.length > 0) {
                 totalErrorRows++;
                 errorRowNumbers.push(index + 1);
                 issues.forEach(iss => {
                     if (iss.field === 'barangay') errorBreakdown.barangay++;
                     if (iss.field === 'date') errorBreakdown.date++;
                     if (iss.field === 'offense') errorBreakdown.crime++;
                 });
             }
         });

         const errorAlert = document.getElementById(`${type}ModalErrorAlert`);
         const errorTitle = document.getElementById(`${type}ModalErrorTitle`);
         const errorDesc = document.getElementById(`${type}ModalErrorDesc`);
         const errorBadge = document.getElementById(`${type}ModalErrorBadge`);
         const confirmBtn = document.getElementById(type === 'manual' ? 'btnConfirmManual' : 'btnConfirmScanner');

         if (errorAlert) {
             if (totalErrorRows > 0) {
                 errorAlert.classList.remove('hidden');
                 if (errorBadge) {
                     errorBadge.className = "px-3 py-1 rounded-lg bg-rose-500 text-white font-black text-[10px] uppercase tracking-wider shadow-sm animate-pulse";
                     errorBadge.textContent = `${totalErrorRows} Issue(s) to Fix`;
                 }
                 if (errorTitle) {
                     errorTitle.textContent = `Attention Required: ${totalErrorRows} Row(s) Contain Errors (Not applicable to continue)`;
                 }
                 if (errorDesc) {
                     const parts = [];
                     if (errorBreakdown.barangay > 0) parts.push(`${errorBreakdown.barangay} Sector`);
                     if (errorBreakdown.date > 0) parts.push(`${errorBreakdown.date} Timeline/Date`);
                     if (errorBreakdown.crime > 0) parts.push(`${errorBreakdown.crime} Classification`);
                     errorDesc.innerHTML = `Errors detected in <strong>Rows #${errorRowNumbers.slice(0, 8).join(', ')}${errorRowNumbers.length > 8 ? '...' : ''}</strong> (${parts.join(', ')}). Correct the highlighted fields to continue.`;
                 }
             } else {
                 errorAlert.classList.add('hidden');
                 if (errorBadge) {
                     errorBadge.className = "px-3 py-1 rounded-lg bg-emerald-500 text-white font-black text-[10px] uppercase tracking-wider shadow-sm";
                     errorBadge.textContent = "All Records Valid";
                 }
             }
         }

         // Highlight Confirm button status (Not applicable to continue vs Ready)
         if (confirmBtn) {
             if (totalErrorRows > 0) {
                 confirmBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'shadow-blue-500/20');
                 confirmBtn.classList.add('bg-rose-600', 'hover:bg-rose-700', 'shadow-rose-500/20', 'ring-2', 'ring-rose-400/50');
                 confirmBtn.setAttribute('title', `Cannot continue: ${totalErrorRows} row(s) contain validation errors.`);
                 confirmBtn.innerHTML = `<i class="fas fa-exclamation-circle text-white"></i> <span>Fix ${totalErrorRows} Error(s)</span>`;
             } else {
                 confirmBtn.classList.remove('bg-rose-600', 'hover:bg-rose-700', 'shadow-rose-500/20', 'ring-2', 'ring-rose-400/50');
                 confirmBtn.classList.add('bg-blue-600', 'hover:bg-blue-700', 'shadow-blue-500/20');
                 confirmBtn.removeAttribute('title');
                 confirmBtn.innerHTML = `<i class="fas fa-check-circle"></i> <span>Confirm</span>`;
             }
         }
     };

