<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <meta name="theme-color" content="#1A3A5C">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

    <title>System Initialization - CPICRS Master Setup</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pnp: {
                            blue: '#1A3A5C',
                            gold: '#C8A415',
                        }
                    }
                }
            }
        }
    </script>
    <script>
        if (localStorage.getItem('darkMode') === 'true' ||
            (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        button, a, input, select {
            touch-action: manipulation;
        }
    </style>
</head>

<body
    class="min-h-screen flex items-start justify-center p-4 py-12 relative overflow-y-auto transition-all duration-500 bg-cover bg-center bg-no-repeat"
    style="background-image: linear-gradient(to bottom, rgba(26, 58, 92, 0.90), rgba(15, 23, 42, 0.97)), url('/images/stacruz_police_station.jpg');">

    <!-- Desktop Only Guard for security -->
    <div id="desktopOnlyGuard" class="fixed inset-0 z-50 flex flex-col items-center justify-center p-6 bg-slate-950/95 backdrop-blur-xl text-white text-center lg:hidden">
        <div class="max-w-sm w-full p-8 rounded-[2.5rem] bg-slate-900/90 border border-slate-800 shadow-2xl relative overflow-hidden">
            <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-amber-500/10 text-pnp-gold border border-pnp-gold/30 flex items-center justify-center text-3xl shadow-inner">
                <i class="fas fa-desktop"></i>
            </div>
            <span class="inline-block px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-[10px] font-black uppercase tracking-widest mb-3">
                Desktop Access Only
            </span>
            <h2 class="text-xl font-black uppercase tracking-tight text-white mb-2">
                Mobile Access Restricted
            </h2>
            <p class="text-xs text-slate-400 leading-relaxed font-medium mb-6">
                Master system initialization must be performed on an authorized station computer (screens 1024px or wider).
            </p>
            <a href="/"
                class="w-full py-3.5 px-6 rounded-xl bg-pnp-blue hover:bg-blue-900 text-white text-xs font-black uppercase tracking-wider transition border border-white/10 shadow-lg flex items-center justify-center space-x-2">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Return to Public Portal</span>
            </a>
        </div>
    </div>

    <div class="max-w-xl w-full relative z-10 hidden lg:block">
        <!-- Theme Toggle -->
        <div class="flex justify-end mb-4">
            <button onclick="toggleTheme()"
                class="w-10 h-10 bg-white/10 hover:bg-white/20 text-white rounded-xl flex items-center justify-center transition-all duration-300">
                <i id="themeIcon" class="fas fa-moon"></i>
            </button>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[3rem] shadow-2xl overflow-hidden border border-white/20 dark:border-slate-800">
            <!-- Header Banner -->
            <div class="p-10 text-center bg-gray-50 dark:bg-slate-800/60 border-b border-gray-100 dark:border-slate-800">
                <div class="w-20 h-20 bg-pnp-blue dark:bg-slate-900 text-white rounded-3xl flex items-center justify-center mx-auto mb-5 shadow-xl border border-white/10 overflow-hidden">
                    <img src="/images/PNP.jpg" alt="PNP Logo" class="w-16 h-16 object-contain">
                </div>
                <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-pnp-gold/30 text-pnp-gold text-[10px] font-black uppercase tracking-widest mb-2">
                    <i class="fas fa-shield-alt text-xs"></i>
                    <span>One-Time System Initialization</span>
                </div>
                <h1 class="text-2xl font-black text-pnp-blue dark:text-pnp-gold tracking-tighter uppercase mb-1">
                    Setup Super Administrator
                </h1>
                <p class="text-[11px] text-gray-500 dark:text-gray-400 font-medium max-w-md mx-auto">
                    Configure the root administrative credentials for the Santa Cruz CPICRS portal. Once registered, this initialization page will be permanently disabled.
                </p>
            </div>

            <div class="p-10">
                <!-- Security Warning Banner -->
                <div class="mb-8 p-4 rounded-2xl bg-amber-500/10 border border-pnp-gold/20 flex items-start space-x-3 text-left">
                    <i class="fas fa-lock text-pnp-gold text-lg mt-0.5 shrink-0"></i>
                    <div class="text-[11px] text-slate-700 dark:text-slate-300 leading-relaxed">
                        <strong class="text-pnp-blue dark:text-pnp-gold font-bold">Anti-Scraping Security Protocol:</strong>
                        Default credentials are not stored in the repository. The account you create here is stored securely in the database using bcrypt salted hashing.
                    </div>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg) { %>
                    <div class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl text-xs font-bold uppercase tracking-widest mb-6 border border-red-100 dark:border-red-900/30 flex items-center space-x-3">
                        <i class="fas fa-exclamation-circle text-base shrink-0"></i>
                        <span><%= error_msg %></span>
                    </div>
                <% } %>

                <form action="/admin/setup" method="POST" id="setupForm" class="space-y-6">
                    <!-- Full Name -->
                    <div class="space-y-1.5">
                        <label for="full_name" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                            Full Name & Rank <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="text" name="full_name" id="full_name" required placeholder="e.g. PMAJ Juan Dela Cruz"
                                class="w-full pl-12 pr-4 py-3.5 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-id-badge absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                        </div>
                    </div>

                    <!-- Email Address -->
                    <div class="space-y-1.5">
                        <label for="email" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                            Official Email Address <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="email" name="email" id="email" required placeholder="e.g. chief.stacruz@pnp.gov.ph"
                                class="w-full pl-12 pr-4 py-3.5 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                        </div>
                    </div>

                    <!-- Username -->
                    <div class="space-y-1.5">
                        <label for="username" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                            Master Username <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="text" name="username" id="username" required placeholder="e.g. chief_admin"
                                class="w-full pl-12 pr-4 py-3.5 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-user-shield absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                        </div>
                    </div>

                    <!-- Master Password -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between items-center">
                            <label for="password" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                                Master Password <span class="text-red-500">*</span>
                            </label>
                            <span class="text-[9px] text-gray-400 font-mono">Min 8 characters</span>
                        </div>
                        <div class="relative">
                            <input type="password" name="password" id="password" required minlength="8" placeholder="••••••••••••"
                                class="w-full pl-12 pr-12 py-3.5 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                            <button type="button" onclick="togglePassVisibility('password', 'eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-gold focus:outline-none">
                                <i id="eye1" class="fas fa-eye text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="space-y-1.5">
                        <label for="confirm_password" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                            Confirm Master Password <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password" name="confirm_password" id="confirm_password" required minlength="8" placeholder="••••••••••••"
                                class="w-full pl-12 pr-12 py-3.5 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-check-double absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 dark:text-gray-500"></i>
                            <button type="button" onclick="togglePassVisibility('confirm_password', 'eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-gold focus:outline-none">
                                <i id="eye2" class="fas fa-eye text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Optional Setup Passcode if configured in .env -->
                    <% if (typeof requireSecret !== 'undefined' && requireSecret) { %>
                    <div class="space-y-1.5">
                        <div class="flex justify-between items-center">
                            <label for="setup_key" class="block text-[10px] font-black text-pnp-gold uppercase tracking-widest">
                                Server Setup Secret Key <span class="text-red-500">*</span>
                            </label>
                            <span class="text-[9px] text-gray-400">Configured in server .env</span>
                        </div>
                        <div class="relative">
                            <input type="password" name="setup_key" id="setup_key" required placeholder="Enter server SETUP_SECRET_KEY"
                                class="w-full pl-12 pr-4 py-3.5 bg-amber-500/5 dark:bg-slate-800 border border-pnp-gold/40 rounded-2xl focus:ring-4 focus:ring-pnp-gold/20 outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                            <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-pnp-gold"></i>
                        </div>
                    </div>
                    <% } %>

                    <!-- Submit Button -->
                    <button type="submit"
                        class="w-full mt-4 bg-pnp-blue dark:bg-pnp-gold hover:bg-blue-900 dark:hover:bg-yellow-600 text-white dark:text-pnp-blue font-black py-4 rounded-2xl shadow-xl transition duration-300 transform hover:-translate-y-1 flex items-center justify-center space-x-3 uppercase tracking-widest text-xs">
                        <i class="fas fa-shield-alt text-sm"></i>
                        <span>Initialize Super Administrator</span>
                    </button>
                </form>

                <div class="mt-8 text-center">
                    <a href="/"
                        class="text-[10px] font-black text-gray-400 dark:text-gray-500 hover:text-pnp-blue dark:hover:text-pnp-gold uppercase tracking-widest transition">
                        <i class="fas fa-arrow-left mr-2"></i> Return to Public Site
                    </a>
                </div>
            </div>
        </div>

        <p class="text-center text-[10px] text-white/30 font-black uppercase tracking-widest mt-6">
            &copy; 2026 PNP Sta. Cruz Municipal Police Station • Secure Initialization
        </p>
    </div>

    <script>
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('darkMode', isDark);
            updateIcon();
        }

        function updateIcon() {
            const icon = document.getElementById('themeIcon');
            if (document.documentElement.classList.contains('dark')) {
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }
        updateIcon();

        function togglePassVisibility(inputId, iconId) {
            const el = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (el.type === 'password') {
                el.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                el.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        document.getElementById('setupForm').addEventListener('submit', function (e) {
            const p1 = document.getElementById('password').value;
            const p2 = document.getElementById('confirm_password').value;
            if (p1 !== p2) {
                e.preventDefault();
                alert('Master Password and Confirmation Password do not match!');
            }
        });
    </script>
</body>

</html>
