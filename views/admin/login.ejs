<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon & Search Engine Logo Configuration -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#1A3A5C">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

    <title>Admin Login - CPICRS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pnp: {
                            blue: '#1A3A5C',
                            gold: '#C8A415',
                        }
                    }
                }
            }
        }
    </script>
    <script>
        // Check for saved theme preference or use system preference
        if (localStorage.getItem('darkMode') === 'true' ||
            (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Vercel Web Analytics -->
    <%- include('../partials/analytics') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        button, a, input, select {
            touch-action: manipulation;
        }
    </style>
</head>

<body
    class="min-h-screen flex items-start justify-center p-4 py-12 relative overflow-y-auto transition-all duration-500 bg-cover bg-center bg-no-repeat"
    style="background-image: linear-gradient(to bottom, rgba(26, 58, 92, 0.85), rgba(15, 23, 42, 0.95)), url('/images/home_hero.jpg');">
    <!-- Background Decoration -->
    <div class="absolute top-0 left-0 w-full h-full opacity-5">
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border-[50px] border-white dark:border-pnp-gold rounded-full">
        </div>
    </div>

    <!-- Mobile Device & Small Screen Access Blocker -->
    <div id="desktopOnlyGuard" class="fixed inset-0 z-50 flex flex-col items-center justify-center p-6 bg-slate-950/95 backdrop-blur-xl text-white text-center lg:hidden">
        <div class="max-w-sm w-full p-8 rounded-[2.5rem] bg-slate-900/90 border border-slate-800 shadow-2xl relative overflow-hidden">
            <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-amber-500/10 text-pnp-gold border border-pnp-gold/30 flex items-center justify-center text-3xl shadow-inner">
                <i class="fas fa-desktop"></i>
            </div>
            
            <span class="inline-block px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-[10px] font-black uppercase tracking-widest mb-3">
                Desktop Access Only
            </span>

            <h2 class="text-xl font-black uppercase tracking-tight text-white mb-2">
                Mobile Access Disabled
            </h2>

            <p class="text-xs text-slate-400 leading-relaxed font-medium mb-6">
                The CPICRS Administration Portal is strictly restricted to desktop and laptop computers (screens 1024px or wider). Administrative operations and crime record management are disabled on mobile phones.
            </p>

            <div class="p-3.5 rounded-2xl bg-slate-800/60 border border-slate-700/50 mb-6 flex items-center space-x-3 text-left">
                <i class="fas fa-shield-halved text-pnp-gold text-lg shrink-0"></i>
                <div class="text-[11px] text-slate-300">
                    <p class="font-bold text-white">Security Protocol</p>
                    <p class="text-slate-400 text-[10px]">Please access this system from an authorized station workstation or PC.</p>
                </div>
            </div>

            <a href="/"
                class="w-full py-3.5 px-6 rounded-xl bg-pnp-blue hover:bg-blue-900 active:scale-95 text-white text-xs font-black uppercase tracking-wider transition border border-white/10 shadow-lg flex items-center justify-center space-x-2">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Return to Public Portal</span>
            </a>
        </div>
    </div>

    <div class="max-w-md w-full relative z-10 hidden lg:block">
        <!-- Theme Toggle -->
        <div class="flex justify-end mb-4">
            <button onclick="toggleTheme()"
                class="w-10 h-10 bg-white/10 hover:bg-white/20 text-white rounded-xl flex items-center justify-center transition-all duration-300">
                <i id="themeIcon" class="fas fa-moon"></i>
            </button>
        </div>

        <div
            class="bg-white dark:bg-slate-900 rounded-[3rem] shadow-2xl overflow-hidden border border-white/20 dark:border-slate-800">
            <div
                class="p-12 text-center bg-gray-50 dark:bg-slate-800/50 border-b border-gray-100 dark:border-slate-800">
                <div
                    class="w-20 h-20 bg-pnp-blue dark:bg-slate-900 text-white rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-xl border border-white/10 overflow-hidden">
                    <img src="/images/PNP.jpg" alt="PNP Logo" class="w-16 h-16 object-contain">
                </div>
                <h1 class="text-3xl font-black text-pnp-blue dark:text-pnp-gold tracking-tighter uppercase mb-2">Admin
                    Portal</h1>
                <p class="text-[10px] text-gray-400 dark:text-gray-500 font-black uppercase tracking-widest">Authorized
                    Personnel Only</p>
            </div>

            <div class="p-12">
                <% if (typeof success_msg !=='undefined' && success_msg) { %>
                    <div
                        class="bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 p-4 rounded-2xl text-xs font-bold uppercase tracking-widest mb-8 border border-emerald-100 dark:border-emerald-900/30 flex items-center space-x-3">
                        <i class="fas fa-check-circle"></i>
                        <span>
                            <%= success_msg %>
                        </span>
                    </div>
                <% } %>
                <!-- Security Lockout Banner (Persistent across refresh) -->
                <div id="lockoutBox" class="<%= (typeof lockout_seconds !== 'undefined' && lockout_seconds > 0) ? '' : 'hidden' %> bg-amber-500/10 border-2 border-pnp-gold/50 text-amber-700 dark:text-pnp-gold p-5 rounded-2xl mb-8 flex flex-col items-center space-y-3 text-center shadow-lg">
                    <div class="flex items-center space-x-2 text-xs font-black uppercase tracking-widest text-amber-600 dark:text-pnp-gold">
                        <i class="fas fa-shield-alt text-base animate-pulse"></i>
                        <span>Security Lockout Active</span>
                    </div>
                    <p id="lockoutDesc" class="text-[11px] text-gray-600 dark:text-slate-300 font-semibold leading-relaxed">
                        <%= (typeof error_msg !== 'undefined' && error_msg && typeof lockout_seconds !== 'undefined' && lockout_seconds > 0) ? error_msg : '5 consecutive failed attempts detected. Access is temporarily locked for 5 minutes.' %>
                    </p>
                    <div class="w-full py-2.5 px-4 bg-white/60 dark:bg-slate-800/80 rounded-xl border border-pnp-gold/30 font-mono text-sm font-black text-pnp-blue dark:text-pnp-gold tracking-widest flex items-center justify-center space-x-2">
                        <i class="fas fa-hourglass-half text-xs animate-spin" style="animation-duration: 3s;"></i>
                        <span>RETRY IN: <span id="countdownTimer">--:--</span></span>
                    </div>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg && (!lockout_seconds || lockout_seconds <= 0)) { %>
                    <div id="generalErrorBox"
                        class="bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 p-4 rounded-2xl text-xs font-bold uppercase tracking-widest mb-8 border border-red-100 dark:border-red-900/30 flex items-center space-x-3">
                        <i class="fas fa-exclamation-circle text-base shrink-0"></i>
                        <span>
                            <%= error_msg %>
                        </span>
                    </div>
                <% } %>

                        <form action="/admin/login" method="POST" class="space-y-8" onsubmit="return validateLoginForm(event)">
                            <div class="space-y-2">
                                <label for="username"
                                    class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">Email Address</label>
                                <div class="relative">
                                    <input type="text" name="username" id="username" required
                                        placeholder="Enter email address"
                                        class="w-full pl-12 pr-6 py-4 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                                    <i
                                        class="fas fa-user absolute left-5 top-1/2 -translate-y-1/2 text-gray-300 dark:text-gray-600"></i>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="password"
                                    class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">Password</label>
                                <div class="relative">
                                    <input type="password" name="password" id="password" required placeholder="••••••••"
                                        class="w-full pl-12 pr-12 py-4 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-sm text-pnp-blue dark:text-white">
                                    <i
                                        class="fas fa-lock absolute left-5 top-1/2 -translate-y-1/2 text-gray-300 dark:text-gray-600"></i>
                                    <button type="button" onclick="togglePasswordVisibility()" class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-blue dark:hover:text-pnp-gold focus:outline-none">
                                        <i id="eyeIcon" class="fas fa-eye text-xs"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit"
                                class="w-full bg-pnp-blue dark:bg-pnp-gold hover:bg-blue-900 dark:hover:bg-yellow-600 text-white dark:text-pnp-blue font-black py-5 rounded-2xl shadow-2xl transition duration-300 transform hover:-translate-y-1 flex items-center justify-center space-x-3 uppercase tracking-widest text-xs">
                                <span>Secure Login</span>
                                <i class="fas fa-arrow-right text-[10px]"></i>
                            </button>
                        </form>

                        <div class="mt-12 text-center">
                            <a href="/"
                                class="text-[10px] font-black text-gray-400 dark:text-gray-500 hover:text-pnp-blue dark:hover:text-pnp-gold uppercase tracking-widest transition">
                                <i class="fas fa-arrow-left mr-2"></i> Return to Public Site
                            </a>
                        </div>
            </div>
        </div>

        <p class="text-center text-[10px] text-white/30 font-black uppercase tracking-widest mt-8">
            &copy; 2026 PNP Sta. Cruz Municipal Police Station
        </p>
    </div>

    <script>
        function updateIcon() {
            const icon = document.getElementById('themeIcon');
            if (document.documentElement.classList.contains('dark')) {
                icon.classList.remove('fa-moon');
                icon.classList.add('fa-sun');
            } else {
                icon.classList.remove('fa-sun');
                icon.classList.add('fa-moon');
            }
        }

        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('darkMode', isDark);
            updateIcon();
        }

        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        function validateLoginForm(e) {
            const usernameInput = document.getElementById('username');
            const passwordInput = document.getElementById('password');
            const cleanUser = (usernameInput.value || '').trim();
            const cleanPass = (passwordInput.value || '').trim();

            if (!cleanUser) {
                alert('Email address cannot be empty or blank spaces.');
                usernameInput.focus();
                e.preventDefault();
                return false;
            }
            if (!cleanPass) {
                alert('Password cannot be empty or blank spaces.');
                passwordInput.focus();
                e.preventDefault();
                return false;
            }
            return true;
        }

        // Initial icon state
        updateIcon();

        // Clean expired query from URL so refreshing does not retain stale expired state
        if (window.location.search.includes('expired=')) {
            const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
            window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
        }

        // Desktop-only enforcement helper for body scroll locks
        const syncDesktopOnlyGuard = () => {
            if (window.innerWidth < 1024) {
                document.body.classList.add('overflow-hidden');
            } else {
                document.body.classList.remove('overflow-hidden');
            }
        };
        window.addEventListener('resize', syncDesktopOnlyGuard);
        syncDesktopOnlyGuard();

        // Security Lockout 5-Minute Countdown Manager (Guaranteed Anti-Bypass)
        (function() {
            const serverSeconds = <%= (typeof lockout_seconds !== 'undefined' && lockout_seconds) ? lockout_seconds : 0 %>;
            const now = Date.now();
            let storedUntil = parseInt(localStorage.getItem('cpicrs_lockout_until') || '0', 10);

            // 1. Sync from server response if server returned an active lockout
            if (serverSeconds > 0) {
                storedUntil = Math.max(storedUntil, now + (serverSeconds * 1000));
                localStorage.setItem('cpicrs_lockout_until', String(storedUntil));
            }

            // 2. Check for cookie-based lockout timestamp
            const cookieMatch = document.cookie.match(/cpicrs_lockout_time=([0-9]+)/);
            if (cookieMatch && cookieMatch[1]) {
                const cookieTime = parseInt(cookieMatch[1], 10);
                if (cookieTime > storedUntil) {
                    storedUntil = cookieTime;
                    localStorage.setItem('cpicrs_lockout_until', String(storedUntil));
                }
            }

            // 3. If lockout is active, enforce UI lockdown and continuous countdown
            if (storedUntil > now) {
                const lockoutBox = document.getElementById('lockoutBox');
                const generalErrorBox = document.getElementById('generalErrorBox');
                const submitBtn = document.querySelector('button[type="submit"]');
                const timerEl = document.getElementById('countdownTimer');
                const usernameInput = document.getElementById('username');
                const passwordInput = document.getElementById('password');
                const loginForm = document.querySelector('form[action="/admin/login"]');

                if (lockoutBox) lockoutBox.classList.remove('hidden');
                if (generalErrorBox) generalErrorBox.classList.add('hidden');

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
                }
                if (usernameInput) usernameInput.disabled = true;
                if (passwordInput) passwordInput.disabled = true;

                // Prevent form submission on enter key
                if (loginForm) {
                    loginForm.onsubmit = function(e) {
                        if (Date.now() < storedUntil) {
                            e.preventDefault();
                            return false;
                        }
                    };
                }

                function tick() {
                    const currentNow = Date.now();
                    const remainingSeconds = Math.ceil((storedUntil - currentNow) / 1000);

                    if (remainingSeconds <= 0) {
                        localStorage.removeItem('cpicrs_lockout_until');
                        if (timerEl) timerEl.innerText = "00:00 (Ready)";
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed', 'pointer-events-none');
                        }
                        if (usernameInput) usernameInput.disabled = false;
                        if (passwordInput) passwordInput.disabled = false;
                        if (loginForm) loginForm.onsubmit = null;
                        if (lockoutBox) lockoutBox.classList.add('opacity-60');
                        return;
                    }

                    const m = Math.floor(remainingSeconds / 60);
                    const s = remainingSeconds % 60;
                    if (timerEl) {
                        timerEl.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                    }
                    setTimeout(tick, 1000);
                }
                tick();
            } else {
                localStorage.removeItem('cpicrs_lockout_until');
            }
        })();
    </script>
</body>

</html>