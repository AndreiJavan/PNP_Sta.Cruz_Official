<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon & Search Engine Logo Configuration -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#1A3A5C">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

    <title>Admin Dashboard - MIMPAS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pnp: {
                            blue: {
                                50: '#EBF1F7',
                                100: '#D1DEEB',
                                200: '#A3BDD7',
                                300: '#759CC3',
                                400: '#477BAF',
                                500: '#1A3A5C',
                                600: '#152E4A',
                                700: '#102237',
                                800: '#0A1725',
                                900: '#050B12',
                                DEFAULT: '#1A3A5C',
                            },
                            gold: {
                                50: '#FAF7E8',
                                100: '#F5F0D1',
                                200: '#EBE1A3',
                                300: '#E1D275',
                                400: '#D7C347',
                                500: '#C8A415',
                                600: '#A08311',
                                700: '#78620D',
                                800: '#504109',
                                900: '#282104',
                                DEFAULT: '#C8A415',
                            }
                        }
                    }
                }
            }
        }
    </script>
    <script>
        // Check for dark mode preference
        if (localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Vercel Web Analytics -->
    <%- include('../partials/analytics') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
        }

        .bg-pnp-blue {
            background-color: #1A3A5C;
        }

        .text-pnp-blue {
            color: #1A3A5C;
        }

        .bg-pnp-gold {
            background-color: #C8A415;
        }

        .text-pnp-gold {
            color: #C8A415;
        }

        .border-pnp-gold {
            border-color: #C8A415;
        }

        /* Border utility fallback for border-gray-150 in both themes */
        .border-gray-150 {
            border-color: #e2e8f0;
        }
        .dark .border-gray-150 {
            border-color: rgba(51, 65, 85, 0.6);
        }

        .pnp-gradient-blue {
            background: linear-gradient(135deg, #1A3A5C 0%, #0A1725 100%);
        }

        .pnp-card {
            @apply bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700/50 shadow-sm transition-all duration-300;
        }

        .pnp-card:hover {
            @apply shadow-xl border-pnp-blue/20 transform -translate-y-1;
        }

        .pnp-glass {
            background: rgba(255, 255, 255, 0.01);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .pnp-glass-dark {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .text-shadow-tactical {
            text-shadow: 0 0 20px rgba(200, 164, 21, 0.3);
        }

        .sidebar-item-active {
            @apply bg-white/20 border-l-4 border-white shadow-[inset_-10px_0_20px_rgba(255, 255, 255, 0.05)];
        }

        /* Global scrollbar hiding */
        * {
            scrollbar-width: none !important;
            -ms-overflow-style: none !important;
        }

        *::-webkit-scrollbar {
            display: none !important;
        }

        /* Sidebar toggle states & flexible layout */
        .sidebar-hidden {
            transform: translateX(-100%);
        }

        .main-content-expanded {
            margin-left: 0 !important;
            width: 100% !important;
        }

        @media (min-width: 1024px) {
            #sidebar:not(.sidebar-hidden) + #mainContent {
                margin-left: 16rem;
                /* w-64 matches aside width (decreased by 10% from 18rem) */
                width: calc(100% - 16rem) !important;
            }
        }

        #layoutHeader,
        #layoutFooter {
            left: 0;
            width: 100%;
            transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (min-width: 1024px) {
            #sidebar:not(.sidebar-hidden) ~ #mainContent #layoutHeader,
            #sidebar:not(.sidebar-hidden) ~ #mainContent #layoutFooter {
                left: 16rem;
                width: calc(100% - 16rem);
            }
        }
    </style>
</head>

<body class="bg-[#eaedf2] dark:bg-slate-950 min-h-screen flex transition-colors duration-300 overflow-x-hidden">
    <!-- Global Network Resilience Banner -->
    <div id="networkStatusBanner" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] hidden transition-all duration-300 transform -translate-y-4 opacity-0 pointer-events-none">
        <div id="networkStatusContent" class="flex items-center gap-3 px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider shadow-2xl backdrop-blur-md border">
            <span id="networkStatusIcon"></span>
            <span id="networkStatusText"></span>
        </div>
    </div>

    <!-- Mobile Device & Small Screen Access Blocker -->
    <div id="desktopOnlyGuard" class="fixed inset-0 z-[99999] flex flex-col items-center justify-center p-6 bg-slate-950 text-white text-center lg:hidden">
        <div class="max-w-md w-full p-8 rounded-[2.5rem] bg-slate-900 border border-slate-800 shadow-2xl relative overflow-hidden">
            <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-amber-500/10 text-pnp-gold border border-pnp-gold/30 flex items-center justify-center text-3xl shadow-inner">
                <i class="fas fa-desktop"></i>
            </div>
            
            <span class="inline-block px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-[10px] font-black uppercase tracking-widest mb-3">
                Desktop Access Only
            </span>

            <h2 class="text-xl font-black uppercase tracking-tight text-white mb-2">
                Mobile Access Disabled
            </h2>

            <p class="text-xs text-slate-400 leading-relaxed font-medium mb-6">
                The MIMPAS (Municipality Incident Management and Public Advisory Sta.Cruz) Administration Console and Crime Map Command is strictly restricted to desktop and laptop computers (screens 1024px or wider). Mobile access is disabled for operational security, tactical mapping precision, and data integrity.
            </p>

            <div class="p-3.5 rounded-2xl bg-slate-800/60 border border-slate-700/50 mb-6 flex items-center space-x-3 text-left">
                <i class="fas fa-shield-halved text-pnp-gold text-lg shrink-0"></i>
                <div class="text-[11px] text-slate-300">
                    <p class="font-bold text-white">Station Protocol</p>
                    <p class="text-slate-400 text-[10px]">Please access this console from an authorized station workstation, PC, or laptop.</p>
                </div>
            </div>

            <a href="/"
                class="w-full py-3.5 px-6 rounded-xl bg-pnp-blue hover:bg-blue-900 text-white text-xs font-black uppercase tracking-wider transition border border-white/10 shadow-lg flex items-center justify-center space-x-2">
                <i class="fas fa-arrow-left text-xs"></i>
                <span>Return to Public Portal</span>
            </a>
        </div>
    </div>

    <!-- Fixed Sidebar (All controls visible, high-contrast readable text) -->
    <aside id="sidebar"
        class="w-64 pnp-gradient-blue text-white hidden lg:flex flex-col fixed top-0 left-0 h-screen z-50 shadow-2xl border-r-4 border-pnp-gold/50 transition-transform duration-300 overflow-y-auto justify-between <%= typeof hideSidebar !== 'undefined' && hideSidebar ? 'sidebar-hidden' : '' %>">
        <!-- Brand Header with Logo in White Circle -->
        <div class="px-4 py-3.5 border-b border-white/10 flex items-center justify-between shrink-0">
            <div class="flex items-center space-x-3 min-w-0">
                <!-- White circular logo container with MIMPAS logo -->
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center p-1 shadow-md border border-white/20 shrink-0">
                    <img src="/favicon.png" alt="MIMPAS Logo" class="w-full h-full object-contain rounded-full"
                        onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                </div>
                <div class="min-w-0">
                    <h1 class="text-base font-black tracking-wider leading-none text-white">M I M P A S</h1>
                    <p class="text-[8px] text-blue-100 uppercase tracking-wider font-bold mt-1 leading-tight">Municipality Incident Management and Public Advisory Sta.Cruz</p>
                </div>
            </div>
            <button id="sidebarClose" class="lg:hidden text-white/50 hover:text-white transition cursor-pointer">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Navigation Menu (All items clearly visible, high contrast text) -->
        <nav class="flex-grow px-3 py-2 space-y-1.5 overflow-y-auto flex flex-col justify-start">
            <p class="text-[9.5px] text-blue-200 uppercase tracking-[0.2em] font-black mb-1 px-3">Main Menu</p>

            <a href="/admin/dashboard"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Dashboard' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Dashboard' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-chart-line text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Dashboard</span>
            </a>

            <a href="/admin/bulletins"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Bulletins' || title === 'New Bulletin' || title === 'Edit Bulletin' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Bulletins' || title === 'New Bulletin' || title === 'Edit Bulletin' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-bullhorn text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Bulletins</span>
            </a>

            <a href="/admin/reports"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Crime Reports' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Crime Reports' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-file-invoice text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Crime Reports</span>
            </a>

            <a href="/admin/map"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Map' || title === 'Map Management' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Map' || title === 'Map Management' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-map-location-dot text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Crime Map</span>
            </a>

            <a href="/admin/hotlines"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Hotlines' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Hotlines' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-phone-volume text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Hotlines</span>
            </a>

            <% if (user && user.role === 'superadmin') { %>
                <a href="/admin/users"
                    class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Users' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                    <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Users' ? 'text-white' : 'text-white/80' %>">
                        <i class="fas fa-users-cog text-xs"></i>
                    </div>
                    <span class="text-xs font-bold uppercase tracking-wider">Users</span>
                </a>
            <% } %>

            <a href="/admin/archive"
                class="flex items-center space-x-3 px-3 py-2 rounded-xl transition-all duration-200 group <%= title === 'Archive' ? 'sidebar-item-active text-white font-black bg-white/20' : 'hover:bg-white/10 text-white/90 font-bold' %>">
                <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center group-hover:scale-105 transition-transform shrink-0 <%= title === 'Archive' ? 'text-white' : 'text-white/80' %>">
                    <i class="fas fa-box-archive text-xs"></i>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider">Archive</span>
            </a>
        </nav>

        <!-- Sidebar Footer -->
        <div class="p-3 border-t border-white/10 space-y-1.5 shrink-0">
            <!-- Quick utilities: Dark Theme, Instruction Manual, Public Site -->
            <div class="flex items-center justify-between gap-1.5 px-1 py-0.5">
                <button id="darkModeToggle" title="Toggle Theme (Dark / Light)"
                    class="flex-1 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white hover:text-white flex items-center justify-center transition cursor-pointer">
                    <i class="fas fa-moon text-xs dark:hidden"></i>
                    <i class="fas fa-sun text-xs hidden dark:block"></i>
                </button>
                <button onclick="toggleHelpModal()" title="Instruction Manual"
                    class="flex-1 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white hover:text-white flex items-center justify-center transition cursor-pointer">
                    <i class="fas fa-question text-xs"></i>
                </button>
                <a href="/" title="View Public Portal"
                    class="flex-1 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white hover:text-white flex items-center justify-center transition cursor-pointer">
                    <i class="fas fa-globe text-xs"></i>
                </a>
            </div>

            <button onclick="openChangePasswordModal()"
                class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg bg-white/10 hover:bg-white/20 text-white transition duration-200 group cursor-pointer"
                title="Change Account Password">
                <i class="fas fa-key text-[10px] text-white/80 group-hover:scale-105 transition shrink-0"></i>
                <span class="text-[10px] font-bold uppercase tracking-wider text-white">Change Password</span>
            </button>
            <a href="/admin/logout" onclick="confirmLogout(event); return false;"
                class="flex items-center space-x-2.5 px-3 py-2 rounded-lg bg-red-500/20 text-red-200 hover:bg-red-600 hover:text-white transition duration-200 group cursor-pointer"
                title="End Administrative Session">
                <i class="fas fa-sign-out-alt text-[10px] group-hover:scale-105 transition shrink-0"></i>
                <span class="text-[10px] font-bold uppercase tracking-wider text-red-200 group-hover:text-white">Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area (Navbar removed per user request) -->
    <div id="mainContent"
        class="hidden lg:flex flex-grow lg:ml-64 <%= typeof hideSidebar !== 'undefined' && hideSidebar ? 'main-content-expanded' : '' %> flex-col min-h-screen transition-all duration-300 w-full lg:w-auto">
        <!-- Floating Sidebar Toggle Button (Visible if sidebar is collapsed) -->
        <button id="sidebarToggle"
            class="fixed top-3 left-3 z-40 w-9 h-9 rounded-xl bg-pnp-blue text-white shadow-lg flex items-center justify-center hover:bg-blue-900 transition <%= typeof hideSidebar !== 'undefined' && hideSidebar ? '' : 'lg:hidden' %> cursor-pointer"
            title="Toggle Sidebar Navigation">
            <i class="fas fa-bars text-sm"></i>
        </button>

        <!-- Page Body -->
        <main class="flex-grow animate-fade-in <%= (title === 'Map Management' || title === 'Map' ? 'p-0' : 'p-4 sm:p-6 pb-20') %>">
            <!-- Flash Messages -->
            <% if (typeof success_msg !=='undefined' && success_msg) { %>
                <div
                    class="bg-green-50 text-green-600 p-4 sm:p-5 rounded-xl text-xs font-bold uppercase tracking-widest mb-6 border border-green-100 flex items-center space-x-4 shadow-sm mx-4 sm:mx-6">
                    <i class="fas fa-check-circle text-base"></i>
                    <span>
                        <%= success_msg %>
                    </span>
                </div>
                <% } %>
                    <% if (typeof error_msg !=='undefined' && error_msg) { %>
                        <div
                            class="bg-red-50 text-red-600 p-4 sm:p-5 rounded-xl text-xs font-bold uppercase tracking-widest mb-6 border border-red-100 flex items-center space-x-4 shadow-sm mx-4 sm:mx-6">
                            <i class="fas fa-exclamation-circle text-base"></i>
                            <span>
                                <%= error_msg %>
                            </span>
                        </div>
                        <% } %>

                            <%- body %>
        </main>
    </div>

    <script>
        const darkModeToggle = document.getElementById('darkModeToggle');
        if (darkModeToggle) {
            darkModeToggle.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark');
                localStorage.setItem('darkMode', document.documentElement.classList.contains('dark'));
            });
        }

        // Sidebar Toggle Logic
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebarClose = document.getElementById('sidebarClose');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('mainContent');
        const layoutHeader = document.getElementById('layoutHeader');
        const layoutFooter = document.getElementById('layoutFooter');

        const toggleSidebar = () => {
            sidebar.classList.toggle('sidebar-hidden');
            mainContent.classList.toggle('main-content-expanded');

            const isHidden = sidebar.classList.contains('sidebar-hidden');
            localStorage.setItem('sidebarHidden', isHidden);

            // Invalidate map size if a Leaflet map is loaded on the page
            setTimeout(() => {
                if (window.map) {
                    window.map.invalidateSize({ pan: false });
                }
            }, 350);

            // Notify server to persist state across refreshes
            fetch('/admin/api/toggle-sidebar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ hideSidebar: isHidden })
            }).catch(err => console.error('Failed to sync sidebar state'));
        };

        sidebarToggle.addEventListener('click', toggleSidebar);
        sidebarClose.addEventListener('click', toggleSidebar);

        // Global Double-Click and Repetitive Action Prevention
        document.addEventListener('submit', (e) => {
            if (e.defaultPrevented) return;
            const form = e.target;
            const submitButtons = form.querySelectorAll('button[type="submit"]');
            submitButtons.forEach(btn => {
                if (btn.dataset.isPruned === 'true') {
                    // e.preventDefault(); // Don't prevent standard submission if it's already pruning
                    return;
                }
                btn.dataset.isPruned = 'true';
                const originalText = btn.innerHTML;
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Transmitting...';
                    btn.disabled = true;
                    btn.classList.add('opacity-50', 'cursor-not-allowed');
                }, 10);
            });
        });

        // Hide Header and only show Footer at the bottom
        let lastScrollTop = 0;
        const footer = document.getElementById('layoutFooter');

        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            let windowHeight = window.innerHeight;
            let documentHeight = document.documentElement.scrollHeight;

            // Header logic: hide on scroll down, show on scroll up
            if (layoutHeader) {
                if (scrollTop > lastScrollTop && scrollTop > 50) {
                    layoutHeader.style.transform = 'translateY(-100%)';
                } else {
                    layoutHeader.style.transform = 'translateY(0)';
                }
            }

            // Footer logic: only show when near the bottom
            if (footer) {
                if ((windowHeight + scrollTop) >= (documentHeight - 100)) {
                    footer.style.transform = 'translateY(0)';
                    footer.style.opacity = '1';
                } else {
                    footer.style.transform = 'translateY(100%)';
                    footer.style.opacity = '0';
                }
            }

            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, { passive: true });

        // Responsive Sidebar Initial State
        const savedState = localStorage.getItem('sidebarHidden');
        const forceHide = <%= typeof hideSidebar !== 'undefined' && hideSidebar ? 'true' : 'false' %>;


        if (forceHide || window.innerWidth < 1024 || savedState === 'true') {
            sidebar.classList.add('sidebar-hidden');
            mainContent.classList.add('main-content-expanded');

            // If it was forced, save it to local storage for consistency
            if (forceHide) localStorage.setItem('sidebarHidden', 'true');
        } else if (savedState === 'false' && window.innerWidth >= 1024) {
            sidebar.classList.remove('sidebar-hidden');
            mainContent.classList.remove('main-content-expanded');
        }

        // Handle viewport resize for flexible responsiveness
        window.addEventListener('resize', () => {
            if (window.innerWidth < 1024) {
                sidebar.classList.add('sidebar-hidden');
                mainContent.classList.add('main-content-expanded');
            }
            if (window.map) {
                window.map.invalidateSize({ pan: false });
            }
        });

        // Global Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            // Ignore if typing in an input
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') return;

            // CTRL + / -> Toggle Help Modal
            if (e.ctrlKey && e.key === '/') {
                e.preventDefault();
                if (typeof toggleHelpModal === 'function') toggleHelpModal();
            }

            // CTRL + B -> Toggle Sidebar
            if (e.ctrlKey && e.key.toLowerCase() === 'b') {
                e.preventDefault();
                toggleSidebar();
            }

            // ESC -> Close Help Modal
            if (e.key === 'Escape') {
                const helpModal = document.getElementById('helpModal');
                if (helpModal && !helpModal.classList.contains('hidden') && typeof toggleHelpModal === 'function') {
                    toggleHelpModal();
                }
            }
        });

        // ==========================================
        // Robust Network & Session Resilience System
        // ==========================================
        const networkBanner = document.getElementById('networkStatusBanner');
        const networkStatusContent = document.getElementById('networkStatusContent');
        const networkStatusIcon = document.getElementById('networkStatusIcon');
        const networkStatusText = document.getElementById('networkStatusText');
        let networkBannerTimeout = null;

        function showNetworkBanner(status, message) {
            if (!networkBanner || !networkStatusContent || !networkStatusIcon || !networkStatusText) return;
            if (networkBannerTimeout) clearTimeout(networkBannerTimeout);

            networkBanner.classList.remove('hidden');
            // Force reflow for transition
            void networkBanner.offsetWidth;

            if (status === 'offline') {
                networkStatusContent.className = 'flex items-center gap-3 px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider shadow-2xl backdrop-blur-md border bg-amber-500/90 dark:bg-amber-600/90 text-white border-amber-400/50';
                networkStatusIcon.innerHTML = '<i class="fas fa-wifi-slash animate-pulse text-sm"></i>';
                networkStatusText.textContent = message || 'Connection lost. Reconnecting...';
                networkBanner.classList.remove('-translate-y-4', 'opacity-0');
                networkBanner.classList.add('translate-y-0', 'opacity-100');
            } else if (status === 'online') {
                networkStatusContent.className = 'flex items-center gap-3 px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider shadow-2xl backdrop-blur-md border bg-emerald-600/90 text-white border-emerald-400/50';
                networkStatusIcon.innerHTML = '<i class="fas fa-check-circle text-sm"></i>';
                networkStatusText.textContent = message || 'Connection restored. Synchronized.';
                networkBanner.classList.remove('-translate-y-4', 'opacity-0');
                networkBanner.classList.add('translate-y-0', 'opacity-100');

                networkBannerTimeout = setTimeout(() => {
                    networkBanner.classList.remove('translate-y-0', 'opacity-100');
                    networkBanner.classList.add('-translate-y-4', 'opacity-0');
                    setTimeout(() => networkBanner.classList.add('hidden'), 300);
                }, 3000);
            }
        }

        // Window online / offline listeners
        window.addEventListener('offline', () => {
            showNetworkBanner('offline', 'Connection lost. Reconnecting when connection is restored...');
        });

        window.addEventListener('online', () => {
            showNetworkBanner('online', 'Connection restored. All systems synchronized.');
        });

        // Global Fetch Interceptor
        const _originalFetch = window.fetch;
        let isRedirectingToLogin = false;
        let consecutiveExpiredFailures = 0;

        async function verifySessionExpired() {
            if (isRedirectingToLogin) return;
            if (!navigator.onLine) return; // Do not redirect if user is temporarily offline

            try {
                // Wait 1.5 seconds and check heartbeat
                await new Promise(r => setTimeout(r, 1500));
                const res1 = await _originalFetch('/admin/api/heartbeat', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' }
                });

                if (res1.status === 401) {
                    const data1 = await res1.json().catch(() => null);
                    if (data1 && data1.expired) {
                        consecutiveExpiredFailures++;
                    }
                } else if (res1.ok) {
                    consecutiveExpiredFailures = 0;
                    return;
                }

                // If first check failed, wait another 2 seconds and re-verify before forcing redirect
                if (consecutiveExpiredFailures >= 1) {
                    await new Promise(r => setTimeout(r, 2000));
                    const res2 = await _originalFetch('/admin/api/heartbeat', {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });

                    if (res2.status === 401) {
                        const data2 = await res2.json().catch(() => null);
                        if (data2 && data2.expired) {
                            isRedirectingToLogin = true;
                            console.warn('[AUTH] Session confirmed expired after multiple checks. Redirecting to login.');
                            window.location.href = '/admin/login?expired=1';
                            return;
                        }
                    } else if (res2.ok) {
                        consecutiveExpiredFailures = 0;
                        return;
                    }
                }
            } catch (err) {
                // Network error during retry - do NOT logout, keep admin on current page
                console.warn('[AUTH] Retry check failed due to network latency:', err);
            }
        }

        window.fetch = async function(...args) {
            try {
                const response = await _originalFetch.apply(this, args);

                // Ignore background non-critical routes (like toggle-sidebar) from triggering session expiration
                const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
                const isNonCritical = url.includes('/api/toggle-sidebar') || url.includes('/api/sync-facebook');

                // Only genuine 401 with expired flag on critical requests should trigger double-check verification
                if (response.status === 401 && !isRedirectingToLogin && !isNonCritical) {
                    const clone = response.clone();
                    try {
                        const data = await clone.json();
                        if (data && data.expired) {
                            verifySessionExpired();
                            return response;
                        }
                    } catch (_) {
                        // Non-JSON response or parse failure, do not redirect
                    }
                }

                return response;
            } catch (networkError) {
                // Network failures (slow network aborts, temporary dropouts, offline)
                // MUST NOT redirect to login! Keep current view and notify admin.
                console.warn('[NETWORK WARNING] Fetch failed due to network conditions:', networkError);
                if (!navigator.onLine) {
                    showNetworkBanner('offline', 'Connection lost. Reconnecting...');
                } else {
                    showNetworkBanner('offline', 'Network slow or unstable. Reconnecting...');
                    if (networkBannerTimeout) clearTimeout(networkBannerTimeout);
                    networkBannerTimeout = setTimeout(() => {
                        if (navigator.onLine && networkBanner) {
                            networkBanner.classList.remove('translate-y-0', 'opacity-100');
                            networkBanner.classList.add('-translate-y-4', 'opacity-0');
                            setTimeout(() => networkBanner.classList.add('hidden'), 300);
                        }
                    }, 4000);
                }
                throw networkError;
            }
        };

        // Periodic Session Keepalive Heartbeat (every 5 minutes when tab is active and online)
        setInterval(() => {
            if (document.visibilityState === 'visible' && navigator.onLine && !isRedirectingToLogin) {
                _originalFetch('/admin/api/heartbeat', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' }
                }).then(res => {
                    if (res.status === 401) {
                        res.json().then(data => {
                            if (data && data.expired) {
                                verifySessionExpired();
                            }
                        }).catch(() => {});
                    }
                }).catch(err => {
                    // Silently ignore network errors in heartbeat
                    console.debug('[HEARTBEAT] Connection check skipped due to network conditions:', err.message);
                });
            }
        }, 5 * 60 * 1000);

        // Desktop-only enforcement helper for body scroll locks
        const syncDesktopOnlyGuard = () => {
            if (window.innerWidth < 1024) {
                document.body.classList.add('overflow-hidden');
            } else {
                document.body.classList.remove('overflow-hidden');
            }
        };
        window.addEventListener('resize', syncDesktopOnlyGuard);
        syncDesktopOnlyGuard();

        // Administrative Sign-Out Confirmation Protocol
        window.confirmLogout = async function(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            const confirmFn = window.strategicConfirm || (async () => confirm("Are you sure you want to end your administrative session and log out?"));
            const confirmed = await confirmFn({
                title: "Sign Out Confirmation",
                message: "Are you sure you want to terminate your active administrative session? Any unsaved edits will be lost.",
                confirmText: "Sign Out",
                cancelText: "Stay Logged In",
                type: "danger"
            });

            if (confirmed) {
                window.location.href = "/admin/logout";
            }
            return false;
        };
    </script>


    <%- include('../partials/notifications') %>
    <%- include('../partials/help_modal') %>
    <%- include('../partials/change_password_modal') %>
</body>

