            <% if (locals.user) { %>
            <!-- Floating Admin Dashboard Button (Desktop only) -->
            <a href="/admin/dashboard" title="Admin Dashboard"
                class="hidden md:flex fixed bottom-6 right-6 z-40 w-12 h-12 bg-pnp-blue dark:bg-pnp-gold shadow-2xl rounded-full items-center justify-center text-white dark:text-pnp-blue transition-all duration-300 hover:scale-110 active:scale-95 border border-pnp-blue dark:border-pnp-gold">
                <i class="fas fa-shield-halved text-lg"></i>
            </a>
            <% } %>

             <script>
                const mobileMenuBtn = document.getElementById('mobileMenuBtn');
                const closeMenuBtn = document.getElementById('closeMenuBtn');
                const mobileMenu = document.getElementById('mobileMenu');
                const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');

                // Unified Dark Mode Sync and Logic
                const syncThemeUI = () => {
                    const isDark = document.documentElement.classList.contains('dark');
                    document.querySelectorAll('.theme-icon-moon').forEach(el => el.classList.toggle('hidden', isDark));
                    document.querySelectorAll('.theme-icon-sun').forEach(el => el.classList.toggle('hidden', !isDark));
                };

                const toggleTheme = () => {
                    document.documentElement.classList.toggle('dark');
                    const isDark = document.documentElement.classList.contains('dark');
                    localStorage.setItem('darkMode', isDark);
                    syncThemeUI();
                };

                document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
                    btn.addEventListener('click', toggleTheme);
                });

                syncThemeUI();

                // Active Navigation Link Highlighting
                const currentPath = window.location.pathname;

                // Desktop Nav
                const desktopLinks = document.querySelectorAll('header nav a');
                desktopLinks.forEach(link => {
                    const href = link.getAttribute('href');
                    if (href) {
                        const pathOnly = href.split('#')[0] || '/';
                        if (currentPath === pathOnly || (pathOnly !== '/' && currentPath.startsWith(pathOnly))) {
                            link.classList.add('bg-white/20', 'text-pnp-gold');
                        }
                    }
                });

                // Mobile Nav
                const mobileLinks = document.querySelectorAll('#mobileMenu nav a');
                mobileLinks.forEach(link => {
                    const href = link.getAttribute('href');
                    if (href) {
                        const pathOnly = href.split('#')[0] || '/';
                        if (currentPath === pathOnly || (pathOnly !== '/' && currentPath.startsWith(pathOnly))) {
                            link.classList.remove('text-white');
                            link.classList.add('text-pnp-gold');
                        }
                    }
                });

                const closeMenu = () => {
                    if (mobileMenu) mobileMenu.classList.add('translate-x-full');
                    if (mobileMenuBackdrop) {
                        mobileMenuBackdrop.classList.add('opacity-0');
                        setTimeout(() => {
                            mobileMenuBackdrop.classList.add('hidden');
                        }, 300);
                    }
                    document.body.style.overflow = '';
                };

                if (mobileMenuBtn) {
                    mobileMenuBtn.addEventListener('click', () => {
                        if (mobileMenuBackdrop) {
                            mobileMenuBackdrop.classList.remove('hidden');
                            setTimeout(() => mobileMenuBackdrop.classList.remove('opacity-0'), 10);
                        }
                        if (mobileMenu) mobileMenu.classList.remove('translate-x-full');
                        document.body.style.overflow = 'hidden';
                    });
                }

                if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMenu);
                if (mobileMenuBackdrop) mobileMenuBackdrop.addEventListener('click', closeMenu);

                // Smooth Scroll Logic for Hash Anchors
                const initSmoothScroll = () => {
                    const handleAnchorClick = (e) => {
                        const href = e.currentTarget.getAttribute('href');
                        if (href && (href.startsWith('/#') || href.startsWith('#'))) {
                            const hashIndex = href.indexOf('#');
                            const targetId = href.substring(hashIndex);
                            if (targetId && targetId.length > 1 && targetId.startsWith('#')) {
                                try {
                                    const targetEl = document.querySelector(targetId);
                                    if (targetEl) {
                                        e.preventDefault();
                                        closeMenu();
                                        
                                        const headerHeight = document.querySelector('header')?.offsetHeight || 80;
                                        const targetPosition = targetEl.getBoundingClientRect().top + window.pageYOffset - headerHeight - 16;
                                        
                                        window.scrollTo({
                                            top: targetPosition,
                                            behavior: 'smooth'
                                        });
                                        
                                        // Update URL hash without scroll jumping
                                        history.pushState(null, '', href);
                                    }
                                } catch (err) {
                                    console.error('Error in selector query:', err);
                                }
                            }
                        }
                    };

                    document.querySelectorAll('a[href*="#"]').forEach(link => {
                        link.removeEventListener('click', handleAnchorClick);
                        link.addEventListener('click', handleAnchorClick);
                    });

                    // On-load smooth scroll if hash is present
                    if (window.location.hash && window.location.hash.length > 1) {
                        setTimeout(() => {
                            try {
                                const targetEl = document.querySelector(window.location.hash);
                                if (targetEl) {
                                    const headerHeight = document.querySelector('header')?.offsetHeight || 80;
                                    const targetPosition = targetEl.getBoundingClientRect().top + window.pageYOffset - headerHeight - 16;
                                    window.scrollTo({
                                        top: targetPosition,
                                        behavior: 'smooth'
                                    });
                                }
                            } catch (err) {
                                console.error('Error on-load hash scroll:', err);
                            }
                        }, 400);
                    }
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initSmoothScroll);
                } else {
                    initSmoothScroll();
                }
            </script>
</body>

</html>