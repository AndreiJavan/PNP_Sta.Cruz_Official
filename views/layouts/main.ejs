<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Favicon & Search Engine Logo Configuration -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#1A3A5C">
    
    <!-- Open Graph & Search Metadata -->
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="description" content="PNP Santa Cruz Municipal Police Station - Official Geospatial Crime Mapping and Reporting System in Santa Cruz, Laguna.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="PNP Santa Cruz Municipal Police Station">
    <meta property="og:description" content="Official crime reporting, real-time incident mapping, and public safety advisories for Santa Cruz, Laguna.">
    <meta property="og:image" content="/images/PNP.jpg">

    <title>Sta. Cruz Crime Mapping & Reporting System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        pnp: {
                            blue: {
                                50: '#EBF1F7',
                                100: '#D1DEEB',
                                200: '#A3BDD7',
                                300: '#759CC3',
                                400: '#477BAF',
                                500: '#1A3A5C',
                                600: '#152E4A',
                                700: '#102237',
                                800: '#0A1725',
                                900: '#050B12',
                                DEFAULT: '#1A3A5C',
                            },
                            gold: {
                                50: '#FAF7E8',
                                100: '#F5F0D1',
                                200: '#EBE1A3',
                                300: '#E1D275',
                                400: '#D7C347',
                                500: '#C8A415',
                                600: '#A08311',
                                700: '#78620D',
                                800: '#504109',
                                900: '#282104',
                                DEFAULT: '#C8A415',
                            }
                        }
                    }
                }
            }
        }
    </script>
    <script>
        // Check for dark mode preference
        if (localStorage.getItem('darkMode') === 'true' || (!('darkMode' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Text-to-Speech Helper -->
    <script src="/js/tts-helper.js"></script>

    <!-- Vercel Web Analytics -->
    <%- include('../partials/analytics') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

        body {
            font-family: 'Inter', sans-serif;
        }

        .bg-pnp-blue {
            background-color: #1A3A5C;
        }

        .text-pnp-blue {
            color: #1A3A5C;
        }

        .bg-pnp-gold {
            background-color: #C8A415;
        }

        .text-pnp-gold {
            color: #C8A415;
        }

        .border-pnp-gold {
            border-color: #C8A415;
        }

        /* Border utility fallback for border-gray-150 in both themes */
        .border-gray-150 {
            border-color: #e2e8f0;
        }
        .dark .border-gray-150 {
            border-color: rgba(51, 65, 85, 0.6);
        }

        .pnp-gradient-blue {
            background: linear-gradient(135deg, #1A3A5C 0%, #0A1725 100%);
        }

        .pnp-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .dark .pnp-card {
            background-color: #1e293b;
            border-color: rgba(51, 65, 85, 0.6);
        }

        .pnp-card:hover {
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .pnp-glass {
            background: rgba(255, 255, 255, 0.01);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .pnp-glass-dark {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .text-shadow-tactical {
            text-shadow: 0 0 20px rgba(200, 164, 21, 0.3);
        }

        /* Enhanced Modal Scrollbar */
        .custom-modal-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-modal-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-modal-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-modal-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .dark .custom-modal-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(100, 116, 139, 0.5);
        }
        .dark .custom-modal-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(100, 116, 139, 0.8);
        }

        /* Dark mode overrides for custom classes if needed */
        .dark .bg-gray-50 {
            background-color: #0f172a;
        }

        .dark .bg-white {
            background-color: #1e293b;
        }

        .dark .text-gray-800 {
            color: #f1f5f9;
        }

        .dark .text-gray-700 {
            color: #e2e8f0;
        }

        .dark .text-gray-600 {
            color: #cbd5e1;
        }

        .dark .text-gray-500 {
            color: #94a3b8;
        }

        .dark .text-gray-400 {
            color: #64748b;
        }

        .dark .border-gray-100 {
            border-color: #334155;
        }

        .dark .border-gray-200 {
            border-color: #475569;
        }

        /* Leaflet Dark Mode Support & Mobile Touch Acceleration */
        /* Native dark tiles from ArcGIS Canvas are dynamically loaded without expensive CSS raster filters */

        * {
            -webkit-tap-highlight-color: transparent;
        }

        button, a, select, input, textarea, [role="button"] {
            touch-action: manipulation;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
        }

        .leaflet-tile {
            will-change: transform;
            transform: translate3d(0, 0, 0);
            -webkit-transform: translate3d(0, 0, 0);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .leaflet-map-pane,
        .leaflet-tile-pane {
            transform: translate3d(0, 0, 0);
            will-change: transform;
        }

        #leafletMap {
            touch-action: pan-x pan-y pinch-zoom;
        }

        .dark .leaflet-container {
            background: #0f172a;
        }

        .dark .leaflet-popup-content-wrapper,
        .dark .leaflet-popup-tip {
            background-color: #1e293b;
            color: #f8fafc;
        }

        .grid-label,
        .corner-coord-container,
        .grid-intersection-label,
        .manual-pin-container {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .barangay-label-tooltip {
            background: rgba(26, 58, 92, 0.9) !important;
            border: 1px solid #C8A415 !important;
            color: #C8A415 !important;
            font-weight: 900 !important;
            font-size: 8px !important;
            text-transform: uppercase !important;
            letter-spacing: 0.1em !important;
            padding: 2px 6px !important;
            border-radius: 4px !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;
        }

        .barangay-label-tooltip::before {
            border-top-color: rgba(26, 58, 92, 0.9) !important;
        }

        /* Custom PNP Popup Styling */
        .custom-pnp-popup .leaflet-popup-content-wrapper {
            padding: 0;
            overflow: hidden;
            border-radius: 1.5rem;
            border: 2px solid #C8A415;
        }

        .custom-pnp-popup .leaflet-popup-content {
            margin: 0;
            width: auto !important;
        }

        .custom-pnp-popup .leaflet-popup-tip {
            background: #C8A415;
        }

        #mobileMenu {
            will-change: transform;
            -webkit-backface-visibility: hidden;
            backface-visibility: hidden;
        }
    </style>
</head>

<body class="bg-[#eaedf2] dark:bg-slate-950 text-slate-800 dark:text-slate-100 flex flex-col min-h-screen transition-colors duration-300 overflow-x-hidden">
    <!-- Header -->
    <header class="bg-pnp-blue text-white sticky top-0 z-50 shadow-2xl border-b-4 border-pnp-gold">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16 sm:h-20">
                <!-- Brand / Logo -->
                <a href="/" class="flex items-center space-x-3 sm:space-x-3.5 group min-w-0">
                    <!-- White circular logo container with MIMPAS logo matching Admin -->
                    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white flex items-center justify-center p-1 shadow-md border border-white/20 shrink-0 group-hover:scale-105 transition duration-300">
                        <img src="/favicon.png" alt="MIMPAS Logo" class="w-full h-full object-contain rounded-full"
                            onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-base sm:text-lg font-black tracking-wider leading-none text-white">M I M P A S</h1>
                        <p class="text-[8px] sm:text-[9px] text-blue-100 uppercase tracking-wider font-bold mt-1 leading-tight truncate">
                            Municipality Incident Management and Public Advisory Sta.Cruz
                        </p>
                    </div>
                </a>

                <!-- Desktop Nav -->
                <nav class="hidden lg:flex items-center space-x-1">
                    <a href="/#hero-section"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && title === 'Home' ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">Home</a>
                    <a href="/map"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && (title === 'Crime Map' || title === 'Map') ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">Crime Map</a>
                    <a href="/bulletins"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && (title === 'Public Advisory' || title === 'Bulletins' || title === 'Wanted Persons' || title === 'Missing Persons') ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">Public Advisory</a>
                    <a href="/news"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && (title === 'Station Releases' || title === 'News') ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">News</a>
                    <a href="/hotlines"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && (title === 'Emergency Hotlines' || title === 'Hotlines') ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">Hotlines</a>
                    <a href="/about"
                        class="px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider transition-all duration-200 <%= typeof title !== 'undefined' && title === 'About' ? 'bg-white/20 text-white font-black border-b-2 border-pnp-gold shadow-xs' : 'text-white/90 hover:bg-white/10 hover:text-white font-bold' %>">About</a>
                    
                    <% if (locals.user) { %>
                        <a href="/admin/dashboard"
                            class="ml-2 px-3.5 py-2 rounded-xl text-xs uppercase tracking-wider font-black text-pnp-gold bg-white/10 hover:bg-pnp-gold hover:text-pnp-blue transition duration-200 flex items-center gap-1.5 border border-pnp-gold/30 shadow-xs"
                            title="Access Admin Console">
                            <i class="fas fa-shield-halved text-xs"></i>
                            <span>Admin Console</span>
                        </a>
                    <% } %>
                </nav>

                <!-- Action Buttons -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- Topbar Theme Toggle (Single light/dark mode button for both desktop and mobile) -->
                    <button class="theme-toggle-btn w-9 h-9 sm:w-10 sm:h-10 bg-white/10 hover:bg-white/20 active:scale-95 rounded-xl flex items-center justify-center text-white hover:text-pnp-gold transition duration-200 border border-white/20 shrink-0 cursor-pointer"
                        title="Toggle Light / Dark Mode" aria-label="Toggle Theme">
                        <i class="fas fa-moon text-sm theme-icon-moon dark:hidden"></i>
                        <i class="fas fa-sun text-sm theme-icon-sun hidden dark:block text-pnp-gold"></i>
                    </button>

                    <!-- Mobile Menu Toggle -->
                    <button id="mobileMenuBtn" aria-label="Open Navigation Menu"
                        class="lg:hidden w-9 h-9 sm:w-10 sm:h-10 bg-white/10 hover:bg-white/20 active:scale-95 rounded-xl flex items-center justify-center text-base sm:text-lg text-white transition shrink-0 border border-white/20 cursor-pointer">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Backdrop -->
    <div id="mobileMenuBackdrop"
        class="fixed inset-0 bg-black/60 z-[90] hidden transition-opacity duration-300 opacity-0 backdrop-blur-sm">
    </div>

    <!-- Mobile Menu Drawer -->
    <div id="mobileMenu"
        class="fixed top-0 right-0 bottom-0 w-[85%] sm:w-1/2 md:w-1/3 bg-pnp-blue z-[100] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 sm:p-7 inset-y-0 shadow-2xl border-l-4 border-pnp-gold/50">
        <div class="flex justify-between items-center mb-6 border-b border-white/10 pb-4">
            <div class="flex items-center space-x-3 min-w-0">
                <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center p-1 shadow-md border border-white/20 shrink-0">
                    <img src="/favicon.png" alt="MIMPAS Logo" class="w-full h-full object-contain rounded-full"
                        onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                </div>
                <div class="min-w-0">
                    <h2 class="text-white text-base font-black tracking-wider leading-none">M I M P A S</h2>
                    <p class="text-[8px] text-blue-100 uppercase tracking-wider font-bold mt-0.5 truncate">Sta. Cruz Municipal Police</p>
                </div>
            </div>
            <button id="closeMenuBtn" aria-label="Close Menu"
                class="w-9 h-9 bg-white/10 rounded-xl flex items-center justify-center text-white text-base active:scale-95 transition shrink-0 border border-white/20 cursor-pointer">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <nav class="flex flex-col space-y-2 overflow-y-auto">
            <a href="/#hero-section" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && title === 'Home' ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">Home</a>
            <a href="/map" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && (title === 'Crime Map' || title === 'Map') ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">Crime Map</a>
            <a href="/bulletins" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && (title === 'Public Advisory' || title === 'Bulletins' || title === 'Wanted Persons' || title === 'Missing Persons') ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">Public Advisory</a>
            <a href="/news" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && (title === 'Station Releases' || title === 'News') ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">News</a>
            <a href="/hotlines" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && (title === 'Emergency Hotlines' || title === 'Hotlines') ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">Hotlines</a>
            <a href="/about" class="px-3.5 py-2.5 rounded-xl text-base font-bold text-white hover:bg-white/10 transition <%= typeof title !== 'undefined' && title === 'About' ? 'bg-white/20 text-white font-black border-l-4 border-pnp-gold' : '' %>">About PNP</a>

            <% if (locals.user) { %>
                <a href="/admin/dashboard" class="px-3.5 py-2.5 rounded-xl text-base font-black text-pnp-gold hover:bg-white/10 transition pt-3 border-t border-white/10 flex items-center gap-2">
                    <i class="fas fa-shield-halved text-base"></i>
                    <span>Admin Dashboard</span>
                </a>
            <% } %>
        </nav>

        <!-- Mobile Drawer Footer Info -->
        <div class="mt-auto pt-5 border-t border-white/10 flex items-center justify-between text-[10px] text-blue-200/70 font-bold uppercase tracking-wider">
            <span>Sta. Cruz Police Station</span>
            <span>Laguna PPO</span>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-grow">
        <%- body %>
    </main>

    <% if (!locals.hideFooter) { %>
        <!-- Footer -->
        <footer class="bg-pnp-blue text-white dark:bg-slate-950 border-t-4 border-pnp-gold mt-auto py-12 transition-colors duration-300">
            <div class="container mx-auto px-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                    <!-- Brand Section -->
                    <div class="flex flex-col space-y-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-11 h-11 rounded-full bg-white flex items-center justify-center p-1 shadow-md border border-white/20 shrink-0">
                                <img src="/favicon.png" alt="MIMPAS Logo" class="w-full h-full object-contain rounded-full" onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                            </div>
                            <div>
                                <h2 class="text-base font-black tracking-wider leading-none text-white">M I M P A S</h2>
                                <p class="text-[8px] text-blue-100 uppercase tracking-wider font-bold mt-1">PNP Sta. Cruz &bull; Laguna PPO</p>
                            </div>
                        </div>
                        <p class="text-xs text-blue-200/80 max-w-sm leading-relaxed">
                            To enforce the law, prevent and control crimes, maintain peace and order, and ensure public
                            safety and internal security with the active support of the community.
                        </p>
                    </div>

                    <!-- Quick Links -->
                    <div class="flex flex-col space-y-3">
                        <h3 class="text-xs font-black text-pnp-gold uppercase tracking-[0.2em] mb-2">Quick Links</h3>
                        <div class="grid grid-cols-2 gap-2">
                            <a href="/"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                Home
                            </a>
                            <a href="/bulletins"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                Public Advisory
                            </a>
                            <a href="/news"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                News
                            </a>
                            <a href="/map"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                Crime Map
                            </a>
                            <a href="/hotlines"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                Hotlines
                            </a>
                            <a href="/about"
                                class="text-xs text-blue-200 hover:text-white transition group flex items-center">
                                <i class="fas fa-chevron-right text-[8px] mr-2 text-pnp-gold opacity-0 group-hover:opacity-100 transition"></i>
                                About
                            </a>
                            <% if (locals.user) { %>
                            <a href="/admin/dashboard"
                                class="text-xs text-pnp-gold hover:text-white transition group flex items-center mt-1">
                                <i class="fas fa-shield-halved text-[8px] mr-2 transition"></i> Admin Dashboard
                            </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Contact Info / Hotlines -->
                    <div class="flex flex-col space-y-3">
                        <h3 class="text-xs font-black text-pnp-gold uppercase tracking-[0.2em] mb-2">Emergency Hotlines</h3>

                        <% if (locals.footerHotlines && locals.footerHotlines.length > 0) { %>
                            <% locals.footerHotlines.slice(0, 5).forEach(h => { 
                                const agencyName = h.agency_name || h.name || 'Emergency Hotline';
                                const rawNum = String(h.contact_number || h.number || '');
                                const cleanTel = rawNum.replace(/[^0-9+]/g, '');
                                const formattedNum = rawNum.length === 11 ? rawNum.replace(/(\d{4})(\d{3})(\d{4})/, '$1 $2 $3') : rawNum;
                            %>
                                <div class="text-xs text-blue-200 flex space-x-3 items-center">
                                    <i class="fas fa-phone-volume text-red-400 w-3"></i>
                                    <span><%= agencyName %>: <a href="tel:<%= cleanTel %>" class="text-white hover:text-pnp-gold transition"><strong><%= formattedNum %></strong></a></span>
                                </div>
                            <% }); %>
                            <% if (locals.footerHotlines.length > 5) { %>
                                <a href="/hotlines" class="text-[11px] text-pnp-gold hover:underline flex items-center gap-1.5 pt-1 font-semibold group">
                                    <span>View All Hotlines (<%= locals.footerHotlines.length %>)</span>
                                    <i class="fas fa-chevron-right text-[8px] group-hover:translate-x-0.5 transition-transform"></i>
                                </a>
                            <% } %>
                        <% } else { %>
                            <div class="text-xs text-blue-200 flex space-x-3 items-center">
