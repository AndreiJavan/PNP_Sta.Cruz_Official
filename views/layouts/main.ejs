                            <div class="text-xs text-blue-200 flex space-x-3 items-center">
                                <i class="fas fa-phone-volume text-red-400 w-3"></i>
                                <span>National Emergency: <a href="tel:911" class="text-white hover:text-pnp-gold transition"><strong>911</strong></a></span>
