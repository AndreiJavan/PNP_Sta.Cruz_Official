    // Render Category Filter Tabs
    function renderCategoryTabs() {
        const container = document.getElementById('faqCategoryTabsContainer');
        if (!container) return;

        const t = faqBotTranslations[currentFaqLang] || faqBotTranslations.en;
        const categories = [];
        const seen = new Set();

        (FAQ_DATA || []).forEach(f => {
            const cat = f.category || 'General';
            if (!seen.has(cat)) {
                seen.add(cat);
                categories.push(cat);
            }
        });

        let html = `
            <button type="button" onclick="setFaqCategoryFilter('all')"
                class="px-3.5 py-1.5 rounded-xl font-black text-xs whitespace-nowrap transition-all duration-200 border cursor-pointer shrink-0 ${
                    currentCategoryFilter === 'all'
                        ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-950 border-pnp-blue dark:border-pnp-gold shadow-xs'
                        : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-pnp-gold'
                }">
                <i class="fas fa-layer-group text-xs mr-1"></i>
                <span>${t.allCategory} (${FAQ_DATA.length})</span>
            </button>
        `;

        categories.forEach(cat => {
            const meta = getCategoryMeta(cat);
            const count = FAQ_DATA.filter(f => (f.category || 'General') === cat).length;
            const isActive = currentCategoryFilter === cat;

            html += `
                <button type="button" onclick="setFaqCategoryFilter('${cat.replace(/'/g, "\\'")}')"
                    class="px-3.5 py-1.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all duration-200 border cursor-pointer shrink-0 flex items-center gap-1.5 ${
                        isActive
                            ? 'bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-950 border-pnp-blue dark:border-pnp-gold shadow-xs'
                            : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-pnp-gold'
                    }">
                    <i class="fas ${meta.icon} text-xs"></i>
                    <span>${meta.label} (${count})</span>
                </button>
            `;
        });

        container.innerHTML = html;
    }

    // Render Question Cards in Expanded Grid (Complete, untruncated text, clickable)
    function renderQuestionsGrid() {
        const grid = document.getElementById('faqQuestionsGrid');
        if (!grid) return;

        const t = faqBotTranslations[currentFaqLang] || faqBotTranslations.en;
        const isFil = currentFaqLang === 'fil';

        let items = (FAQ_DATA || []).slice();

        // 1. Category Filter
        if (currentCategoryFilter !== 'all') {
            items = items.filter(f => (f.category || 'General') === currentCategoryFilter);
        }

        // 2. Search Query Filter
        if (currentSearchQuery) {
            const q = currentSearchQuery;
            items = items.filter(f => {
                const titleEn = (f.title || '').toLowerCase();
                const titleFil = (f.titleFil || '').toLowerCase();
                const cat = (f.category || '').toLowerCase();
                const kws = (f.keywords || []).map(k => String(k).toLowerCase()).join(' ');
                const ansEn = (f.summaryEn || '').toLowerCase();
                const ansFil = (f.summaryFil || '').toLowerCase();

                return titleEn.includes(q) || titleFil.includes(q) || cat.includes(q) || kws.includes(q) || ansEn.includes(q) || ansFil.includes(q);
            });
        }

        // Update counts in header & badges
        const countBadge = document.getElementById('faqCountBadge');
        const headerCount = document.getElementById('faqDrawerHeaderCount');
        const countText = `${FAQ_DATA.length} ${isFil ? 'Tanong' : 'Questions'}`;
        if (countBadge) countBadge.textContent = countText;
        if (headerCount) headerCount.textContent = `${items.length} / ${FAQ_DATA.length}`;

        // Empty State
        if (items.length === 0) {
            grid.innerHTML = `
                <div class="col-span-1 md:col-span-2 p-8 text-center bg-white dark:bg-slate-900 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 space-y-3">
                    <div class="w-12 h-12 mx-auto rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-xl">
                        <i class="fas fa-search"></i>
                    </div>
                    <p class="text-sm font-bold text-slate-800 dark:text-slate-200">
                        ${t.noResults}
                    </p>
                    <button type="button" onclick="clearFaqSearch(); setFaqCategoryFilter('all');"
                        class="px-4 py-2 rounded-xl bg-pnp-blue hover:bg-pnp-blue-600 text-white dark:bg-pnp-gold dark:text-slate-950 font-black text-xs uppercase tracking-wider cursor-pointer transition">
                        ${t.resetFilter}
                    </button>
                </div>
            `;
            return;
        }

        // Render each card: READABLE AS A WHOLE, NO TRUNCATION
        let cardsHtml = '';
        items.forEach((faq, idx) => {
            const meta = getCategoryMeta(faq.category);
            const questionTitle = isFil ? (faq.titleFil || faq.title) : faq.title;
            const displayOrder = faq.display_order || (idx + 1);

            cardsHtml += `
                <div onclick="selectFaqQuestion('${faq.id}')"
                    class="group bg-white dark:bg-slate-900 hover:bg-pnp-blue hover:text-white dark:hover:bg-[#122238] border-2 border-slate-200/90 dark:border-slate-800 hover:border-pnp-gold dark:hover:border-pnp-gold p-4 sm:p-5 rounded-2xl shadow-xs hover:shadow-md transition-all duration-200 cursor-pointer flex flex-col justify-between text-left hover:-translate-y-0.5 active:scale-[0.99]">
                    <div>
                        <!-- Top Category Tag & Number -->
                        <div class="flex items-center justify-between gap-2 mb-2.5">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[9.5px] font-black uppercase tracking-wider bg-slate-100 group-hover:bg-white/20 dark:bg-slate-800 text-slate-700 group-hover:text-white dark:text-slate-300 transition-colors">
                                <i class="fas ${meta.icon} text-pnp-gold text-[10px]"></i>
                                <span>${meta.label}</span>
                            </span>
                            <span class="text-[10px] font-black text-slate-400 group-hover:text-blue-100 dark:group-hover:text-pnp-gold/80 transition-colors">
                                #${displayOrder}
                            </span>
                        </div>
                        <!-- Question Title: Full text, completely readable -->
                        <h5 class="text-xs sm:text-sm font-black text-slate-900 group-hover:text-white dark:text-slate-100 dark:group-hover:text-white leading-snug break-words">
                            ${formatFaqMsg(questionTitle)}
                        </h5>
                    </div>
                    <!-- Bottom Action Row -->
                    <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100 group-hover:border-white/20 dark:border-slate-800 text-[10.5px] font-bold text-pnp-blue group-hover:text-pnp-gold dark:text-pnp-gold transition-colors">
                        <span class="flex items-center gap-1.5">
                            <i class="fas fa-comment-dots text-xs"></i>
                            <span>${t.viewAnswer}</span>
                        </span>
                        <i class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform"></i>
                    </div>
                </div>
            `;
        });

        grid.innerHTML = cardsHtml;
    }

    // Select a Question: Minimizes Quick Ask, Displays User Bubble, Answers the Question
    window.selectFaqQuestion = function(faqId) {
        // 1. Immediately minimize the quick ask drawer
        toggleQuickAsk(false);

        // 2. Lookup FAQ item
        const faq = (FAQ_DATA || []).find(f => String(f.id) === String(faqId));
        if (!faq) {
            console.warn('FAQ item not found for id:', faqId);
            return;
        }

        const isFil = currentFaqLang === 'fil';
        const questionText = isFil ? (faq.titleFil || faq.title) : faq.title;
        const answerText = isFil ? (faq.summaryFil || faq.summaryEn) : faq.summaryEn;
        const nearQuestions = isFil ? (faq.nearQuestionsFil || []) : (faq.nearQuestionsEn || []);

        // 3. Append User Question Bubble
        appendFaqChatMessage('user', questionText);

        // 4. Show typing indicator
        const chatBox = document.getElementById('faq-chat-messages');
        const indicator = document.createElement('div');
        indicator.id = 'faq-chat-typing';
        indicator.className = 'flex justify-start';
        indicator.innerHTML = `
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold italic p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-2">
                <i class="fas fa-circle-notch fa-spin text-pnp-blue dark:text-pnp-gold"></i>
                <span>${currentFaqLang === 'fil' ? 'Sinisuri ang opisyal na FAQs ng himpilan...' : 'Checking official station FAQs...'}</span>
            </div>
        `;
        chatBox.appendChild(indicator);
        chatBox.scrollTop = chatBox.scrollHeight;

        // 5. Brief realistic delay then render the verified answer
        setTimeout(() => {
            const ind = document.getElementById('faq-chat-typing');
            if (ind) ind.remove();

            appendFaqChatMessage('assistant', answerText, nearQuestions, true, false);
        }, 220);
    };

    // Ask a Question by Text (used by welcome card buttons, follow-up chips, etc.)
    window.askFaqQuickQuestion = async function(queryText) {
        // 1. Minimize drawer if open
        toggleQuickAsk(false);

        const text = String(queryText || '').trim();
        if (!text) return;

        // 2. Append User Bubble
        appendFaqChatMessage('user', text);

        // 3. Check if text matches an existing FAQ in FAQ_DATA
        const isFil = currentFaqLang === 'fil';
        const qLower = text.toLowerCase();
        const matchedFaq = (FAQ_DATA || []).find(f => {
            const titleEn = (f.title || '').toLowerCase().trim();
            const titleFil = (f.titleFil || '').toLowerCase().trim();
            return titleEn === qLower || titleFil === qLower || titleEn.includes(qLower) || qLower.includes(titleEn);
        });

        // 4. Show typing indicator
        const chatBox = document.getElementById('faq-chat-messages');
        const indicator = document.createElement('div');
        indicator.id = 'faq-chat-typing';
        indicator.className = 'flex justify-start';
        indicator.innerHTML = `
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold italic p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-2">
                <i class="fas fa-circle-notch fa-spin text-pnp-blue dark:text-pnp-gold"></i>
                <span>${isFil ? 'Sinisuri ang opisyal na FAQs ng himpilan...' : 'Checking official station FAQs...'}</span>
            </div>
        `;
        chatBox.appendChild(indicator);
        chatBox.scrollTop = chatBox.scrollHeight;

        if (matchedFaq) {
            setTimeout(() => {
                const ind = document.getElementById('faq-chat-typing');
                if (ind) ind.remove();

                const answerText = isFil ? (matchedFaq.summaryFil || matchedFaq.summaryEn) : matchedFaq.summaryEn;
                const nearQuestions = isFil ? (matchedFaq.nearQuestionsFil || []) : (matchedFaq.nearQuestionsEn || []);
                appendFaqChatMessage('assistant', answerText, nearQuestions, true, false);
            }, 220);
            return;
        }

        // Fallback to server /api/faq-chat endpoint for complex queries
        let res = null;
        try {
            res = await fetch('/api/faq-chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: text, language: currentFaqLang })
            }).then(r => r.json());
        } catch (err) {
            console.warn('Server chat error, using local fallback:', err);
        }

        const ind = document.getElementById('faq-chat-typing');
        if (ind) ind.remove();

        if (res && res.reply) {
            appendFaqChatMessage('assistant', res.reply, res.nearQuestions || [], res.inScope !== false, res.securityBlocked === true);
        } else {
            // Local fallback reply
            const fallbackReply = isFil
                ? "Salamat sa iyong katanungan. Maaari mong tingnan ang kumpletong listahan ng opisyal na FAQs ng Sta. Cruz Police sa pamamagitan ng 'Tingnan Lahat ng Tanong' sa ibaba."
                : "Thank you for your question. You can browse our complete official Sta. Cruz Police FAQs by clicking 'Browse All Questions' below.";
            appendFaqChatMessage('assistant', fallbackReply, [], true, false);
        }
    };

    // Open & Close Modal Handlers
    window.openFaqModal = function(categoryOrQuery) {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
            if (backdrop) backdrop.classList.remove('opacity-0');
            if (container) {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }
        }, 10);

        // Pre-prompt or category handling if opened with category
        const categoryMap = {
            emergency: 'Emergency',
            blotter: 'Blotter',
            clearance: 'Clearance',
            map: 'Crime Map',
            bulletins: 'Bulletins',
            wcpd: 'WCPD',
            general: 'General'
        };

        if (categoryOrQuery) {
            const mappedCat = categoryMap[categoryOrQuery.toLowerCase()];
            if (mappedCat) {
                // Expand quick ask filtered to that category
                currentCategoryFilter = mappedCat;
                toggleQuickAsk(true);
            } else {
                askFaqQuickQuestion(categoryOrQuery);
            }
        }
    };

    window.closeFaqModal = function() {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        // Also minimize quick ask
        toggleQuickAsk(false);

        if (backdrop) backdrop.classList.add('opacity-0');
        if (container) {
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
        }

        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
