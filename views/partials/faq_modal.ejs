                    title="Toggle Language (English / Filipino)">
                    <i class="fas fa-globe text-pnp-gold text-xs"></i>
                    <span id="faqLangToggleLabel">FIL</span>
                </button>

                <!-- Reset Chat History Button -->
                <button type="button" onclick="clearFaqChat()"
                    class="px-3 py-2 rounded-xl text-[10.5px] sm:text-xs font-black uppercase tracking-wider transition-all duration-200 bg-rose-500/15 hover:bg-rose-600 hover:text-white text-rose-200 border border-rose-400/40 shadow-sm active:scale-95 cursor-pointer backdrop-blur-md flex items-center gap-1.5"
                    title="Clear chat and start over">
