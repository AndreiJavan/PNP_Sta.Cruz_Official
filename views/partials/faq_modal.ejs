                    <img src="/favicon.png" alt="MIMPAS Logo" class="w-8 h-8 sm:w-9 sm:h-9 object-contain rounded-full"
                        onerror="this.onerror=null; this.src='/images/PNP.jpg';">
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-400 border-2 border-[#0d2238] animate-pulse shadow-sm" title="Online Station Desk"></span>
                </div>
                <div class="min-w-0 text-left">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 id="faqModalTitle" class="text-sm sm:text-base font-black text-white uppercase tracking-wider truncate leading-tight drop-shadow-xs">
                            Sta. Cruz Police FAQ Assistant
                        </h3>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 shadow-xs">
                            <i class="fas fa-shield-check text-[9px] text-emerald-400"></i> Verified Desk
