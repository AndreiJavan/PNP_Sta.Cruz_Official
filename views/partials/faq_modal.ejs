                <button type="button" onclick="askFaqQuickQuestion('How to file a police blotter?')"
                    class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 font-bold text-xs whitespace-nowrap transition-all duration-200 border border-slate-200 dark:border-slate-700 hover:border-pnp-gold shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-95 flex items-center gap-1.5 cursor-pointer shrink-0">
                    <i class="fas fa-file-pen text-amber-500 dark:text-amber-400 text-xs"></i>
                    <span>File a Blotter</span>
                </button>
                <button type="button" onclick="askFaqQuickQuestion('Where is the station located and what are operating hours?')"
                    class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 font-bold text-xs whitespace-nowrap transition-all duration-200 border border-slate-200 dark:border-slate-700 hover:border-pnp-gold shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-95 flex items-center gap-1.5 cursor-pointer shrink-0">
                    <i class="fas fa-clock text-sky-500 dark:text-sky-400 text-xs"></i>
                    <span>Station Location & Hours</span>
                </button>
                <button type="button" onclick="askFaqQuickQuestion('What assistance does WCPD provide?')"
                    class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 font-bold text-xs whitespace-nowrap transition-all duration-200 border border-slate-200 dark:border-slate-700 hover:border-pnp-gold shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-95 flex items-center gap-1.5 cursor-pointer shrink-0">
                    <i class="fas fa-shield-heart text-pink-500 dark:text-pink-400 text-xs"></i>
                    <span>WCPD Desk</span>
                </button>
                <button type="button" onclick="askFaqQuickQuestion('How do I report an online scam?')"
                    class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 font-bold text-xs whitespace-nowrap transition-all duration-200 border border-slate-200 dark:border-slate-700 hover:border-pnp-gold shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-95 flex items-center gap-1.5 cursor-pointer shrink-0">
                    <i class="fas fa-shield-virus text-indigo-500 dark:text-indigo-400 text-xs"></i>
                    <span>Report Online Scam</span>
                </button>
            </div>
        </div>

        <!-- Chat Input Bar (Modal Footer) -->
        <div class="p-4 sm:p-5 md:p-6 bg-gradient-to-b from-white to-slate-50 dark:from-slate-900 dark:to-slate-950 border-t-2 border-slate-200/90 dark:border-slate-800 shrink-0 shadow-lg">
            <div class="flex items-center gap-2.5 sm:gap-3.5">
                <input type="text" id="faq-chat-input" placeholder="Ask a question about PNP Sta. Cruz services, clearance, blotters, hotlines..."
                    class="flex-grow bg-slate-50 focus:bg-white dark:bg-slate-950 dark:focus:bg-slate-900 border-2 border-slate-200 dark:border-slate-700 rounded-2xl px-5 py-3.5 sm:py-4 text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-pnp-blue dark:focus:border-pnp-gold focus:ring-4 focus:ring-pnp-blue/15 dark:focus:ring-pnp-gold/20 transition-all duration-200 shadow-inner"
                    onkeydown="if(event.key === 'Enter') sendFaqChat()">
                <button type="button" id="faq-chat-send-btn" onclick="sendFaqChat()"
                    class="bg-gradient-to-r from-pnp-blue via-[#183657] to-pnp-blue hover:from-[#183657] hover:to-[#10243a] text-white dark:from-pnp-gold dark:via-yellow-400 dark:to-pnp-gold dark:text-slate-950 px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl font-black text-xs sm:text-sm uppercase tracking-wider transition-all duration-200 flex items-center justify-center shrink-0 shadow-md shadow-pnp-blue/25 dark:shadow-pnp-gold/30 hover:shadow-lg active:scale-95 cursor-pointer border border-pnp-gold/30">
                    <i class="fas fa-paper-plane mr-2 text-xs sm:text-sm"></i>
                    <span>Send</span>
                </button>
            </div>
            <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-slate-500 dark:text-slate-400 font-semibold mt-2.5 px-1">
                <span class="flex items-center gap-1.5">
                    <i class="fas fa-shield-halved text-pnp-gold"></i>
                    <span>Strict Scope: Official public FAQs only. System commands, coding, and internal access are strictly restricted (R.A. 10175).</span>
                </span>
                <span class="hidden sm:inline">Press <kbd class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono text-[9px] border border-slate-300 dark:border-slate-700">Enter</kbd> to send</span>
            </div>
