    // Message Formatting with strict HTML entity escaping
    function formatFaqMsg(text) {
        if (!text) return '';
        let safe = String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>');
        safe = safe.replace(/\n/g, '<br>');
        return safe;
    }

