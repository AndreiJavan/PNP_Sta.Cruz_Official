        <!-- Quick Suggestions Horizontal Toolbar -->
        <div class="px-4 py-3 sm:px-7 sm:py-3.5 bg-slate-100/90 dark:bg-[#0c1624] border-t border-slate-200/90 dark:border-slate-800 shrink-0 backdrop-blur-sm">
            <div class="flex items-center gap-2 overflow-x-auto custom-modal-scrollbar pb-1 text-xs">
                <span class="text-[9.5px] sm:text-[10px] font-black uppercase tracking-widest text-pnp-blue dark:text-pnp-gold shrink-0 mr-1.5 flex items-center gap-1">
                    <i class="fas fa-bolt text-pnp-gold"></i> Quick Ask:
                </span>
                <button type="button" onclick="askFaqQuickQuestion('How to get a police clearance?')"
                    class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-pnp-blue hover:text-white dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 font-bold text-xs whitespace-nowrap transition-all duration-200 border border-slate-200 dark:border-slate-700 hover:border-pnp-gold shadow-2xs hover:shadow-md hover:-translate-y-0.5 active:scale-95 flex items-center gap-1.5 cursor-pointer shrink-0">
