        if (!chatBox) return;

        const isUser = sender === 'user';
        const msgWrapper = document.createElement('div');
        msgWrapper.className = isUser ? "flex justify-end" : "flex justify-start";

        const msgDiv = document.createElement('div');
        if (isUser) {
            msgDiv.className = "bg-gradient-to-r from-pnp-blue via-[#1264BE] to-pnp-blue dark:from-pnp-gold dark:via-yellow-400 dark:to-pnp-gold text-white dark:text-slate-950 p-4 sm:p-5 rounded-2xl sm:rounded-3xl max-w-[85%] sm:max-w-xl text-left shadow-md font-semibold text-xs sm:text-sm whitespace-pre-wrap leading-relaxed border border-pnp-blue-300/30 dark:border-pnp-gold-600";
        } else if (isSecurityAlert) {
            msgDiv.className = "bg-rose-500/10 dark:bg-rose-950/40 text-slate-800 dark:text-rose-100 border-2 border-rose-500/80 dark:border-rose-500/60 border-l-4 border-l-rose-600 p-4 sm:p-6 rounded-2xl sm:rounded-3xl max-w-2xl lg:max-w-3xl text-left shadow-lg font-normal text-xs sm:text-sm leading-relaxed space-y-3 relative";
        } else {
            msgDiv.className = "bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 border border-slate-200/90 dark:border-slate-800 border-l-4 border-l-pnp-gold p-4 sm:p-6 rounded-2xl sm:rounded-3xl max-w-2xl lg:max-w-3xl text-left shadow-sm font-normal text-xs sm:text-sm leading-relaxed space-y-3 relative";
        }

        let inner = '';
        if (isSecurityAlert) {
            inner += `
                <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <span class="w-6 h-6 rounded-lg bg-rose-600 text-white flex items-center justify-center text-[10px] font-black shadow-xs">
                        <i class="fas fa-shield-virus"></i>
                    </span>
                    <strong class="text-xs font-black uppercase tracking-wider text-rose-600 dark:text-rose-400">PNP Cyber Security Guard</strong>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-600 dark:text-rose-300 border border-rose-500/40 font-bold">Access Blocked &bull; R.A. 10175</span>
                </div>
            `;
        } else if (!isUser) {
            inner += `
                <div class="flex items-center gap-2 mb-1">
                    <span class="w-6 h-6 rounded-lg bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-950 flex items-center justify-center text-[10px] font-black shadow-xs">
                        <i class="fas fa-shield-halved"></i>
                    </span>
                    <strong class="text-xs font-black uppercase tracking-wider text-pnp-blue dark:text-pnp-gold">Sta. Cruz Police Assistant</strong>
                </div>
            `;
        }

        inner += `<div class="leading-relaxed">${formatFaqMsg(text)}</div>`;

        if (!isUser && nearQuestions && nearQuestions.length > 0) {
            const t = faqBotTranslations[currentFaqLang] || faqBotTranslations.en;
            const heading = isInScope ? t.nearHeadingInScope : t.nearHeadingOutOfScope;

            inner += `
                <div class="mt-4 pt-3.5 border-t border-slate-100 dark:border-slate-800 text-left">
                    <span class="text-[9.5px] sm:text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2.5 flex items-center gap-1.5">
                        <i class="fas fa-compass text-pnp-gold text-[10px]"></i>
                        <span>${heading}</span>
                    </span>
                    <div class="flex flex-wrap gap-2">
                        ${nearQuestions.map(q => `
                            <button type="button" onclick="askFaqQuickQuestion('${String(q).replace(/'/g, "\\'")}')"
                                class="text-xs font-bold px-3.5 py-1.5 rounded-xl bg-slate-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-800/90 dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 transition-all duration-200 flex items-center gap-2 cursor-pointer text-left border border-slate-200 dark:border-slate-700/80 hover:border-pnp-gold shadow-2xs hover:shadow-sm hover:-translate-y-0.5">
