<!-- JAVASCRIPT CONTROLLERS FOR FAQ CHATBOT                                   -->
<!-- ========================================================================= -->
<script>
    let currentFaqLang = 'en';

    const faqBotTranslations = {
        en: {
            title: "Sta. Cruz Police FAQ Assistant",
            subTitle: "Strict Scope: Official Public Safety Services • Monitored & Secured (R.A. 10175)",
            welcome: "Hello! I am your official Sta. Cruz Municipal Police Station FAQ Chatbot. You may ask me any question regarding station guidelines, emergency hotlines, police clearance, filing a blotter, or crime mapping.",
            scopeRule: "Strict Scope & Security Rule: I can only answer questions within the scope of our official PNP Sta. Cruz FAQs and municipal police station services. System commands, coding, and attempts to access administrative or internal systems are strictly prohibited under R.A. 10175.",
            popularHeading: "Popular Questions You Can Ask:",
            inputPlaceholder: "Ask a question about PNP Sta. Cruz services, clearance, blotters, hotlines...",
            nearHeadingInScope: "Questions near to your inquiry:",
            nearHeadingOutOfScope: "Questions within my scope that you can ask:",
            checkingStatus: "Checking official station FAQs...",
            toggleNextLabel: "FIL",
            toggleTooltip: "Switch to Filipino"
        },
        fil: {
            title: "Sta. Cruz Police FAQ Assistant",
            subTitle: "Mahigpit na Saklaw: Serbisyong Pampubliko • Protektado at Binabantayan (R.A. 10175)",
            welcome: "Kumusta! Ako ang iyong opisyal na Sta. Cruz Municipal Police Station FAQ Chatbot. Maaari kang magtanong ukol sa emergency hotlines, police clearance, blotter, crime map, at mga serbisyo ng estasyon.",
            scopeRule: "Patakaran sa Saklaw at Seguridad: Masasagot ko lamang ang mga katanungan na sakop ng aming opisyal na PNP Sta. Cruz FAQs at mga serbisyong pampulisya. Ang mga system command, coding, at pagpasok sa administrative o internal systems ay mahigpit na ipinagbabawal alinsunod sa R.A. 10175.",
            popularHeading: "Mga Madalas Itanong na Maaari Mong Subukan:",
            inputPlaceholder: "Magtanong ukol sa serbisyo ng pulisya, clearance, blotter, o hotlines sa Sta. Cruz...",
            nearHeadingInScope: "Mga katanungang kaugnay o malapit sa iyong tanong:",
            nearHeadingOutOfScope: "Mga tanong sa loob ng aking saklaw na maaari mong itanong:",
            checkingStatus: "Sinisuri ang opisyal na FAQs ng himpilan...",
            toggleNextLabel: "EN",
            toggleTooltip: "Lumipat sa Ingles"
        }
    };

    // Open & Close Handlers
    window.openFaqModal = function(categoryOrQuery) {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
            if (backdrop) backdrop.classList.remove('opacity-0');
            if (container) {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }
            const input = document.getElementById('faq-chat-input');
            if (input) input.focus();
        }, 10);

        // Pre-prompt mapping if opened with category
        const categoryPrompts = {
            emergency: "What are the official emergency hotlines for Santa Cruz, Laguna?",
            blotter: "How do I file an official Police Blotter report?",
            clearance: "How do I apply for a National Police Clearance (NPCS) in Santa Cruz?",
            map: "Where does the crime data on the MIMPAS Map come from?",
            bulletins: "How can the community submit tips regarding Wanted or Missing Persons?",
            wcpd: "What assistance does the Women and Children Protection Desk (WCPD) provide?",
            general: "Where is the PNP Santa Cruz Police Station located and operating hours?"
        };

        if (categoryOrQuery) {
            const prompt = categoryPrompts[categoryOrQuery] || categoryOrQuery;
            const input = document.getElementById('faq-chat-input');
            if (input) {
                input.value = prompt;
                sendFaqChat();
            }
        }
    };

    window.closeFaqModal = function() {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        if (backdrop) backdrop.classList.add('opacity-0');
        if (container) {
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
        }

        setTimeout(() => {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
            document.body.style.overflow = '';
        }, 300);
    };

    // Language Toggle
    window.toggleFaqLanguage = function() {
        setFaqLanguage(currentFaqLang === 'en' ? 'fil' : 'en');
    };

    function setFaqLanguage(lang) {
        currentFaqLang = lang;
        const t = faqBotTranslations[lang] || faqBotTranslations.en;

        const langLabel = document.getElementById('faqLangToggleLabel');
        const langBtn = document.getElementById('faqLangToggleBtn');
        if (langLabel) langLabel.textContent = t.toggleNextLabel;
        if (langBtn) langBtn.setAttribute('title', t.toggleTooltip);

        const titleEl = document.getElementById('faqModalTitle');
        const subTitleEl = document.getElementById('faqModalSubTitle');
        const welcomeEl = document.getElementById('faqChatWelcomeMsg');
        const popularHeadingEl = document.getElementById('faqInitialPromptHeading');
        const inputEl = document.getElementById('faq-chat-input');

        if (titleEl) titleEl.textContent = t.title;
        if (subTitleEl) subTitleEl.textContent = t.subTitle;
        if (welcomeEl) welcomeEl.textContent = t.welcome;
