                <!-- Initial Suggested Questions -->
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                    <span class="text-[9.5px] sm:text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2.5 flex items-center gap-1.5">
