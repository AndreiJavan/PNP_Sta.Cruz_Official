    // Category styling helper
    function getCategoryMeta(cat) {
        const c = (cat || '').toLowerCase().trim();
        if (c.includes('emergency')) return { icon: 'fa-phone-volume', label: cat || 'Emergency' };
        if (c.includes('blotter')) return { icon: 'fa-file-pen', label: cat || 'Blotter' };
        if (c.includes('clearance')) return { icon: 'fa-id-card', label: cat || 'Clearance' };
        if (c.includes('crime map') || c.includes('map') || c.includes('mimpas')) return { icon: 'fa-map-location-dot', label: cat || 'Crime Map' };
        if (c.includes('wcpd') || c.includes('women') || c.includes('children')) return { icon: 'fa-shield-heart', label: cat || 'WCPD Desk' };
        if (c.includes('bulletin') || c.includes('wanted') || c.includes('missing')) return { icon: 'fa-bullhorn', label: cat || 'Bulletins' };
        if (c.includes('cyber') || c.includes('scam')) return { icon: 'fa-shield-virus', label: cat || 'Cybercrime' };
        if (c.includes('firearm') || c.includes('ltopf')) return { icon: 'fa-crosshairs', label: cat || 'Firearms / LTOPF' };
        if (c.includes('drug') || c.includes('badac')) return { icon: 'fa-capsules', label: cat || 'Anti-Drug' };
        return { icon: 'fa-building-shield', label: cat || 'General' };
    }

    // Toggle Expandable Quick Ask Drawer throughout modal only
    
    // Function to dynamically refresh FAQs from database API
    async function refreshFaqsFromApi() {
        try {
            const res = await fetch('/api/faqs?t=' + Date.now());
            if (res.ok) {
                const data = await res.json();
                if (Array.isArray(data) && data.length > 0) {
                    FAQ_DATA = data;
                    renderCategoryTabs();
                    renderQuestionsGrid();
                }
            }
        } catch (e) {
            console.warn('Live FAQ refresh skipped:', e);
        }
    }

    
    // Smooth, reliable scroll to bottom so message is never cut off
    function scrollFaqChatToBottom() {
        const chatBox = document.getElementById('faq-chat-messages');
        const anchor = document.getElementById('faq-chat-anchor');
        if (!chatBox) return;

        requestAnimationFrame(() => {
            if (anchor) {
                anchor.scrollIntoView({ behavior: 'smooth', block: 'end' });
            } else {
                chatBox.scrollTo({ top: chatBox.scrollHeight + 100, behavior: 'smooth' });
            }
        });
        setTimeout(() => {
            if (anchor) {
                anchor.scrollIntoView({ behavior: 'auto', block: 'end' });
            } else {
                chatBox.scrollTop = chatBox.scrollHeight + 100;
            }
        }, 120);
    }

    window.toggleQuickAsk = function(forceState) {
        const drawer = document.getElementById('faqQuickAskDrawer');
        const minBar = document.getElementById('faqQuickAskMinimizedBar');
        const expContent = document.getElementById('faqQuickAskExpandedContent');
        const searchInput = document.getElementById('faqDrawerSearch');

        if (!drawer || !minBar || !expContent) return;

        isQuickAskExpanded = (forceState !== undefined) ? !!forceState : !isQuickAskExpanded;

        if (isQuickAskExpanded) {
            // Expand throughout the modal body below the header
            drawer.classList.remove('h-20');
            drawer.classList.add('h-[calc(100%-72px)]', 'top-[72px]', 'border-pnp-gold');
            minBar.classList.add('hidden');
            expContent.classList.remove('hidden');
            expContent.classList.add('flex');

            // Render updated grid & tabs
            renderCategoryTabs();
            renderQuestionsGrid();

            // Focus search input after expansion
            setTimeout(() => {
                if (searchInput && window.innerWidth >= 768) {
                    searchInput.focus();
                }
            }, 150);
        } else {
            // Minimize back to docked footer
            drawer.classList.remove('h-[calc(100%-72px)]', 'top-[72px]', 'border-pnp-gold');
            drawer.classList.add('h-20');
            expContent.classList.add('hidden');
            expContent.classList.remove('flex');
            minBar.classList.remove('hidden');
        }
    };

