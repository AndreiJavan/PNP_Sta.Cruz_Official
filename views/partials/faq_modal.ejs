        const sqlInjectionPatterns = [
            /\b(union(\s+all)?\s+select|select\s+.*?\s+from\s+[a-z0-9_]+|insert\s+into\s+[a-z0-9_]+|delete\s+from\s+[a-z0-9_]+|drop\s+table|alter\s+table|truncate\s+table)\b/i,
