<div id="faqModal" class="fixed inset-0 z-[9999] hidden items-center justify-center p-2 sm:p-4 md:p-6 transition-all duration-300" role="dialog" aria-modal="true" aria-labelledby="faqModalTitle">
    <!-- Modal Backdrop -->
    <div id="faqModalBackdrop" class="absolute inset-0 bg-slate-950/85 backdrop-blur-md transition-opacity duration-300 opacity-0" onclick="closeFaqModal()"></div>

    <!-- Modal Container: Spacious layout with elevated PNP tactical design -->
    <div id="faqModalContainer" class="relative bg-white dark:bg-slate-900 w-full max-w-5xl xl:max-w-6xl h-[95vh] sm:h-[90vh] rounded-2xl sm:rounded-[2rem] shadow-2xl border-2 border-slate-200/80 dark:border-slate-700/80 overflow-hidden flex flex-col transform transition-all duration-300 scale-95 opacity-0">
        
        <!-- Top Tactical Accent Stripe -->
        <div class="h-1.5 w-full bg-gradient-to-r from-pnp-blue via-pnp-gold to-pnp-blue shrink-0 shadow-xs"></div>

        <!-- Modal Header: Deep PNP Police Navy with Gold Accents -->
