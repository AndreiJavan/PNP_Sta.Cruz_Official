    // Clear Chat
    window.clearFaqChat = function() {
        const chatBox = document.getElementById('faq-chat-messages');
        if (!chatBox) return;

        const t = faqBotTranslations[currentFaqLang] || faqBotTranslations.en;

        chatBox.innerHTML = `
            <div class="bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 border-l-4 border-l-pnp-gold p-5 sm:p-7 rounded-2xl sm:rounded-3xl max-w-2xl lg:max-w-3xl mr-auto text-left shadow-md space-y-3.5 leading-relaxed relative overflow-hidden">
                <div class="flex items-center gap-3">
                    <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-2xl bg-gradient-to-br from-pnp-blue to-pnp-blue-700 text-pnp-gold flex items-center justify-center text-sm font-black shadow-xs border border-pnp-gold/30">
                        <i class="fas fa-shield-halved"></i>
                    </span>
                    <div>
                        <strong class="text-xs sm:text-sm font-black uppercase tracking-wider text-pnp-blue dark:text-pnp-gold block leading-none">
                            PNP Santa Cruz Police Assistant
                        </strong>
                        <span class="text-[9.5px] sm:text-[10px] text-slate-500 dark:text-slate-400 font-bold block mt-0.5">
                            Official Municipal Police Station Desk &bull; Sta. Cruz, Laguna
                        </span>
                    </div>
                </div>

                <p id="faqChatWelcomeMsg" class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed font-medium">
                    ${t.welcome}
                </p>

                <div class="p-3.5 sm:p-4 rounded-2xl bg-amber-500/10 dark:bg-amber-500/15 border border-amber-400/40 dark:border-amber-400/30 text-[11px] sm:text-xs text-amber-900 dark:text-amber-200 flex items-start gap-2.5 leading-relaxed shadow-2xs font-semibold">
                    <i class="fas fa-shield-halved text-amber-600 dark:text-amber-400 text-sm mt-0.5 shrink-0"></i>
                    <span>
                        <strong class="font-bold">Strict Scope Rule:</strong> ${t.scopeRule}
                    </span>
                </div>

                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                    <span class="text-[9.5px] sm:text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2.5 flex items-center gap-1.5">
                        <i class="fas fa-sparkles text-pnp-gold text-[10px]"></i>
                        <span id="faqInitialPromptHeading">${t.popularHeading}</span>
                    </span>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" onclick="askFaqQuickQuestion('How do I apply for a National Police Clearance (NPCS)?')"
                            class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-800 dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 transition-all duration-200 border border-slate-200 dark:border-slate-700/80 hover:border-pnp-gold flex items-center gap-2 cursor-pointer shadow-2xs hover:shadow-sm hover:-translate-y-0.5 text-left">
                            <i class="fas fa-id-card text-emerald-500 dark:text-emerald-400 text-xs"></i>
                            <span>How to get Police Clearance?</span>
                        </button>
                        <button type="button" onclick="askFaqQuickQuestion('What are the official emergency hotlines for Santa Cruz, Laguna?')"
                            class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-800 dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 transition-all duration-200 border border-slate-200 dark:border-slate-700/80 hover:border-pnp-gold flex items-center gap-2 cursor-pointer shadow-2xs hover:shadow-sm hover:-translate-y-0.5 text-left">
                            <i class="fas fa-phone-volume text-rose-500 dark:text-rose-400 text-xs"></i>
                            <span>Emergency Hotlines (911)</span>
                        </button>
                        <button type="button" onclick="askFaqQuickQuestion('How do I file an official Police Blotter report?')"
                            class="text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-50 hover:bg-pnp-blue hover:text-white dark:bg-slate-800 dark:hover:bg-pnp-gold dark:hover:text-slate-950 text-slate-800 dark:text-slate-200 transition-all duration-200 border border-slate-200 dark:border-slate-700/80 hover:border-pnp-gold flex items-center gap-2 cursor-pointer shadow-2xs hover:shadow-sm hover:-translate-y-0.5 text-left">
                            <i class="fas fa-file-pen text-amber-500 dark:text-amber-400 text-xs"></i>
                            <span>How to file a Police Blotter?</span>
                        </button>
                    </div>
                </div>
            </div>
        `;
    };

    // Keyboard ESC Handler: Minimizes Quick Ask first if open, or closes Modal
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            if (isQuickAskExpanded) {
                toggleQuickAsk(false);
                return;
            }
            const modal = document.getElementById('faqModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeFaqModal();
            }
        }
    });

    // Auto-open and Data Fetch on DOMContentLoaded
    document.addEventListener('DOMContentLoaded', () => {
        // Fallback fetch if FAQ_DATA is empty
        if (!FAQ_DATA || FAQ_DATA.length === 0) {
            fetch('/api/faqs')
                .then(r => r.json())
                .then(data => {
                    if (Array.isArray(data) && data.length > 0) {
                        FAQ_DATA = data;
                        renderCategoryTabs();
                        renderQuestionsGrid();
                    }
                })
                .catch(err => console.warn('FAQ fallback fetch failed:', err));
        } else {
            renderCategoryTabs();
            renderQuestionsGrid();
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (window.location.hash === '#faq' || urlParams.get('faq') === '1' || urlParams.get('faq') === 'true') {
            setTimeout(() => {
                openFaqModal();
            }, 300);
        }
    });
</script>
