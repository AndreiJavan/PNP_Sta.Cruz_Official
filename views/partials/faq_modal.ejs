                        <span>Strict Scope: Official Public Safety Services &bull; Monitored & Secured (R.A. 10175)</span>
                    </p>
                </div>
            </div>

            <!-- Right Controls: Distinctly Styled Header Buttons -->
            <div class="flex items-center space-x-2 shrink-0">
                <!-- Single Language Toggle Button -->
                <button id="faqLangToggleBtn" onclick="toggleFaqLanguage()" type="button"
