<!-- FAQ SCRIPT & INTERACTIVE CONTROLS                                         -->
<!-- ========================================================================= -->
<script>
    // Bilingual Text Store for FAQ Items
    const faqTranslations = {
        en: {
            title: "Official Station FAQ",
            verifiedBadge: "100% Verified",
            subTitle: "PNP Sta. Cruz, Laguna PPO • Accurate Guidelines & Public Services",
            searchPlaceholder: "Search answers (e.g. police clearance, blotter, 911, hotlines, crime map, WCPD)...",
            authoritativeTitle: "Authoritative Public Safety Information",
            authoritativeBody: "This official FAQ replaces automated AI assistant outputs to guarantee 100% legal precision, station-verified hotlines, and standard operating procedures directly from the PNP Santa Cruz Municipal Police Station.",
            expandAll: "Expand All",
            collapseAll: "Collapse All"
        },
        fil: {
            title: "Opisyal na FAQ ng Himpilan",
            verifiedBadge: "100% Beripikado",
            subTitle: "PNP Sta. Cruz, Laguna PPO • Tumpak na Gabay at Serbisyong Pampubliko",
            searchPlaceholder: "Maghanap ng sagot (hal. police clearance, blotter, 911, hotlines, crime map, WCPD)...",
            authoritativeTitle: "Awtorisadong Impormasyon sa Kaligtasan",
            authoritativeBody: "Ang opisyal na FAQ na ito ang pumapalit sa automated AI assistant upang tiyakin ang 100% kawastuhan sa batas, beripikadong hotlines, at pamamaraan ng PNP Santa Cruz Municipal Police Station.",
            expandAll: "Buksan Lahat",
            collapseAll: "Isara Lahat"
        }
    };

    let currentFaqLang = 'en';
    let currentFaqCategory = 'all';
    let allFaqExpanded = false;

    // Open FAQ Modal
    function openFaqModal(categoryOrQuery) {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
            if (backdrop) backdrop.classList.remove('opacity-0');
            if (container) {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }
        }, 10);

        if (categoryOrQuery) {
            if (['emergency', 'blotter', 'clearance', 'map', 'bulletins', 'wcpd', 'general', 'all'].includes(categoryOrQuery)) {
                setFaqCategory(categoryOrQuery);
            } else {
                const searchInput = document.getElementById('faqSearchInput');
                if (searchInput) {
                    searchInput.value = categoryOrQuery;
                    filterFaqQuestions();
                }
            }
        }
    }

    // Close FAQ Modal
    function closeFaqModal() {
        const modal = document.getElementById('faqModal');
        const backdrop = document.getElementById('faqModalBackdrop');
        const container = document.getElementById('faqModalContainer');
        if (!modal) return;

        if (backdrop) backdrop.classList.add('opacity-0');
        if (container) {
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
        }

        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }, 280);
    }

    // Toggle specific accordion
    function toggleFaqItem(id) {
        const answerEl = document.getElementById(`faq-answer-${id}`);
        if (!answerEl) return;
        const itemEl = answerEl.closest('.faq-item');
        const chevron = itemEl ? itemEl.querySelector('.faq-chevron') : null;

        const isHidden = answerEl.classList.contains('hidden');
        if (isHidden) {
            answerEl.classList.remove('hidden');
            if (chevron) chevron.classList.add('rotate-180', 'text-pnp-blue', 'dark:text-pnp-gold');
        } else {
            answerEl.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180', 'text-pnp-blue', 'dark:text-pnp-gold');
        }
    }

    // Category Selector
    function setFaqCategory(category) {
        currentFaqCategory = category;
        
        // Update pill UI styles
        document.querySelectorAll('.faq-cat-pill').forEach(btn => {
            const cat = btn.getAttribute('data-faq-cat');
            if (cat === category) {
                btn.className = 'faq-cat-pill px-3 py-1.5 rounded-xl whitespace-nowrap transition-all uppercase tracking-wider text-[10px] font-black bg-pnp-blue text-white dark:bg-pnp-gold dark:text-slate-950 shadow-xs';
            } else {
                btn.className = 'faq-cat-pill px-3 py-1.5 rounded-xl whitespace-nowrap transition-all uppercase tracking-wider text-[10px] font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700';
            }
        });

        filterFaqQuestions();
    }

    // Filter Questions (Category + Search Query)
    function filterFaqQuestions() {
        const searchInput = document.getElementById('faqSearchInput');
        const clearBtn = document.getElementById('faqSearchClearBtn');
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

        if (clearBtn) {
            if (query.length > 0) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
        }

        const items = document.querySelectorAll('.faq-item');
        let visibleCount = 0;

        items.forEach(item => {
            const cat = item.getAttribute('data-faq-cat') || '';
            const keywords = (item.getAttribute('data-keywords') || '').toLowerCase();
            const textContent = item.textContent.toLowerCase();

            const matchesCategory = (currentFaqCategory === 'all') || (cat === currentFaqCategory);
            const matchesQuery = !query || keywords.includes(query) || textContent.includes(query);

            if (matchesCategory && matchesQuery) {
                item.classList.remove('hidden');
                visibleCount++;
            } else {
                item.classList.add('hidden');
            }
        });

        // Toggle No Results View
        const noResults = document.getElementById('faqNoResults');
        if (noResults) {
            if (visibleCount === 0) noResults.classList.remove('hidden');
            else noResults.classList.add('hidden');
        }

        // Update count badge
        const countBadge = document.getElementById('faqCountBadge');
        if (countBadge) {
            countBadge.textContent = `${visibleCount} Question${visibleCount === 1 ? '' : 's'}`;
        }
    }

    // Clear Search Input
    function clearFaqSearch() {
        const searchInput = document.getElementById('faqSearchInput');
        if (searchInput) {
            searchInput.value = '';
            filterFaqQuestions();
            searchInput.focus();
        }
    }

    // Toggle All Accordions
    function toggleAllFaqAccordions() {
        allFaqExpanded = !allFaqExpanded;
        const answers = document.querySelectorAll('.faq-answer');
        const chevrons = document.querySelectorAll('.faq-chevron');
        const toggleBtn = document.getElementById('faqToggleAllBtn');

        answers.forEach(a => {
            if (allFaqExpanded) a.classList.remove('hidden');
            else a.classList.add('hidden');
        });

        chevrons.forEach(c => {
            if (allFaqExpanded) c.classList.add('rotate-180', 'text-pnp-blue', 'dark:text-pnp-gold');
            else c.classList.remove('rotate-180', 'text-pnp-blue', 'dark:text-pnp-gold');
        });

        if (toggleBtn) {
            toggleBtn.textContent = allFaqExpanded 
                ? (currentFaqLang === 'fil' ? 'Isara Lahat' : 'Collapse All')
                : (currentFaqLang === 'fil' ? 'Buksan Lahat' : 'Expand All');
        }
    }

    // Switch Language (EN / FIL)
    function setFaqLanguage(lang) {
        currentFaqLang = lang;
        const enBtn = document.getElementById('faqLangEnBtn');
        const filBtn = document.getElementById('faqLangFilBtn');

        if (lang === 'en') {
            if (enBtn) {
                enBtn.className = 'px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider transition-all bg-white dark:bg-pnp-gold text-pnp-blue dark:text-slate-950 shadow-xs font-black';
            }
            if (filBtn) {
                filBtn.className = 'px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-bold';
            }
        } else {
            if (filBtn) {
                filBtn.className = 'px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider transition-all bg-white dark:bg-pnp-gold text-pnp-blue dark:text-slate-950 shadow-xs font-black';
            }
            if (enBtn) {
                enBtn.className = 'px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider transition-all text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white font-bold';
            }
        }

        const t = faqTranslations[lang] || faqTranslations.en;
        const titleEl = document.getElementById('faqModalTitle');
        const searchInput = document.getElementById('faqSearchInput');
        const toggleBtn = document.getElementById('faqToggleAllBtn');

        if (titleEl) titleEl.textContent = t.title;
        if (searchInput) searchInput.placeholder = t.searchPlaceholder;
        if (toggleBtn) toggleBtn.textContent = allFaqExpanded ? t.collapseAll : t.expandAll;
    }

    // Keyboard ESC & Hash / URL Auto-open handler
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const modal = document.getElementById('faqModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeFaqModal();
            }
        }
    });

    // Auto-open if #faq or ?faq=1 in URL
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (window.location.hash === '#faq' || urlParams.get('faq') === '1' || urlParams.get('faq') === 'true') {
            setTimeout(() => {
                openFaqModal();
            }, 300);
        }
    });
</script>
