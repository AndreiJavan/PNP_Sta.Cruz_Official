        }

        const topics = [
            { id: 1, words: ["emergency", "ongoing", "crime", "saklolo", "tulong", "911", "urgent", "krimen", "dispatch"], answerEn: "In an ongoing emergency or crime in progress, dial **911** immediately or call the Sta. Cruz Police Station desk directly at **(049) 501-5971** or **0998 598 5667**.\n\nPlease provide: your exact location (Barangay, street/landmark), nature of the incident, and descriptions of suspects or any injuries.", answerFil: "Sa oras ng agarang emergency o nagaganap na krimen, tumawag agad sa **911** o sa Sta. Cruz Police Station desk sa **(049) 501-5971** o **0998 598 5667**.\n\nIbigay ang: eksaktong lokasyon (Barangay, kalye/landmark), uri ng insidente, at deskripsyon ng suspek.", nearEn: ["What are the official emergency hotlines for Santa Cruz, Laguna?", "How do I file an official Police Blotter report?", "Where is the police station located?"], nearFil: ["Ano ang mga opisyal na emergency hotline?", "Paano mag-file ng Police Blotter?", "Saan matatagpuan ang estasyon?"] },
            { id: 2, words: ["hotline", "hotlines", "number", "numbers", "contact", "phone", "telepono", "numero", "tawag", "bfp", "fire", "mdrrmo"], answerEn: "Official Sta. Cruz Emergency Hotlines:\n• **PNP Sta. Cruz Desk:** (049) 501-5971 / 0998 598 5667\n• **National Emergency Hotline:** 911\n• **BFP Fire Station:** (049) 501-1911 / 0915 602 2167\n• **MDRRMO Disaster & Rescue:** (049) 501-2070 / 0939 917 5202\n• **Laguna PPO:** (049) 501-1647", answerFil: "Mga Opisyal na Emergency Hotline ng Sta. Cruz:\n• **PNP Sta. Cruz Desk:** (049) 501-5971 / 0998 598 5667\n• **Pambansang Emergency:** 911\n• **BFP Fire Station (Sunog):** (049) 501-1911 / 0915 602 2167\n• **MDRRMO Rescue:** (049) 501-2070 / 0939 917 5202", nearEn: ["How do I report an ongoing emergency?", "Where is the police station located?", "What assistance does the WCPD provide?"], nearFil: ["Paano mag-ulat ng emergency?", "Saan matatagpuan ang estasyon?", "Anong tulong ang ibinibigay ng WCPD?"] },
            { id: 6, words: ["clearance", "npcs", "kuha clearance", "apply clearance", "police clearance", "jobseeker"], answerEn: "To apply for a National Police Clearance (NPCS):\n1. Register online at https://pnpclearance.ph and book an appointment at Sta. Cruz MPS.\n2. Pay ₱180 via Landbank/e-wallet (free for first-time jobseekers with Barangay certificate).\n3. Bring 2 valid IDs and appointment slip to the station for biometrics.\nClearance is released in about 10-15 minutes if there is no hit.", answerFil: "Para kumuha ng National Police Clearance (NPCS):\n1. Mag-rehistro sa https://pnpclearance.ph at pumili ng appointment sa Sta. Cruz MPS.\n2. Magbayad ng ₱180 (libre sa First-Time Jobseekers).\n3. Magdala ng 2 valid ID at appointment slip para sa biometrics.\nMatatapos ito sa loob ng 10-15 minuto kung walang hit.", nearEn: ["What valid government IDs and documents are accepted for Police Clearance?", "Can I get a Police Clearance for free under the First-Time Jobseekers Act?", "Where is the police station located?"], nearFil: ["Anu-anong valid government ID ang tinatanggap?", "Libre ba ang clearance para sa First-Time Jobseekers?", "Saan matatagpuan ang estasyon?"] },
            { id: 3, words: ["blotter", "magpablotter", "magpa-blotter", "report", "reklamo", "complaint", "katarungang"], answerEn: "To file an official Police Blotter report, personally visit the Sta. Cruz MPS Investigation Section (1153 A. Mabini St., Poblacion) with a valid government ID. An investigator will take your sworn statement and issue an Incident Record Form (IRF) or Blotter Extract.", answerFil: "Para mag-file ng Police Blotter, pumunta personal sa Investigation Section ng Sta. Cruz MPS dala ang valid ID. Kapanayamin ka ng duty investigator at bibigyan ng kopya ng Incident Record Form (IRF).", nearEn: ["Can I file a police blotter online or through social media?", "When should I report to the Barangay Lupon versus the Police Station?", "What valid IDs are accepted?"], nearFil: ["Maaari ba akong magpa-blotter online?", "Kailan dapat sa Barangay Lupon muna?", "Anu-anong valid ID ang tinatanggap?"] },
            { id: 16, words: ["location", "address", "operating hours", "oras", "lugar", "saan", "istasyon", "headquarters"], answerEn: "Sta. Cruz Municipal Police Station is located at: 1153 A. Mabini St., Poblacion, Santa Cruz, Laguna (beside the Municipal Hall).\n• **Emergency Patrols & Desk:** 24/7 continuous operation\n• **Clearance & Administrative Services:** Monday to Friday, 8:00 AM – 5:00 PM.", answerFil: "Ang Sta. Cruz Police Station ay nasa: 1153 A. Mabini St., Poblacion, Santa Cruz, Laguna (katabi ng Munisipyo).\n• **Emergency Patrols:** 24/7 bukas araw at gabi\n• **Administrative & Clearance Services:** Lunes hanggang Biyernes, 8:00 AM – 5:00 PM.", nearEn: ["What are the official emergency hotlines for Santa Cruz, Laguna?", "How do I apply for a Police Clearance?", "Is there priority assistance for senior citizens, pregnant women, and PWDs?"], nearFil: ["Ano ang mga opisyal na emergency hotline?", "Paano kumuha ng Police Clearance?", "May priority assistance ba para sa PWD at seniors?"] },
            { id: 9, words: ["crime map", "mapa", "mimpas", "map", "filter map", "cases", "krimen sa mapa"], answerEn: "The MIMPAS Crime Map visualizes official CIRAS blotter-recorded incidents across all 26 barangays of Sta. Cruz, Laguna. You can filter cases by Barangay, Year, and 8-Focus Crime categories. To protect citizen privacy under R.A. 10173, no personal names or exact home addresses are ever displayed.", answerFil: "Ipinapakita ng MIMPAS Crime Map ang mga naitalang blotter sa 26 barangay ng Sta. Cruz. Maaari itong i-filter ayon sa Barangay, Taon, at uri ng krimen. Alinsunod sa Data Privacy Act, walang personal na pangalan o eksaktong tirahan ang inilalabas.", nearEn: ["Does the Crime Map disclose personal names or exact home addresses?", "How do I search or filter incidents by Barangay, Year, or Category on the Map?", "What is MIMPAS and how does it help Sta. Cruz residents?"], nearFil: ["Inilalabas ba sa Crime Map ang personal na pangalan?", "Paano mag-filter sa Mapa?", "Ano ang MIMPAS?"] },
            { id: 12, words: ["wcpd", "vawc", "women", "children", "babae", "bata", "pang-aabuso", "abuse"], answerEn: "The Women and Children Protection Desk (WCPD) provides private, confidential assistance for victims of domestic violence (R.A. 9262), child abuse (R.A. 7610), and gender harassment. Female investigators conduct interviews in a secure safe space.", answerFil: "Ang WCPD ay nagbibigay ng pribado at protektadong tulong para sa mga biktima ng karahasan sa kababaihan at kabataan (VAWC / R.A. 9262). Mga babaeng pulis ang nag-iimbestiga sa isang pribadong kwarto.", nearEn: ["What are the official emergency hotlines?", "How do I file an official Police Blotter report?", "Is there priority assistance for senior citizens, pregnant women, and PWDs?"], nearFil: ["Ano ang mga emergency hotline?", "Paano mag-file ng Police Blotter?", "May priority assistance ba sa estasyon?"] },
            { id: 13, words: ["cyber", "scam", "online scam", "hacking", "hacked", "facebook scam", "harassment online"], answerEn: "For online scams or cybercrime: preserve uncropped screenshots of chat messages, sender profile links, and transaction numbers. File an official complaint with the Sta. Cruz MPS Investigation Section or contact the PNP Anti-Cybercrime Group (RACU 4A) at 0998 598 8116.", answerFil: "Para sa online scam: i-save agad ang buong screenshot ng chat, profile link, at transaction reference number. Pumunta sa Sta. Cruz MPS o makipag-ugnayan sa PNP Anti-Cybercrime Group (RACU 4A) sa 0998 598 8116.", nearEn: ["How do I file an official Police Blotter report?", "Can I file a police blotter online?", "What are the official emergency hotlines?"], nearFil: ["Paano mag-file ng Police Blotter?", "Maaari ba magpa-blotter online?", "Ano ang mga emergency hotline?"] },
            { id: 20, words: ["which barangay", "barangay cases", "large amount of cases", "most cases", "highest cases", "pinakamaraming kaso", "maraming kaso", "aling barangay", "anong barangay", "crime cases", "dami ng kaso", "cases in"], answerEn: "Incident volumes in Santa Cruz, Laguna are actively tracked across all 26 barangays on the MIMPAS Crime Map. Denser commercial areas such as the Poblacion sectors typically report higher activity.\n\nTo view exact case counts, heatmaps, and filter by individual Barangay:\n• Visit the **Crime Map** (/map) on the top navigation.\n• Select your Barangay in the filter to inspect recorded cases and incident types.\n• For emergency police assistance, call **(049) 501-5971** or dial **911**.", answerFil: "Ang bilang ng kaso sa 26 na barangay ng Santa Cruz ay nakatala sa MIMPAS Crime Map. Ang mga sentro ng kalakalan tulad ng Poblacion ang kadalasang may pinakamaraming naitalang ulat.\n\nPara makita ang eksaktong bilang ng kaso sa bawat barangay:\n• Buksan ang **Crime Map** (/map) sa navigation.\n• Piliin ang Barangay sa filter upang makita ang mga insidente.\n• Para sa emergency, tumawag sa **(049) 501-5971** o mag-dial ng **911**.", nearEn: ["How do I search or filter incidents by Barangay, Year, or Category on the Map?", "Where does the crime data on the MIMPAS Map come from?", "What are the official emergency hotlines for Santa Cruz, Laguna?"], nearFil: ["Paano mag-filter sa Mapa?", "Saan nagmumula ang datos ng krimen?", "Ano ang mga opisyal na emergency hotline?"] }
        ];

        let bestTopic = null;
        let highestMatches = 0;

        for (const t of topics) {
            let matches = 0;
            for (const w of t.words) {
                if (qLower.includes(w)) matches++;
            }
            if (matches > highestMatches) {
                highestMatches = matches;
                bestTopic = t;
            }
        }

        if (highestMatches > 0 && bestTopic) {
            return {
                inScope: true,
                reply: isFil ? bestTopic.answerFil : bestTopic.answerEn,
                nearQuestions: isFil ? bestTopic.nearFil : bestTopic.nearEn
            };
        }

        return {
            inScope: false,
            reply: isFil 
                ? "Hindi ko masasagot ang katanungang iyan. Masasagot ko lamang ang mga katanungan na sakop ng opisyal na PNP Sta. Cruz FAQs at mga serbisyo ng ating estasyon ng pulisya."
                : "I cannot answer that question. I am programmed to only answer questions within the scope of the official PNP Sta. Cruz FAQs and public safety guidelines.",
            nearQuestions: isFil
                ? ["Paano mag-ulat ng emergency sa Sta. Cruz?", "Ano ang mga opisyal na hotline?", "Paano kumuha ng Police Clearance?", "Paano mag-file ng Police Blotter?"]
                : ["How do I report an ongoing emergency in Santa Cruz?", "What are the official emergency hotlines?", "How do I apply for a Police Clearance?", "How do I file an official Police Blotter?"]
        };
    }

    // Send Chat
    window.sendFaqChat = async function() {
        const inputEl = document.getElementById('faq-chat-input');
        const sendBtn = document.getElementById('faq-chat-send-btn');
        if (!inputEl) return;

        const text = inputEl.value.trim();
        if (!text) return;

        inputEl.value = '';
        inputEl.disabled = true;
        if (sendBtn) sendBtn.disabled = true;

        appendFaqChatMessage('user', text);

        // Client-side Security & Access Control Guard: Instant Interception
        const secThreat = detectFaqSecurityThreat(text, currentFaqLang);
        if (secThreat.blocked) {
            appendFaqChatMessage('assistant', secThreat.clientMessage, secThreat.nearQuestions, false, true);
            inputEl.disabled = false;
            if (sendBtn) sendBtn.disabled = false;
            inputEl.focus();
            return;
        }

        const chatBox = document.getElementById('faq-chat-messages');
        const indicator = document.createElement('div');
        indicator.id = 'faq-chat-typing';
        indicator.className = 'flex justify-start';
        indicator.innerHTML = `
            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold italic p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-2xs flex items-center gap-2">
                <i class="fas fa-circle-notch fa-spin text-pnp-blue dark:text-pnp-gold"></i>
                <span>${currentFaqLang === 'fil' ? 'Sinisuri ang opisyal na FAQs ng himpilan...' : 'Checking official station FAQs...'}</span>
            </div>
        `;
        chatBox.appendChild(indicator);
        chatBox.scrollTop = chatBox.scrollHeight;

        let res = null;
        try {
            res = await fetch('/api/faq-chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ question: text, language: currentFaqLang })
            }).then(r => r.json());
        } catch (err) {
            console.warn('Server chat error, using local matcher:', err);
        }

        if (!res || !res.reply) {
            res = clientFaqEvaluate(text, currentFaqLang);
        }

        const ind = document.getElementById('faq-chat-typing');
        if (ind) ind.remove();

        appendFaqChatMessage('assistant', res.reply, res.nearQuestions || [], res.inScope !== false, res.securityBlocked === true);

        inputEl.disabled = false;
        if (sendBtn) sendBtn.disabled = false;
        inputEl.focus();
    };

    // Keyboard ESC Handler
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const modal = document.getElementById('faqModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeFaqModal();
            }
        }
    });

    // Auto-open if #faq or ?faq=1 in URL
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        if (window.location.hash === '#faq' || urlParams.get('faq') === '1' || urlParams.get('faq') === 'true') {
            setTimeout(() => {
                openFaqModal();
            }, 300);
        }
    });
</script>
