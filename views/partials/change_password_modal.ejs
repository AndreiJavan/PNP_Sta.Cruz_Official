<!-- Change Password Modal -->
<div id="changePasswordModal" class="fixed inset-0 z-[2500] hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <!-- Backdrop with blur -->
    <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm transition-opacity" onclick="closeChangePasswordModal()"></div>

    <div class="flex min-h-screen items-center justify-center p-4 text-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-[2.5rem] bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md p-8">
            <!-- Header -->
            <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800 mb-6">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 bg-amber-500/10 rounded-2xl flex items-center justify-center text-pnp-gold border border-pnp-gold/20">
                        <i class="fas fa-key text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-pnp-blue dark:text-white uppercase tracking-wider">
                            Change Password
                        </h3>
                        <p class="text-[10px] text-slate-500 dark:text-gray-400 font-mono uppercase tracking-widest mt-0.5">
                            Rotate Tactical Credentials
                        </p>
                    </div>
                </div>
                <button type="button" onclick="closeChangePasswordModal()"
                    class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white border border-slate-200 dark:border-slate-700 flex items-center justify-center transition">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <!-- Form -->
            <form id="changePasswordForm" onsubmit="submitChangePassword(event)" class="space-y-5">
                <div id="changePassAlert" class="hidden p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2"></div>

                <!-- Current Password -->
                <div class="space-y-1.5">
                    <label for="cp_current" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                        Current Password <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="cp_current" required placeholder="Enter current password"
                            class="w-full pl-11 pr-11 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-xs text-pnp-blue dark:text-white">
                        <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                        <button type="button" onclick="togglePassField('cp_current', 'cp_eye0')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-gold">
                            <i id="cp_eye0" class="fas fa-eye text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- New Password -->
                <div class="space-y-1.5">
                    <div class="flex justify-between items-center">
                        <label for="cp_new" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                            New Password <span class="text-red-500">*</span>
                        </label>
                        <span class="text-[9px] text-gray-400 font-mono">Min 8 chars</span>
                    </div>
                    <div class="relative">
                        <input type="password" id="cp_new" required minlength="8" placeholder="••••••••••••"
                            class="w-full pl-11 pr-11 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-xs text-pnp-blue dark:text-white">
                        <i class="fas fa-shield-alt absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                        <button type="button" onclick="togglePassField('cp_new', 'cp_eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-gold">
                            <i id="cp_eye1" class="fas fa-eye text-xs"></i>
                        </button>
                    </div>
                </div>

                <!-- Confirm New Password -->
                <div class="space-y-1.5">
                    <label for="cp_confirm" class="block text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest">
                        Confirm New Password <span class="text-red-500">*</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="cp_confirm" required minlength="8" placeholder="••••••••••••"
                            class="w-full pl-11 pr-11 py-3 bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-pnp-blue/10 dark:focus:ring-pnp-gold/10 focus:border-pnp-blue dark:focus:border-pnp-gold outline-none transition font-bold text-xs text-pnp-blue dark:text-white">
                        <i class="fas fa-check-double absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                        <button type="button" onclick="togglePassField('cp_confirm', 'cp_eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-pnp-gold">
                            <i id="cp_eye2" class="fas fa-eye text-xs"></i>
                        </button>
                    </div>
                </div>

                <div class="pt-4 flex items-center space-x-3">
                    <button type="button" onclick="closeChangePasswordModal()"
                        class="w-1/2 py-3 px-4 rounded-xl bg-gray-100 dark:bg-slate-800 hover:bg-gray-200 dark:hover:bg-slate-700 text-gray-600 dark:text-slate-300 text-xs font-black uppercase tracking-wider transition">
                        Cancel
                    </button>
                    <button type="submit" id="cp_submit_btn"
                        class="w-1/2 py-3 px-4 rounded-xl bg-pnp-blue dark:bg-pnp-gold hover:bg-blue-900 dark:hover:bg-yellow-600 text-white dark:text-pnp-blue text-xs font-black uppercase tracking-wider transition shadow-lg flex items-center justify-center space-x-2">
                        <i class="fas fa-save text-xs"></i>
                        <span>Update</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openChangePasswordModal() {
        const modal = document.getElementById('changePasswordModal');
        if (modal) {
            modal.classList.remove('hidden');
            document.body.classList.add('modal-open');
            const alertBox = document.getElementById('changePassAlert');
            alertBox.classList.add('hidden');
            alertBox.className = 'hidden p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2';
            document.getElementById('changePasswordForm').reset();
        }
    }

    function closeChangePasswordModal() {
        const modal = document.getElementById('changePasswordModal');
        if (modal) {
            modal.classList.add('hidden');
            document.body.classList.remove('modal-open');
        }
    }

    function togglePassField(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    async function submitChangePassword(e) {
        e.preventDefault();
        const current_password = document.getElementById('cp_current').value;
        const new_password = document.getElementById('cp_new').value;
        const confirm_password = document.getElementById('cp_confirm').value;
        const alertBox = document.getElementById('changePassAlert');
        const submitBtn = document.getElementById('cp_submit_btn');

        if (new_password !== confirm_password) {
            alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2 bg-red-50 text-red-600 border border-red-200';
            alertBox.innerHTML = '<i class="fas fa-exclamation-triangle"></i><span>New passwords do not match.</span>';
            alertBox.classList.remove('hidden');
            return;
        }

        if (new_password.length < 8) {
            alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2 bg-red-50 text-red-600 border border-red-200';
            alertBox.innerHTML = '<i class="fas fa-exclamation-triangle"></i><span>New password must be at least 8 characters.</span>';
            alertBox.classList.remove('hidden');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i><span>Updating...</span>';

        try {
            const res = await fetch('/admin/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ current_password, new_password, confirm_password })
            });
            const data = await res.json();

            if (res.ok && data.success) {
                alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2 bg-green-50 text-green-700 border border-green-200';
                alertBox.innerHTML = '<i class="fas fa-check-circle"></i><span>Password updated successfully!</span>';
                alertBox.classList.remove('hidden');
                setTimeout(() => {
                    closeChangePasswordModal();
                }, 1500);
            } else {
                alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2 bg-red-50 text-red-600 border border-red-200';
                alertBox.innerHTML = `<i class="fas fa-exclamation-circle"></i><span>${data.error || 'Failed to update password.'}</span>`;
                alertBox.classList.remove('hidden');
            }
        } catch (err) {
            alertBox.className = 'p-3.5 rounded-2xl text-xs font-bold uppercase tracking-wider flex items-center space-x-2 bg-red-50 text-red-600 border border-red-200';
            alertBox.innerHTML = '<i class="fas fa-wifi"></i><span>Network error. Please try again.</span>';
            alertBox.classList.remove('hidden');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-save text-xs"></i><span>Update</span>';
        }
    }
</script>
