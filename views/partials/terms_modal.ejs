<script>
    (function() {
        let isReviewMode = false;

        function hasAcceptedTerms() {
            try {
                return sessionStorage.getItem('staCruzDisclaimerAccepted') === 'true' ||
                       localStorage.getItem('staCruzDisclaimerAccepted') === 'true';
            } catch (e) {
                return false;
            }
        }

        window.openTermsModal = function(reviewMode = false) {
            const modal = document.getElementById('jurisdiction-modal');
            const content = document.getElementById('modal-content');
            const closeBtn = document.getElementById('terms-modal-close-btn');
            const declineBtn = document.getElementById('decline-disclaimer');
            const acceptBtn = document.getElementById('accept-disclaimer');
            const agreeCb = document.getElementById('agree-terms');
            if (!modal || !content) return;

            isReviewMode = Boolean(reviewMode);

            if (isReviewMode) {
                if (closeBtn) closeBtn.classList.remove('hidden');
                if (closeBtn) closeBtn.classList.add('flex');
                if (declineBtn) declineBtn.classList.add('hidden');
                if (agreeCb) agreeCb.checked = true;
                updateTermsPolicyUI(true);
            } else {
                if (closeBtn) {
                    closeBtn.classList.remove('flex');
                    closeBtn.classList.add('hidden');
                }
                if (declineBtn) declineBtn.classList.remove('hidden');
                const accepted = hasAcceptedTerms();
                if (agreeCb) agreeCb.checked = accepted;
                updateTermsPolicyUI(accepted);
            }

            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';

            setTimeout(() => {
                modal.classList.remove('opacity-0');
                content.classList.remove('scale-95');
                content.classList.add('scale-100');
            }, 20);
        };

        window.closeTermsModal = function() {
            // In gate mode, closing without agreeing is forbidden
            if (!isReviewMode && !hasAcceptedTerms()) {
                const agreeCb = document.getElementById('agree-terms');
                if (agreeCb && !agreeCb.checked) {
                    highlightCheckbox();
                    return;
                }
            }

            const modal = document.getElementById('jurisdiction-modal');
            const content = document.getElementById('modal-content');
            if (!modal || !content) return;

            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');

            setTimeout(() => {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
                document.documentElement.style.overflow = '';
                isReviewMode = false;
            }, 300);
        };

        window.declineTerms = function() {
            const confirmed = confirm("You must accept the Terms and Conditions to access the Sta. Cruz Public Safety Portal. Do you wish to leave the portal?");
            if (confirmed) {
                try {
                    sessionStorage.removeItem('staCruzDisclaimerAccepted');
                    localStorage.removeItem('staCruzDisclaimerAccepted');
                } catch(e){}
                if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = 'https://www.google.com';
                }
            }
        };

        function highlightCheckbox() {
            const agreeCb = document.getElementById('agree-terms');
            if (!agreeCb) return;
            const container = agreeCb.closest('label');
            if (container) {
                container.classList.add('ring-2', 'ring-amber-500', 'p-1', 'rounded-lg');
                setTimeout(() => {
                    container.classList.remove('ring-2', 'ring-amber-500', 'p-1', 'rounded-lg');
                }, 1200);
            }
        }

        function updateTermsPolicyUI(isAccepted) {
            const acceptBtn = document.getElementById('accept-disclaimer');
            const validationMsg = document.getElementById('policy-validation-msg');

            if (isAccepted) {
                if (validationMsg) {
                    validationMsg.innerHTML = `
                        <i class="fas fa-check-circle text-emerald-500 text-sm sm:text-base"></i>
                        <span class="text-xs sm:text-sm font-bold text-emerald-700 dark:text-emerald-400">Terms and Conditions accepted. You may now proceed to the portal.</span>
                    `;
                }
                if (acceptBtn) {
                    acceptBtn.disabled = false;
                    acceptBtn.className = 'w-full flex-1 bg-pnp-blue hover:bg-pnp-gold hover:text-pnp-blue text-white font-black py-3 sm:py-3.5 rounded-xl transition-all duration-300 uppercase tracking-widest text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-lg cursor-pointer transform active:scale-[0.99]';
                    acceptBtn.innerHTML = `
                        <span>Proceed to Portal</span>
                        <i class="fas fa-arrow-right text-xs sm:text-sm"></i>
                    `;
                }
            } else {
                if (validationMsg) {
                    validationMsg.innerHTML = `
                        <i class="fas fa-exclamation-circle text-amber-500 text-sm sm:text-base"></i>
                        <span class="text-xs sm:text-sm font-bold text-amber-700 dark:text-amber-400">Please agree to the Terms and Conditions to proceed to the portal.</span>
                    `;
                }
                if (acceptBtn) {
                    acceptBtn.disabled = true;
                    acceptBtn.className = 'w-full flex-1 bg-slate-200 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed font-black py-3 sm:py-3.5 rounded-xl transition-all duration-300 uppercase tracking-widest text-xs sm:text-sm flex items-center justify-center space-x-2 shadow-sm';
                    acceptBtn.innerHTML = `
                        <i class="fas fa-lock text-xs sm:text-sm"></i>
                        <span>Proceed to Portal</span>
                    `;
                }
            }
        }

        function initTermsModal() {
            const acceptBtn = document.getElementById('accept-disclaimer');
            const agreeTermsCb = document.getElementById('agree-terms');
            const backdrop = document.getElementById('modal-backdrop');

            if (agreeTermsCb) {
                agreeTermsCb.addEventListener('change', () => {
                    updateTermsPolicyUI(agreeTermsCb.checked);
                });
            }

            if (acceptBtn) {
                acceptBtn.addEventListener('click', (e) => {
                    if (!agreeTermsCb || !agreeTermsCb.checked) {
                        e.preventDefault();
                        highlightCheckbox();
                        return;
                    }

                    try {
                        sessionStorage.setItem('staCruzDisclaimerAccepted', 'true');
                        localStorage.setItem('staCruzDisclaimerAccepted', 'true');
                    } catch (err) {}

                    closeTermsModal();
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', () => {
                    if (isReviewMode) {
                        closeTermsModal();
                    } else if (!hasAcceptedTerms()) {
                        highlightCheckbox();
                    }
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const modal = document.getElementById('jurisdiction-modal');
                    if (modal && !modal.classList.contains('hidden')) {
                        if (isReviewMode) {
                            closeTermsModal();
                        } else if (!hasAcceptedTerms()) {
                            highlightCheckbox();
                        }
                    }
                }
            });

            // Enforce gate on ANY public page if terms have not yet been accepted
            if (!hasAcceptedTerms()) {
                openTermsModal(false);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initTermsModal);
        } else {
            initTermsModal();
        }
    })();
</script>

